INSERT INTO `node__field_subtitle` VALUES ('news','0','1644','1708','en','0','<p>“Stick me on your fridge …”</p>\r\n','full_html'),('news','0','1646','1710','en','0','<p><strong>… and need your help</strong></p>\r\n','full_html'),('news','0','1647','1711','en','0','<p>Another successful ‘Community Hay-Day’</p>\r\n','full_html'),('news','0','1648','1712','en','0','<p>Over 100 people squeezed into the village hall for a trip down memory lane</p>\r\n','full_html'),('news','0','1652','1716','en','0','<p>Schoolchildren mark special occasion</p>\r\n','full_html'),('event','0','1653','1717','en','0','<p>A cabaret evening by Buriton Players</p>\r\n','full_html'),('event','0','1654','1718','en','0','<p>A cabaret evening by Buriton Players</p>\r\n','full_html'),('event','0','1655','1719','en','0','<p>Everyone is warned to expect the unexpected!</p>\r\n','full_html'),('event','0','1657','1721','en','0','<p>Arts, crafts and home-made produce.</p>\r\n','full_html'),('event','0','1659','1723','en','0','<p>Come and join the merry throng.</p>\r\n\r\n<p>The Liss Brass Band will be providing the music and, as usual, there will be mince pies, mulled wine and more carols in the church afterwards.&nbsp;&nbsp;</p>\r\n\r\n<p>It would be helpful if people could bring their own cup for the mulled wine.</p>\r\n\r\n<p>&nbsp;</p>\r\n','full_html'),('news','0','1660','1724','en','0','<p>Unfortunately, dog poo in the village continues to be a problem.</p>\r\n','full_html'),('event','0','1661','1725','en','0','<p>Raising money for good causes&nbsp;&nbsp;</p>\r\n','full_html'),('quickevent','0','1668','1734','en','0','<p>Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, starting at 7pm. Members of the public can attend meetings, observe business and ask questions in a Public Forum session at about 7.45pm. If you have any queries about any Parish Council matter, please contact our Clerk, Mrs Petra Norris via 07943 536065 or <a href="mailto:buritonparishcouncil@hotmail.co.uk">buritonparishcouncil@hotmail.co.uk</a>. More details about the Parish Council can be found elsewhere on this website:&nbsp;<a href="http://www.buriton.info/parish-council">http://www.buriton.info/parish-council</a></p>\r\n','full_html');
INSERT INTO `node__field_subtitle` VALUES ('quickevent','0','1669','1735','en','0','<p>Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, starting at 7pm. Members of the public can attend meetings, observe business and ask questions in a Public Forum session at about 7.45pm. If you have any queries about any Parish Council matter, please contact our Clerk, Mrs Petra Norris via 07943 536065 or <a href="mailto:buritonparishcouncil@hotmail.co.uk">buritonparishcouncil@hotmail.co.uk</a>. More details about the Parish Council can be found elsewhere on this website:&nbsp;<a href="http://www.buriton.info/parish-council">http://www.buriton.info/parish-council</a></p>\r\n','full_html'),('quickevent','0','1670','1736','en','0','<p>Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, starting at 7pm. Members of the public can attend meetings, observe business and ask questions in a Public Forum session at about 7.45pm. If you have any queries about any Parish Council matter, please contact our Clerk, Mrs Petra Norris via 07943 536065 or <a href="mailto:buritonparishcouncil@hotmail.co.uk">buritonparishcouncil@hotmail.co.uk</a>. More details about the Parish Council can be found elsewhere on this website:&nbsp;<a href="http://www.buriton.info/parish-council">http://www.buriton.info/parish-council</a></p>\r\n','full_html'),('quickevent','0','1671','1737','en','0','<p>Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, starting at 7pm. Members of the public can attend meetings, observe business and ask questions in a Public Forum session at about 7.45pm. If you have any queries about any Parish Council matter, please contact our Clerk, Mrs Petra Norris via 07943 536065 or <a href="mailto:buritonparishcouncil@hotmail.co.uk">buritonparishcouncil@hotmail.co.uk</a>. More details about the Parish Council can be found elsewhere on this website:&nbsp;<a href="http://www.buriton.info/parish-council">http://www.buriton.info/parish-council</a></p>\r\n','full_html');
INSERT INTO `node__field_subtitle` VALUES ('quickevent','0','1672','1738','en','0','<p>Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, starting at 7pm. Members of the public can attend meetings, observe business and ask questions in a Public Forum session at about 7.45pm. If you have any queries about any Parish Council matter, please contact our Clerk, Mrs Petra Norris via 07943 536065 or <a href="mailto:buritonparishcouncil@hotmail.co.uk">buritonparishcouncil@hotmail.co.uk</a>. More details about the Parish Council can be found elsewhere on this website:&nbsp;<a href="http://www.buriton.info/parish-council">http://www.buriton.info/parish-council</a></p>\r\n','full_html'),('quickevent','0','1673','1739','en','0','<p>Buriton Parish Council meets every alternate month throughout the year.</p>\r\n\r\n<p>On 15<sup>th</sup> May the Parish Council will also be holding its Annual Parish Meeting, commencing at 6.30pm.</p>\r\n\r\n<p>The Agenda for the Annual Parish Meeting will include an annual report and a copy of the full agenda for the Annual Parish Meeting will be available on the home page of the Parish Council part of this web-site.</p>\r\n\r\n<p>At the end of the Annual Parish Meeting, the Council will hold its regular meeting which will also provide an opportunity for members of the public to ask questions or make comments in a Public Forum session. More details about the Parish Council can be found elsewhere on this website:&nbsp;<a href="http://www.buriton.info/parish-council">http://www.buriton.info/parish-council</a></p>\r\n','full_html'),('event','0','1674','1740','en','0','<p>After achieving major-label success, shanty-singing group Fisherman’s Friends should be riding high. BUT ...</p>\r\n','full_html'),('event','0','1675','1741','en','0','<p>In 2012, having been lost for over 500 years, the remains of King Richard III were discovered beneath a carpark in Leicester.</p>\r\n','full_html'),('news','0','1677','1743','en','0','<p>The Parish Council has studied details and written to the Planning Authority</p>\r\n','full_html');
