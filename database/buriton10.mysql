INSERT INTO `search_dataset` VALUES ('118','en','node_search',' pupils give to ghana pupils give to ghana img4597jpg pupils from ditcham park school have recently been fundraising to help disadvantaged families in buriton s sister community of dominase in rural ghana doug jones mon 4042011 514pm  ','0'),('119','en','node_search',' another award for buriton another award for buriton weblogovillagevoicejpg members of buriton s parish plan team travelled to london in march and came home with the top prize in a competition across all counties in the south east of england doug jones mon 4042011 528pm  ','0'),('120','en','node_search',' more good news from ghana more good news from ghana webdsc0017jpg the pilot stage of buriton s programme to provide household toilets in dominase has now been completed successfully doug jones mon 4042011 548pm  ','0'),('121','en','node_search',' buriton s heritage bank needs your help buriton s heritage bank needs your help weblogojpg it is exactly ten years since the buriton heritage bank was launched and much has been achieved in that time a series of nine lavishly illustrated books was published in 2003 free copies were provided to every household in the parish and popular annual local history exhibitions have been held ever since doug jones mon 4042011 609pm  ','0'),('124','en','node_search',' the big question what do i believe  the big question what do i believe  pachasapopruuacuhovistajotrichidrarudocukonotredau an occasional discussion group of topical interest anonymous not verified sat 9042011 951am  ','0'),('125','en','node_search',' the next big question the next big question pachasapopruuacuhovistajotrichidrarudocukonotredau an occasional discussion group of topical interest anonymous not verified sat 9042011 954am  ','0'),('126','en','node_search',' we all believe in something  we all believe in something  pachasapopruuacuhovistajotrichidrarudocukonotredau the next big question will be does it matter what we believe anonymous not verified sat 9042011 955am  ','0'),('127','en','node_search',' buriton chalk pits open day buriton chalk pits open day pachasapopruuacuhovistajotrichidrarudocukonotredau a family friendly event on saturday 7th may to celebrate achievements over the past year in the buriton chalk pits project 11am 3pm  doug jones sun 10042011 842am  ','0');
INSERT INTO `search_dataset` VALUES ('129','en','node_search',' 1st beer men only  1st beer men only  pachasapopruuacuhovistajotrichidrarudocukonotredau first beer sunday may 1st at 800pm at the five bells a chance for the men of buriton to get together for a drink and some intelligent conversation starting subject euthanasia can it ever be justified anonymous not verified mon 18042011 1019pm  ','0'),('130','en','node_search',' 1st beer men only  1st beer men only  pachasapopruuacuhovistajotrichidrarudocukonotredau first beer sunday june 1st at 800pm at the five bells a chance for the men of buriton to get together for a drink and some intelligent conversation starting subject drugs doctors and diseases anonymous not verified mon 18042011 1020pm  ','0'),('131','en','node_search',' the five bells the five bells thefivebellsjpeg admin thu 21042011 613pm  ','0'),('132','en','node_search',' christian aid christian aid christianaid0jpeg admin thu 21042011 650pm  ','0'),('133','en','node_search',' christian aid week starts sunday 15 may christian aid week starts sunday 15 may pachasapopruuacuhovistajotrichidrarudocukonotredau as always buriton will be supporting this anuual fundraising drive for the poor and disadvantaged christian aid aims to attract support for its projects not just from the church community but from all quarters collection envelopes will be distributed in advance and collected housetohouse admin thu 21042011 700pm  ','0'),('134','en','node_search',' buriton cycling group buriton cycling group cyclingclub20jpeg admin fri 22042011 647pm  ','0'),('136','en','node_search',' buriton wine challenge buriton wine challenge pachasapopruuacuhovistajotrichidrarudocukonotredau this is the third buriton wine challenge in aid of the agsduk funds raised will sponsor allan muir to take part in a slightly more demanding challenge a 1500 mile cycle ride from pompey to pompeii in september all funds raised from the event will go towards supporting families living with pompe and related ultrarare diseases and to promote research into improved care and treatments admin sat 23042011 519am  ','0');
