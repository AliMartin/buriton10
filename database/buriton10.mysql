INSERT INTO `search_dataset` VALUES ('1418','en','node_search',' parish council update report november 2020 parish council update report november 2020 doug jones sat 5122020 243pm bpc update report november 2020pdf update reports 2020 2021 ','0'),('1419','en','node_search',' dog fouling new dog poop bag dispenser means no excuses now dog fouling new dog poop bag dispenser means no excuses now img1674ejpg the district council is helping to catch offenders doug jones sat 5122020 254pm  ','0'),('1420','en','node_search',' buriton parish council planning committee agenda 14 december 2020 buriton parish council planning committee agenda 14 december 2020 doug jones mon 7122020 406pm buriton parish council planning committee agenda 14 december 2020pdf agendas planning committee 2020 2021 ','0'),('1421','en','node_search',' parish council meeting parish council meeting buriton parish council normally meets every alternate month throughout the year with meetings taking place in the upper hall buriton village hall with an opportunity for members of the public to ask questions or make comments in a public forum session due to the current government restrictions on public meetings during the coronavirus outbreak buriton parish council has adopted alternative ways of working in order to continue with business whilst upholding democratic principles and compliance with the public health guidance members of the public are still able to attend meetings observe business and ask questions in a public forum session if you have any queries about any parish council matter please continue to contact our clerk mrs petra norris in the normal way via 7943 536065 or  buritonparishcouncil hotmailcouk  more details about the parish council can be found elsewhere on this website  http wwwburitoninfo parishcouncil   doug jones mon 7122020 603pm  ','0'),('1422','en','node_search',' parish council meeting parish council meeting buriton parish council normally meets every alternate month throughout the year with meetings taking place in the upper hall buriton village hall starting at 7pm with an opportunity for members of the public to ask questions or make comments in the public forum at 745pm due to the current government restrictions on public meetings during the coronavirus outbreak buriton parish council has adopted alternative ways of working in order to continue with business whilst upholding democratic principles and compliance with the public health guidance members of the public are still able to attend meetings observe business and ask questions in a public forum session if you have any queries about any parish council matter please continue to contact our clerk mrs petra norris in the normal way via 7943 536065 or  buritonparishcouncil hotmailcouk  more details about the parish council can be found elsewhere on this website  http wwwburitoninfo parishcouncil   doug jones mon 7122020 603pm  ','0');
INSERT INTO `search_dataset` VALUES ('1423','en','node_search',' parish council meeting including apm parish council meeting including apm buriton parish council normally meets every alternate month throughout the year with meetings taking place in the upper hall buriton village hall starting at 7pm with an opportunity for members of the public to ask questions or make comments in the public forum at 745pm due to the current government restrictions on public meetings during the coronavirus outbreak buriton parish council has adopted alternative ways of working in order to continue with business whilst upholding democratic principles and compliance with the public health guidance members of the public are still able to attend meetings observe business and ask questions in a public forum session this meeting in may 2021 will start at 630pm so as to accommodate the annual parish meeting the date has been brought forward this year because government legislation does not allow any councils to hold virtual meetings after 7th may but also currently prohibits indoor gatherings meetings or events if you have any queries about any parish council matter please continue to contact our clerk mrs petra norris in the normal way via 7943 536065 or  buritonparishcouncil hotmailcouk  more details about the parish council can be found elsewhere on this website  http wwwburitoninfo parishcouncil     doug jones mon 7122020 603pm  ','0'),('1424','en','node_search',' parish council meeting parish council meeting buriton parish council normally meets every alternate month throughout the year with meetings taking place in the upper hall buriton village hall starting at 7pm with an opportunity for members of the public to ask questions or make comments in the public forum at 745pm due to government restrictions on public meetings during the coronavirus outbreak buriton parish council adopted alternative ways of working in order to continue with business whilst upholding democratic principles and compliance with the public health guidance it is anticipated that this meeting of the parish council will take place in the main part of the village hall members of the public will be able to attend meetings observe business and ask questions in a public forum session if you have any queries about any parish council matter please continue to contact our clerk mrs petra norris in the normal way via 7943 536065 or  buritonparishcouncil hotmailcouk  more details about the parish council can be found elsewhere on this website  http wwwburitoninfo parishcouncil   doug jones mon 7122020 603pm  ','0');
