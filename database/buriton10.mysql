INSERT INTO `webform_submission` VALUES ('1245','contact_buriton_village_hall','f405826c-8cea-44a8-a40c-b7e0f44cdf76','846','N-UglDjnPw_jbxKwp4q1He1riLceS5g2Pbf9d4pGe3s','/form/contact-buriton-village-hall','1788458800','1788458800','1788458800','0',null,'82.5.104.145','0','en',null,null,'0',null,'0'),('1246','contact','4348d304-b4ab-4edb-8671-4638d535784f','398','ZkOdYkT_jk9FbzmunXmAv-ZEkDcHPgqTLW0buII65RM','/form/contact','1791870890','1791870890','1791870890','0',null,'109.153.96.211','0','en',null,null,'0',null,'0');
DROP TABLE IF EXISTS `webform_submission_data`;
CREATE TABLE `webform_submission_data` (   `webform_id` varchar(32) NOT NULL COMMENT 'The webform id.',   `sid` int(11) NOT NULL COMMENT 'The unique identifier for this submission.',   `name` varchar(128) NOT NULL COMMENT 'The name of the element.',   `property` varchar(128) NOT NULL DEFAULT '' COMMENT 'The property of the element''s value.',   `delta` int(10) unsigned NOT NULL DEFAULT 0 COMMENT 'The delta of the element''s value.',   `value` mediumtext NOT NULL COMMENT 'The element''s value.',   PRIMARY KEY (`sid`,`name`,`property`,`delta`),   KEY `webform_id` (`webform_id`),   KEY `sid_webform_id` (`sid`,`webform_id`),   KEY `name_webform_id` (`name`,`webform_id`),   KEY `name_property` (`name`,`property`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='Stores all submitted data for webform submissions.';
INSERT INTO `webform_submission_data` VALUES ('contact','1','email','','0','ali@alimartin.com'),('contact','1','message','','0','Test message'),('contact','1','name','','0','Ali test'),('contact','1','your_telephone_number','','0','07528686583'),('contact','3','email','','0','ali@alimartin.com'),('contact','3','message','','0','Testing the site contact form.'),('contact','3','name','','0','Ali'),('contact','3','your_telephone_number','','0','+447528686583'),('contact','4','email','','0','ali@alimartin.com'),('contact','4','message','','0','Test 2!'),('contact','4','name','','0','Ali'),('contact','4','your_telephone_number','','0','07528686583'),('contact','5','email','','0','rmsnelson@ntlworld.com'),('contact','5','message','','0','Hello. I''m not sure who to address this to but I''ve seen there is a film night in the village hall on Friday this week. As someone who has not been before, I assume one buys tickets on the door? If so, is there limited seating and is it usually necessary to arrive early to ensure a seat?\r\nMany thanks\r\nRuth Snelson'),('contact','5','name','','0','Ruth Snelson'),('contact','5','your_telephone_number','','0','07890000680'),('contact','6','email','','0','ali@alimartin.com'),('contact','6','message','','0','Should see Name, Email, Phone and Message (this bit!)'),('contact','6','name','','0','Test contact form'),('contact','6','your_telephone_number','','0','07528686583'),('contact','7','email','','0','g.j.s.knight@btinternet.com'),('contact','7','message','','0','I am Secretary of the Billingshurst Local History Society and would like to contact Jennifer Goldsmith re a possible talk. Have you got contact details for her?\r\nThanks.'),('contact','7','name','','0','Gillian Knight'),('contact','7','your_telephone_number','','0','01403784101'),('contact','8','email','','0','peteedwards004@hotmail.com'),('contact','8','message','','0','Hi,\r\nI hired the hall on 1St April, when I booked back in February I wrote out two cheques one was for the £100 deposit the other was for payment of the hall, both cheques were cash in February I was wondering when the deposit is going to be paid back to me as it has been nearly a month since my booking? ');
INSERT INTO `webform_submission_data` VALUES ('contact','8','name','','0','Pete Rohansten'),('contact','8','your_telephone_number','','0','07771512548'),('contact','9','email','','0','katwoo@me.com'),('contact','9','message','','0','hello - could some details about Lion and Unicorn''s next play be put on this site? Boudicca at Verulamium will be at Zurs, a private house in Rake, May 8-9, then St Peter''s Church, The Square, May 10-11 and finally in the Great Roundhouse at Butser Ancient Farm on May 12-13. Tickets from One Tree Books or https://www.ticketsource.co.uk/lionandunicornplayers  Tim Concannon has kindly lent us a sword and torc, and plenty of useful history on the subject!'),('contact','9','name','','0','Kat Wootton'),('contact','9','your_telephone_number','','0','07471203855'),('contact','10','email','','0','paulwidgery@cemco.com'),('contact','10','message','','0','Hi there,\r\nI''d like to speak to someone with regards the football pitch on the Rec. I grew up in the village many years ago & used to play football for Buriton in my youth. I now run Petersfield Ladies football team & have had such an amazing influx of players, that I would like to find a perminant home pitch for them. I have been with the team for 9 years & co-formed them. We have been a full adult team now for 2 years & are now looking at a second team, as it has grow so much, so having somewhere the team can call home would be amazing.\r\n\r\nLook forward to hearing from you\r\n\r\nBest Regards\r\nPaul'),('contact','10','name','','0','Paul Widgery'),('contact','10','your_telephone_number','','0','07834906592'),('contact','11','email','','0','francesca.haines@googlemail.com'),('contact','11','message','','0','Hi\r\n\r\nWe recently attended a friend''s party at your village hall. I''m looking to host my three year olds birthday party on Saturday 10th June from 10-2 pm. Is the hall free for hire on this date and time? Please let me know and what you charge for this hire. I can be flexible on the party timings at this stage.\r\n\r\nFeel free to call me if it''s easier.\r\n\r\nThanks Francesca Fowler\r\n07799146689');
INSERT INTO `webform_submission_data` VALUES ('contact','11','name','','0','Francesca Fowler'),('contact','11','your_telephone_number','','0','07799146689'),('contact','13','email','','0','lisa.jones@victimsupport.org.uk'),('contact','13','message','','0','Please could you advise me of a postal address for the clerk to the Parish Council?\r\nMany thanks\r\nLisa'),('contact','13','name','','0','Lisa Jones '),('contact','13','your_telephone_number','','0','023 8024 0600'),('contact','15','email','','0','nags@csciltd.com'),('contact','15','message','','0','You are advertising the Open Gardens on this site as 27th August when they should be 20th?'),('contact','15','name','','0','Naomi Gordon-Smith'),('contact','15','your_telephone_number','','0','01730 262586'),('contact','16','email','','0','tonymaurice24@yahoo.co.uk'),('contact','16','message','','0','I would like to know if the village hall would be available on Saturday 15th July for my daughters birthday party. Morning or afternoon wouldn''t be a problem.'),('contact','16','name','','0','tony'),('contact','16','your_telephone_number','','0','07722467987'),('contact','17','email','','0','lac_hall@yahoo.com'),('contact','17','message','','0','To whom it may concern,\r\nI just wanted to double check the time\r\nof the Judo Class on Wednesday.\r\nI think it is at 7.30 but could be wrong.\r\nYours sincerely,\r\nMr. Leander Hall\r\n'),('contact','17','name','','0','Leander Hall'),('contact','17','your_telephone_number','','0','01730 261340'),('contact','21','email','','0','wendy.wakelin@futuresys.co.uk'),('contact','21','message','','0','HI,\r\nWe went to the Farm Fun Day at Bolinge Farm on Sunday (25th June) with our steam engine and as we left I spoke to a lady about sending her some pictures of our time there, she said to sent them through to Buriton Parish Council but I can''t find an email address. Please could you email me back so I can forward these pictures onto the lady who owns Bolinge Farm and her friendly team of helpers.\r\n\r\nBest Regards\r\nWendy Wakelin'),('contact','21','name','','0','Wendy Wakelin'),('contact','21','your_telephone_number','','0','01730892944');
INSERT INTO `webform_submission_data` VALUES ('contact','22','email','','0','poetryonsouthdowns@gmail.com'),('contact','22','message','','0','Dear Town or Parish Councillor,\r\n\r\nI have been asked (by Winchester Poetry Festival, funding for the study from SDNPA) to write an initial feasibility study about installing a poetry trail on the South Downs. Potential ideas for the nature of the trail are listed in the survey questionnaire linked below. The first stage of the study for me is to gauge the opinions of those interested in the South Downs and gather suggestions. Therefore, I would be very grateful if you could fill in the survey.   Thanks so much for taking the time  to fill out this short survey. We would particularly value the views of people living in towns and villages near or in the South Downs National Park area. I stress that this is simply a first stage survey to take the temperature of local opinion among those who live on or near the South Downs or who visit the South Downs.\r\n\r\nThanks so much for your time and attention.\r\n\r\nwww.surveymonkey.co.uk/r/2TWN38K\r\n\r\n\r\n\r\nAll best wishes,\r\n\r\nStephanie \r\n\r\nStephanie Norgate\r\nReader in Creative Writing, University of Chichester\r\n\r\nwww.stephanienorgate.wordpress.com\r\nwww.bloodaxebooks.com/ecs/category/stephanie-norgate'),('contact','22','name','','0','Stephanie Norgate '),('contact','22','your_telephone_number','','0','O1730817578'),('contact','23','email','','0','chossels@yahoo.co.uk'),('contact','23','message','','0','Please would Joe Williams contact me with regard to giving a talk to Sheet WI next year.\r\nThank you\r\n'),('contact','23','name','','0','Madeleine McWilliam'),('contact','23','your_telephone_number','','0','01730233866'),('contact','24','email','','0','linda_godfrey@tiscali.co.uk'),('contact','24','message','','0','I have been researching my family history and had great problems finding my great great grandfather Henry Budd who was in the Royal Marines at the time of his marriage and the birth of my great grandfather and. I think may have been born in Buriton in 1821. His marriage certificate is difficult to read but I think hie fathers name was Thomas and he was a cordwainer (shoemaker). I think his mother Elizabeth was living at Weston Farm in 1841. Can you help?');
INSERT INTO `webform_submission_data` VALUES ('contact','24','name','','0','Linda Godfrey'),('contact','24','your_telephone_number','','0','01625428428'),('contact','25','email','','0','catherine.anne.pocock@ntlworld.com'),('contact','25','message','','0','I am looking for a farm we saw last year on a walk we did along the S Downs Way. The walk was from Hooksway though Didling then back again. This farm was just off the S Downs Way along a white track, and living there were two very nice red Vizla dogs. The OS map indicates that it might be called Buriton Farm, but I can''t find any other reference to it. I had some idea that they might have B&B accommodation at this property; we would be interested in staying there. Would you know what I am talking about? With thanks and regards.'),('contact','25','name','','0','Catherine Pocock'),('contact','25','your_telephone_number','','0','07813894554'),('contact','28','email','','0','frances_vesey@btconnect.com'),('contact','28','message','','0','Hi there Terry or whoever is standing in for you if still on hols.  On 2nd September we are doing a bar for someone in the hall.  I also have a private party off site elsewhere that day and wonder if the people using the hall have booked your crockery and cutlery?  If not the other offsite booking would be interested in hiring some.  We will collect and deliver to them and return clean.  Just need to know if it is available and what the price is.  Ta  Fran, The Five Bells'),('contact','28','name','','0','Frances Vesey'),('contact','28','your_telephone_number','','0','01730263584'),('contact','29','email','','0','collin.mcintosh@talk21.com'),('contact','29','message','','0','Good morning\r\n\r\nI am looking for a hall in which we could run dance lessons on Tuesday and Thursday evenings from about 19.00 hours until 22.00 hours.\r\n\r\nWould you be able to help, please?\r\n\r\nThank you\r\n\r\nBest regards\r\n\r\nCollin Mc Intosh'),('contact','29','name','','0','Collin Mc Intosh'),('contact','29','your_telephone_number','','0','023 9259 6755'),('contact','33','email','','0','Trevor@stollyhospital');
INSERT INTO `webform_submission_data` VALUES ('contact','33','message','','0','Arrived at 7.00am this morning for bootsale. Obviously has been cancelled, although no notification on website. Is there one tomorrow?'),('contact','33','name','','0','Trevor Bush'),('contact','33','your_telephone_number','','0','01730 826679'),('contact','34','email','','0','m.sidaway@ntlworld.com'),('contact','34','message','','0','What happened to the car boot advertised  for today  . We all got up early as did a lot more people , and drove over there  to find it wasn''t on  , not even a sign to say  it was cancelled  , so we had a wasted journey  ms '),('contact','34','name','','0','Mrs m sidaway  '),('contact','34','your_telephone_number','','0','0239259645'),('contact','35','email','','0','h.gardner1999@gmail.com'),('contact','35','message','','0','Can you tell me why does it say on this website that a car boot sale was to take place today, Sunday 27 august 2017, when there wasn''t? I had a wasted journey today to buriton from Portsmouth.'),('contact','35','name','','0','HILDA Gardner'),('contact','35','your_telephone_number','','0','07775950291'),('contact','36','email','','0','jon@jakesartisanfoods.co.uk'),('contact','36','message','','0','Hi \r\nI''m enquiringly about use of the kitchen in the village hall for a few times this week. \r\nCan you please get back asap?\r\nMuch appreciated. \r\nRegards\r\nJon \r\n\r\nRock Cottage\r\nSussex Road\r\n'),('contact','36','name','','0','Jon Kaye'),('contact','36','your_telephone_number','','0','07443422817'),('contact','37','email','','0','Nicky.morgans@icloud.com'),('contact','37','message','','0','Hi \r\nMy name is Nicky Morgans- I was approached my someone at the East Meon Fair to have a stall at the Briton xmas market. I can''t find the email that she sent to me, can to help me get back in touch? \r\n\r\nMany thanks \r\nNicky ????'),('contact','37','name','','0','Nicky Morgans'),('contact','37','your_telephone_number','','0','07876684074'),('contact','38','email','','0','Nicky.morgans@icloud.com'),('contact','38','message','','0','Hi \r\nMy name is Nicky Morgans- I was approached my someone at the East Meon Fair to have a stall at the Briton xmas market. I can''t find the email that she sent to me, can to help me get back in touch? \r\n\r\nMany thanks \r\nNicky ????');
INSERT INTO `webform_submission_data` VALUES ('contact','38','name','','0','Nicky Morgans'),('contact','38','your_telephone_number','','0','07876684074'),('contact','40','email','','0','paul.simmonds@ageconcernhampshire.org.uk'),('contact','40','message','','0','Is sent and email to the clerk to the Parish Council and it bounced back -\r\nmailto:wendy@bhcs.fsnet.co.uk. I believe there maybe a new clerk now, please could I have their email address?\r\n\r\nThank you\r\nPaul'),('contact','40','name','','0','Paul Simmonds'),('contact','40','your_telephone_number','','0','01962 892455'),('contact','41','email','','0','alex@southernplanning.co.uk'),('contact','41','message','','0','Dear Sir/Madam,\r\nI would like to know whether the Buriton Village Design Statement has now been fully adopted?  If so, can you please let me know the date of adoption, please.  I work as a planning consultant at Southern Planning Practice in Twyford, Winchester.  I did see the document on the website and I believe I may have seen a date, somewhere, indicating it was 3rd September 2017?\r\n\r\nRegards  Alex Webb'),('contact','41','name','','0','Alex Webb'),('contact','41','your_telephone_number','','0','01962 715770'),('contact','42','email','','0','katwoo@me.com'),('contact','42','message','','0','hello - can Playhouse Creatures performed by Lion and Unicorn go in the listings please? This play by April de Angelis, follows the first actresses on the stage in the 1660s. it''s funny, bawdy and poignant (adult themes and swearing!) Festival Hall, Petersfield, November 2,3,4 at 7.30pm and 2.30pm Sat matinee. Tickets from One Tree Books or www.lionandunicornplayers.co.uk '),('contact','42','name','','0','Kat Wootton'),('contact','42','your_telephone_number','','0','07471203855'),('contact','43','email','','0','teeman-1950@tiscali.co.uk'),('contact','43','message','','0','I''m enquiring to see if I can hold a caravan rally at the hall. I''ve been told there is grassland where we can site the vans. '),('contact','43','name','','0','Brian Tee'),('contact','43','your_telephone_number','','0','02392 253637');
INSERT INTO `webform_submission_data` VALUES ('contact','44','email','','0','karlosm18@yahoo.co.uk'),('contact','44','message','','0','just looking to see if the hall is free on the afternoon of the 3/12/2017 \r\n\r\nmanys thanks '),('contact','44','name','','0','karl messenger '),('contact','44','your_telephone_number','','0','07887404847'),('contact','45','email','','0','draig63@hotmail.com'),('contact','45','message','','0','Hello,\r\nWould you be able to put the details for Buriton Fireworks on the Website please?\r\n\r\n It is on Friday 3 November. Tickets are available from the Five Bells,  and village Post office, One Tree Books and the Sweet Stop in Petersfield. They can be bought online at www.ticketsource.co.uk/buritonfireworks. We have a Facebook & Twitter page. The website; www.buritonfireworks.org has had to be changed, so it''s not live at the moment. \r\nI have a logo/pictures  and further details etc, which I can send as attachments if you are able to contact me via my email.\r\n\r\nMany thanks,\r\n\r\nSian Griffiths'),('contact','45','name','','0','Sian Griffiths'),('contact','45','your_telephone_number','','0','01730 267203'),('contact','47','email','','0','francesca@midsummernightcap.com'),('contact','47','message','','0','Hello from Midsummer Nightcap!\r\n\r\nWe are a fully converted 1950''s Cheltenham caravan bar (very unique design in the UK) offering an enticing selection of classic and novel refreshments for shows, weddings, parties, festivals and all-sorts. \r\n\r\nMidsummer Nightcap is fully customisable- we wanted to create a beautiful bar with bifold windows and wooden hatches, to entice people to our bar but to also be personalised so we can create something unique for each event. We are available to serve a broad range of classic drinks on request, such as cold lagers, local craft ales, Prosecco (all on tap); traditional cocktails made from premium local spirits; vintage wines and champagne. Furthermore we can create unique and different offerings for each festival and event, from frozen cocktails in the summer to warm winter apple punch and pimms for winter.\r\n\r\nThe Midsummer Nightcap experience spans beyond the beverage. \r\n\r\nAll played from our vintage suitcase speaker, we carefully select 1960''s- 80''s tunes for our customers to jiggle to. We can offer as much seating and tables (and games!) as needs be, for kids to climb on and adults to laze in. All additionally with beautiful blankets for those winter months. \r\n\r\nMidsummer Nightcap has been selected to trade at all Blenheim Palace events this season, as well as being used as a Laurent-Perrier bar and in support of an interactive circus at the Dorset Sea food festival. Although we never fail to offer a premium-class service, our menu remain affordable- this is really important to us.\r\n\r\nWe are well-equipped with four draft systems, a cooler system, a back bar, two sinks as well as many additional extras.\r\n\r\nWe would love to create something extra special for your event, all lead onto by our coconut matting rug, with fantastic tunes being played from our suitcase speaker we really feel as though we can create something unique for the event. \r\n\r\nPlease do visit our website www.midsummernightcap.com which offers additional photos and concepts to those attached here. Please do email for some more photos of us in action.\r\n\r\nAll the best,');
INSERT INTO `webform_submission_data` VALUES ('contact','47','name','','0','Francesca Nally'),('contact','47','your_telephone_number','','0','07971531190'),('contact','48','email','','0','s_cork@hotmail.co.uk'),('contact','48','message','','0','Hello\r\n\r\nI have just had my garden fence replaced and the builder saw a sign for your bonfire night and wondered if you would like some old fence panels, approx 6, for your bonfire? He can drop them to you. \r\n\r\nKind regards\r\n\r\nSarah Cork'),('contact','48','name','','0','Sarah Cork'),('contact','48','your_telephone_number','','0','01730 601987'),('contact','50','email','','0','cathylatte@hotmail.com'),('contact','50','message','','0','Hi\r\nI have family coming to stay in the Buriton area next July - we have already contacted Nurstead Farm for accommodation but just wondering if there is another self catering/B&B place in the village I could contact as they can''t all fit in there.  It would be for 4 people.\r\nThanks Cath Crook'),('contact','50','name','','0','Cath Crook'),('contact','50','your_telephone_number','','0','07751304182'),('contact','51','email','','0','support@landandpartners.com'),('contact','51','message','','0','To whom it may concern,\r\n\r\nI am carrying out some research on behalf of Land & Partners, a land promotion company, into shared space and traffic calming schemes in rural areas, such as those advocated by Ben Hamilton-Baillie.\r\n\r\nI understand that a successful scheme was implemented in Buriton a couple of years ago with the help of Hamilton-Baillie Associates and I am interested in finding out more about how the Parish Council was able to work with Hampshire County Council to design, approve and fund the project.\r\n\r\nAny information you can provide on this would be greatly appreciated.\r\n\r\nKind regards,\r\n\r\n\r\nAbigail Jefferies\r\nProjects Assistant\r\n\r\nfor and on behalf of\r\nLand & Partners Limited\r\n8 High Bois Lane\r\nAmersham\r\nBucks HP6 6DG\r\n\r\n01494 728080\r\nsupport@landandpartners.com\r\nwww.landandpartners.com\r\nwww.villagefoundations.co.uk');
INSERT INTO `webform_submission_data` VALUES ('contact','51','name','','0','Abigail Jefferies'),('contact','51','your_telephone_number','','0','01494 728080'),('contact','52','email','','0','tjthraves@gmail.com'),('contact','52','message','','0','I''m looking for historical info on Buriton from maybe 1066 or even before, particularly referring to the route of the Portsmouth Road, the church and the emergence of Petersfield!\r\nWhom do you think I should contact?'),('contact','52','name','','0','Terry Thraves'),('contact','52','your_telephone_number','','0','01730 260160'),('contact','53','email','','0','nathalie.macdonald@ditchampark.com'),('contact','53','message','','0','I am Head of House at Ditcham Park school, and our house is called Buriton. As a house, we would like to do some community work at Buriton, and I would like your thoughts on what we could do. We also have a small budget for our community work, and we were thinking of either planting bulbs or small trees/shrubs with a plaque, or if you think that a bench is needed; we are open to any suggestion. Please do not use the phone number, as I teach all day and cannot get out of the classroom to answer a phone call.\r\nKind regards,  \r\nNathalie MacDonald\r\n'),('contact','53','name','','0','Nathalie MacDonald'),('contact','53','your_telephone_number','','0','01730 825659'),('contact','54','email','','0','nathalie.macdonald@ditchampark.com'),('contact','54','message','','0','I am Head of House at Ditcham Park school, and our house is called Buriton. As a house, we would like to do some community work at Buriton, and I would like your thoughts on what we could do. We also have a small budget for our community work, and we were thinking of either planting bulbs or small trees/shrubs with a plaque, or if you think that a bench is needed; we are open to any suggestion. Please do not use the phone number, as I teach all day and cannot get out of the classroom to answer a phone call.\r\nKind regards,  \r\nNathalie MacDonald\r\n'),('contact','54','name','','0','Nathalie MacDonald'),('contact','54','your_telephone_number','','0','01730 825659');
INSERT INTO `webform_submission_data` VALUES ('contact','55','email','','0','samanthagolden@me.com'),('contact','55','message','','0','Hi there, I''m writing from a small village in Wiltshire where our local farmer wants to turn a barn into a wedding venue.  I''m desperate to hear from any of the group who successfully fought your venue and had it closed down.  I"m worried that our village is sleepwalking in to what will fast become a nightmare.  Could the Parish Council make contact as well?  I would really appreciate some guidance on how you managed to bring the beast down?  All the best, Samantha'),('contact','55','name','','0','Samantha Golden'),('contact','55','your_telephone_number','','0','07813965337'),('contact','56','email','','0','CATTDAMON871@GMAIL.COM'),('contact','56','message','','0','Dear Sir or Madam,\r\n                                Having read all the Buriton in World War 1 articles--which featured my\r\nGrandfather Albert Marriner--I wondered if it might be possible to contact the author of\r\nsaid articles to discuss how he or she gathered the details for the project.'),('contact','56','name','','0','DAMON CATT '),('contact','56','your_telephone_number','','0','02392 597 825'),('contact','57','email','','0','megend@btinternet.com'),('contact','57','message','','0','Dear All\r\n\r\nThere is a generation of Buriton children who have never experienced a street party\r\nI suggest one in May for the wedding similar to 2012\r\nI need movers and shakers to get this und reward\r\nMy health does not allow me to lead it so your help needed\r\nNorman davies'),('contact','57','name','','0','Norman davies'),('contact','57','your_telephone_number','','0','01730268149'),('contact','58','email','','0','louise@jobcentrenearme.com'),('contact','58','message','','0','Hi,\r\n     \r\nI’m reaching out on behalf of Jobcentre Near Me. We’ve made it easier to find local Jobcentre Plus offices, benefits and employment information.\r\n\r\nPlease, would you consider adding http://www.jobcentrenearme.com to your page http://www.buriton.info/useful_links and help people find their nearest jobcentre more easily?\r\n\r\nThanks for your time,\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','58','name','','0','Louise'),('contact','58','your_telephone_number','','0','0345 608 8545'),('contact','59','email','','0','liz@sawscapesplay.co.uk'),('contact','59','message','','0','I would be very interested in providing a quotation to supply and install play equipment in your proposed new play area.  Sawscapes Play is a family run company and based based in Alton and we are Hampshire approved.\r\nPlease let me know if it would be possible to discuss your requirements  further.\r\n\r\nkind regards\r\n\r\nLiz'),('contact','59','name','','0','Liz Strain'),('contact','59','your_telephone_number','','0','01420 257234'),('contact','60','email','','0','louise@jobcentrenearme.com'),('contact','60','message','','0','Hi,\r\n\r\nI’m writing to follow up on my email. I didn’t hear back from anyone on the team. If it makes sense to talk, let me know how your calendar looks.\r\n\r\nIf not, who is the appropriate person for me to talk to?\r\n\r\nThanks for your help'),('contact','60','name','','0','Louise'),('contact','60','your_telephone_number','','0','0345 608 8545'),('contact','62','email','','0','grant.abbott@ditchampark.com'),('contact','62','message','','0','Good afternoon\r\n\r\nI am the Bursar at Ditcham Park School and I would like to set up a communication with the Parish Councils that are in the schools vicinity in order to keep you informed of any developments regarding the school. Therefore, and if you are interested, please send me the email details of a point of contact and I will forward any pertinent information and arrange any meetings if required.\r\n\r\nAll the best in the New Year\r\n\r\nGrant Abbott'),('contact','62','name','','0','Grant Abbott'),('contact','62','your_telephone_number','','0','01730 825 659 Ext 225'),('contact','63','email','','0','charliemartin054@gmail.com'),('contact','63','message','','0','Could you please send me details of your short-mat bowls,\r\nC Martin.'),('contact','63','name','','0','Charles Martin'),('contact','63','your_telephone_number','','0','07950759831'),('contact','64','email','','0','sndrlynes315@gmail.com');
INSERT INTO `webform_submission_data` VALUES ('contact','64','message','','0','I am a Personal Trainer who is looking for local venues to run fitness classes.'),('contact','64','name','','0','Sandra Lynes'),('contact','64','your_telephone_number','','0','2392175190'),('contact','65','email','','0','karen.hall@hotmail.com'),('contact','65','message','','0','Hello,\r\nI am looking to hire a village hall for  me to use 1 evening a week, I run a dog training comapny and would like to offer small classes - of 4/5 dogs per class.\r\n\r\nI have used village halls before and am used to doing the sweeping and washing of floor after I have finished to get rid of any hairs.\r\n\r\nWould this be possible at all.\r\n\r\nThere is a good demand for a class locally.\r\n\r\nI have been training dogs for over 30yrs and am insured.\r\n\r\nI look forward to hearing from you'),('contact','65','name','','0','karen Hall'),('contact','65','your_telephone_number','','0','07795574868'),('contact','66','email','','0','wylds7@yahoo.co.uk'),('contact','66','message','','0','Hello Terry\r\nWould like to know the availability of Buriton Hall for either the 21st or 28th April 2018.\r\nWe are Buriton parishioners, living in Weston, and wish to possibly hire this venue for a birthday celebration.  I believe there is a separate cost for the main hall and the stage, so would be grateful to know the rates for each. Many thanks Liz Baker'),('contact','66','name','','0','Mrs Liz Baker'),('contact','66','your_telephone_number','','0','01730 264378'),('contact','71','email','','0','michaelis.edward@gmail.com'),('contact','71','message','','0','Hey there, I am a firendly walker from Germany planning on doing the South Downs Way in May. I love traveling in my one person tent however its not always easy to find a place to pitch my tent. Especially as wild camping is technically not allowed in Britain. So I try to communicate in advance to avoid trouble. I am looking for a place to camp in the vicinity of East Harting. There is a farm located directly on the trail. The OS Map says its called Buriton Farm. Is there any way I can contact the farmer to ask if its ok to pitch my tent next to the trail on his land? I hope this message isnt totally weird. I just dont want to piss anyone off.\r\nAll the best from Berlin');
INSERT INTO `webform_submission_data` VALUES ('contact','71','name','','0','Edward Michaelis'),('contact','71','your_telephone_number','','0','17642088254'),('contact','72','email','','0','megend@btinternet.com'),('contact','72','message','','0','\r\nII write to enquire as to interest in holding a street party for the village on the 19th of may\r\nFor the royal wedding\r\nI can only sew the seed\r\nI am thinking along the lines of 2012\r\nYours\r\nNorman Davies'),('contact','72','name','','0','Norman Davies'),('contact','72','your_telephone_number','','0','01730268149'),('contact','73','email','','0','duncancumminguk@yahoo.co.uk'),('contact','73','message','','0','Good Morning \r\n\r\nWe were just wondering if you had any availability for Saturday 2nd March 2018 at 2 pm for 2 hours for our sons 11th birthday?  Many thanks in advance\r\n\r\nDuncan and Suzie Cumming \r\n07990 695926'),('contact','73','name','','0','Duncan Cumming'),('contact','73','your_telephone_number','','0','07990695926'),('contact','75','email','','0','fionajcrosby@hotmail.com'),('contact','75','message','','0','Hello\r\nWe are looking for a venue for a 16th birthday party on Friday 13th July.\r\nCould you please advise your availability.\r\nMany thanks\r\nFiona Crosby'),('contact','75','name','','0','Fiona Crosby'),('contact','75','your_telephone_number','','0','7833671088'),('contact','76','email','','0','lee.coares.chimneys@btinternet.com'),('contact','76','message','','0','Hi there, \r\nJust enquiring whether there is availability of the hall for today, we’d like to hire it for an hour in about an hours time? \r\nThank you'),('contact','76','name','','0','Heidi Crew'),('contact','76','your_telephone_number','','0','07917840218'),('contact','77','email','','0','marthatryers1@gmail.com'),('contact','77','message','','0','Desperately trying to find my dear elderly boss, Roger Kerry, from Derbyshire, B&B accommodation for the night of 15th June as he walks the SDW, which he has done annually for years!  We have organised accommodation for the 10 day walk , except for that night in Buriton! The problem seems to be that he has his 2 lovely Springers - trained to command - with him, as always. Nursted Farm, The Village Inn, the 5 Bells etc etc do not accept dogs. Roger is a lovely, Christian chap, and at 78 this will probably be the last time he and the Springers manage the SDW walk. Do you know anyone in the village who could accommodate this lovely trio for the night? Roger is happy to pay a generous donation to anyone who can offer him B&B and direct him to an evening meal on the 15th June! Any suggestions please??? Private household, farm.... the vicarage! The dogs are happy to be kennelled over night, and Roger is a wonderful chap. There must be someone in Buriton who can help!!! ');
INSERT INTO `webform_submission_data` VALUES ('contact','77','name','','0','Martha Tryers'),('contact','77','your_telephone_number','','0','07507676209'),('contact','79','email','','0','helenmountain25@hotmail.com'),('contact','79','message','','0','I asked to speak at the planning meeting in Midhurst tomorrow representing Ramblers Ass. i understand that only 3 speakers are allowed so don''t want to deprive someone else of the opportunity. I would welcome a phone call to discuss this before tomorrow.'),('contact','79','name','','0','Helen Mountain'),('contact','79','your_telephone_number','','0','01730 262437'),('contact','80','email','','0','deanlowe72@gmail.com'),('contact','80','message','','0','Good afternoon,\r\nI am just enquiringly as to the current usage of the football pitch in buriton?\r\nI help run a local vets team in the Farnham and district Sunday league and am thinking of relocating to another pitch as of next season.\r\nCould you advise me as to the possible availability/costs etc?\r\nKindest regards,\r\nDean lowe '),('contact','80','name','','0','Dean lowe'),('contact','80','your_telephone_number','','0','07791741695'),('contact','81','email','','0','lorem12641ipsum@gmail.com'),('contact','81','message','','0','Sed ut perspiciatis, unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam eaque ipsa, quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt, explicabo. Nemo enim ipsam voluptatem, quia voluptas sit, aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos, qui ratione voluptatem sequi nesciunt, neque porro quisquam est, qui dolorem ipsum, quia dolor sit amet consectetur adipisci[ng] velit, sed quia non-numquam [do] eius modi tempora inci[di]dunt, ut labore et dolore magnam aliquam quaerat voluptatem. Ut enim ad minima veniam, quis nostrum exercitationem ullam corporis suscipit laboriosam, nisi ut aliquid ex ea commodi consequatur? Quis autem vel eum iure reprehenderit, qui in ea voluptate velit esse, quam nihil molestiae consequatur, vel illum, qui dolorem eum fugiat, quo voluptas nulla pariatur?\r\nAt vero eos et accusamus et iusto odio dignissimos ducimus, qui blanditiis praesentium voluptatum deleniti atque corrupti, quos dolores et quas molestias excepturi sint, obcaecati cupiditate non-provident, similique sunt in culpa, qui officia deserunt mollitia animi, id est laborum et dolorum fuga. Et harum quidem rerum facilis est et expedita distinctio. Nam libero tempore, cum soluta nobis est eligendi optio, cumque nihil impedit, quo minus id, quod maxime placeat, facere possimus, omnis voluptas assumenda est, omnis dolor repellendus. Temporibus autem quibusdam et aut officiis debitis aut rerum necessitatibus saepe eveniet, ut et voluptates repudiandae sint et molestiae non-recusandae. Itaque earum rerum hic tenetur a sapiente delectus, ut aut reiciendis voluptatibus maiores alias consequatur aut perferendis doloribus asperiores repellat…');
INSERT INTO `webform_submission_data` VALUES ('contact','81','name','','0','Lorem Ipsum'),('contact','81','your_telephone_number','','0','6549876543'),('contact','82','email','','0','gemzls@live.co.uk'),('contact','82','message','','0','Hi there,\r\nI would like to enquire if the hall is available to hire on Sunday 10th June. \r\nDo you have the facilities to slupply inflatables or soft play? If not would this be possible to have a company provide on the day? \r\nUnfortunately I struggle with emails, so if you would be so kind and give me a call back it would be much appreciated. \r\nThanks\r\nGemma'),('contact','82','name','','0','Gemma'),('contact','82','your_telephone_number','','0','07583415269'),('contact','83','email','','0','hello@postofficesnearme.com'),('contact','83','message','','0','Hi Dear , \r\n\r\nI’m emailing on behalf of Post Office Near Me. We’re making it easier for people to find local post offices and the services they offer. \r\n\r\n\r\nPlease, would you consider adding https://www.postofficesnearme.com/ to your website page http://www.buriton.info/useful_links and help people find their nearest post offices more easily? \r\n\r\n\r\nThanks for your help, \r\n\r\nAmy '),('contact','83','name','','0','Amy'),('contact','83','your_telephone_number','','0','03456112970'),('contact','84','email','','0','barbsart@hotmail.co.uk'),('contact','84','message','','0','I am a watercolour artist in Waterlooville, can you advise me if your trail is open to artists from my area and if so how do you apply please. Many thanks'),('contact','84','name','','0','Barbara Jones'),('contact','84','your_telephone_number','','0','07734044971'),('contact','85','email','','0','barbsart@hotmail.co.uk'),('contact','85','message','','0','I am a watercolour artist in Waterlooville, can you advise me if your trail is open to artists from my area and if so how do you apply please. Many thanks'),('contact','85','name','','0','Barbara Jones'),('contact','85','your_telephone_number','','0','07734044971'),('contact','86','email','','0','hello@postofficesnearme.com'),('contact','86','message','','0','Hi, \r\n\r\nI am writing to follow up on my previous email. \r\n\r\nPlease could you get back to me at the earliest possible convenience? Or, forward my enquiry on to a relevant member of staff if appropriate.\r\n\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','86','name','','0','Amy'),('contact','86','your_telephone_number','','0','03456112970'),('contact','87','email','','0','glen.robinson@interworks.co.uk'),('contact','87','message','','0','Hi, \r\nCould you let me know when the Rec is going to be mowed? \r\nThe grass is too long for the kids to play football, and I am getting constantly pestered about it.\r\nThanks in advance\r\nGlen\r\n'),('contact','87','name','','0','Glen Robinson'),('contact','87','your_telephone_number','','0','07729861285'),('contact','89','email','','0','chair.droxfordpc@gmail.com'),('contact','89','message','','0','Hullo, With the imminent arrival of GDPR regulations, I would like to find out what cloud provider your Parish uses and how user-friendly you have found it. The new regulations may be somewhat onerous and I thought it better to start with some research in the first instance. Looking forward to hearing from you.\r\nThank you.'),('contact','89','name','','0','Barbara Chandler'),('contact','89','your_telephone_number','','0','01489878741'),('contact','90','email','','0','jstormont@hotmail.com'),('contact','90','message','','0','Will there be a Buriton Car Boot Sale in 2018'),('contact','90','name','','0','Jeanne'),('contact','90','your_telephone_number','','0','01730 825636'),('contact','91','email','','0','lisasaines@hotmail.com'),('contact','91','message','','0','Good morning,\r\n\r\nWe have in previous years had a family event at Buriton village hall. We are looking to arrange another one and we’re wondering what Saturday dates are available this year? \r\n\r\nMany thanks '),('contact','91','name','','0','Lisa Saines '),('contact','91','your_telephone_number','','0','07793866345'),('contact','92','email','','0','loremipsum1234777@gmail.com'),('contact','92','message','','0','Sed ut perspiciatis, unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam eaque ipsa, quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt, explicabo. Nemo enim ipsam voluptatem, quia voluptas sit, aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos, qui ratione voluptatem sequi nesciunt, neque porro quisquam est, qui dolorem ipsum, quia dolor sit amet consectetur adipisci[ng] velit, sed quia non-numquam [do] eius modi tempora inci[di]dunt, ut labore et dolore magnam aliquam quaerat voluptatem. Ut enim ad minima veniam, quis nostrum exercitationem ullam corporis suscipit laboriosam, nisi ut aliquid ex ea commodi consequatur? Quis autem vel eum iure reprehenderit, qui in ea voluptate velit esse, quam nihil molestiae consequatur, vel illum, qui dolorem eum fugiat, quo voluptas nulla pariatur?');
INSERT INTO `webform_submission_data` VALUES ('contact','92','name','','0','Lorem Ipsum'),('contact','92','your_telephone_number','','0','6549876543'),('contact','93','email','','0','sophie@comparitech.email'),('contact','93','message','','0','Hi,\r\n\r\nGiven you recommend the Action Fraud initiative [here on this page http://www.buriton.info/node/738] I thought I’d reach out to suggest one of our resources which may also be worth including on your website.\r\n\r\n70+ Scams and How to Avoid Them - http://compari.tech/avoid-scams\r\n\r\nI’m confident this list is the most comprehensive A-Z of common scams, schemes and fraud.\r\n\r\nIf you think this will be useful, could you add a link to this on your website?\r\n\r\nPlease let me know if I can do anything to help.\r\n\r\nThanks,\r\nSophie\r\n\r\n-----\r\nSophie Hunt\r\nComparitech\r\n\r\n+44 (0)333 577 0163\r\n\r\nFind us on Twitter\r\nFind us on Facebook\r\nFind us on LinkedIn'),('contact','93','name','','0','Sophie'),('contact','93','your_telephone_number','','0','+44 (0)333 577 0163'),('contact','94','email','','0','sophie@comparitech.email'),('contact','94','message','','0','Hi, \r\n\r\nI''ve tried to reach you a couple of times now but I''m sure you''re busy or my suggestion isn''t of interest. Either way I don''t want to be a nuisance so I''m just following up one last time before I leave you alone. \r\n\r\nGiven you recommend the Action Fraud initiative [here on this page http://www.buriton.info/node/738] I thought I’d reach out to suggest one of our resources which may also be worth including on your website.\r\n\r\n70+ Scams and How to Avoid Them - http://compari.tech/avoid-scams\r\n\r\nI’m confident this list is the most comprehensive A-Z of common scams, schemes and fraud.\r\n\r\nIf you think this will be useful, could you add a link to this on your website?\r\n\r\nPlease let me know if I can do anything to help.\r\n\r\nThanks,\r\nSophie\r\n\r\n-----\r\nSophie Hunt\r\nComparitech\r\n\r\n+44 (0)333 577 0163\r\n\r\nFind us on Twitter\r\nFind us on Facebook\r\nFind us on LinkedIn');
INSERT INTO `webform_submission_data` VALUES ('contact','94','name','','0','Sophie'),('contact','94','your_telephone_number','','0','+44 (0)333 577 0163'),('contact','95','email','','0','lissfuneral@southerncoops.co.uk'),('contact','95','message','','0','Would like information on the following fees\r\nchurch service for a burial \r\nVerger fees\r\norganist fees\r\nHeating fees \r\nministers fees hope you can help many thanks\r\n'),('contact','95','name','','0','Tracy Newman'),('contact','95','your_telephone_number','','0','01730895593'),('contact','97','email','','0','webdesignz2impress@gmail.com'),('contact','97','message','','0','I just checked out your website and I have some ideas I''d like to discuss with you regarding how make it great.\r\n\r\nI am a veteran web designer/developer who has almost a decade of experience in both creating websites from scratch and in redesigning existing sites to cater to the modern needs of a company. I offer top-notch results at affordable prices. Please let me know if you are interested in my services and I will gladly reach out though phone.\r\n\r\nSincerely,\r\nBradley Hunt'),('contact','97','name','','0','Bradley Hunt'),('contact','97','your_telephone_number','','0','(707) 144-7819'),('contact','98','email','','0','joel@worldeconomies.org'),('contact','98','message','','0','Hi,\r\n\r\nAre you able to help us raise awareness of some common investment scams?\r\n\r\nMost anti-fraud resources online (including initiatives like Action Fraud) don’t adequately cover investment fraud which is what prompted us to prepare a detailed guide to the topic. \r\n\r\nHere’s the link - http://commodity.link/avoid-scams\r\n\r\nIt covers 9 common investment scams and provides a simple checklist to help people protect their money.\r\n\r\nIf you think your community will find this valuable, could you add a link to it from your website? \r\n\r\nPlease let me know if you have any questions.\r\n\r\nThank you in advance.\r\n\r\n-Joel\r\n\r\n---\r\nJoel Foster\r\nCommunity Manager\r\n\r\n'),('contact','98','name','','0','Joel Foster');
INSERT INTO `webform_submission_data` VALUES ('contact','98','your_telephone_number','','0','0'),('contact','99','email','','0','sites2impress96@gmail.com'),('contact','99','message','','0','Hi, I am looking for new clients who are interested in giving their website an edge in both design and sales. I am a skilled web designer that can produce quality work at a price that even small businesses can afford. I am confident that I can do anything that you can come up with or I can share with you some ideas that I came up with when I saw your site. I can tell you that having a great looking website will increase your profits.\r\n\r\nSo if you''re interested, let''s talk. Let me know who I can speak with and the best time I can reach out. I look forward to speaking with you.\r\n- Mario Ferguson'),('contact','99','name','','0','Carmen Webb'),('contact','99','your_telephone_number','','0','(678) 661-1593'),('contact','100','email','','0','elwalters13@outlook.com'),('contact','100','message','','0','Hi there \r\nI was wondering if the hall is available to hire on Sunday 22nd July 2018 please? It will be for my children''s 1st birthday party any time in afternoon is fine. \r\nIf it is available could I please have info on prices ect \r\nMany thanks \r\nEmma '),('contact','100','name','','0','Emma Walters'),('contact','100','your_telephone_number','','0','07881373268'),('contact','101','email','','0','joel@worldeconomies.org'),('contact','101','message','','0','Hi, \r\n\r\nQuick follow-up in case you missed my email from the other day:\r\n\r\nOn Wed, May 23, 2018 at 11:03 AM, <> wrote:\r\nHi,\r\n\r\nAre you able to help us raise awareness of some common investment scams?\r\n\r\nMost anti-fraud resources online (including initiatives like Action Fraud) don’t adequately cover investment fraud which is what prompted us to prepare a detailed guide to the topic. \r\n\r\nHere’s the link - http://commodity.link/avoid-scams\r\n\r\nIt covers 9 common investment scams and provides a simple checklist to help people protect their money.\r\n\r\nIf you think your community will find this valuable, could you add a link to it from your website? \r\n\r\nPlease let me know if you have any questions.\r\n\r\nThank you in advance.\r\n\r\n-Joel\r\n\r\n---\r\nJoel Foster\r\nCommunity Manager\r\n\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','101','name','','0','Joel Foster'),('contact','101','your_telephone_number','','0','0'),('contact','103','email','','0','sharon@pennicott.co.uk'),('contact','103','message','','0','Good morning,\r\n\r\nI am seeking some further information regarding your vacancy for a Parish Clerk,\r\n\r\nI am currently a part-time Parish Clerk with a CiLCA qualification.\r\n\r\nThank you\r\n\r\nSharon'),('contact','103','name','','0','Sharon Hurr'),('contact','103','your_telephone_number','','0','07493 038895'),('contact','104','email','','0','sites2impress96@gmail.com'),('contact','104','message','','0','Hi, I am looking for new clients who are interested in giving their website an edge in both design and sales. I am a skilled web designer that can produce quality work at a price that even small businesses can afford. I am confident that I can do anything that you can come up with or I can share with you some ideas that I came up with when I saw your site. I can tell you that having a great looking website will increase your profits.\r\n\r\nSo if you''re interested, let''s talk. Let me know who I can speak with and the best time I can reach out. I look forward to speaking with you.\r\n- Mario Ferguson'),('contact','104','name','','0','Carmen Webb'),('contact','104','your_telephone_number','','0','(678) 661-1593'),('contact','105','email','','0','joel@worldeconomies.org'),('contact','105','message','','0','Hi, \r\n\r\nI''ve tried to reach you a couple of times now but I''m sure you''re busy or my suggestion isn''t of interest. Either way I don''t want to be a nuisance so I''m just following up one last time before I leave you alone.\r\n\r\nOn Tue, May 29, 2018 at 3:48 PM, <> wrote:\r\nHi, \r\n\r\nQuick follow-up in case you missed my email from the other day:\r\n\r\nOn Wed, May 23, 2018 at 11:03 AM, <> wrote:\r\nHi,\r\n\r\nAre you able to help us raise awareness of some common investment scams?\r\n\r\nMost anti-fraud resources online (including initiatives like Action Fraud) don’t adequately cover investment fraud which is what prompted us to prepare a detailed guide to the topic. \r\n\r\nHere’s the link - http://commodity.link/avoid-scams\r\n\r\nIt covers 9 common investment scams and provides a simple checklist to help people protect their money.\r\n\r\nIf you think your community will find this valuable, could you add a link to it from your website? \r\n\r\nPlease let me know if you have any questions.\r\n\r\nThank you in advance.\r\n\r\n-Joel\r\n\r\n---\r\nJoel Foster\r\nCommunity Manager\r\n\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','105','name','','0','Joel Foster'),('contact','105','your_telephone_number','','0','0'),('contact','106','email','','0','CHRISTINA.LONG929@gmail.com'),('contact','106','message','','0','Are you interested in increasing the sales that you get from your site?\r\nOne of the things you can do is give your site a new and more modern look that will catch your customers attention. As a veteran web designer, I can help you in making your plans for your site a reality. If this is something you''re interested in, I can give you some samples of my work and a free consultation about elements that you can add to your site to make it more effective. My rates are very affordable as well.\r\n\r\nI hope to hear from you soon,\r\nChristina Long'),('contact','106','name','','0','Christina Long'),('contact','106','your_telephone_number','','0','707-049-1986'),('contact','107','email','','0','CHAD.MASON270@gmail.com'),('contact','107','message','','0','Hi There,\r\n\r\nAre you thinking of upgrading your website or adding some new features to it? I am an expert web designer who is looking for new clients to work with. I guarantee my work, and I can tell you that my clients are very happy with the work I do. I can show you some samples if you''d like to see them.\r\n\r\nThe look and feel of a website greatly affect how successful the site is. I can help you make it so that your site can help you make more money. If this is something that you want then please let me know and I will send you some info and setup a time for a call.\r\n\r\nI would love to work with you.\r\n\r\nChad Mason'),('contact','107','name','','0','Chad Mason'),('contact','107','your_telephone_number','','0','(342) 565-7781'),('contact','108','email','','0','edingershock362@gmail.com'),('contact','108','message','','0','I''m reaching out to you because I design great looking websites for small business owners and would love to have the opportunity to show you what I can do.  I specialize in the wordpress website platform, but I''m also very good with many other platforms and shopping carts as well.  I can upgrade your existing website or build you a new one completely that has all of the modern features and functionality.  \r\nHave you been thinking about making some updates to your site?  If so, do you have some free time in the next few days for a quick consultation call? I can give you some ideas, get your feedback and give you a proposal. I''d really like to be of assistance and make the site better.  \r\n\r\nLet me know what you think,\r\n\r\nThanks,\r\nEdward Frez\n\n ');
INSERT INTO `webform_submission_data` VALUES ('contact','108','name','','0','Ed Frez'),('contact','108','your_telephone_number','','0','(702) 758-4988'),('contact','110','email','','0','mandkelsom@yahoo.com'),('contact','110','message','','0','Hi, We''d like to get in touch with the judo club which teaches at the community centre. Do you have a tel. no. or an email address please?\r\nKind regards,\r\nMatt'),('contact','110','name','','0','Matthew Elsom'),('contact','110','your_telephone_number','','0','07775906722'),('contact','111','email','','0','Randy@TalkWithLead.com'),('contact','111','message','','0','Hi,\r\n\r\nMy name is Randy and I was looking at a few different sites online and came across your site buriton.info.  I must say - your website is very impressive.  I found your website on the first page of the Search Engine. \r\n\r\nHave you noticed that 70 percent of visitors who leave your website will never return?  In most cases, this means that 95 percent to 98 percent of your marketing efforts are going to waste, not to mention that you are losing more money in customer acquisition costs than you need to.\r\n \r\nAs a business person, the time and money you put into your marketing efforts is extremely valuable.  So why let it go to waste?  Our users have seen staggering improvements in conversions with insane growths of 150 percent going upwards of 785 percent. Are you ready to unlock the highest conversion revenue from each of your website visitors?  \r\n\r\nTalkWithLead is a widget which captures a website visitor’s Name, Email address and Phone Number and then calls you immediately, so that you can talk to the Lead exactly when they are live on your website — while they''re hot!\r\n  \r\nTry the TalkWithLead Live Demo now to see exactly how it works.  Visit: https://www.talkwithlead.com/Contents/LiveDemo.aspx\r\n\r\nWhen targeting leads, speed is essential - there is a 100x decrease in Leads when a Lead is contacted within 30 minutes vs being contacted within 5 minutes.\r\n\r\nIf you would like to talk to me about this service, please give me a call.  We do offer a 30 days free trial.  \r\n\r\nThanks and Best Regards,\r\nRandy');
INSERT INTO `webform_submission_data` VALUES ('contact','111','name','','0','Randy'),('contact','111','your_telephone_number','','0','416-385-3200'),('contact','112','email','','0','LucasSanderson858@gmail.com'),('contact','112','message','','0','Hi!\r\n\r\nI was browsing the net when I came across your site. I was reviewing it, and you have a site that holds potential. I can help build that bridge to success by applying the SEO techniques to get you there. I am an expert and have years of experience in my profession. There are three important factors that I can give you. The first, you can expect targeted traffic to start flowing continuously in and out of your website. Secondly, the credibility that I will build for your site. This is a good way to have potential leads and more buyers. Thirdly, I can get you at the top of organic search engines including Google, Bing, and Yahoo.\r\n\r\nI offer the most competitive rates that you will find on the market today. Unlike others, you will get real results and watch your website crawl to the top of the rankings. I will love to talk more about this in detail with you if you are interested. If there is another way that I can contact you I will appreciate you sending me a response with your contact info. I am excited and looking forward to working with you on this project. Thank you for taking the time to consider my proposal to you. \r\n\r\nCheers,\r\nLucas Sanderson\n\n '),('contact','112','name','','0','Lucas Sanderson'),('contact','112','your_telephone_number','','0','6465479126'),('contact','116','email','','0','adrianrussell904@gmail.com'),('contact','116','message','','0','Hello,\r\n\r\nI have something to ask you. Would you be interested in upgrading your site or redesigning to a modern one? I specialize in building websites, designs, and marketing. My schedule is starting to open up, and I would love to work on this project with you. After reviewing your site I did notice a few errors that may be blocking visitors accessibility to your site. But I also noticed that it had the potential to dominate rankings in search engines. \r\n\r\nI work by using strategies and techniques that have been proven to gain amazing results. The fees for my services are quite fair and reasonable. I am very dedicated and hard working. Your satisfaction is my main priority and delivering you a successful site that you can use for years. If you are interested or just want to know more, I will appreciate it if you will kindly leave me a better way to get in touch. I am excited to work with you and the success that is waiting in the future.\r\n\r\nThank you for your time.\r\n\r\nAdrian Russell\r\nWeb Developer/Designer\r\n\n\n ');
INSERT INTO `webform_submission_data` VALUES ('contact','116','name','','0','Adrian Russell'),('contact','116','your_telephone_number','','0','2295141482'),('contact','117','email','','0','lissfuneral@southerncoops.co.uk'),('contact','117','message','','0','I believe that Rev Judith Bee Is currently on Holiday until the end of this week but I need to get a message to her as a family have requested her to take a service for the Late Mr Boorer whom Judith went to visit in hospital before his passing. The service is at Portchester Crematorium on Tuesday 17th July which I also know this is normally her day off. So I was wondering if I could have her contact details so I can contact her Monday( I did have them but can not locate them at the moment) or If someone could contact me to discuss this or is there someone else I could provisionally book if she can not do it. Hope you can help look forward to hearing from you Kind Regards Tracy Newman '),('contact','117','name','','0','Tracy Newman  Liss funeral co-coordinator'),('contact','117','your_telephone_number','','0','01730895593'),('contact','118','email','','0','lissfuneral@southerncoops.co.uk'),('contact','118','message','','0','I believe that Rev Judith Bee Is currently on Holiday until the end of this week but I need to get a message to her as a family have requested her to take a service for the Late Mr Boorer whom Judith went to visit in hospital before his passing. The service is at Portchester Crematorium on Tuesday 17th July which I also know this is normally her day off. So I was wondering if I could have her contact details so I can contact her Monday( I did have them but can not locate them at the moment) or If someone could contact me to discuss this or is there someone else I could provisionally book if she can not do it. Hope you can help look forward to hearing from you Kind Regards Tracy Newman '),('contact','118','name','','0','Tracy Newman  Liss funeral co-coordinator'),('contact','118','your_telephone_number','','0','01730895593'),('contact','119','email','','0','lissfuneral@southerncoops.co.uk');
INSERT INTO `webform_submission_data` VALUES ('contact','119','message','','0','I believe that Rev Judith Bee Is currently on Holiday until the end of this week but I need to get a message to her as a family have requested her to take a service for the Late Mr Boorer whom Judith went to visit in hospital before his passing. The service is at Portchester Crematorium on Tuesday 17th July which I also know this is normally her day off. So I was wondering if I could have her contact details so I can contact her Monday( I did have them but can not locate them at the moment) or If someone could contact me to discuss this or is there someone else I could provisionally book if she can not do it. Hope you can help look forward to hearing from you Kind Regards Tracy Newman '),('contact','119','name','','0','Tracy Newman  Liss funeral co-coordinator'),('contact','119','your_telephone_number','','0','01730895593'),('contact','122','email','','0','virginiarees64@gmail.com'),('contact','122','message','','0','Can you do me a favor and point me in the right direction for who to speak with about your website?\r\n\r\nI design websites professionally and I am currently looking for new clients to work with. I looked through your site and it looks like there are some design issues that I can help you out with and features that I can add.\r\n\r\nIf you are interested in a free consultation, then please let me know who to reach out to. I would really appreciate it.\r\n\r\nSincerely,\r\nVirginia Rees\r\nRees Web Development\n\n '),('contact','122','name','','0','Virginia Rees'),('contact','122','your_telephone_number','','0','(920) 249-5363'),('contact','126','email','','0','hannah@hannahshucksmith.com'),('contact','126','message','','0','To whom it may concern, I am interested in participating in the Christmas market - I am a jewellery designer and have recently moved from London to Haslemere. Please could you let me know who to apply to and send my information to?\r\n\r\nMany thanks,\r\n\r\nHannah'),('contact','126','name','','0','Hannah Shucksmith'),('contact','126','your_telephone_number','','0','7974795671');
INSERT INTO `webform_submission_data` VALUES ('contact','129','email','','0','t.daughtrey@tiscali.co.uk'),('contact','129','message','','0','Hi, can you please advise if there are any car boot sales in Buriton recreation ground this year, if so on which day is it being held.\r\nMany thanks.'),('contact','129','name','','0','Trevor Daughtrey'),('contact','129','your_telephone_number','','0','01243000000'),('contact','130','email','','0','JULIENCOUSINS@HOTMAIL.COM'),('contact','130','message','','0','Would it be possible to post this at short notice?\r\nCOT APPEAL - does anyone have a travel cot I could borrow or buy immediately? Surprise visit by 6-month-old grandson tomorrow night - eek!'),('contact','130','name','','0','Buzz Cousins'),('contact','130','your_telephone_number','','0','07526757639'),('contact','135','email','','0','liampaterson600@gmail.com'),('contact','135','message','','0','Hi There, \r\nI wanted to reach out with you to see if you want an app built for your site or business? Do you have a great app idea?  I LOVE great ideas, and I love turning them into apps.  \r\nI''m a programmer/developer that can design and program any type of app that you can think of on any platform (Android, iOs, etc?).  \r\nIf you''re interested in my services or you would like to learn more, then I''d love to talk with you about it.  Please let me know if you''re interested and I can send you a portfolio of other apps I''ve built and schedule a time to chat.  Looking forward to speaking with you.  \r\nMany thanks,\r\nLiam Paterson - App Development Services	\n\n '),('contact','135','name','','0','Liam Paterson'),('contact','135','your_telephone_number','','0','8474387119'),('contact','137','email','','0','xglbob@aol.com'),('contact','137','message','','0','Good Morning,\r\nMy name is Bob Sawyer and I have been asked to judge your flower show on the 11th August. Is it possible for some one to contact me with more details and possible send me a shedule.\r\nMy address is 8Tucks Close Bransgore BH23 8ND other details as above.\r\nI look forward to meeting you on the 11th     Regards  Bob');
INSERT INTO `webform_submission_data` VALUES ('contact','137','name','','0','Robert Sawyer'),('contact','137','your_telephone_number','','0','01425673605'),('contact','139','email','','0','evnf@hotmail.co.uk'),('contact','139','message','','0','Hello, I''m interested in booking the hall next August 2019 for a Saturday. \r\nCould you please tell me your prices for a 24 hour hire, and how much time is per hour to set up the day before and tidy up the next day.\r\nAlso what time is music allowed to?\r\n\r\nMany thanks \r\n\r\nEllie\r\n'),('contact','139','name','','0','Ellie '),('contact','139','your_telephone_number','','0','07931559630'),('contact','140','email','','0','kyliedickens632@gmail.com'),('contact','140','message','','0','Hello.  I was hoping you could do me a favor and reply back and let me know if you''re interested in improving your rankings in the search engines.  Are you looking for more traffic and sales, or pretty happy with where you''re at?  I have been a search engine specialist for quite a long time now and can get your site up where you want it to be.  Just let me know if you''re interested and I can provide you with a consultation and pricing on my services. \r\n\n\nThank you\r\nKylie Dickens'),('contact','140','name','','0','Kylie Dickens'),('contact','140','your_telephone_number','','0','(954) 507-7597'),('contact','144','email','','0','improveurwebdesign4u@gmail.com'),('contact','144','message','','0','Hello There, \r\n\r\nI''m reaching out to see if you need help with your website.  Are there changes that you would like to make to the site?  If so, I''d love to speak with you.  \r\n\r\nJust a little bit about me, I''ve been developing sites for over a decade now and I''m excellent at what I do.  I am able to do both programming and design work.  I use many different programming languages, website platforms, and shopping carts, and have a particular specialty in the "Wordpress" website platform (I would love to tell you more about it if you''re not familiar).  \r\n\r\nIf you''re interested in updating the site, please just reply and let me know and I will send you more info and try to set up a time to talk.  \r\n\r\nI look forward to hearing from you.  \r\n\r\nBest Regards,\r\nEdward Frez | Web Developer \n\n ');
INSERT INTO `webform_submission_data` VALUES ('contact','144','name','','0','Ed Frez'),('contact','144','your_telephone_number','','0','(708) 955-4965	'),('contact','146','email','','0','impressivedesignz4u@gmail.com'),('contact','146','message','','0','Have you thought about how to enhance the design/layout of your website and give it a more cutting edge look? How about adding new features that will help you improve your bottom line? If so, I would love to speak with you!\r\n\r\nI am proficient and experienced in web designing/developing and I can create amazing websites that would be perfect for your company and the type of business you run. I can upgrade your current website or build you a new one with all the modern features that your business will need all for a very reasonable price. If you are interested, send me a reply so I can give you a call at a time when you are available. Please let me know what you think.\r\n\r\nSincerely,\r\nKurt Caldwell\n\n '),('contact','146','name','','0','Kurt Caldwell'),('contact','146','your_telephone_number','','0','(709) 868-8790'),('contact','147','email','','0','j.bryant195@btinternet.com'),('contact','147','message','','0','Hi Good Morning,\r\nI was up the Recreation Ground yesterday and the week before,I would just like to bring to your attention the waste bins are completely full and the liner has been taken out and filled completely too,its such a lovely play area for the\r\nchildren but this could become a problem,it would be a shame after all the good work put in by people that the area could become a litter haven.\r\n\r\nThank you hopefully something can be done.\r\n\r\nRegards John.'),('contact','147','name','','0','John Bryant'),('contact','147','your_telephone_number','','0','07427188176'),('contact','148','email','','0','webdesigngurus21@gmail.com'),('contact','148','message','','0','Hello to you,\r\nNeed something changed, repaired, or planning to redesign your website? I''m a web designer with the skills to do just about anything that you can imagine and I''m here to help.\r\n\r\nI can even assist if you''re planning on building a brand new website complete with all the features that you''ll need to make your website a better reflection of the quality of your company.\r\n\r\nIf this particular boost is something that you''re interested in, it would be great if I could speak with you so I can tell you about some ideas I have of what I can do to make your site great. I''ll let you know what the cost would be by then as well. Please let me know the best number to reach you on and I''ll give you a call right away.\r\n\r\nThank you!\r\nTyler Forrest - Web Developer\r\n\r\n\r\n\r\n\r\n\r\nIf you would like to be removed from any of these emails, kindly send me an email to inform me and you won''t hear from me again.\n\n ');
INSERT INTO `webform_submission_data` VALUES ('contact','148','name','','0','Tyler Forrest'),('contact','148','your_telephone_number','','0','(520) 485-9738'),('contact','154','email','','0','paitg@me.com'),('contact','154','message','','0','Hello, I am working with Rake Parish Council and the village hall to install a playground in the grounds of the village hall. I visited the new playground at Buriton the other day and was so impressed with it! I was wondering if i could speak to the relevant person who was involved with it?\r\nThanks\r\nPai'),('contact','154','name','','0','Pai Tang-George'),('contact','154','your_telephone_number','','0','07788721811'),('contact','155','email','','0','ross.langley@yahoo.co.uk'),('contact','155','message','','0','I attended your fantastic art trail recently and had a wonderful time. I found an artist that was showing his digital prints in the Village hall. I can''t seems to find his name or any contact details at all. Is there any chance you know him and could pass on his details to me? I am desperate to purchase some of his work. \r\nKind regards\r\nRoss'),('contact','155','name','','0','Ross Langley'),('contact','155','your_telephone_number','','0','07799830927'),('contact','157','email','','0','s.m.manktelow@gmail.com'),('contact','157','message','','0','Hi I am president of Petersfield Lions Club and wondered if you would be able to put some blurb about our club in your newsletter. We are trying to attract new members but also put it out into the community about what we do.  Looking forward to hearing from you soon and if you are in agreement I will email you the information.  Kind regards Sandra Manktelow'),('contact','157','name','','0','Sandra Manktelow'),('contact','157','your_telephone_number','','0','07871451131'),('contact','159','email','','0','celiatownsend811@gmail.com'),('contact','159','message','','0','Hi, I am looking for new clients and I would like to check with you to see if you need any change or redesigning on your website. I am a skilled web designer that can produce quality work at a price that is affordable even for small businesses. I can do anything that you can come up with whether its adding features to your site or a complete make-over, I can do it. I can tell you that having a great looking website will increase your profits. So if you''re interested, let''s talk. Let me know who I can speak with and the best time I can reach out. I look forward to speaking with you.\r\n\n\n- Celia Townsend');
INSERT INTO `webform_submission_data` VALUES ('contact','159','name','','0','Celia Townsend'),('contact','159','your_telephone_number','','0','(709) 707-2898'),('contact','163','email','','0','SebastianWalkernf@gmail.com'),('contact','163','message','','0','I''m a freelance web designer looking for new clients and I wanted to check with you and see if there''s anything you''d like to change or update on your site.  I can make site repairs and updates or can also help you out if you''d like to build a completely brand new website.\r\n\r\nI have a lot of experience with designing websites and I''m sure I will be a valuable asset to you. I can do just about anything you can come up with and my rates are affordable for nearly everyone.  \r\n\r\nIf you''re interested in getting this consultation and proposal (it won''t cost you), I''ll be happy to give you a call.  I look forward to speaking with you.   \r\n\r\n\n\nThanks!\r\nSebastian Walker'),('contact','163','name','','0','Sebastian Walker'),('contact','163','your_telephone_number','','0','(868) 852-9437'),('contact','168','email','','0','tc23775@gmail.com'),('contact','168','message','','0','Hello,\r\n\r\nAre you interested in getting more info about how to improve your site and traffic from sites like Google and the other search engines?  I can give you all of the the information, time frames, and prices that will surely yield to results that you''ll be happy with.  \r\n\r\nThe site traffic and sales available from the companies in the top spots are massive compared to those below it.  So I just wanted to find out if that was something you wanted a consultation on.  I have some really interesting information to share with you, so let me know if this is something you would be interested in and we can set up a time to chat.  \r\n\n\nThank You,\r\n\r\nMax Lowe - Search Engine Marketing Expert\r\n\r\nP.S. If you''re not interested for any reason, just reply back with the word "remove" in the subject line and I won''t reach out to you again. Thanks.'),('contact','168','name','','0','Max Lowe');
INSERT INTO `webform_submission_data` VALUES ('contact','168','your_telephone_number','','0','(809) 935-8912	'),('contact','169','email','','0','gillian.herring2@hants.gov.uk'),('contact','169','message','','0','Can you help. I work as the Hampshire County Council Childcare Development Business Officer covering East Hampshire and would welcome the opportunity to speak to someone about early years groups in Buriton.\r\n\r\nThe closure of Buriton Nursery has left us with a gap in the early years childcare market in Buriton and I am hoping to make key contacts in the area to build early years provision.\r\n\r\nI look forward to hearing from you.'),('contact','169','name','','0','Gillian Herring'),('contact','169','your_telephone_number','','0','077532 79769'),('contact','172','email','','0','DylanBailey478@gmail.com'),('contact','172','message','','0','I saw your site and I was wondering if you might need some help with improving the web architecture and feel of your site.\r\n\r\nMy name is Dylan, a veteran web developer/designer. I''m ready to show you some of my previous works so you can see why my clients are so happy with the work I do. My main goal in reaching out is because there is great potential in making your website great. The primary elements necessary to make it awesome are there but I want to share with you some ideas I have to make it even better. You don''t have to worry about my rates because they are very affordable.\r\n\r\nWe can talk about it through the phone so I can tell you what I think can be made better and you can tell me if you want these changes on your site. \r\nI would very much appreciate it if you reply.\r\n\r\nWarmest regards,\r\n\n\nDylan Bailey'),('contact','172','name','','0','Dylan Bailey'),('contact','172','your_telephone_number','','0','9014731955'),('contact','178','email','','0','kate.jones@fitzroy.org'),('contact','178','message','','0','Hi there,\r\n\r\nPlease could you include the following event in your online What''s On Guide? \r\nThe details are as follows;\r\n\r\n\r\nFITZROY''S CASINO ROYALE FUNDRAISER\r\n\r\nWhen: Friday 28th September 2018, 7.30pm\r\nWhere: Churcher''s College, Ramshill, Petersfield, GU31 4AS\r\n\r\nJoin local charity FitzRoy for an exciting Bond-inspired evening of casino games, cocktails, music and dancing. The event will be held at Churcher''s College in Petersfield on Friday 28th September from 7.30pm.\r\nTickets are just £25 and include a glass of prosecco on arrival & hors d’oeuvres. All money raised will go towards transforming the lives of people with learning disabilities & autism.\r\nTo find out more details visit: www.fitzroy.org/casino-royale or call 01730 711104.');
INSERT INTO `webform_submission_data` VALUES ('contact','178','name','','0','Kate Jones'),('contact','178','your_telephone_number','','0','01730 711104'),('contact','181','email','','0','fhenderson459@gmail.com'),('contact','181','message','','0','Hi, it looks like your site could use some help with its rankings in the web searches. Have you ever had any optimization work done to it?\r\n\r\nIt looks like your site wasn''t set up properly with the right keywords to make it easy for Google or Bing to know what you should rank for.  The site also has some issues that prevent the search providers from trusting it as much as they should.  \r\n\r\nI work as a freelance optimizer and I can do everything that needs to be done to help you rank higher in the Google searches.  Please tell me if you''re interested in getting a proposal and quote.  \r\n\n\n \r\nSincerely,\r\nFrank Henderson'),('contact','181','name','','0','Frank Henderson'),('contact','181','your_telephone_number','','0','(307) 228-0751'),('contact','184','email','','0','fundraising@fitzroy.org'),('contact','184','message','','0','Please could you add our charity event to your What''s On guide? \r\nThe details are as follows:\r\n\r\nFIREWALK FESTIVAL\r\nFriday 23rd November 2018, 6pm until late\r\nThe Queens Head pub, Sheet, Hampshire GU32 2AN\r\n\r\nTake part in FitzRoy''s Firewalk Challenge, or just come and join in the Firewalk Festival fun. The firewalk is open to anyone over 16 years old and no experience is needed. Firewalking experts Blaze will give participants full training and preparation.\r\nEnter into the Firewalk Festival spirit and enjoy live music, hearty homemade food, games and prizes. If you’re not sure if you want to take on the challenge just come to cheer on the brave ‘soles’.\r\nAll funds raised by this event will support the local charity to continue transforming the lives of people with learning disabilities and autism.\r\n• Firewalk registration fee: £25 includes food and a flaming sambuca (after the walk!)\r\n• Fundraising target: £125\r\n• Adult supporter ticket: £6 includes food\r\n• Child supporter (under 14): £3 includes food & glow stick\r\nTo find out more visit: www.fitzroy.org/firewalk');
INSERT INTO `webform_submission_data` VALUES ('contact','184','name','','0','Kate Jones'),('contact','184','your_telephone_number','','0','01730 711104'),('contact','185','email','','0','fundraising@fitzroy.org'),('contact','185','message','','0','Please could you include the following details in your November What''s On Guide?\r\n\r\nFitzRoy''s Pop Up Shop\r\n11 Lavant Street, Petersfield, GU32 3EW\r\nTuesday 13th - Saturday 17th November, 9.30am - 5.30pm\r\n\r\nFitzRoy will be running its very first Pop Up Shop this November. All funds raised will help the local charity to continue supporting adults with learning disabilities and autism to live the life they choose.\r\nRun by volunteers, the Pop Up Shop will be selling gifts that have been kindly donated by the local community, as well as Christmas crafts made by the people FitzRoy support. Why not ‘pop in’ and pick up some Christmas bargains?'),('contact','185','name','','0','Kate Jones'),('contact','185','your_telephone_number','','0','01730 711104'),('contact','186','email','','0','mosesjohnson317@gmail.com'),('contact','186','message','','0','Good day! \r\n\r\nI thought I''d write you an email to see if you''re interested in making your website run the business for you by adding some modern features that will be helpful for you and your clients. I can share with you some case studies I made from my previous projects as examples of how I can make you attract more clients with the power or a modern and beautiful website that has all the functionality to help your business grow. \r\n\r\nGuaranteed, it''ll make a difference on your business as soon as people start noticing your online content. I see potential in your site and with a little help from me, we can make it look amazing to attract the consumers. \r\n\r\nWhen would you like to get started with the make-over?\r\n\n\n \r\nBest Regards,\r\nMoses Johnson'),('contact','186','name','','0','Moses Johnson'),('contact','186','your_telephone_number','','0','(702) 758-4988'),('contact','188','email','','0','geraldpilkingtonfirstaid@outlook.com');
INSERT INTO `webform_submission_data` VALUES ('contact','188','message','','0','FIRST AID for COMMUNITY GROUPS\r\n\r\n\r\n\r\n•	FREE British Heart Foundation Heartstart programme sessions.\r\n\r\nI am a volunteer instructor with Meon Valley Heartstart which offers free sessions in emergency first aid. These can be tailored for different age groups but the full programme which is suitable for those aged over 12 years includes action at an emergency, CPR, the recovery position, recognising the signs of a heart attack, treatment for severe bleeding, choking and use of a defibrillator.\r\n\r\nMV Heartstart have run these for many years in a number of schools and colleges, and community groups across Hampshire: we have trained over 3,500 people already this year. The sessions are provided through MV Heartstart and are free although they do ask for a donation to cover costs. \r\n\r\nIf these sessions are of interest to your local community groups I would be happy to discuss them further or you can look at the website at https://www.heartstartmeonvalley.co.uk/\r\n\r\n\r\n\r\nThrough my own first aid training business (separate from MV Heartstart) I can also provide certificated and non-certificated courses in a range of first aid topics and at different levels to meet the needs of specific groups. \r\n\r\nFor more information about any of these courses or any other first aid training needs please contact me.\r\n'),('contact','188','name','','0','Gerald Pilkington'),('contact','188','your_telephone_number','','0','7713511585'),('contact','190','email','','0','edmundse816@gmail.com'),('contact','190','message','','0','Hello!\r\n\r\nI saw that your website already has good content but based on my observations, I think that your clients would really be more engaged if you give it a more cutting edge look or add a few user-friendly elements to it (or even a few new functionalities). Is this something that you are interested in? \r\n\r\nI sent this email to know if you''re interested in any upgrades or changes on your website that can help your business. I''m Ed Frez, an expert in WordPress and various other website platforms / shopping carts (I''d love to tell you more about these platforms if you''re not familiar with them) and we can help you in setting those up for your website. I can give you plenty of information and a portfolio of what we''ve done for other clients and other sites, and also what the results have been. \r\n\r\nIf you like, we can talk more about it in the next couple of days if that would work for you. Let me know if you''re interested and hopefully we''ll be able to talk about our ideas soon.\n\n Thanks, \r\nEd Frez - Web Designer / Programmer');
INSERT INTO `webform_submission_data` VALUES ('contact','190','name','','0','Ed Frez'),('contact','190','your_telephone_number','','0','(302) 316-5112'),('contact','191','email','','0','Waterman47@btinternet.com'),('contact','191','message','','0','Hi there.\r\nI wonder if you have any information on water loss in Buriton during the latter part of July\r\nI have been in touch with South East Water to make a claim on my account because of at least\r\nthree  occasions when the supply was interupted and the last occasion the water was off for twelve \r\nhours plus and there was very little information available for residents  in Glebe and Summner roads\r\nand it was the hottest part of the season which meant having to drive into petersfield for bottled\r\nwater,although later finding out from a nieghbour that bottled water was available at the Church\r\ncar park!\r\nFurther more I believe that the whole of the village should be entitled to compensation on their water bills as a consequence of South East Waters actions if this were the case.\r\nI made it very clear to their customer services that I and my neighbours were not impressed with the way we were treated seeing that we live right on the extreme of their supply area. and I have copies of tweets for the 31st of July\r\nwhere customers in the Causeway were suffering the same problem.\r\nI also found it amusing when South East even asked had I specific dates to verify the losses of water and times?\r\nApparently there appears to have been a large water main burst in petersfield which caused the problem thus giving rise to Buriton having to suffer the consequences of no water.\r\nIhave also asked for them to look in to whether there was any connection to the new main being laid in Stroud to \r\nWeston and was the old main damaged by the contractors and this was the cause of the loss.\r\nthanking you.\r\nAnd I look forward to your comments into this matter\r\n\r\nKeith Cummins\r\n65. Glebe Road\r\nBuriton\r\nGU31 5SD\r\n\r\n  \r\n\r\n\r\n'),('contact','191','name','','0','Keith Cummins');
INSERT INTO `webform_submission_data` VALUES ('contact','191','your_telephone_number','','0','01730 263285'),('contact','192','email','','0','Waterman47@btinternet.com'),('contact','192','message','','0','Hi there.\r\nI wonder if you have any information on water loss in Buriton during the latter part of July\r\nI have been in touch with South East Water to make a claim on my account because of at least\r\nthree  occasions when the supply was interupted and the last occasion the water was off for twelve \r\nhours plus and there was very little information available for residents  in Glebe and Summner roads\r\nand it was the hottest part of the season which meant having to drive into petersfield for bottled\r\nwater,although later finding out from a nieghbour that bottled water was available at the Church\r\ncar park!\r\nFurther more I believe that the whole of the village should be entitled to compensation on their water bills as a consequence of South East Waters actions if this were the case.\r\nI made it very clear to their customer services that I and my neighbours were not impressed with the way we were treated seeing that we live right on the extreme of their supply area. and I have copies of tweets for the 31st of July\r\nwhere customers in the Causeway were suffering the same problem.\r\nI also found it amusing when South East even asked had I specific dates to verify the losses of water and times?\r\nApparently there appears to have been a large water main burst in petersfield which caused the problem thus giving rise to Buriton having to suffer the consequences of no water.\r\nIhave also asked for them to look in to whether there was any connection to the new main being laid in Stroud to \r\nWeston and was the old main damaged by the contractors and this was the cause of the loss.\r\nthanking you.\r\nAnd I look forward to your comments into this matter\r\n\r\nKeith Cummins\r\n65. Glebe Road\r\nBuriton\r\nGU31 5SD\r\n\r\n  \r\n\r\n\r\n'),('contact','192','name','','0','Keith Cummins'),('contact','192','your_telephone_number','','0','01730 263285');
INSERT INTO `webform_submission_data` VALUES ('contact','193','email','','0','audreytaylor239@gmail.com'),('contact','193','message','','0','Hello, \r\n\r\nKeeping up with modern trends on web design is essential to keep up with your competitors. Are you happy with your website right now? Most modern websites can do just about anything for their clients. It gives them a good-user experience, making them trust your company more. Is there anything on the site that you would like to have changed, added, or fixed, or are you planning to completely redesign your website soon?\r\n\r\nI''m a web designer with the skills to do just about anything that you can imagine. If this is something that you''re interested in, then it would be great if I could speak with you so I can tell you about some ideas I have of what I can do to make your website better in terms of aesthetics and functionality. I''ll let you know what the cost would be by then as well. \r\n\r\nPlease let me know the best number to reach you on and I''ll give you a call right away.\n\nAudrey Taylor - Web Designer / Programmer'),('contact','193','name','','0','Audrey Taylor'),('contact','193','your_telephone_number','','0','5828542510'),('contact','198','email','','0','abimckern@gmail.com'),('contact','198','message','','0','Good afternoon!\r\nJust to let you know I have emailed Councillor Robert Mocatta about the burnt out van in Greenway Lane. I tried ringing the Police (waited for SO long) but then Ted Underwood told me the Police already know about it. He has a friend who is willing to dispose of it if the Council are too busy - after all there is a car junk yard a couple of hundred meters away! Do you know anyone else I can contact? I am worried that if we don''t make a fuss it will stay there for MONTHS! Cheers!'),('contact','198','name','','0','Abigail MCKERN'),('contact','198','your_telephone_number','','0','231359'),('contact','200','email','','0','almera.toogood@hampshire.pnn.police.uk'),('contact','200','message','','0','Hi\r\nThere  has been several burglaries in the village of Buriton last night. I was hoping to have a beat surgery this Friday between 12.00- 13.00hrs so that if the residents want to come down and talk to me they can.I hope this is okay and if it is could you advertise it on your website\r\nKind regards\r\nPCSO Almy Toogood 13326\r\nBuster Neighbourhood Policing Team');
INSERT INTO `webform_submission_data` VALUES ('contact','200','name','','0','PCSO Almy Toogood'),('contact','200','your_telephone_number','','0','101'),('contact','201','email','','0','langdonkaren6@gmail.com'),('contact','201','message','','0','I ran a report on your site, and the results showed that there is a massive amount of additional web traffic we can get you by getting your website into higher positions in Google search results. How many of your clients told you that they found out about your business online? Are you interested in getting additional traffic/sales? I can get you there.\r\n\r\nIf you''re interested in learning more about what I do and how I can help you, then I''d be happy to give you a free consultation. All of the information that about your website and how it could perform better will be useful whether or not you take advantage of my services. I would love to speak with you and share some insights. Hopefully, we can work together.\r\n\r\n\n\nSincerely,\r\nKaren Langdon'),('contact','201','name','','0','Karen Langdon'),('contact','201','your_telephone_number','','0','(386) 361-3287'),('contact','202','email','','0','Randy@TalkWithLead.com'),('contact','202','message','','0','Hi,\r\n\r\nMy name is Randy and I was looking at a few different sites online and came across your site buriton.info.  I must say - your website is very impressive.  I found your website on the first page of the Search Engine. \r\n\r\nHave you noticed that 70 percent of visitors who leave your website will never return?  In most cases, this means that 95 percent to 98 percent of your marketing efforts are going to waste, not to mention that you are losing more money in customer acquisition costs than you need to.\r\n \r\nAs a business person, the time and money you put into your marketing efforts is extremely valuable.  So why let it go to waste?  Our users have seen staggering improvements in conversions with insane growths of 150 percent going upwards of 785 percent. Are you ready to unlock the highest conversion revenue from each of your website visitors?  \r\n\r\nTalkWithLead is a widget which captures a website visitor’s Name, Email address and Phone Number and then calls you immediately, so that you can talk to the Lead exactly when they are live on your website — while they''re hot! Best feature of all, we offer FREE International Long Distance Calling!\r\n  \r\nTry the TalkWithLead Live Demo now to see exactly how it works.  Visit: https://www.talkwithlead.com/Contents/LiveDemo.aspx\r\n\r\nWhen targeting leads, speed is essential - there is a 100x decrease in Leads when a Lead is contacted within 30 minutes vs being contacted within 5 minutes.\r\n\r\nIf you would like to talk to me about this service, please give me a call.  We do offer a 14 days free trial.  \r\n\r\nThanks and Best Regards,\r\nRandy');
INSERT INTO `webform_submission_data` VALUES ('contact','202','name','','0','Randy'),('contact','202','your_telephone_number','','0','416-385-3200'),('contact','204','email','','0','josef.self@gmail.com'),('contact','204','message','','0','Hello!\r\n\r\nLove the pets content on your site! You know, businesses get traffic from their blog, and we feel that you could use a little help, since you are not blogging weekly yet.\r\n\r\nWriting takes a lot of time and effort, and we have just the team  to come up with great content you need.\r\n\r\nYou can have a brand new article to post on buriton.info starting at $10 in as little as 5  days!\r\n\r\nCheck out our work and reviews from satisfied clients here: http://bit.ly/seowriters\r\n\r\nThanks for your time,\r\n\r\nEnjoy the rest of your day.\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nYou are receiving this email because the contact form at buriton.info is open to the public. \r\nIf you like to opt-out of future communications from us, please submit your request here:\r\n\r\nhttp://bit.ly/submitawebsite Unsubscribe to stop getting our emails.'),('contact','204','name','','0','Josef Self'),('contact','204','your_telephone_number','','0','412-235-7801'),('contact','207','email','','0','heathere011@gmail.com'),('contact','207','message','','0','Hello there!\r\n\r\nI see an opportunity for your business to get more sales if your website would get optimized. Search engines have a way of crawling on websites and look for certain keywords and elements that will highlight what your site is all about and often, these keywords are tied with your products and services that your potential clients are searching online on Google or the other major search engines. There may be some issues with your website that needs to be fixed so that your company can easily be found online. Have you ever had it optimized before?\r\n\r\nI am an online marketing analyst who specializes in making sure that search engine algorithms find what my clients have on their website so they can be on top of the search results (where the money is). My services make it easy for people to find your products and services online, thus making your business website more profitable.\r\n\r\nIf you''re interested in my services, then I''d be happy to give you more detailed helpful information. Please let me know when''s the best time to contact you.\n\nThank you,\r\nHeather Ellison');
INSERT INTO `webform_submission_data` VALUES ('contact','207','name','','0','Heather Ellison'),('contact','207','your_telephone_number','','0','(352) 405-5498'),('contact','208','email','','0','aliceash151@btinternet.com'),('contact','208','message','','0','Could you help to publicise a missing Spaniel in Buriton by printing and displaying a DogLost poster to help to locate Bibi. Her family are very upset.\r\nhttp://www.doglost.co.uk/poster.php?dogId=135281#.W7uX7Myovwo\r\nThe telephone number for any sightings is 07919050615 or mine, I am a Local DogLost volunteer trying to assist the family.\r\n'),('contact','208','name','','0','Alice Ash'),('contact','208','your_telephone_number','','0','07796543571'),('contact','209','email','','0','haddock.linda@gmail.com'),('contact','209','message','','0','Hi!\r\n\r\nLove the testing content on your site! You know, websites get traffic from their blog, and we feel that you could use a little help, since you are not blogging weekly yet.\r\n\r\nBlogging takes a lot of time and effort, and we have just the team from United States/Canada to come up with great content you need.\r\n\r\nYou can have a brand new article to post on buriton.info starting at $10 in as little as 5 business days!\r\n\r\nCheck out our work and reviews from happy clients here: https://goo.gl/KGRAi4\r\n\r\nThanks for your time,\r\n\r\nRegards.\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nYou are receiving this email because the contact form at buriton.info is open to the public. \r\nIf you like to opt-out of future communications from us, please submit your request here:\r\n\r\nhttps://goo.gl/u4rPbG Unsubscribe to stop getting our emails.'),('contact','209','name','','0','Linda Haddock'),('contact','209','your_telephone_number','','0','717-926-9347'),('contact','211','email','','0','webexpertsdesignz4u@gmail.com'),('contact','211','message','','0','Hi!\r\n\r\nI''m a freelance creative web developer, and I saw a potential for your site to become better in terms of aesthetics and business reliability. I''m reaching out to your company to help you redesign your website or fix any issues that you have with it if there''s any (all at a cheap cost). I''ve compiled some of my previous work in a portfolio ready to be viewed if you are interested. Please let me know if you''d like to see them and know more about how we can renovate your website to make it appeal to more clients.\r\n\r\nI''m offering you a complimentary consultation so I can share with you some expert advice and design ideas that might just be fit for the business that you do. Just write back to me when''s the best time to contact you. Talk to you soon!\n\nMarty Brock');
INSERT INTO `webform_submission_data` VALUES ('contact','211','name','','0','Marty Brock'),('contact','211','your_telephone_number','','0','(709) 909-1574'),('contact','214','email','','0','kimberliee_meadee@hotmail.co.uk'),('contact','214','message','','0','Hello, I was just wondering if you had a fair on around July/August. My partner bought me a bottle of gin from a fair that he was also working at doing a bee keeping demonstration. I’d love to find the company that makes the gin as it was a small family business and it was fantastic gin, but I no longer have the bottle. \r\nThank you. \r\nKimberly Meade.'),('contact','214','name','','0','Kimberly Meade '),('contact','214','your_telephone_number','','0','07864310773'),('contact','215','email','','0','webdesignz2impress@gmail.com'),('contact','215','message','','0','Hello,\r\n\r\nI was just checking your website and if you''re in need for some web design advice or assistance, then I am just the right person who knows how make your site look stunning and be more profitable. I am a creative web developer with 10 years of experience in both creating brand-new websites and in updating existing sites to accommodate the modern needs of a company. I able to deliver excellent results at relatively cheap prices. \r\n\r\nLet me know if you''re interested in my services and I will contact you at a time that''s best for you. I hope we can work together on this soon.\n\nBradley Hunt'),('contact','215','name','','0','Bradley Hunt'),('contact','215','your_telephone_number','','0','(707) 144-7819'),('contact','220','email','','0','tina.wallace854@gmail.com'),('contact','220','message','','0','Good day!\r\n\r\n\r\nThere are various types of apps that can help your business, whether in terms of marketing, business efficiency, or even both. Would you be interested in building an app for your business? I''m an app developer that can design and program on any platform (Android, iOs, etc).\r\n\r\nIf you already have an idea, I would like to hear about it to help you more on how we can make it happen. I have many ideas of my own that I''d really like to share with you. Most clients nowadays are more comfortable doing business with companies whose mobile app does not only have an amazing look and feel, but also has some features that make doing most business processes easier.\r\n\r\nIf you''re interested about my services, I''ll send you a portfolio containing the apps that I''ve made for my other clients. I can also show you data about how the app helps their business. Please let me know what you think, then I''ll call you at a time you''d suggest.\n\nMuch appreciated,\r\nTina Wallace');
INSERT INTO `webform_submission_data` VALUES ('contact','220','name','','0','Tina Wallace'),('contact','220','your_telephone_number','','0','9662161531'),('contact','225','email','','0','design4sitelite@gmail.com'),('contact','225','message','','0','Are you getting the most out of your site? Is your site generating enough traffic? Are you satisfied with the amount of business that your website is making?\r\n\r\nI am reaching out to you because I am a skilled site optimizer and I can help you with boosting the amount of traffic generated by your site. I can provide you with examples of my previous work so you have a general idea of what it''s like before and after a website has been optimized for web searches. My services are very affordable so you don''t have to worry at all.\r\n\r\nKindly, inform me about whom I should contact and when to reach them best if you''re interested. I will then get in touch with them immediately.\r\n\n\nRonald Mink'),('contact','225','name','','0','Ronald Mink'),('contact','225','your_telephone_number','','0','(954) 351-8026'),('contact','227','email','','0','wilmer.pratt@outlook.com'),('contact','227','message','','0','Hello!\r\n\r\nNice pets content you have on your site. You know, MOST customers look at your review pages before visiting and ordering at your business. \r\nOver 60% of them check Google first!  We feel that your site could use a little boost at Google and TripAdvisor.\r\n\r\nMost clients avoid leaving a review unless they have a BAD experience to vent! \r\nWe have just the team  to come up with great reviews you need. \r\nOur services help keep at least a 4.0 star rating in order to avoid losing business to competitors! \r\n\r\nWe provide reliable Google, SiteJabber, TrustPilot, TripAdvisor, Facebook, Zomato, YellowPages reviews in bulk, starting at $20 in as little as 5 business days!\r\n\r\nCheck out our work and happy clients here: \r\nhttp://bit.ly/ormworks\r\n\r\nThank you for your time,\r\n\r\nEnjoy the rest of your day.\r\nWilmer'),('contact','227','name','','0','Wilmer Pratt'),('contact','227','your_telephone_number','','0','(08) 8381 2877');
INSERT INTO `webform_submission_data` VALUES ('contact','232','email','','0','CHAD.MASON270@gmail.com'),('contact','232','message','','0','Greetings!\r\n\r\nAre you presently satisfied with how your website looks? I''m a freelance creative web developer and I''m reaching out to you to show you how much potential your website holds. I can help you upgrade your current website or redesign your website from scratch, all for an affordable cost that even small businesses consider cheap. If you have some free time, I can call you and give you a free consultation. \r\n\r\nIf you''re interested, I can give you some ideas, get your feedback and give you a proposal, so please let me know if I can provide you with any of my services. I''m hoping to speak with you soon!\n\nChad Mason'),('contact','232','name','','0','Chad Mason'),('contact','232','your_telephone_number','','0','(342) 565-7781'),('contact','235','email','','0','contact@billyscoffee.co.uk'),('contact','235','message','','0','Billys Coffee Co is a local supplier based in the Midlands. We supply an extensive range of coffee equipment, gourmet coffees and consumables.\r\nDue to the high demand for quality coffee throughout the UK we supply into many different sectors such as leisure, catering, business and industry.\r\n\r\nOur approach to coffee is simple, we wish to supply our partners with the latest technology and quality ingredients to ensure the delivery of premium espresso based beverages that consumers enjoy drinking.\r\nBillys Coffee Co prides itself on offering its partners a high level of customer service for machine repairs and deliveries.\r\nWe offer a free consultation with industry experts in order to share the benefits of working with Billys Coffee Co. With many years’ experience within the coffee industry we will advise on the best way to maximise the profit potential when selling coffee in a retail environment.\r\n \r\n \r\nKind regards\r\nGreg\r\n \r\nBilly’s Coffee Company Ltd\r\ninfo@billyscoffee.co.uk\r\nwww.billyscoffee.co.uk\r\nFreephone: 0800 292 2868\r\nFollow us on Twitter: @BillysCoffeeCo');
INSERT INTO `webform_submission_data` VALUES ('contact','235','name','','0','Billys Coffee Company'),('contact','235','your_telephone_number','','0','07773896294'),('contact','236','email','','0','melba.walthall@yahoo.com'),('contact','236','message','','0','Hello!\r\n\r\nNice pets content you have on your site. You know, MOST clients look at your review pages before visiting and buying at your business. \r\nOver 63% of them check Google first!  We feel that your business could use a little help at Google and Facebook.\r\n\r\nMost customers avoid leaving a review unless they have a BAD experience to share! \r\nWe have just the team from USA/Canada to come up with great reviews you need. \r\nOur services help keep at least a 4 star rating in order to avoid losing business to competitors! \r\n\r\nWe provide reliable Google, SiteJabber, TrustPilot, TripAdvisor, Facebook, Zomato, YellowPages reviews in bulk, starting at $20 in as little as 5 business days!\r\n\r\nCheck out our work and satisfied clients here: \r\nhttp://bit.ly/ormworks\r\n\r\nThanks for your time,\r\n\r\nRegards.\r\nMelba'),('contact','236','name','','0','Melba Walthall'),('contact','236','your_telephone_number','','0','0660 181 10 74'),('contact','238','email','','0','kim.young1299@gmail.com'),('contact','238','message','','0','Hi there!\r\n\r\nI was just running a few of my SEO reporting tools on your site, and results showed that there''s a lot of room for improvement so your website can profit more. There are certain keywords related to what your potential clients are searching online on Google that can effectively make your site rank higher on the search engine results. I can make your site be more discoverable so that you can get more profit from online.\r\n\r\nI''m quite sure you''re aware that Google and other major search engines have a way of "crawling" into websites and look for specific keywords and elements that will help your site rank at the top of the searches. I specialize in getting Google and other major search engines retrieve precisely what it needs on your website to put it on top of the organic search results, which means that anyone searching for your products/services will see your website first instead of your competitors.\r\n\r\nIf you are interested to know more, I can give you a free consultation so I can show you the data about your website and valuable information about how you can get more profit with the optimization. Please write back to inform me about what time works best for you to be contacted. Talk to you soon!\n\nKim Young');
INSERT INTO `webform_submission_data` VALUES ('contact','238','name','','0','Kim Young'),('contact','238','your_telephone_number','','0','(342) 567-7049'),('contact','239','email','','0','ses.wright@gmail.com'),('contact','239','message','','0','Dear Parish Clerk, I am contacting local parish councils in the Rother Valley to introduce the new Rother Valley Farmers Group (RVFG), a key aim of which is to help foster and improve informed engagement between the farming sector and local town councils and community groups. We are planning a short autumn/winter farm walk event and would like to invite a couple of councilors along to explain our aims. We have 34 farm members, with two farm members within your parish. We are looking to deliver multi-farm conservation benefits from the project as well as bringing interested local communities together to show what the RVFG is trying to achieve and how developing a network of farmers should enable groups to liaise and contact them more easily. I look forward to hearing from you. Best wishes, Ses Wright'),('contact','239','name','','0','Mrs. Seeseana Wright (please call me Ses for short)'),('contact','239','your_telephone_number','','0','07854 721902'),('contact','249','email','','0','ali@alimartin.com'),('contact','249','message','','0','This is a test message to see if the contact form is still working for bona fide enquiries,'),('contact','249','name','','0','Ali'),('contact','249','your_telephone_number','','0','07528686583'),('contact','250','email','','0','katedowns15@gmail.com'),('contact','250','message','','0','Good afternoon, I attempted to attend the baby and toddler group that is advertised on your website, However on arriving at the village hall at 09:30 found it locked up and no one around. I am assuming that the group is no longer running - I would suggest if this is the case you update your website as I met someone else there who had gone out of their way to attend the group after seeing it advertised on your website.\r\nRegards, Kate Downs'),('contact','250','name','','0','kate Downs'),('contact','250','your_telephone_number','','0','0');
INSERT INTO `webform_submission_data` VALUES ('contact','251','email','','0','Lisa.graves@hants.gov.uk'),('contact','251','message','','0','I am trying to send you our annual email regarding the annual cutting programme, but i am unable to find an email address for you.  please can you forward it to me.'),('contact','251','name','','0','Lisa.graves'),('contact','251','your_telephone_number','','0','01256 840483'),('contact','252','email','','0','lenara@lenara.plus.com'),('contact','252','message','','0','Left message on  Answerphone to the Clerk but no reply.  Wish to speak about the Post Office Service in Buriton  Here today (7th) after 3.30 pm. Available Sunday or Monday..'),('contact','252','name','','0','Leonard Wood  (Compton)'),('contact','252','your_telephone_number','','0','02392631246'),('contact','253','email','','0','brewdelver@aol.com'),('contact','253','message','','0','I am researching the breweries of Petersfield and district.  Is there anyone in the village who could tell me more about the Buriton Brewery?   I believe the brewery was bought in 1892 by Thomas Amey of Petersfield and was run by the Aburrow family but I do not know the location.  I wonder if it was located at a beerhouse (not The Five Bells but maybe the Village Inn)?\r\n\r\nThank you and kind regards\r\n\r\nKeith Osborne'),('contact','253','name','','0','Keith Osborne'),('contact','253','your_telephone_number','','0','1933674856'),('contact','254','email','','0','keith@stealacre.com'),('contact','254','message','','0','Hello - and Happy New Year!\r\nHaving cleared two years'' worth of a tenant''s weeds from Chapel Cottage, we''re thinking of paving the area to reduce maintenance.\r\nI just wanted to check with the PC whether there are any issues with planning / The Buriton Plan etc. in relation to this.\r\nShould I speak to Maggie directly?\r\nKind regards,\r\nKeith\r\nps on a separate subject - who should I speak to regarding burial plots in the cemetery?\r\nKind regards,\r\nKeith'),('contact','254','name','','0','Keith Harrison'),('contact','254','your_telephone_number','','0','07860236169');
INSERT INTO `webform_submission_data` VALUES ('contact','255','email','','0','clerk@marchwoodparishcouncil.org.uk'),('contact','255','message','','0','I was visiting your village last week when I saw a fantastic number of Silent Soldiers on display.\r\n\r\nCould you let me know for how long you plan to have these items on display.\r\n\r\nBest Regards,\r\n\r\nBrendan Gibbs,\r\nClerk to Marchwood Parish Council.\r\n'),('contact','255','name','','0','Brendan Gibbs'),('contact','255','your_telephone_number','','0','02380 860273'),('contact','256','email','','0','clerk@marchwoodparishcouncil.org.uk'),('contact','256','message','','0','I was visiting your village last week when I saw a fantastic number of Silent Soldiers on display.\r\n\r\nCould you let me know for how long you plan to have these items on display.\r\n\r\nBest Regards,\r\n\r\nBrendan Gibbs,\r\nClerk to Marchwood Parish Council.\r\n'),('contact','256','name','','0','Brendan Gibbs'),('contact','256','your_telephone_number','','0','02380 860273'),('contact','257','email','','0','lisasaines@hotmail.com'),('contact','257','message','','0','Good evening, \r\n\r\nWe have in the past had a family event at Burriton Hall and would really love to arrange another on for June 2019 preferably on a Saturday. \r\n\r\nCould you please provide us with availability in June and the cost involved.\r\n\r\n\r\nMany thanks, I look forward to hearing from you\r\n\r\nKind regards \r\n\r\nLisa Saines '),('contact','257','name','','0','Lisa'),('contact','257','your_telephone_number','','0','07793866345'),('contact','258','email','','0','lisasaines@hotmail.com'),('contact','258','message','','0','Good evening, \r\n\r\nWe have in the past had a family event at Burriton Hall and would really love to arrange another on for June 2019 preferably on a Saturday. \r\n\r\nCould you please provide us with availability in June and the cost involved.\r\n\r\n\r\nMany thanks, I look forward to hearing from you\r\n\r\nKind regards \r\n\r\nLisa Saines '),('contact','258','name','','0','Lisa'),('contact','258','your_telephone_number','','0','07793866345');
INSERT INTO `webform_submission_data` VALUES ('contact','259','email','','0','lauraproudman@hotmail.co.uk'),('contact','259','message','','0','Hi, \r\nI am trying to get hold of contact details for someone at the church with regards to arranging a christening. \r\nI can see the church website is under development and no numbers are on display. \r\nIf anyone can help it would be much appreciated. \r\nKind regards\r\nLaura '),('contact','259','name','','0','Laura Proudman'),('contact','259','your_telephone_number','','0','07967970543'),('contact','260','email','','0','committeeclerk@denmeadparishcouncil.co.uk'),('contact','260','message','','0','My name is Karen and I am the Amenities Committee Clerk here at Denmead Parish Council.  I wonder if you wouldn’t mind helping us?  We require a playground inspection soon.  The man we have used before has recently retired.  Would you mind letting us know who it is that you use for your playground inspections?  Your help would be greatly appreciated.\r\n\r\nMany thanks in advance for your help.\r\n\r\nI look forward to hearing from you,\r\n\r\nKindest regards\r\n'),('contact','260','name','','0','Karen Seear'),('contact','260','your_telephone_number','','0','02392247947'),('contact','261','email','','0','christine@thegroundscaregroup.co.uk'),('contact','261','message','','0','The Grounds Care Group – Specialist Grounds Care inc fencing, trees and invasives\r\n\r\nWhere traditional values and technology meet……………….\r\nGood afternoon\r\nWe work extensively in your geographical area, employing local teams. As an SME we care about the work we do and service we provide - to us you are not just a number. I was hoping to ascertain when your grounds maintenance contract is up for review. All our works are backed up by live reporting and before and after pictures. It would be great if we could help make your green spaces and public areas something to be proud of.\r\nPlease take a look at our website to find out more.\r\nIn brief:\r\n•	Landscaping/Grounds maintenance: services to single and multi-sites \r\n•	Vegetation: site clearance and management\r\n•	Invasive weeds: control and eradication including Japanese Knotweed\r\n•	Tree surgery and surveys\r\n•	Fencing – including wildlife and tree protection \r\n\r\nQuality and safety is assured through a portfolio of recognised accreditations.\r\n\r\nMy Director Adam Brindle would be happy to meet with you on an informal basis to see if you feel our company would meet your requirements moving forward. \r\n\r\nPlease let me know how best to proceed. If you require further information, please do let me know.\r\n\r\nKind regards,\r\n\r\nChristine');
INSERT INTO `webform_submission_data` VALUES ('contact','261','name','','0','Christine Lambert'),('contact','261','your_telephone_number','','0','07914 389062 '),('contact','262','email','','0','chris.bellwood@rentokil.com'),('contact','262','message','','0','On behalf of my running club, Hursley Hash House Harriers, we are looking to hold a weekend camping event in your area. I''ve spoken with a lady at The Five Bells who tells me that there is an annual "camp out" on the Recreation Ground opposite the pub and was wondering if it might be possible for us to replicate it in June? The itinerary for the weekend is everyone arrives on Saturday morning to pitch tents (there is the occasional camper van & caravan), goes for a long run after lunchtime, has a lively evening in the pub, after Sunday breakfast another run at 11am, lunch, pack up tents and go home. You can view our typical run radius and activities at www.hursleyh3.co.uk . Many thanks for your attention in this matter.'),('contact','262','name','','0','Chris Bellwood'),('contact','262','your_telephone_number','','0','07515064424'),('contact','263','email','','0','gavin@writehandmarketing.co.uk'),('contact','263','message','','0','Hello Ian\r\nWe know of each other through the Local Tory party. Also through my son Hugh.\r\n\r\nI have request. As a local metal detector I am always looking for areas to ''sweep'' and I wonder if we could discuss permission for me to access your fields(subject to stock safety'' to do some detecting\r\nI am a registered member of the National Council for Metal Detecting and any finds will be shown to you and you will have 50% of the value should anything of interest turn up.\r\nThanking You in Anticipation\r\nGavin Sandeman'),('contact','263','name','','0','Gavin F Sandeman'),('contact','263','your_telephone_number','','0','1730263603'),('contact','268','email','','0','Bec_star_8@hotmail.com'),('contact','268','message','','0','Hello curious about using this hall for a wedding reception wondering if it''s possible to come and view it??'),('contact','268','name','','0','Rebecca Ferris');
INSERT INTO `webform_submission_data` VALUES ('contact','268','your_telephone_number','','0','07584288780'),('contact','269','email','','0','lily_1997@hormail.co.uk'),('contact','269','message','','0','I was wondering how you go about booking the hall for a child’s birthday party. \r\n\r\nIt would be 25th May. 11-1pm if at all possible. \r\n\r\nMany Thanks \r\nLily '),('contact','269','name','','0','Lily Knight '),('contact','269','your_telephone_number','','0','07791809311'),('contact','270','email','','0','lily_1997@hormail.co.uk'),('contact','270','message','','0','I was wondering how you go about booking the hall for a child’s birthday party. \r\n\r\nIt would be 25th May. 11-1pm if at all possible. \r\n\r\nMany Thanks \r\nLily '),('contact','270','name','','0','Lily Knight '),('contact','270','your_telephone_number','','0','07791809311'),('contact','271','email','','0','jcwise49@gmail.com'),('contact','271','message','','0','Would like to know if it is possible to hire the village hall from midday to 5pm on Sunday 28th July, and what the cost might be please. This would be for a visit by the South Hants Vehicle Preservation Society, for a Lady''s Day event. Thank you.'),('contact','271','name','','0','John Wise, President SHVPS'),('contact','271','your_telephone_number','','0','023 9225 1635 or 07802 709 247'),('contact','275','email','','0','katwoo@me.com'),('contact','275','message','','0','Tickets are now on sale for Lion and Unicorn''s touring production of Lilies on the Land! You can see it at Buriton Village Hall, Liss village hall, St Peter''s Church in Petersfield, The Rural Life Centre in Tilford and the roundhouse at Butser Ancient Farm. Find out what life was really like for the Women''s Land Army in WW2. See www.lionandunicornplayers.co.uk or go to One Tree Books or Butser Ancient Farm or the Rural Life Centre to buy tickets. May 5-11 at 7.30pm.'),('contact','275','name','','0','Kat Wootton'),('contact','275','your_telephone_number','','0','7471203855'),('contact','277','email','','0','katwoo@me.com'),('contact','277','message','','0','Hello. Please can I add something to the what''s on? Lion and Unicorn present Lilies on the Land at Buriton Village Hall, Sunday May 5 at 7.30pm. This lovely play about the WLA focuses on four Land Girls from very different backgrounds, getting to grips with working on the Land, doing their bit for the War Effort. Tickets from One Tree Books or www.lionandunicornplayers.co.uk Tickets £12,£10 students');
INSERT INTO `webform_submission_data` VALUES ('contact','277','name','','0','Kat Wootton'),('contact','277','your_telephone_number','','0','7471203855'),('contact','278','email','','0','kimhoo@hotmail.co.uk'),('contact','278','message','','0','Hello,  \r\n\r\nAs I’m sure you are aware, the organisation for the Buriton art trail is well under way and we have booked the Village Hall for the 29th and 30th of June.  We have also organised a ‘taster’ evening on Friday 28th in the Manor Barn. Each artist will display one piece and there will be  a speaker on the evening.  We need to source about 70 chairs for this and so I’m emailing to ask if  we would be able to hire some chairs from the village hall?  If so could you please let me know how much it would cost. We’re trying to make this accessible to anyone in the village and keep the cost of the ticket down, so may end up scavenging chairs from wherever we can get them!\r\nThanks very much, \r\nKim\r\n\r\nKim Hoolahan.\r\n01730 262252\r\nkimhoo@hotmail.co.uk\r\n'),('contact','278','name','','0','Kim Hoolahan'),('contact','278','your_telephone_number','','0','01730262252'),('contact','280','email','','0','kimhoo@hotmail.co.uk'),('contact','280','message','','0','Hello. I recently emailed to ask about borrowing some chairs from the hall for the art trail launch in June. I''ve just had a chat with Sarah and Patrick Figgis who own the Manor Barn where we are holding the launch evening on Friday 28th. They have said that they have borrowed chairs on a few occasions for charity events and they have said how very helpful you have been.  I''m hoping that as this is for a non-profit community event then we also would be eligible to borrow the chairs at no charge. If by any remote chance we do make any money on the launch evening we would donate this to PAtrick Figgie''s cancer charity.  \r\nKind regards, \r\nKim '),('contact','280','name','','0','kim Hoolahan'),('contact','280','your_telephone_number','','0','01730 262252'),('contact','282','email','','0','stephen.olivant@btopenworld.com'),('contact','282','message','','0','Please could you give me an e-mail address for Doug Jones as I wish to contact him with regard to his role as the East Hampshire Association of Parish & Town Councils appointee to the South Downs National Park Authority. \r\n\r\nThank you in advance for your help. \r\n\r\nStephen Olivant');
INSERT INTO `webform_submission_data` VALUES ('contact','282','name','','0','Stephen Olivant'),('contact','282','your_telephone_number','','0','01730266147'),('contact','283','email','','0','clerk@steep-pc.gov.uk'),('contact','283','message','','0','Hi Steve,\r\n\r\nRe- EHAP&TC Meeting - Weds 26th June - I should have asked whether the Judo class being upstairs would disturb the meeting downstairs - do you know how many are at the classes?  Also what time do they start and finish - do they need to come via the main hall?\r\n\r\nCould you give me a ring to discuss?   Many thanks, Jenny'),('contact','283','name','','0','Jenny Hollington'),('contact','283','your_telephone_number','','0','01730 267784'),('contact','284','email','','0','genevieve.dady@sky.com'),('contact','284','message','','0','Hi, a very long shot but thought I’d ask.... I lost some keys whilst visiting your lovely village yesterday. If anyone found them, where would they be likely to hand them in to? I’m not sure who to ask. Thank you in advance. \r\nGenni Dady'),('contact','284','name','','0','Genevieve Dady'),('contact','284','your_telephone_number','','0','07887778077'),('contact','285','email','','0','genevieve.dady@sky.com'),('contact','285','message','','0','Hi, a very long shot but thought I’d ask.... I lost some keys whilst visiting your lovely village yesterday. If anyone found them, where would they be likely to hand them in to? I’m not sure who to ask. Thank you in advance. \r\nGenni Dady'),('contact','285','name','','0','Genevieve Dady'),('contact','285','your_telephone_number','','0','07887778077'),('contact','286','email','','0','alfiebutler750@gmail.com'),('contact','286','message','','0','Hi will you be doing a Buriton carboot sale this year kind regards Alfie '),('contact','286','name','','0','Alfie '),('contact','286','your_telephone_number','','0','+44 7384 709297'),('contact','287','email','','0','maureen_prior@hotmail.com'),('contact','287','message','','0','We have just been to fun on the farm I must say it was a wonderful day we brought four generations  the youngest my three year old great grandson he loved it.  The tractor ride made my day you put so much into it thank you all so much.  I love waving to you all when we go for our walks you are all very special. ');
INSERT INTO `webform_submission_data` VALUES ('contact','287','name','','0','Maureen prior'),('contact','287','your_telephone_number','','0','01730 260769'),('contact','288','email','','0','melaniewilks30@gmail.com'),('contact','288','message','','0','Hi, I was just wondering if the Manor Barn is available to hire for a few hours at all? Many thanks '),('contact','288','name','','0','Mel'),('contact','288','your_telephone_number','','0','07533160927'),('contact','289','email','','0','hello@jobcentrejobs.co.uk'),('contact','289','message','','0','\r\n Hi, \r\n\r\n\r\nI’m reaching out to help you and your audience to find out their nearest Jobcentre \r\n\r\nOffice. \r\n\r\n\r\nPlease, would you consider adding a link to https://www.jobcentrejobs.co.uk/ to your \r\n\r\nwebsite http://www.buriton.info/useful_links directory and help people find \r\n\r\ntheir nearest Jobcentre Office more easily? \r\n\r\n\r\nThanks for your time,\r\nJohn'),('contact','289','name','','0','John'),('contact','289','your_telephone_number','','0','444443333322'),('contact','292','email','','0','foxyason@gmail.com'),('contact','292','message','','0','Hi, strange request but I am recording an audiobook featuring your towns name in it. Could you give me a correct pronunciation?\r\n\r\nMany thanks\r\nRichard'),('contact','292','name','','0','RIchard Fox'),('contact','292','your_telephone_number','','0','07779004930'),('contact','294','email','','0','elizabeth.eveleigh31@gmail.com'),('contact','294','message','','0','Hello,\r\nWe are hiring the Buriton Village Hall for our Honey Show. It will be open to the public from 2pm, and we would also like people to enter if they wish. Can I ask you to add the following to your website, if possible :\r\n\r\nPetersfield & District Beekeepers Association\r\nHoney Show\r\nSaturday 14th September at the Buriton Village Hall\r\n\r\nThis year we are holding our annual Honey Show in Buriton and we would like to invite you to join us.\r\n\r\nNot only would we like you to pop along between 2 and 4pm to find out more about bees, honey and wax while drinking tea and eating cake, we would also like you to take part.\r\n\r\nYou don''t have to be a member to enter and you do not need to keep bees (though entering the honey classes without is a challenge too far). We have photographic classes and baking sections. There are classes for artistic flair from adults as well as children. If you have missed entering the Buriton Village Show competition (or want to add to your prizes), there is still time for your cakes to shine. The schedule is on our website www.petersfieldbeekeepers.co.uk and it cost nothing to enter.');
INSERT INTO `webform_submission_data` VALUES ('contact','294','name','','0','Elizabeth Eveleigh'),('contact','294','your_telephone_number','','0','1730892304'),('contact','296','email','','0','edfrez.478@gmail.com'),('contact','296','message','','0','Hi!\r\n\r\nI was checking on your website, and it seems you might have to update it to keep up with the current trends. People nowadays are more comfortable browsing the internet on their phone or tablet since it''s more convenient. There were some issues when I was viewing it in mobile platforms, I can fix that for you. \r\n\r\nI already like its design and overall user-interface, but I believe that your website can get even better so that your potential clients can be more engaged to do business with you, thus making your website more profitable. I''m all about flexibility and I''m sure that we can work out something to fit your needs. \r\n\r\nMy rates are cheap since I''m committed to helping small businesses. I''ll answer all the questions you have for me during a free consultation over the phone. I''d also like to know your ideas for the website, so please reply with the best time for me to call and your preferred contact details. I look forward to hearing back from you. \n\nThank you,\r\nEdward Frez | Web Designer / Developer'),('contact','296','name','','0','Ed Frez'),('contact','296','your_telephone_number','','0','936-576-9872'),('contact','297','email','','0','markward38@icloud.com'),('contact','297','message','','0','URGENT.  Phone or e-mail  number for member of Buriton Garden Club. Re. Saturday Show.'),('contact','297','name','','0','Mr Mark Ward '),('contact','297','your_telephone_number','','0','02392251873'),('contact','298','email','','0','chasecott@btinternet.com'),('contact','298','message','','0','Sorry to bother you - I''ve been trying to find out whether Buriton Show is on or off tomorrow, but I can''t find anything about it online. Perhaps you can help. Many thanks.\r\n\r\nAmanda'),('contact','298','name','','0','Amanda Francis-Watts'),('contact','298','your_telephone_number','','0','1428605423');
INSERT INTO `webform_submission_data` VALUES ('contact','299','email','','0','brightangel@ntlworld.com'),('contact','299','message','','0','I wish to make a couple of suggestions to the Parish Council and hope it’s officers will consider them.\r\n\r\nAbout 40 years ago, when I first started visiting Buriton, which I love, the pond was deep, it’s water was clear\r\nand it had a nice island with a weeping willow tree on it. \r\nThere were lots of ducks - moorhens, coots, mallards, muscovy and possibly others that I haven’t remembered. Now three of those species are still there but their numbers are very small. \r\nThats not surprising because the pond is very silted up and needs dredging.\r\nDo you have any plans for doing that?\r\n\r\nSecondly, somehow the general public has not yet got the message about not feeding ducks and swans with  bread. \r\nIt would be a great idea if you put up a couple of notices with information of alternatives. One on the corner of the pond facing up the Main Street and the other on the grassed bank area bear where you cut down the lovely, but presumably ailing, lime tree. If you really wanted to go for it a third, on the grass near the bench on the bend leading up to Toad Alley, would be great. Here is a link that I hope will work for you. There are some good examples on that page.\r\n\r\nKind regards\r\nAnn Chawner\r\n\r\nhttps://www.google.co.uk/search?q=what+to+feed+ducks+with&client=safari&hl=en-gb&prmd=isvn&source=lnms&tbm=isch&sa=X&ved=2ahUKEwi5oJfFvITkAhVcUxUIHXAVDMUQ_AUoAXoECBEQAQ&biw=768&bih=950#imgrc=iMKM15ezGfyLWM&imgdii=6Rcg77ipr-TftM\r\n\r\n\r\n'),('contact','299','name','','0','Ann Chawner'),('contact','299','your_telephone_number','','0','02392240729 XD'),('contact','300','email','','0','t.higham@hambledon-pc.gov.uk'),('contact','300','message','','0','Good morning. Am on Hambledon PC with responsibility for Children''s Play areas. Have had very good reports about your new play area - I note the issues surrounding moving old equipment in your minutes. Could you spare a few moments with a call please? Many thanks.\r\n\r\nTony ');
INSERT INTO `webform_submission_data` VALUES ('contact','300','name','','0','Councillor Tony Higham '),('contact','300','your_telephone_number','','0','02392 632628'),('contact','301','email','','0','info@disastersafety.info'),('contact','301','message','','0','Hi,\r\n\r\nSince natural disasters are a constant threat, it’s important that we do everything we can to protect our families, our homes, and ourselves from their potentially devastating effects. That’s exactly what my site is dedicated to, and it’s why I’m reaching out to you today!\r\n\r\nI hope that in order to help your site’s visitors stay safe no matter what bad weather comes their way, you’ll consider adding some disaster safety information to one of your resource pages. Maybe it would be a good fit on a page with helpful information for local residents?\r\n\r\nHere are my suggestions. As you can see, this list covers a wide variety of natural disasters, so feel free to use all of these or pick and choose the ones you think are most relevant for your audience:\r\n\r\nSurviving a Wildfire\r\nhttps://www.iccsafe.org/advocacy/disaster-toolkits/consumer-safety/surviving-a-wildfire/\r\n\r\nFlash Flood Safety and Damage Prevention Guide\r\nhttps://www.homeadvisor.com/r/flash-flood-safety-and-damage-prevention/\r\n\r\nHurricane Safety Tips\r\nhttps://www.libertymutual.com/claims-center/catastrophe-preparation/hurricanes/hurricane-safety-tips\r\n\r\nUltimate Guide to Drought Safety\r\nhttps://www.angieslist.com/articles/ultimate-guide-drought-safety.htm\r\n\r\nTornado Safety Guide\r\nhttps://www.basementguides.com/tornado-safety-guide/\r\n\r\nHow to Proactively Prepare for a Blizzard\r\nhttps://www.fbfs.com/learning-center/how-to-proactively-prepare-for-a-blizzard\r\n\r\nThanks in advance for helping your readers stay prepared!\r\n\r\nBest,\r\nOliver\r\n\r\nOliver Lambert | info@disastersafety.info\r\n\r\nIf you don’t want to hear from me again, please email me with “no more contact” in the subject line. On the other hand, if you’re interested in a new resource to share on your site (something that I write that you could maybe add as a blog post), let me know.\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','301','name','','0','Oliver Lambert'),('contact','301','your_telephone_number','','0','6163430069'),('contact','302','email','','0','info@disastersafety.info'),('contact','302','message','','0','Hi,\r\n\r\nSince natural disasters are a constant threat, it’s important that we do everything we can to protect our families, our homes, and ourselves from their potentially devastating effects. That’s exactly what my site is dedicated to, and it’s why I’m reaching out to you today!\r\n\r\nI hope that in order to help your site’s visitors stay safe no matter what bad weather comes their way, you’ll consider adding some disaster safety information to one of your resource pages. Maybe it would be a good fit on a page with helpful information for local residents?\r\n\r\nHere are my suggestions. As you can see, this list covers a wide variety of natural disasters, so feel free to use all of these or pick and choose the ones you think are most relevant for your audience:\r\n\r\nSurviving a Wildfire\r\nhttps://www.iccsafe.org/advocacy/disaster-toolkits/consumer-safety/surviving-a-wildfire/\r\n\r\nFlash Flood Safety and Damage Prevention Guide\r\nhttps://www.homeadvisor.com/r/flash-flood-safety-and-damage-prevention/\r\n\r\nHurricane Safety Tips\r\nhttps://www.libertymutual.com/claims-center/catastrophe-preparation/hurricanes/hurricane-safety-tips\r\n\r\nUltimate Guide to Drought Safety\r\nhttps://www.angieslist.com/articles/ultimate-guide-drought-safety.htm\r\n\r\nTornado Safety Guide\r\nhttps://www.basementguides.com/tornado-safety-guide/\r\n\r\nHow to Proactively Prepare for a Blizzard\r\nhttps://www.fbfs.com/learning-center/how-to-proactively-prepare-for-a-blizzard\r\n\r\nThanks in advance for helping your readers stay prepared!\r\n\r\nBest,\r\nOliver\r\n\r\nOliver Lambert | info@disastersafety.info\r\n\r\nIf you don’t want to hear from me again, please email me with “no more contact” in the subject line. On the other hand, if you’re interested in a new resource to share on your site (something that I write that you could maybe add as a blog post), let me know.\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','302','name','','0','Oliver Lambert'),('contact','302','your_telephone_number','','0','6163430069'),('contact','303','email','','0','oldbadger46@btinternet.com'),('contact','303','message','','0','Hello St Mary''s. Can anyone help me to trace details of my family?  My mother was one of the Powell family and her father one of the few Powell survivors from the WW1 trenches. Her name was Marjorie May Powell and was born around 1922. She married a Stephen Frederick Spencer in 1945 and i was born in 1946. The marriage and my christening were held in St Mary.s. The marriage did not survive and my mother remarried a Mr A Sidebottom. When she died in 1972,he returned her to Buriton to be  buried in St Mary.s \r\nAny help with the exact dates of my mother''s birth,marriage and death and her family would be much appreciated.\r\nThank you,\r\nTrevor Spencer.  '),('contact','303','name','','0','Brian Trevor Spencer'),('contact','303','your_telephone_number','','0','01661 1661824283'),('contact','304','email','','0','alastair.ramsay@protonmail.com'),('contact','304','message','','0','Dear Buriton Community Website,\r\n\r\nI am a (very) previous student of Buriton Primary School and I am trying to find out if there is a correspondence Email address or postal address for Ted Underwood, the man you mentioned in your post (http://www.buriton.info/index.php/buriton-art-trail-0) regarding his "Craft from the woods" exhibition.\r\n\r\nI studied Judo and Jujitsu under his tuition as a young boy and wish to write to him and thank him personally for the profound effect his teachings had on my life as an adult.\r\n\r\nIf you could help me in this matter it would be greatly appreciated.\r\n\r\nRegards,\r\nAlastair Ramsay'),('contact','304','name','','0','Alastair Ramsay'),('contact','304','your_telephone_number','','0','07535990096'),('contact','305','email','','0','philly.churcherbrown@sky.com'),('contact','305','message','','0','Good evening, I am a British Riding Club member and we have been asked to contact our local parish council regarding any public routes that need attention. \r\nI would like please to advise you of the following which has been mainly unusable for the past few years;\r\n\r\nBOAT: Bopeep Lane\r\nOverall Rating: 0\r\nLocation: Weston, Hampshire.\r\nOS Explorer Map 120, ''Chichester''.\r\nStarting OS Grid Reference: SU725219\r\nStarting GPS Co-ordinates: N50 99'' 20" W000 96'' 80"\r\nFinishing OS Grid Reference: SU722214\r\nFinishing GPS Co-ordinates: N50 98'' 80" W000 97'' 20"\r\nTo see: not much.\r\nALWAYS follow the Greenlane Code!\r\nThis byway (which is nameless, so we named it after the copse found at its southern end) is subject to a TRO, is massively overgrown, and is closed to motorised vehicles. Move along.\r\n\r\nTo Hampshire County Council this is Byway 33.\r\n\r\nI would really appreciate any assistance that you can offer in relation to this matter.\r\nMany thanks\r\nPhilly Miller');
INSERT INTO `webform_submission_data` VALUES ('contact','305','name','','0','Philly Miller'),('contact','305','your_telephone_number','','0','07736929663'),('contact','307','email','','0','info@disastersafety.info'),('contact','307','message','','0','Hi,\r\n\r\nI thought I’d send a quick follow-up to my first email, which had this list of disaster safety information:\r\n\r\nSurviving a Wildfire\r\nhttps://www.iccsafe.org/advocacy/disaster-toolkits/consumer-safety/surviving-a-wildfire/\r\n\r\nFlash Flood Safety and Damage Prevention Guide\r\nhttps://www.homeadvisor.com/r/flash-flood-safety-and-damage-prevention/\r\n\r\nHurricane Safety Tips\r\nhttps://www.libertymutual.com/claims-center/catastrophe-preparation/hurricanes/hurricane-safety-tips\r\n\r\nUltimate Guide to Drought Safety\r\nhttps://www.angieslist.com/articles/ultimate-guide-drought-safety.htm\r\n\r\nTornado Safety Guide\r\nhttps://www.basementguides.com/tornado-safety-guide/\r\n\r\nHow to Proactively Prepare for a Blizzard\r\nhttps://www.fbfs.com/learning-center/how-to-proactively-prepare-for-a-blizzard\r\n\r\nOnce again, I hope you’ll consider adding this list (whether in full or in part) to your site to help your readers stay safe and prepared in the event of a natural disaster. I think they’d fit well on a resources page that has other information for local residents.\r\n\r\nThanks for taking the time to help your readers stay prepared!\r\n\r\nBest,\r\nOliver\r\n\r\nOliver Lambert | info@disastersafety.info\r\n\r\nIf you don’t want to hear from me again, please email me with “no more contact” in the subject line. On the other hand, if you’re interested in a new resource to share on your site (something that I write that you could maybe add as a blog post), let me know.'),('contact','307','name','','0','Oliver Lambert'),('contact','307','your_telephone_number','','0','6163430069'),('contact','308','email','','0','info@disastersafety.info'),('contact','308','message','','0','Hi,\r\n\r\nI thought I’d send a quick follow-up to my first email, which had this list of disaster safety information:\r\n\r\nSurviving a Wildfire\r\nhttps://www.iccsafe.org/advocacy/disaster-toolkits/consumer-safety/surviving-a-wildfire/\r\n\r\nFlash Flood Safety and Damage Prevention Guide\r\nhttps://www.homeadvisor.com/r/flash-flood-safety-and-damage-prevention/\r\n\r\nHurricane Safety Tips\r\nhttps://www.libertymutual.com/claims-center/catastrophe-preparation/hurricanes/hurricane-safety-tips\r\n\r\nUltimate Guide to Drought Safety\r\nhttps://www.angieslist.com/articles/ultimate-guide-drought-safety.htm\r\n\r\nTornado Safety Guide\r\nhttps://www.basementguides.com/tornado-safety-guide/\r\n\r\nHow to Proactively Prepare for a Blizzard\r\nhttps://www.fbfs.com/learning-center/how-to-proactively-prepare-for-a-blizzard\r\n\r\nOnce again, I hope you’ll consider adding this list (whether in full or in part) to your site to help your readers stay safe and prepared in the event of a natural disaster. I think they’d fit well on a resources page that has other information for local residents.\r\n\r\nThanks for taking the time to help your readers stay prepared!\r\n\r\nBest,\r\nOliver\r\n\r\nOliver Lambert | info@disastersafety.info\r\n\r\nIf you don’t want to hear from me again, please email me with “no more contact” in the subject line. On the other hand, if you’re interested in a new resource to share on your site (something that I write that you could maybe add as a blog post), let me know.');
INSERT INTO `webform_submission_data` VALUES ('contact','308','name','','0','Oliver Lambert'),('contact','308','your_telephone_number','','0','6163430069'),('contact','309','email','','0','jon.moss1@btinternet.com'),('contact','309','message','','0','Can you please change the date on Buriton firework night to Friday 1st November\r\n\r\nThank you\r\nJon M'),('contact','309','name','','0','Jon Moss'),('contact','309','your_telephone_number','','0','07818413207'),('contact','310','email','','0','tomfg@hotmail.com'),('contact','310','message','','0','Hi,\r\n\r\nI have just found the contact page online for Buriton re­creation ground. I have just got back ho­me recently from Stu­dying Music at Unive­rsity, as well as st­udying music perform­ance and technology in sound engineering before that for 3 ye­ars. I have had a few ide­as whilst being back here in order to be using my experience, and wondered:\r\n\r\n1) Whether you had music for the Firewor­ks event on the rec, and have a sound sy­stem setup with music syncing wi­th the fireworks to the changes in the display ? As I could create a a mix of songs that would compliment the fireworks. \r\n\r\n2) Whether there wou­ld be the opportunity to help with events in general, with live music bands, concerts of a classical theme such as dance works­hops, theatre, small ensembles etc, to be utilising the club house more..?\r\n\r\nI have lots of ideas and passion for mus­ic and events, and in need of a project in my subject to keep me busy which is a joy to do. I''m happy to work in a volun­tary capacity. \r\n\r\nKind regards\r\n\r\nTom'),('contact','310','name','','0','Tom'),('contact','310','your_telephone_number','','0','07756739951'),('contact','311','email','','0','denise.allen@ditchampark.com'),('contact','311','message','','0','Dear Sirs\r\nGood morning; I''m writing as Bursar of Ditcham Park School.  I have just read the Parish Council''s response on the SDNP planning portal to the School''s recent planning application for a PE block extension.  I would like make contact and, if you wish, arrange an opportunity for us to meet at the School so I can outline the School''s thoughts for the future which I hope will put your mind at rest.  There is an outline "master plan" in mind which is currently being explored and proposed to the Governing Body and will be "published" in due course.  I am currently away from School on a few days leave, but can be contacted on the above number at any time from Monday next onwards.  \r\nI look forward to hearing from you.\r\nDenise');
INSERT INTO `webform_submission_data` VALUES ('contact','311','name','','0','Denise Allen'),('contact','311','your_telephone_number','','0','01730 825659 '),('contact','312','email','','0','doug.pam@btinternet.com'),('contact','312','message','','0','TESTING'),('contact','312','name','','0','Doug Jones'),('contact','312','your_telephone_number','','0','01730231326'),('contact','313','email','','0','doug.pam@btinternet.com'),('contact','313','message','','0','TEST 2'),('contact','313','name','','0','Doug Jones 2'),('contact','313','your_telephone_number','','0','01730 231326'),('contact','314','email','','0','chris.d.loftus@openreach.co.uk'),('contact','314','message','','0','I have been asked to provide phone service to Monks Walk to do this Openreach have to lay duct across Buriton Parish Land, I am trying to find out who we need to contact to obtain permission to do this work.'),('contact','314','name','','0','Chris Loftus'),('contact','314','your_telephone_number','','0','07802872027'),('contact','315','email','','0','v.a.ghaisas@gmail.com'),('contact','315','message','','0','We''ve been looking for a Dark Sky Discovery site to visit on the night of 27th November. We found that Buriton is on a list of sites that the South Downs website has (https://www.southdowns.gov.uk/enjoy/dark-night-skies/).\r\n\r\nCan you give us any more information about the quality of the night sky at Buriton? We''ve found some SQM and Bortle scale measurements, but we''re not sure what they really mean in practice. Also, are there any night sky events at Buriton around then?\r\n\r\nI''ve also noticed that Butser Hill, another Dark Sky Discovery site is close to Buriton. We were planning to get to Buriton by public transport, not by car, so we would also be interested to know if there is a convenient way to get to the top of Butser Hill for a couple of hours at night and then get back.'),('contact','315','name','','0','Vivek'),('contact','315','your_telephone_number','','0','-'),('contact','316','email','','0','josh@fosterwood.co.uk'),('contact','316','message','','0','Hello,\r\n\r\nDo you have an event on for New years Eve?\r\n\r\nthanks, Josh ');
INSERT INTO `webform_submission_data` VALUES ('contact','316','name','','0','Josh Wood'),('contact','316','your_telephone_number','','0','07885485721'),('contact','317','email','','0','info@converthink.com'),('contact','317','message','','0','Hello Team,\r\n\r\nHope you are doing great.\r\n\r\nI feel so curious to know your thought and help you to expand your website’s promotional to protect and creating massive traffic for your business growth. I have visited your website and found some factors where we need to focus on for a better campaign.\r\n\r\nPlease find below some of the major areas:-\r\n\r\n- Key phrases selected for your site are not competitive enough to present you on first page.\r\n\r\n- On page and website issues are the major setback leading to non-performance on search engines.\r\n\r\n- Search based landing page relevance has been broadly ignored, leading to higher bounce rate.\r\n\r\n- Aggressive Social media promotion will help you to achieve brand visibility.\r\n\r\nWe will take all the responsibilities in making the website performance grow faster and you can dedicate your time & energy on new businesses acquisition.\r\n\r\nThis Email just provides you the glimpse of information, if you have any type of queries to discuss what latest technologies we have adopted and how it can significantly improve your online presence.\r\n\r\nLet me know your thought and if possible give me the best time to make further discussion.\r\n\r\nKind Regards\r\nSidharth | Sr Web Analyst\r\n--------------------------------------------------------------------------\r\nPS I. If you are interested, then reply us "Send your Proposal and Price list"\r\nPS II. If you are not interested, then send "Remove or No"'),('contact','317','name','','0','Sidharth Pattnaik'),('contact','317','your_telephone_number','','0','09853892894'),('contact','318','email','','0','info@converthink.com'),('contact','318','message','','0','Hello Team,\r\n\r\nHope you are doing great.\r\n\r\nI feel so curious to know your thought and help you to expand your website’s promotional to protect and creating massive traffic for your business growth. I have visited your website and found some factors where we need to focus on for a better campaign.\r\n\r\nPlease find below some of the major areas:-\r\n\r\n- Key phrases selected for your site are not competitive enough to present you on first page.\r\n\r\n- On page and website issues are the major setback leading to non-performance on search engines.\r\n\r\n- Search based landing page relevance has been broadly ignored, leading to higher bounce rate.\r\n\r\n- Aggressive Social media promotion will help you to achieve brand visibility.\r\n\r\nWe will take all the responsibilities in making the website performance grow faster and you can dedicate your time & energy on new businesses acquisition.\r\n\r\nThis Email just provides you the glimpse of information, if you have any type of queries to discuss what latest technologies we have adopted and how it can significantly improve your online presence.\r\n\r\nLet me know your thought and if possible give me the best time to make further discussion.\r\n\r\nKind Regards\r\nSidharth | Sr Web Analyst\r\n--------------------------------------------------------------------------\r\nPS I. If you are interested, then reply us "Send your Proposal and Price list"\r\nPS II. If you are not interested, then send "Remove or No"');
INSERT INTO `webform_submission_data` VALUES ('contact','318','name','','0','Sidharth Pattnaik'),('contact','318','your_telephone_number','','0','09853892894'),('test_webform','319','email','','0','info@alimartin.com'),('test_webform','319','name','','0','Ali test 1'),('test_webform','319','telephone','ext','0',''),('test_webform','319','telephone','phone','0','+44 7528 686583'),('test_webform','319','telephone','type','0',''),('test_webform','320','email','','0','info@alimartin.com'),('test_webform','320','name','','0','Ali test 2'),('test_webform','320','telephone','ext','0',''),('test_webform','320','telephone','phone','0','+44 7528 686583'),('test_webform','320','telephone','type','0',''),('contact','322','email','','0','doug.pam@btinternet.com'),('contact','322','message','','0','A test from the main Contact bit of the website'),('contact','322','name','','0','Doug Jones'),('contact','322','your_telephone_number','','0','01730 231326'),('contact','323','email','','0','info@alimartin.com'),('contact','323','message','','0','Test message with Doug''s Southdowns email address.'),('contact','323','name','','0','Ali test Friday 1'),('contact','323','your_telephone_number','','0','07528 686583'),('contact','325','email','','0','j.silvester@hotmail.co.uk'),('contact','325','message','','0','Good morning, I’m emailing to ask if you had any information on the history of Buriton house? I’ve been working there for over a year now and want to delve into the property’s history and wondered if you could help.\r\n\r\nMany thanks \r\nJames '),('contact','325','name','','0','James '),('contact','325','your_telephone_number','','0','07805435211'),('contact','326','email','','0','ehegarty26@gmail.com'),('contact','326','message','','0','I have been attending your carols round the pond for the last few years and am again looking forward to this wonderful event. However I don''t seem to be able to find a date and would like to know so that I keep the evening free. Hope you can help.\r\nThanking you'),('contact','326','name','','0','Eileen Hegarty'),('contact','326','your_telephone_number','','0','07443599549');
INSERT INTO `webform_submission_data` VALUES ('contact','328','email','','0','lyn.colbeck33@gmail.com'),('contact','328','message','','0','I''m a local textile craft worker (Petersfield) and I would like to sell my craft goods at the Buriton Christmas Market on 07 Dec.  Could you please send me details?  With thanks. Lyn Colbeck'),('contact','328','name','','0','lyn colbeck'),('contact','328','your_telephone_number','','0','01730858953'),('contact','329','email','','0','melvyn_wingfield@yahoo.co.uk'),('contact','329','message','','0','I have recently established that my maternal Great Grandmother was born in Buriton. It says on her birth certificate;\r\nBorn 16th September 1901. In ''A HUT'', New Barn, BURITON, R.D. She was NORA EVANS. The mention of being born in ''A HUT'' or ''a HUT, makes me think of Hop Pickers. I''ve always understood the Evans family may have been travellers, hawkers and maybe even from the gypsy community. Whilst you will not be able to help with Nora in particular, I''m wondering if you might be able to shine any light on the location where she was said to be born i.e., New Barn or who may have owned the barns, ground etc. in 1901. Thanking you in anticipation. Melvyn WINGFIELD.'),('contact','329','name','','0','Melvyn WINGFIELD'),('contact','329','your_telephone_number','','0','01173301033'),('contact','330','email','','0','lacramioara_bolat@yahoo.co.uk'),('contact','330','message','','0','Dear Sir/ Madame,\r\n\r\nI would like to apply for the position of Teaching Assistant in your school.\r\nI have worked as an English Teacher for six years in Romania and I have been recognised as a teacher here in England starting from August 2014.\r\nI have some experience working in the UK as a supply English teacher and teacher assistant through a couple of agencies as well as the previous 6 years as an English teacher in Romania (EFL teacher), therefore working with students on a one-to-one basis or in groups will not be much of a challenge for me, but it will definitely be a great joy to see them develop as individuals, raise their interest and inspire them with my enthusiasm for learning and discovering new things.\r\nI believe that my qualifications and my experience are exactly what is required for this role, so please contact me to discuss my application. My phone number is 07892719784.\r\n\r\nYours Sincerely,\r\nLacramioara Bolat');
INSERT INTO `webform_submission_data` VALUES ('contact','330','name','','0','Lacramioara Bolat'),('contact','330','your_telephone_number','','0','07484251070'),('contact','331','email','','0','s.powney1@ntlworld.com'),('contact','331','message','','0','\r\n\r\nDear Sirs\r\n\r\nI am currently looking for a hall to run my small Zumbini Group.  Zumbini is dancing and movement for children aged 0-4 years.  It would ideally be required for a Saturday morning.\r\n\r\nIf you are able to accommodate us, could you please let me know.  I would be extremely grateful if you could kindly contact me by email as I teach at Petersfield Infant School and cannot receive or make call during the day as I am teaching.  \r\n\r\nThank you for your kind co-operation.\r\n\r\n \r\nKind regards\r\n\r\nSue Powney\r\n\r\nZumbini Instructor\r\n\r\n'),('contact','331','name','','0','Sue Powney'),('contact','331','your_telephone_number','','0','07511230632'),('contact','332','email','','0','paul.coates@bordonherald.com'),('contact','332','message','','0','Hello\r\n\r\nThe Petersfield Post is doing a feature on parish councils’ aims for 2020 and would welcome a 200-word contribution from your chairman on this theme.\r\n\r\nThe deadline for contributions is 10am on January 6 but for planning purposes it would be appreciated if you could let me know beforehand whether you would like to take part.\r\n\r\nMany Thanks\r\n\r\nPaul Coates\r\n\r\nPetersfield Post'),('contact','332','name','','0','Paul Coates'),('contact','332','your_telephone_number','','0','01730 232603'),('contact','333','email','','0','tim@timjordan.co.uk'),('contact','333','message','','0','\r\nTim Jordan Grounds Maintenance Ltd Maintain Local Parish Councils, Schools, Housing and Council sites From Chichester to Kent and would be happy to assist in any of your grounds Maintenance needs.\r\n\r\n\r\n\r\nPlease contact me if you require any further information.\r\n \r\nThank You\r\n \r\n \r\nKind regards\r\nTim Jordan\r\n\r\nDirector\r\n \r\n \r\n                                                                     Tim Jordan Grounds Maintenance Ltd\r\n                                                                                            Unit 7 East,\r\n                                                                               E Plan Industrial Estate,\r\n                                                                                            Newhaven,\r\n                                                                                            East Sussex,\r\n                                                                                               BN9 0EX\r\n \r\n                                                                                     Tel: 01273 254025\r\n                                                                                 tim@timjordan.co.uk \r\n                                                                                 www.timjordan.co.uk\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','333','name','','0','Tim Jordan'),('contact','333','your_telephone_number','','0','01273254025'),('contact','334','email','','0','hath@tinet.ie'),('contact','334','message','','0','I recently placed an order for the ‘Buriton D-day’ information, unfortunately I can’t find an address to send my cheque, can I just pay by credit card over the phone or do you have an office as I only live in Fareham, so not a million miles from you.\r\nRegards\r\nDavid\r\n'),('contact','334','name','','0','David Hathaway'),('contact','334','your_telephone_number','','0','07502244505/01329311280'),('contact','336','email','','0','thomaswalker@homesafetyhub.org'),('contact','336','message','','0','Hello,\r\n\r\nI would love to send you additional resources related to fire safety in the home. \r\n\r\nI’ll keep the list to ~10 resources that you can review. The hope is that you’ll add the resources to your website (the entire list or just part of it, whatever you think is best) to help your site visitors understand the ins and outs of fire safety in the home.\r\n\r\nI feel confident this is a topic near and dear to your heart, so I’m hopeful you’ll take me up on the offer.\r\n\r\nPlease let me know!\r\n\r\nBest to you,\r\nTom\r\n\r\nThomas Walker @ http://homesafetyhub.org/'),('contact','336','name','','0','Thomas Walker'),('contact','336','your_telephone_number','','0','6022622971'),('contact','338','email','','0','chris_geddes@hotmail.com'),('contact','338','message','','0','Could you please let me know where I can find a copy of the Landscape Character Assessment Map for Buriton Parish, which is referred to in Design Guideline LS10 of the Buriton Village Design Statement?\r\n\r\nThank you\r\n\r\nChris'),('contact','338','name','','0','Chris Geddes'),('contact','338','your_telephone_number','','0','07950777708'),('contact','340','email','','0','amcreynolds@btinternet.com'),('contact','340','message','','0','STOLEN CHICKENS \r\nPlease help us, we are devastated. My niece and I keep 8 chickens in a field about a mile past the car park at the top of kiln Lane, in ‘alunsfield’, New Barn Lane. On Friday afternoon/evening they were stolen, and our ponies were let out of their stables. I have searched the local woods in case someone let them out but didn’t take them but there is no trace of them so it seems they have been stolen.\r\nThere are 6 red hens, 4 of which are rescue hens and still missing some feathers, the other 2 red hens are bigger, one has white tail feathers, the other black tail feathers. The other 2 are speckled hens. They are all beautiful and much loved pets and we are heartbroken at losing them, it’s so callous, they are vulnerable gentle creatures.\r\nBecause of the remote location and nature of the crime, we feel it is likely to be someone local who has taken them and want to appeal to the community to please, please get in touch if you suspect you might know where they are or who took them.\r\nTheir well-being is paramount to us and we are worried sick. Thank you for any help you can offer.\r\nAnita and Rebecca (amcreynolds@btinternet.com)');
INSERT INTO `webform_submission_data` VALUES ('contact','340','name','','0','Anita Huddleston '),('contact','340','your_telephone_number','','0','02392 413146'),('contact','341','email','','0','as@als-ski.com'),('contact','341','message','','0','Dear Sir/Madam, \r\n\r\nI would like to ask some advice on putting a temporary low wooden structure in my garden. Thank you very much.\r\n\r\nKind regards, \r\n\r\nAnnabel\r\n'),('contact','341','name','','0','Annabel Seel'),('contact','341','your_telephone_number','','0','07870351402'),('contact','342','email','','0','barbara.muir@btconnect.com'),('contact','342','message','','0','I would like to make an enquiry about the availability of the village hall for Cardio pulmonary resuscitation courses/+ use of new defibrillator .\r\nI am part of a voluntary group of Buriton villagers arranging to have a defibrillator installed in the village in the next month or two .    I may be asking for use on a few occasions as we have groups too who may be interested eg bowls tennis walkers .\r\nPlease could I ask the hall committee  to waiver fees in view of this community project .\r\nCould you give me a few options for daytime availability and evening.\r\n( I am aware the nursery seems to be full time at present and am not sure of these implications to availability. )\r\n\r\n'),('contact','342','name','','0','Barbara Muir'),('contact','342','your_telephone_number','','0','07940151788 or landline  @01730 231554'),('contact','343','email','','0','mary@learnyay.co.uk'),('contact','343','message','','0','Hi,\r\nI''m Mary, I work as a partnership manager at Learnyay.\r\n\r\nLearnyay helps adults find free education courses and training. By connecting them with ESFA \r\n\r\nand local authority funded colleges, schools and training providers in their area.\r\n\r\nWith many people furloughed and self-isolating, we feel it''s more important than ever to \r\n\r\nraise awareness about free education courses and training.\r\n\r\nPlease would you consider adding our website to your resources page - (http://www.buriton.info/useful_links)? It’s \r\n\r\nhttps://www.learnyay.co.uk\r\n\r\n\r\nHome learning will help people make the most of their time and cope better with self-\r\n\r\nisolation. It will also improve their employment prospects at a time when many jobs are a \r\n\r\nrisk.\r\n\r\nThanks so much for your time,\r\n\r\nMary');
INSERT INTO `webform_submission_data` VALUES ('contact','343','name','','0','Mary Williams'),('contact','343','your_telephone_number','','0','444443333322'),('contact','344','email','','0','brightangel@ntlworld.com'),('contact','344','message','','0','I think it was Doug Jones with whom I had a very interesting conversation at Coulters Dean today. \r\nI would just like to say that I was appalled by the devastation I saw as I turned back onto the SD Way from the lane leading from Ditcham Park. It stretches all the way to the Milky Way. It’s appalling. What exactly are they doing there? It looks as if there is going to be a road? What is the justification for that colossal damage?\r\nAlso I was almost equally appalled when I saw how changed the landscape/trees/vegetation is now all along the footpath down to Toads Alley from the  bench by the pond at the top of the path. So many trees are no longer there that were the last time I walked it a couple of months ago. Also along the route, but particularly in the area before you reach the railway bridge, there is  just total devastation with trees cut down and untidily dumped or left where they fell. \r\nThat whole formerly beautiful path is now wrecked and looks worse than it need due to felled  trees just being left where they fell or dumped.\r\nWhat are the plans to tidy it all up and replant with suitable species? \r\n\r\nI look forward to hearing from you In the hopes that what I then read is positive. '),('contact','344','name','','0','Ann'),('contact','344','your_telephone_number','','0','xd'),('contact','345','email','','0','ginger.reid@ourpreciousresources.org'),('contact','345','message','','0','Hi,\r\n\r\nAs you’re well aware, citizens in communities all across the country (and really, the world) have faced a lot of uncertainty in the last few months due to COVID-19. It’s been critical for community-based sites like yours to share information regarding coronavirus, but I don’t want anyone to forget about the importance of natural disaster safety. On that note, I’m passing along information that will help protect the people in your community during emergency weather:\r\n\r\nTornado facts and safety\r\nhttps://www.iii.org/article/tornado-facts-and-safety\r\n\r\nThe Ultimate Guide to Hurricane Facts, Information and Resources\r\nhttps://www.homeadvisor.com/r/disaster/hurricanes/\r\n\r\nHow to Survive a Flood: Flood Safety Tips\r\nhttps://www.almanac.com/content/flood-safety-and-survival-tips\r\n\r\nThe Ultimate Home Fire-Safety Checklist: Tools and Safety Measures that Will Keep Your Family Safe\r\nhttps://www.highsecurityhome.org/the-ultimate-home-fire-safety-checklist-tools-and-safety-measures-that-will-keep-your-family-safe/\r\n\r\nDrought Safety Tips\r\nhttps://www.ready.gov/drought\r\n\r\nSafety Tips for a Winter Weather Emergency: How to Prepare\r\nhttps://www.directenergy.com/learning-center/weather-readiness/safety-tips-winter-weather-emergency\r\n\r\nHow to Survive a Prolonged Power Outage\r\nhttps://www.consumerreports.org/home-safety/how-to-survive-a-prolonged-power-outage/\r\n\r\nDriving In Emergencies and Disasters\r\nhttp://www.ussartf.org/driving_emergencies_disa.htm\r\n\r\nIs it possible for you to add this list (in full or in part - whatever makes the most sense based on your area) to a resources page so your site’s viewers have easy access to it?\r\n\r\nStay safe!\r\n\r\nWarmly,\r\nGinger\r\n\r\nGinger Reid - ginger.reid@ourpreciousresources.org\r\n\r\nBy the way, I’d also love to write a free, research-based article you could share on your site on living a greener life. Please let me know if you’re interested. If you’d prefer not to be contacted again, please send me an email, and this will be the last time you hear from me. Thanks!\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','345','name','','0','Ginger Reid'),('contact','345','your_telephone_number','','0','2109097718'),('contact','346','email','','0','ginger.reid@ourpreciousresources.org'),('contact','346','message','','0','Hi,\r\n\r\nAs you’re well aware, citizens in communities all across the country (and really, the world) have faced a lot of uncertainty in the last few months due to COVID-19. It’s been critical for community-based sites like yours to share information regarding coronavirus, but I don’t want anyone to forget about the importance of natural disaster safety. On that note, I’m passing along information that will help protect the people in your community during emergency weather:\r\n\r\nTornado facts and safety\r\nhttps://www.iii.org/article/tornado-facts-and-safety\r\n\r\nThe Ultimate Guide to Hurricane Facts, Information and Resources\r\nhttps://www.homeadvisor.com/r/disaster/hurricanes/\r\n\r\nHow to Survive a Flood: Flood Safety Tips\r\nhttps://www.almanac.com/content/flood-safety-and-survival-tips\r\n\r\nThe Ultimate Home Fire-Safety Checklist: Tools and Safety Measures that Will Keep Your Family Safe\r\nhttps://www.highsecurityhome.org/the-ultimate-home-fire-safety-checklist-tools-and-safety-measures-that-will-keep-your-family-safe/\r\n\r\nDrought Safety Tips\r\nhttps://www.ready.gov/drought\r\n\r\nSafety Tips for a Winter Weather Emergency: How to Prepare\r\nhttps://www.directenergy.com/learning-center/weather-readiness/safety-tips-winter-weather-emergency\r\n\r\nHow to Survive a Prolonged Power Outage\r\nhttps://www.consumerreports.org/home-safety/how-to-survive-a-prolonged-power-outage/\r\n\r\nDriving In Emergencies and Disasters\r\nhttp://www.ussartf.org/driving_emergencies_disa.htm\r\n\r\nIs it possible for you to add this list (in full or in part - whatever makes the most sense based on your area) to a resources page so your site’s viewers have easy access to it?\r\n\r\nStay safe!\r\n\r\nWarmly,\r\nGinger\r\n\r\nGinger Reid - ginger.reid@ourpreciousresources.org\r\n\r\nBy the way, I’d also love to write a free, research-based article you could share on your site on living a greener life. Please let me know if you’re interested. If you’d prefer not to be contacted again, please send me an email, and this will be the last time you hear from me. Thanks!\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','346','name','','0','Ginger Reid'),('contact','346','your_telephone_number','','0','2109097718'),('contact','347','email','','0','adam@runprintrun.co.uk'),('contact','347','message','','0','DEAR BURITON COMMUNITY,\r\n\r\nWE ARE ABLE TO SUPPLY ‘YOUR'' HOSPITALS, CARE HOMES, SCHOOLS, SHOPS AND OTHER ORGANISATIONS’ WITH PPE PRODUCTS, FACE MASKS, GLOVES, APRONS, GELS!\r\n\r\nOUR PRICES ARE NOT LOADED BUT FAIR, AS A GESTURE OF GOODWILL!\r\nWE CAN DELIVER TO SINGLE OR MULTIPLE DESTINATIONS!\r\n\r\nWE ALSO SUPPLY PRINTING SERVICES, FORMS, BROCHURES, LEAFLETS ETC.\r\nPROMOTIONAL MERCHANDISE WITH BESPOKE LOGOS AND MORE!\r\n\r\nSTAY SAFE, STAY WELL!\r\n\r\nPlease contact ADAM & JEREMY for further information.\r\nTel: 01753 552 133\r\n'),('contact','347','name','','0','ADAM'),('contact','347','your_telephone_number','','0','01753 552 133'),('contact','348','email','','0','abbychampkin@hotmail.com'),('contact','348','message','','0','Hi, \r\nCould you possibly tell me who would be the best contact for the Buriton car park. The council have said it is not owned by them so Iam assuming it would be the parish? I am keen to have a small mobile coffee unit there? Would this be something that would be possible? Many thanks'),('contact','348','name','','0','Abby'),('contact','348','your_telephone_number','','0','07801481120'),('contact','349','email','','0','rupertsyme@mac.com'),('contact','349','message','','0','Hello,\r\nI live in Buriton (Monks Walk) and am looking for someone locally who might be able to help me with a bit of garden work.  I was wondering if you might know of someone?\r\nKind regards,\r\n\r\nRupert\r\n'),('contact','349','name','','0','Rupert Syme'),('contact','349','your_telephone_number','','0','07974821570'),('contact','350','email','','0','may.myanmar1989@gmail.com'),('contact','350','message','','0','Hi there\r\n\r\nI would like to do a circular hike which (on the map I have seen) starts at the High Street bus stop past the village school - https://www.nationaltrail.co.uk/app/uploads/walks_near_buriton_and_east_meon.pdf\r\n\r\nI have never been there before and wanted some advice on where I could park my car for a fee/for free on Saturday 11th July from about 11am onwards?\r\n\r\nWould be most grateful for any advice on above!\r\n\r\nMany thanks\r\nMay');
INSERT INTO `webform_submission_data` VALUES ('contact','350','name','','0','Dr May Myanmar'),('contact','350','your_telephone_number','','0','07534027032'),('contact','351','email','','0','rogerlunn@gmail.com'),('contact','351','message','','0','I live in village of Soberton in Hampshire.\r\nWe are in the process of preparing a Village development plan .\r\nI have seen your document on internet,and wonder if you would be prepared to send me a hard copy ,thank you\r\nroger lunn\r\nmy address is \r\nCarinya\r\nIngoldfield Lane\r\nNewtown\r\nPO17 6LF '),('contact','351','name','','0','roger lunn'),('contact','351','your_telephone_number','','0','+441329835293'),('contact','352','email','','0','ginger.reid@ourpreciousresources.org'),('contact','352','message','','0','Hi again. I wanted to be sure you got the email I tried sending before, so here it is again (see below). I hope it’s useful, and stay safe!\r\n\r\nHi,\r\n\r\nAs you’re well aware, citizens in communities all across the country (and really, the world) have faced a lot of uncertainty in the last few months due to COVID-19. It’s been critical for community-based sites like yours to share information regarding coronavirus, but I don’t want anyone to forget about the importance of natural disaster safety. On that note, I’m passing along information that will help protect the people in your community during emergency weather:\r\n\r\nTornado facts and safety\r\nhttps://www.iii.org/article/tornado-facts-and-safety\r\n\r\nThe Ultimate Guide to Hurricane Facts, Information and Resources\r\nhttps://www.homeadvisor.com/r/disaster/hurricanes/\r\n\r\nHow to Survive a Flood: Flood Safety Tips\r\nhttps://www.almanac.com/content/flood-safety-and-survival-tips\r\n\r\nThe Ultimate Home Fire-Safety Checklist: Tools and Safety Measures that Will Keep Your Family Safe\r\nhttps://www.highsecurityhome.org/the-ultimate-home-fire-safety-checklist-tools-and-safety-measures-that-will-keep-your-family-safe/\r\n\r\nDrought Safety Tips\r\nhttps://www.ready.gov/drought\r\n\r\nSafety Tips for a Winter Weather Emergency: How to Prepare\r\nhttps://www.directenergy.com/learning-center/weather-readiness/safety-tips-winter-weather-emergency\r\n\r\nHow to Survive a Prolonged Power Outage\r\nhttps://www.consumerreports.org/home-safety/how-to-survive-a-prolonged-power-outage/\r\n\r\nDriving In Emergencies and Disasters\r\nhttp://www.ussartf.org/driving_emergencies_disa.htm\r\n\r\nDIY Home Projects to Work On After a Natural Disaster\r\nhttps://diyguys.net/blog/diy-home-projects-to-work-on-after-a-natural-disaster/\r\n\r\nIs it possible for you to add this list (in full or in part - whatever makes the most sense based on your area) to a resources page so your site’s viewers have easy access to it?\r\n\r\nStay safe!\r\n\r\nWarmly,\r\nGinger\r\n\r\nGinger Reid - ginger.reid@ourpreciousresources.org\r\n\r\nBy the way, I’d also love to write a free, research-based article you could share on your site on living a greener life. Please let me know if you’re interested. If you’d prefer not to be contacted again, please send me an email, and this will be the last time you hear from me. Thanks!');
INSERT INTO `webform_submission_data` VALUES ('contact','352','name','','0','Ginger Reid'),('contact','352','your_telephone_number','','0','2109097718'),('contact','354','email','','0','bernard.allan@tiscali.co.uk'),('contact','354','message','','0','I am looking for a suitable venue in order to run art history classes for adults in the autumn - starting at the end of September.  Ideally I need a hall for Thursdays, but Tuesday morning could be an alternative.  The course would run for 10 weeks (and then re-start after Christmas).  Each session lasts for 2 hours (+ setting up and dismantling time) say a total of 3 hours.\r\nWould you be able to help me?'),('contact','354','name','','0','Bernard Allan'),('contact','354','your_telephone_number','','0','01730813374'),('contact','355','email','','0','whoward69@virginmedia.com'),('contact','355','message','','0','I''ve had a hand delivered letter to "The Clerk of the Parish Council Buriton" (with no other details) pushed through my door.  Where should this have been addressed to?'),('contact','355','name','','0','William Howard'),('contact','355','your_telephone_number','','0','N/A'),('contact','356','email','','0','iainrobgfx@btinternet.com'),('contact','356','message','','0','I have volunteered to help Julie Butler and Rob Mocatta with their long running programme to improve road safety after another fatal accident 3 weeks ago. [Another today].\r\nI am not campaigning but providing resource to conduct research on innovation and best practice.\r\nBuriton came up as an example and as I am very familiar with both the village and Ben Hamilton-Baillie''s work I would be grateful if one of the Buriton Councillors could spare me a few minutes to share the positives and any downsides to the work that was done to Buriton''s main through road some years ago.\r\nAlthough my only experience of Buriton is walking through or driving I owned the land next to Ian and Maggie Johnston until recently so have an impression over a long period that the chnages you made have been very successful.\r\nHappy to do this on the phone or video call, or mask up and visit - I am only in Petersfield.\r\nBest regards\r\n\r\nIain\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','356','name','','0','iain robinson'),('contact','356','your_telephone_number','','0','07900 492730'),('contact','357','email','','0','lucie@oss.org.uk'),('contact','357','message','','0','Hello Petra, I am the financial administrator for the Open Spaces Society. Buriton Parish Councl has been a member since 2007 but I note that the subscription due in June has not yet been paid, I also note that we do not have an address for you. Would it be possible for you to give me this information and I will then send you a letter regarding your subscription in case you wish to renew.  Many thanks and best wishes.  Lucie'),('contact','357','name','','0','Lucie Henwood'),('contact','357','your_telephone_number','','0','01491 573535'),('contact','358','email','','0','committeeclerk@newalresford-tc.gov.uk'),('contact','358','message','','0','Hello Buriton,\r\n\r\nI would like to speak to the clerk regarding advice about Design Statements.  I can see that yours is fairly new and at New Alresford we are about to review our 2008 version.\r\n\r\nWith kind regards\r\nFrances Simpson'),('contact','358','name','','0','Frances Simpson'),('contact','358','your_telephone_number','','0','01962 779490 (home number)'),('contact','359','email','','0','tombrown17@msn.com'),('contact','359','message','','0','Afternoon, as a constant visitor to QECP, I have noticed some ''make shift'' parking restrictions around the kiln lane car park. These do not look like official restrictions and before I contact EHDC or roads authority can I ask what information the parish council have on these. \r\n\r\nRegards '),('contact','359','name','','0','tom brown'),('contact','359','your_telephone_number','','0','07912293776'),('contact','360','email','','0','andy@asfootballacademy.co.uk'),('contact','360','message','','0','Could you please advise on cost and availability for a Saturday afternoon for hiring the main hall??'),('contact','360','name','','0','Andy Sillence '),('contact','360','your_telephone_number','','0','07585586317'),('contact','366','email','','0','benknock904@gmail.com');
INSERT INTO `webform_submission_data` VALUES ('contact','366','message','','0','Please can i have access to tonight''s Zoom meeting '),('contact','366','name','','0','Mr B E Knock'),('contact','366','your_telephone_number','','0','07791416189'),('contact','371','email','','0','c_rosenfeld@gigspark.biz'),('contact','371','message','','0','Hello! \r\n\r\nI’d love to put together a “quick start guide” (including 10-15 resources) on launching a business locally. It can be tricky to get a business up and running, especially during these uncertain times, but I think this quick piece can help guide your readers through the process. \r\n\r\nWhat do you think? May I send it to you for your consideration and possible placement on your site?\r\n\r\nThank you for your time!\r\n\r\nCourtney \r\nc_rosenfeld@gigspark.biz\r\nhttp://www.gigspark.biz/'),('contact','371','name','','0','Courtney Rosenfeld'),('contact','371','your_telephone_number','','0','3217103400'),('contact','372','email','','0','sylviadixon436@gmail.com'),('contact','372','message','','0','Quite by chance I came across an article about Hop Picking in Buriton published in 1984. In the article was the recollections of Aggie Shepherd,the Shephers being regular pickers. Aggie was my 1st cousin 1x removed. I am researching my family tree, which is how I came across the article. Would it be possible for me to put the article on my family tree? I am sure it would be of interest to lots of my family'),('contact','372','name','','0','SYLVIA DIXON'),('contact','372','your_telephone_number','','0','01733239069'),('contact','373','email','','0','sarah_thepickett@hotmail.com'),('contact','373','message','','0','Dear Steve\r\nWe would like to enquire about booking the main hall and kitchen for our sons 1st birthday party in July 2021. Hopefully restrictions will be relaxed by then! We used the hall 3 years ago for my first sons 1st birthday party and it was perfect. We would like to hire a bouncy castle as before and use the kitchen to set up party food. We are interested on having this on a Saturday or  Sunday at the end of July, so either the 24th or 25th or the following weekend the 31st July, 1st August. I think the first weekend would be preferable but at this stage we would just like to see whats available. Ideally we are thinking of a party over lunch time and would maybe be looking to hire from say 11-3 but I cannot remember how this works and of course we are flexible. At this stage I would be grateful if you could just confirm if any of these dates are available? I look forward to hearing from you. Sarah Nutbrown.');
INSERT INTO `webform_submission_data` VALUES ('contact','373','name','','0','Sarah Nutbrown'),('contact','373','your_telephone_number','','0','07793546800'),('contact','374','email','','0','ann.ryan5@btinternet.com'),('contact','374','message','','0','I am walking the South Downs Way in May with friends who have booked into The Village Inn on Wednesday 19th May.  Unfortunately they don''t have any more rooms available so I need to find another room nearby.  Could you advise me of any other accommodation nearby which I could try.  Many thanks'),('contact','374','name','','0','Ann Ryan'),('contact','374','your_telephone_number','','0','07772680307'),('contact','375','email','','0','clerk@parishcouncils.uk'),('contact','375','message','','0','Hi,\r\n\r\nDue to the impact of Coronavirus over 5.5 million people are claiming Universal Credit. Many of them are new to claiming Universal Credit having been negatively impacted by Coronavirus. \r\n\r\n\r\nWe’re encouraging Parish Councils to share the following guide on their website and/or social media to help local people navigate claiming Universal Credit. \r\n\r\n\r\nHere’s the Universal Credit guide https://www.jobcentrenearme.com/universal-credit/\r\n\r\n\r\nBest Regards,\r\n\r\nMary Williams '),('contact','375','name','','0','Mary WIlliams'),('contact','375','your_telephone_number','','0','225509875'),('contact','376','email','','0','clerk@parishcouncils.uk'),('contact','376','message','','0','Hi,\r\n\r\nDue to the impact of Coronavirus over 5.5 million people are claiming Universal Credit. Many of them are new to claiming Universal Credit having been negatively impacted by Coronavirus. \r\n\r\n\r\nWe’re encouraging Parish Councils to share the following guide on their website and/or social media to help local people navigate claiming Universal Credit. \r\n\r\n\r\nHere’s the Universal Credit guide https://www.jobcentrenearme.com/universal-credit/\r\n\r\n\r\nBest Regards,\r\n\r\nMary Williams '),('contact','376','name','','0','Mary WIlliams'),('contact','376','your_telephone_number','','0','26098760986');
INSERT INTO `webform_submission_data` VALUES ('contact','377','email','','0','matt.collins@southernwater.co.uk'),('contact','377','message','','0','I work for Southern Water on a project trying to change customers behaviour in terms of sewer abuse and what is flushed down sinks and loo’s that cause our assets issues.\r\n\r\nFor a number of years now we have had severe ongoing issues at Buriton Waste Water Treatment Works with the excessively high levels of Fat Oil and Grease that are entering the treatment works, which on several occasions has caused our Treatment Work to fail leading to pollution in the nearby watercourse.\r\n\r\nThe actions I am taking to try and tackle this are:\r\n\r\n•	Sending advice letters to all 245 properties in the catchment, giving tips and advice about how to dispose of Fat Oil and Grease effectively.\r\n•	Once lockdown restrictions are lifted my team and I will be door knocking the entire catchment to have a conversation about the issues and how they can help\r\n•	I want to try and engage with yourselves as the Parish Council on how we can work together to potentially get our message and advice out to the locals (putting an article in your local newsletter, website, social media etc and if possible attend a council meeting to deliver a waste water presentation to yourself or other local groups (I can do this via zoom etc if restrictions dont allow us to do this face to face?\r\n•	I want to try and engage with buriton Primary School and perhaps deliver a presentation to the staff and pupils, once restrictions allow me too, or deliver the talk via zoom in the meantime, also provide you them all with goody bags for all the children to take home to there parents/carers which will have devices included to help dispose of fat oil and grease correctly.\r\n•	Whilst door knocking we will lift all the manhole covers and try and investigate further to work out what properties are flushing the highest amounts of Fat Oil and grease.\r\n\r\n\r\nWould it be possible to attend a council meeting, perhaps once the  restrictions open again to deliver a fun and engaging presentation (around 30-60 minutes long) or if not deliver this via zoom etc? \r\n\r\nWould it be possible to put an article about this issue along with our advice in your newsletter/social media/website to help get our message across to the locals?\r\n\r\nI look forward to hearing from you in due course.\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','377','name','','0','Matthew Collins (Southern Water)'),('contact','377','your_telephone_number','','0','07780 490369'),('contact','378','email','','0','marketing@top-tennis-training.com'),('contact','378','message','','0','Hi, \r\nI am the marketing manager for Top Tennis Training - the largest online coaching platform in the world. Over lockdown, we created a free online tennis course to share with players all across the UK. We would love to share this with you and all of your members (free of charge!)\r\nAdditionally, we have set up an initiative to financially support tennis clubs across the UK by splitting our profits with individual clubs. If this sounds of interest, please do get in touch and we can discuss further and get everything set up for you.\r\nMany thanks.\r\n'),('contact','378','name','','0','Oliver Cull'),('contact','378','your_telephone_number','','0','07907642511'),('contact','379','email','','0','paveyscott@googlemail.com'),('contact','379','message','','0','Good morning,\r\n\r\nI am enquiring on behalf of my mother who lives in Glebe Road as to the availability of the Hall on a Saturday in late August, could you also give me an idea of cost also please?\r\n\r\nthanks and best regards\r\n\r\nScott Pavey'),('contact','379','name','','0','scott pavey'),('contact','379','your_telephone_number','','0','+447949330152'),('contact','380','email','','0','philipc@curtinandco.com'),('contact','380','message','','0','I am following up on my email sent last Thursday via the generic Buriton Parish Council email address to Cllrs Jones and Johnston, and would be grateful if someone would give me a call regarding that please. Many thanks.   '),('contact','380','name','','0','Philip Corthorne'),('contact','380','your_telephone_number','','0','07956232878'),('contact','381','email','','0','susiescw@gmail.com'),('contact','381','message','','0','I have sent an email to Petra Norris regarding the phone mast situation. I am hoping, with my husband, to buy a house in Buriton and am trying to urgently find out the where the alternative site is proposed before we start the legal procedure. Please call me back as soon as you are able as the legal process is due to start today  Monday 22nd March. Thank you in anticipation, Sue Wheatley  ');
INSERT INTO `webform_submission_data` VALUES ('contact','381','name','','0','Susan Wheatley'),('contact','381','your_telephone_number','','0','01722 743 943'),('contact','382','email','','0','polly_warman@hotmail.com'),('contact','382','message','','0','Hi I am just enquiring as to whether Buriton village hall is available to hire on 4th September this year. \r\nMany thanks \r\nPolly Wills\r\n'),('contact','382','name','','0','Polly wills '),('contact','382','your_telephone_number','','0','07956598357'),('contact','383','email','','0','grandnaze@sky.com'),('contact','383','message','','0','Hi,\r\nI am coming down from Somerset to meet my Brother (lives in Locksheath) on Friday 07/05 and we intend to ride the South downs Way on the 08/05. A crack of dawn start off to Eastbourne train back same day. \r\nOur start point is Buriton or there abouts. \r\nA cheeky question I know but would it be possible to leave my car in the village hall car park over the day to save blocking up the village pond carpark please? Happy to make a parking donation to the hall as well. \r\nMany thanks in advance\r\n\r\nAlan\r\nPs worked out I first walked from Buriton 43 years ago...how time flies????'),('contact','383','name','','0','Alan Cocker'),('contact','383','your_telephone_number','','0','01963440612'),('contact','384','email','','0','georgia@sawscapesplay.co.uk'),('contact','384','message','','0','Good Afternoon ????\r\n\r\nI am pleased to introduce myself as the new Sales/ Business Development Manager at Sawscapes Play.  I am very excited to join the Playground Experts!\r\n\r\nWhy Sawscapes Play? \r\n\r\n•	Free Design Service\r\n•	Full project installation and build \r\n•	Warranty on installations and products provided\r\n•	Vast choice of play equipment which can be included in your design or to purchase for self-installation\r\n•	Inclusive Playground equipment available \r\n•	Surfacing and Flooring experts – with safety being paramount\r\n•	Fully qualified and DBS checked fitters and build team\r\n•	Inspection and Maintenance Service of existing equipment and play areas\r\n•	Mile Tracks, Adventure Playgrounds, Sensory Gardens and much, much more\r\n•	All play equipment and materials are produced and sourced from the UK. \r\n\r\nPlease view our flier below, along with the play equipment, we can offer tables, benches, Patio areas, planters, resurfacing and bespoke design for any projects you may have in mind. \r\n\r\nIf I can be of any assistance please feel free to contact me, I’m happy to visit you to discuss any requirements you have. \r\n\r\nWishing you all the best. \r\n\r\n\r\nKind regards,\r\nGeorgia\r\n\r\nGeorgia Hoppe\r\nSales Manager \r\nEmail: georgia@sawscapesplay.co.uk\r\nOffice: 01420 257234 \r\nMobile: 07510 924177\r\nWebsite: www.sawscapesplay.co.uk\r\nLinkedIn: https://www.linkedin.com/in/georgia-h-b4867874/\r\nAddress: 7a Hartley Farm Park Business Centre, Selborne Road, Alton, Hampshire, GU34 3HS\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','384','name','','0','Georgia Hoppe'),('contact','384','your_telephone_number','','0','01420257234'),('contact','385','email','','0','turnerandsons@gmail.com'),('contact','385','message','','0','It looks like this link is broken on your site: http://buriton.info/sites/default/files/styles/page_listing/pub...ges/news/img_1682c1.jpg?itok=5nyc7z8a\r\n\r\nI thought you would like to know :).  Silly mistakes can ruin your site''s credibility.  I''ve used a tool called linkSniff.com in the past to keep mistakes off of my website.\r\n\r\n-Ryan'),('contact','385','name','','0','Ryan Turner'),('contact','385','your_telephone_number','','0','510-538-9501'),('contact','386','email','','0','jacob.russell@nurseplusuk.com'),('contact','386','message','','0','Dear Local Parish, \r\n\r\nI hope this email finds you well\r\n\r\nI am emailing to advise about our established local Care at Home and Live-in Care services. Nurseplus Care at Home provides a fast, responsive, premium service delivering care, companionship and confidence to vulnerable people and peace of mind to their families that loved ones are kept safe, well in their own homes.\r\n\r\nWe understand that choosing the right homecare can be overwhelming for the people of our local community, and their families and, would like to promote our services to the people of your local Parish who may be needing support to continue living in the comfort of their own home. \r\n\r\nWe are interested in developing our brand within your community and to seek any brand awareness opportunities you may have within your parish, in particular, parish notice boards where we could display a small flyer and parish newsletters/ magazines which are delivered free of charge to all households. We would also be interested in any events post lockdown which would enable us to develop relationships within your parish. Nurseplus has been operating since 2005, and we have a network of 17 local Branches that support the people in the community to continue an independent lifestyle at home. Our local Branches in Hampshire are based in Andover, Southampton and Gosport, and cover the whole of Hampshire. \r\n\r\nI would be very happy to arrange a further conversation about our services, and also to be involved in talking to the residents in the Parish about topics such as Dementia Awareness.  \r\n\r\nI would be grateful if you could let me know of any opportunity which would enable us to promote our services within your community.\r\n\r\nI look forward to hearing from you in due course. \r\n\r\nKind Regards,\r\n\r\nJacob Russell\r\nBusiness Development Manager\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','386','name','','0','Jacob Russell'),('contact','386','your_telephone_number','','0','07595 778581'),('contact','387','email','','0','Melissa@strengthyoga.co.uk'),('contact','387','message','','0','Hi there,\r\n\r\nI''m interested in booking both the halls for a Health & Wellness fayre in September- do you have a full day hire rate please?\r\n\r\nAlso, could I pop in for a look around some time please?\r\n\r\nMany thanks,\r\nMelissa'),('contact','387','name','','0','Melissa Pasinios'),('contact','387','your_telephone_number','','0','07866516320'),('contact','388','email','','0','collins282@yahoo.com'),('contact','388','message','','0','Hello,\r\n\r\nYou following link is broken on your website: http://buriton.info/sites/default/files/styles/page_listing/pub...shot%20%285888%29e2.jpg?itok=3b0etezs\r\n\r\nSometimes errors like can hurt your web traffic.  Maybe check out a service that alerts you to issues like DeadLinkCheck.com\r\n\r\n-Beth'),('contact','388','name','','0','Beth Collins'),('contact','388','your_telephone_number','','0','203-877-1138'),('contact','396','email','','0','agnieszkadja@googlemail.com'),('contact','396','message','','0','Good morning\r\nI live in Buriton and I am looking for a place to organize a birthday for my mother (60 years old). Would it be possible to rent rooms in Buriton on July 30?\r\nWhat would be the price'),('contact','396','name','','0','Agnieszka M Felinska'),('contact','396','your_telephone_number','','0','07459769395'),('contact','397','email','','0','garypressman458mag@gmail.com'),('contact','397','message','','0','Dear Sir/Madam.\r\nWe seem to have a definate issue with parking on Glebe Road. I live in 51 A and the laybye is constantly used by cars who do not live anywhere near the street,thereby denying parking to the actual residents. Also the waste bin truck is unable to pass through the street due to cars being forced to park in the road. This is going to cause tension and twice I have been woken up before going to work by the poor bin truck driver using his horn to try and find the owner of the cars parked in the road who do not even live in the street. We have had to contact the DVLA before as some inconsiderate person had parked a derelict car in the layby yet kept his driveway clear even though he lived not even two houses away, he was forced to move it. At present we have a red car that has been sitting there for days, badly parked and denying a parking space and another vehicle whose residents do not appear to live in the street yet use the layby. This is a problem, especially on a Friday morning when the bin truck is unable to move.\r\nRegards.\r\nGary Pressman');
INSERT INTO `webform_submission_data` VALUES ('contact','397','name','','0','Gary John Pressman'),('contact','397','your_telephone_number','','0','+441730263794'),('contact','398','email','','0','garypressman458mag@gmail.com'),('contact','398','message','','0','Dear Sir/Madam.\r\nWe seem to have a definate issue with parking on Glebe Road. I live in 51 A and the laybye is constantly used by cars who do not live anywhere near the street,thereby denying parking to the actual residents. Also the waste bin truck is unable to pass through the street due to cars being forced to park in the road. This is going to cause tension and twice I have been woken up before going to work by the poor bin truck driver using his horn to try and find the owner of the cars parked in the road who do not even live in the street. We have had to contact the DVLA before as some inconsiderate person had parked a derelict car in the layby yet kept his driveway clear even though he lived not even two houses away, he was forced to move it. At present we have a red car that has been sitting there for days, badly parked and denying a parking space and another vehicle whose residents do not appear to live in the street yet use the layby. This is a problem, especially on a Friday morning when the bin truck is unable to move.\r\nRegards.\r\nGary Pressman'),('contact','398','name','','0','Gary John Pressman'),('contact','398','your_telephone_number','','0','+441730263794'),('contact','399','email','','0','clerk@loxwood-pc.gov.uk'),('contact','399','message','','0','Loxwood Parish Council have commissioned I Transport to undertake a proposal for traffic calming through Loxwood. They have suggested block paving as a means along sections of the B2133 through Loxwood. They have said that you h have a similar measure in Buriton and I wonder if you have experienced any benefit from it or are there any downsides.\r\nI appreciated you time in dealing with this email.'),('contact','399','name','','0','Jane Bromley'),('contact','399','your_telephone_number','','0','01403 791323'),('contact','400','email','','0','alyons@diydarlin.com');
INSERT INTO `webform_submission_data` VALUES ('contact','400','message','','0','Hello,\r\n\r\nSmall towns can be more tranquil and friendlier than big cities, which is why so many people are moving there.\r\n\r\nSmall towns, on the other hand, are like snowflakes: they''re all different when you look closely. So, how do you select the perfect little town for you and your family?\r\n\r\nThat is exactly the question I would like to answer for your website visitors. Would you like me to write an article about how to pick the perfect little town to call home?\r\n\r\nThank you for your consideration of my request.\r\nAimee Lyons\r\nalyons@diydarlin.com\r\n'),('contact','400','name','','0','Aimee Lyons'),('contact','400','your_telephone_number','','0','9095111482'),('contact','401','email','','0','cara.vaughan94@gmail.com'),('contact','401','message','','0','Hi I am looking at quotes for the 16th of July for my sons birthday and my partner birthday 3pm - 12pm \r\n4-6 will be my sons birthday for his school friends and 6:30 will be family arriving for both birthdays '),('contact','401','name','','0','Cara vaughan '),('contact','401','your_telephone_number','','0','07506004738'),('contact','402','email','','0','liddell.a.s@gmail.com'),('contact','402','message','','0','Good afternoon\r\n\r\nPlease could I check if Buriton toddler group is still running on Wednesday mornings? \r\n\r\nI''ve had some bad luck turning up at toddlers groups listed on the Internet that were no longer running at listed times so thought I''d check first!\r\n\r\nThank you very much\r\n\r\nAngelica  '),('contact','402','name','','0','Angelica Lovell'),('contact','402','your_telephone_number','','0','07828043964'),('contact','403','email','','0','Carolinearm63@gmail.com'),('contact','403','message','','0','Good evening\r\nCan I please ask if something can be done about the patterned slabs at the bottom of the hill on Petersfield Road, where it joins the Causeway. The is a hazard to both cars and cyclist not aware of the hole.\r\nOn our way home tonight to Bolinge Hill Farm a moped rider came flying down the hill towards the Causeway. When my husband flagged him down and asked why he was using the road as it is restricted access only, was told that the rider used it all the time and lived at 20 Sumner Road. When we tried to point out that Sumner Road is outside of the restrictions, the rider said he used it all the time.  We then proceeded home to find the road blocked by a car just before we reached the farm. Apparently the moped had gone to collect something for the car to be to move.\r\nMy point however is that something needs to be done either about the sign at either end clearly people are not aware of the meaning of the signs, or different signs used completely.\r\nI look forward to hearing from you.\r\nKind regards\r\nCaroline Armstrong ');
INSERT INTO `webform_submission_data` VALUES ('contact','403','name','','0','Caroline Armstrong'),('contact','403','your_telephone_number','','0','07917866198'),('contact','404','email','','0','info@climberswaytreecare.co.uk'),('contact','404','message','','0','Good Morning, \r\n\r\nHope you are well. \r\nWe currently work with Winchester Council, Fareham Borough Council, Chichester Council, Oxfordshire County Council and other local parish councils and provide tree maintenance, surveys and watering for them on a regular basis. \r\n\r\nAs we have been working successfully within frameworks for many years, we are keen to explore the possibilities of working for other local councils. I appreciate that every council manages their tree work differently so I would be grateful if you could please let me know if there is a framework we can tender for in the future or whether we can price for individual projects? \r\nWe feel we could really add value to your framework with our efficient service, based around the latest climbing techniques and modern state of the art equipment. It''s led us to being a leading tree surgery firm in the south. \r\n\r\nIn addition, we can also supply and install Tree Protection Fencing and Reptile Fencing. \r\n\r\nTake a look at this PDF to meet our team: https://climberswaytreecare.co.uk/docs/meet-the-team.pdf\r\n\r\nAny queries then please let me know. \r\n\r\nKind Regards,\r\n\r\nEmily Hayward\r\nOperations Manager \r\n\r\nClimbers Way Tree Care'),('contact','404','name','','0','Emily Hayward'),('contact','404','your_telephone_number','','0','02380361062'),('contact','406','email','','0','Helen.smith7@me.com'),('contact','406','message','','0','Do you have toilet facilities now in the park by the village hall?'),('contact','406','name','','0','Helen Smith'),('contact','406','your_telephone_number','','0','07876702198'),('contact','407','email','','0','tiffany.lymn@hotmail.co.uk'),('contact','407','message','','0','Hi,\r\nHope you are well, could you please let me know if the village hall is available for the day and evening on the 17th of September this year please.\r\nMany thanks\r\nTiffany Lymn');
INSERT INTO `webform_submission_data` VALUES ('contact','407','name','','0','Tiffany lymn'),('contact','407','your_telephone_number','','0','07915094089'),('contact','408','email','','0','adam@taylorandnoel.com'),('contact','408','message','','0','Hi,\r\n\r\nPublic parks are a vital part of every community, and yet, we often take them for granted. \r\n\r\nI’d like to encourage more people to become public park advocates. Can I write an article for your website offering tips on how people can help out and make their community parks even better in the process?\r\n\r\nThanks for taking the time to read and consider,\r\nAdam Taylor\r\nadam@taylorandnoel.com\r\n\r\n'),('contact','408','name','','0','Adam Taylor'),('contact','408','your_telephone_number','','0','3342606961'),('contact','409','email','','0','adam@taylorandnoel.com'),('contact','409','message','','0','Hi,\r\n\r\nPublic parks are a vital part of every community, and yet, we often take them for granted. \r\n\r\nI’d like to encourage more people to become public park advocates. Can I write an article for your website offering tips on how people can help out and make their community parks even better in the process?\r\n\r\nThanks for taking the time to read and consider,\r\nAdam Taylor\r\nadam@taylorandnoel.com\r\n\r\n'),('contact','409','name','','0','Adam Taylor'),('contact','409','your_telephone_number','','0','3342606961'),('contact','410','email','','0','gillianaallen@hotmail.co.uk'),('contact','410','message','','0','Hi Can you tell me the best place to park for the show on Saturday please? We’ll have two young children so wondered if there would be extra parking on the field. \r\nThank you in advance'),('contact','410','name','','0','Gillian '),('contact','410','your_telephone_number','','0','07422695788'),('contact','411','email','','0','maxcoutts@hotmail.co.uk'),('contact','411','message','','0','Good afternoon,\r\n\r\nI am in the process of moving to Buriton from Petersfield and have come across the recent application and ongoing appeal for the proposed EE telecommunications mast on Kiln Lane.\r\n\r\nIt appears that the ongoing appeal SDNP/22/00012/REF is the latest live document relating to this but no decision or decision date is available. I cannot see any information on a likely or predicted decision date and rather than go through the slow process of contacting through the South Downs National Park I was wondering what information you might have for me that is pertinent?\r\n\r\nParticularly I cannot find any useful pictures of what the proposed antenna would look like if the application and appeal is successful and Appendix 10 "photo montages" and the drawings document are not (unsurprisingly) helpful in determining what any structure would look like.\r\n\r\nI would be most grateful for your help in this matter and appreciate anything you can tell me or any further information you can direct me to.\r\n\r\nYours,\r\n\r\nMax');
INSERT INTO `webform_submission_data` VALUES ('contact','411','name','','0','Max Coutts'),('contact','411','your_telephone_number','','0','07904971901'),('contact','412','email','','0','johngoodyercharity@gmail.com'),('contact','412','message','','0','Hi,\r\nThank you for including our charity on your website. We are, for a short period, unable to accept any grant applications due to a change of bank accounts. So i would be grateful if you would kindly add that ''we are unable to accept applications at this time'' on your web page. I am very grateful for your assistance.\r\n\r\nKind regards\r\n\r\nMichelle Snow\r\nSecretary/Treasurer\r\nThe John Goodyer Charity'),('contact','412','name','','0','Michelle Snow'),('contact','412','your_telephone_number','','0','01730264282'),('contact','417','email','','0','dancecardiowithstacey@outlook.com'),('contact','417','message','','0','I''m looking for a venue with either a stage or dance studio with mirrors to hold a regular dance fitness class in the Petersfield area, every Thursday evening 7.15-8.15pm. \r\n \r\nI was wondering whether your village hall has this facility and availability at-all?\r\n \r\nThank you in advance. '),('contact','417','name','','0','Stacey Bedford'),('contact','417','your_telephone_number','','0','07547144023'),('contact','419','email','','0','vicky.hodson@cognita.com'),('contact','419','message','','0','Hello I am marketing coordinator at Kingscourt School in Catherington. I am enquiring whether you have any advertising opportunities in your newsletter or on your website and also to let you know that we have four free events this term for preschool children to enjoy if you wanted to include these in any events listings? These include Superworm, a bear hunt, Wonders of Winter and Christmas Craft.  I have a flyer I can send you with all the details of these events if you have an email address I can send it to? Many thanks Vicky \r\n\r\n\r\n '),('contact','419','name','','0','Vicky Hodson'),('contact','419','your_telephone_number','','0','02392593251'),('contact','422','email','','0','info@michael-arnold.net');
INSERT INTO `webform_submission_data` VALUES ('contact','422','message','','0','hello,\r\nI am interested in hiring your hall and kitchen on Saturday 26th November. I would like to hire for most of the day but exact timings depend on pricings.\r\nI would be grateful if you could get back to me in regard to availability, prices and how to book.\r\nMany thanks\r\nRebecca'),('contact','422','name','','0','Rebecca Arnold'),('contact','422','your_telephone_number','','0','0792326907'),('contact','424','email','','0','sally.carpenter@westpointfarmvets.co.uk'),('contact','424','message','','0','Good afternoon,\r\n\r\nwe are a farm vets and are hoping to hold a meeting on Wednesday 15th February at lunchtime/early afternoon, I was wondering if I could have some details on the hall and whether it would be possible to hire it?\r\n\r\nThank you for your help in advance.\r\n\r\nKind regards\r\nSally Carpenter'),('contact','424','name','','0','sally carpenter'),('contact','424','your_telephone_number','','0','01962779593'),('contact','425','email','','0','geraldine.lawrence@hants.gov.uk'),('contact','425','message','','0','Good afternoon\r\n\r\nThe Licence governing Buriton Primary School''s use of Buirton Village Hall is due to expire at the end of this year. Please can someone contact me so that I can discuss renewing the licence on behalf of the School.\r\n\r\nMany thanks\r\nGeraldine Lawrence\r\nEstates Technical Officer\r\nHampshire County Council'),('contact','425','name','','0','Geraldine Lawrence'),('contact','425','your_telephone_number','','0','0370 779 3141'),('contact','427','email','','0','garypressman458mag@gmail.com'),('contact','427','message','','0','Dear Sir / Madam...I would like to raise an issue concerning the Greenway lane development..We were assured that the conifer trees would be incorporated in the landscaping plan, only to find that they have all been chopped down...Is this the way us residents are going to be treated?..I have written to Imperial homes but they have not even bothered to reply...This just shows contempt and that is going to be a mistake...');
INSERT INTO `webform_submission_data` VALUES ('contact','427','name','','0','Gary Pressman'),('contact','427','your_telephone_number','','0','+442392477382'),('contact','429','email','','0','admin@english-naturally.com'),('contact','429','message','','0','Good afternoon, \r\n \r\nI hope you don’t mind me reaching out to you.\r\n \r\nI work for English Naturally - https://www.english-naturally.com – and am contacting you to ask do you have a local community newsletter, as we are looking to bring more host families on board for our Overseas students & Petersfield Summer school next year.\r\n \r\nCan you help?  Is this possible?\r\n  \r\nThanks Alison\r\n '),('contact','429','name','','0','Alison Taylor'),('contact','429','your_telephone_number','','0','.'),('contact','430','email','','0','info@climberswaytreecare.co.uk'),('contact','430','message','','0','Good Afternoon, Hope you are well. We last contacted you in July about how we are able to assist you with your Tree Care needs. We understand the importance of keeping community areas safe and accessible and would like to make you aware that not only can we offer Tree Surgery itself, we can provide Tree Surveys, Safety Reports and Vegetation Management. In addition, we can also supply and install Tree Protection Fencing and Reptile Fencing. We appreciate that every Council manages their tree work differently so I would be grateful if you could please let me know if there is a framework we can tender for in the future or whether we can price for individual projects?We are CHAS, Arb Approved and hold current CSCS cards. Please take a look at our website for what we can offer. climberswaytreecare.co.uk \r\nIf you have any questions or are looking for some advice please don''t hesitate to contact us, we will be more than happy to help.\r\nKindest regards\r\nKelly Ford Customer Care Administrator climberswaytreecare.co.uk       Southampton023 8036 1062Winchester01962 280333New Forest01590 730070Oxford01865 950493Salisbury01722 548059Chichester01243 964739Basingstoke01256 268442Climbers Way Tree Care are an Arboricultural Association Approved Contractor Climbers Way Tree Care Limited is a company registered in England and Wales. Registered number: 09154379\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','430','name','','0','Kelly Ford'),('contact','430','your_telephone_number','','0','02380361062'),('contact_buriton_village_hall','432','email','','0','as@als-ski.com'),('contact_buriton_village_hall','432','message','','0','Hello\r\n\r\nIs it possible to rent the village hall and if so, is Sunday 26 February available pls?\r\n\r\nWe live in the village and we are looking to do a lunch for 30 People after our daughters christening!\r\n\r\nThank you\r\n\r\nBella '),('contact_buriton_village_hall','432','name','','0','Annabel syme'),('contact_buriton_village_hall','432','your_telephone_number','','0','07870351402'),('contact','433','email','','0','Lankabentara@gmail.com'),('contact','433','message','','0','Dear Hall Manager,\r\n\r\nI play pickleball with Sandy and Andy on Tuesdays. I would be interested to play with another pickler on another day of the week and was wondering what would be the rate to hire the pickleball room per hour and what are available slots, starting ideally at 16.30, for 2 hours if possible.\r\n\r\nThis request may possibly be to run on a weekly basis.\r\n\r\nThank you in advance for the information. \r\n\r\nLanka'),('contact','433','name','','0','lanka bentara'),('contact','433','your_telephone_number','','0','07926887507'),('contact_buriton_village_hall','434','email','','0','swhitfield31@icloud.com'),('contact_buriton_village_hall','434','message','','0','Looking for hall availability. Ideally a Monday and Thursday after school '),('contact_buriton_village_hall','434','name','','0','Sarah Ann Whitfield'),('contact_buriton_village_hall','434','your_telephone_number','','0','07815833194'),('contact','435','email','','0','sam@seolabpros.com'),('contact','435','message','','0','"Hi,\r\nAre you still in business?\r\nI found a few errors on your site.\r\nWould you like me to send over a screenshot of those errors?\r\n\r\nRegards,\r\n\r\nSam Smith\r\n\r\n(714) 500-7363"'),('contact','435','name','','0','Sam Smith'),('contact','435','your_telephone_number','','0','(714) 500-7363'),('contact','436','email','','0','j.c.deavin@btinternet.com');
INSERT INTO `webform_submission_data` VALUES ('contact','436','message','','0','As area coordinator for Neighbourhood Watch I have Lynne Ashcroft on my list of local coordinators. Recently the e-mail address and telephone contact details i have on file no longer connect. Could someone kindly ask Lynne to send me a mail to the a.m. address with current status. \r\nThank you  John Deavin 01730262880'),('contact','436','name','','0','John Deavin'),('contact','436','your_telephone_number','','0','07785556332'),('contact','437','email','','0','lucinda.c.herring@gmail.com'),('contact','437','message','','0','Hi there,\r\n\r\nI wanted to get in touch to ask whether I would be able to drop some flyers off and a poster for my mother in law, who is a children’s party entertainer?\r\n\r\nI’m a local resident in Nyewood,  Petersfield and she’d love to get the word out to the local community!\r\n\r\nBest wishes,\r\nLuci Layton'),('contact','437','name','','0','Luci Layton'),('contact','437','your_telephone_number','','0','07908969104'),('contact_buriton_village_hall','438','email','','0','clairealbuery@sky.com'),('contact_buriton_village_hall','438','message','','0','Are you able to give me a contact number for the bowls people that play at the village hall please?  \r\n\r\nI have someone that would like to donate some bowls.  \r\n\r\nMany thanks \r\n\r\nClaire. '),('contact_buriton_village_hall','438','name','','0','Claire Albuery'),('contact_buriton_village_hall','438','your_telephone_number','','0','07788209129'),('contact','439','email','','0','katrina.luff@hotmail.com'),('contact','439','message','','0','Please would you be kind enough to contact me regarding planning within the parish'),('contact','439','name','','0','katrina Luff'),('contact','439','your_telephone_number','','0','07787890920'),('contact_buriton_village_hall','440','email','','0','nofussfood@hotmail.co.uk'),('contact_buriton_village_hall','440','message','','0','Dear Steve\r\nWe are catering for a funeral on Thursday 2 March for approx 80 people. The hall has been booked by Piers Burton Page from 2-6pm. Please could you advice whether there are enough cups and saucers, cafetières, glass etc.\r\nAlso will we the hall be unlocked or do we need to collect a key from somewhere.\r\nWe would be very happy to make a visit to the hall at a convenient time to us both.\r\nWe look forward to hearing from you.\r\nLucy and Sarah');
INSERT INTO `webform_submission_data` VALUES ('contact_buriton_village_hall','440','name','','0','Sarah and Lucy'),('contact_buriton_village_hall','440','your_telephone_number','','0','233410 or 267683'),('contact','441','email','','0','rob.imrie@outlook.com'),('contact','441','message','','0','I was cycling into Buriton along North Lane two weeks ago and I was thrown off my bike by the first sleeping policeman or raised part of the road that I approached. This is made of rectangular stones spaced in such a way to snare a cycle wheel and throw a rider. It has been designed without thought for cyclists. Is this an issue your council is aware of and/or are able to do something about? I have contacted Hampshire Transport and they say it is not a hazard but they do not appreciated what it is like for non motorised transport.'),('contact','441','name','','0','Rob Imrie'),('contact','441','your_telephone_number','','0','07704655517'),('contact','442','email','','0','michelle.bradley.xi@gmail.com'),('contact','442','message','','0','This is a website for the ''Greenway Park'' hotel proposal for Greenway lane: \r\nhttps://greenwaypark.yoursaydigital.co.uk/virtual-exhibition\r\n\r\nP.S. Thanks to the parish council for your stunning letter regarding the planning appeal from Recharge One. Absolutely brilliant writing '),('contact','442','name','','0','Michelle Bradley'),('contact','442','your_telephone_number','','0','01730261320'),('contact','444','email','','0','waterman47@btinternet.com'),('contact','444','message','','0','Ref. Imperial Homes.\r\nI have noticed that  the above company are parking contractors vans in Glebe road.\r\nRecently an Imperial homes van was parked o/s no 61 and was there for the whole day.\r\nToday Thursday 23rd March there is a scaffolding  company van parked up near no 51\r\nThis appears to be in breach of the site agreement in respect of where site traffic should be parked.\r\nGlebe road is already heavily congested with residents vehicals,sometimes double parked\r\nCould you please look in to this matter as soon as possible.\r\n\r\nThank you \r\nKeith Cummins\r\n \r\n\r\n \r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','444','name','','0','Keith Cummins'),('contact','444','your_telephone_number','','0','01730263285'),('contact','445','email','','0','jaqueline.mears@outlook.com'),('contact','445','message','','0','Hi\r\n\r\nI am a volunteer in Kherson region in Ukraine and I must admit that the situation has become extremely dire. The Russian forces are intensifying their attacks almost on an hourly basis, which has resulted in a cut off of all essential supplies and clothing. With extreme cold and lack of food supplies, it has become extremely difficult for innocent Ukrainian civilians to survive, most of whom are homeless. Internet and all communications are heavily censored and down most of the time.\r\n\r\nWe have been promised foreign aid by countless charities and organisations but in reality, hardly anything arrives. I suspect that all deliveries are being intercepted by Russian troops.\r\n\r\nAs a last resort, I am appealing to buriton.info to help Ukrainian civilians in the region with all essential supplies.\r\n\r\nWe would ideally need medical supplies, food (non-perishable or longer lasting), warm clothing and anything else you may be able to provide.\r\n\r\nIf you are able to deliver help, please could you send it to the below address which we are using as shelter for the time being.\r\n\r\nKherson State Agrarian University\r\nStritenska St, 23\r\nKherson, Kherson Oblast \r\nUkraine, 73006\r\n\r\nAlternatively, we are also accepting cryptocurrency donations as conventional banking instruments are simply not available to us. If you do not have cryptocurrency, you can easily purchase and send it from Coinbase, Coinpayments, Coin Mama or alternative providers.\r\n\r\nBelow are the wallet addresses of our local humanitarian volunteer group:\r\n\r\nBitcoin: bc1q9uun7eny4t8pvlq7lmz39z9rr7rm3vw849hqwv\r\n\r\nEthereum: 0xa74cce7805342F10df39B698342380f58bB709b5\r\n\r\nNo donation is too small and will be most appreciated.\r\n\r\nI would like to send you some pictures and video footage of the atrocities in the region but unfortunately, the internet is too slow and very intermittent.\r\n\r\nI would be most appreciative if you could share this message on social media and your friends to raise awareness about the situation and lobby your local government to provide more support to Ukrainian army.\r\n\r\nThank you for you help.\r\n\r\nBest wishes\r\n\r\nJaqueline Mears\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','445','name','','0','Jaqueline Mears'),('contact','445','your_telephone_number','','0','446 2016'),('contact','447','email','','0','clare_brooks@rocketmail.com'),('contact','447','message','','0','Hi, I don’t suppose there is any chance that there is a lost and found from the village hall car park is there? I think I might have left a green fleece jacket there at the end of March weekend. Thanks. Clare'),('contact','447','name','','0','Clare Brooks'),('contact','447','your_telephone_number','','0','02392410199'),('contact','448','email','','0','david@fleming20.co.uk'),('contact','448','message','','0','How do I fund the names of Buriton Parish Councillor candidates on 4th May 2023?'),('contact','448','name','','0','David Fleming'),('contact','448','your_telephone_number','','0','01730233533'),('contact','449','email','','0','j.bryant195@btinternet.com'),('contact','449','message','','0','Hi,\r\nBoth Keith and I on a walk this morning came across a defective gate which some people will find hard to open as the gate post has rotted at ground level and the gate is very heavy,the What Three Word Reference is \r\napplauded.quarrel.dignity  hope you can help or pass to relevant authority,its the path opposite Glebe Road that leads down to the Hangars Way.\r\nThanks\r\nJohn.'),('contact','449','name','','0','John Bryant and Keith Cummins'),('contact','449','your_telephone_number','','0','07484344990'),('contact_buriton_village_hall','450','email','','0','dmoran@stgeorges-ascot.org.uk'),('contact_buriton_village_hall','450','message','','0','Good evening,\r\nYou very kindly let us have use of the changing facilities and the field to camp on last year for our small group of girls who were doing their Silver Duke of Edinburgh Award.\r\nWe would very much like to come again and book the changing room facilities for Thursday 08 June.\r\nWe would be arriving late afternoon and gone early the next morning.\r\nI believe I posted the key back through the letter box and can do the same if required.\r\nThey are a lovely group of fourteen girls who are walking sections of the SD Way and will be accompanied by two teachers as last year.\r\nI will have a look at the booking form to see if I can submit it with this information, but wanted to contact ytin person first, as you were so kind and helpful last time.\r\nPlease can you confirm.\r\nThank you.\r\nKind regards,\r\nDavid Moran\r\nSt Georges''s Girls School, Ascot\r\ndmoran@stgeorges-ascot.org.uk\r\n07769 037513\r\n01344 629900');
INSERT INTO `webform_submission_data` VALUES ('contact_buriton_village_hall','450','name','','0','David Moran'),('contact_buriton_village_hall','450','your_telephone_number','','0','07769037513'),('contact','451','email','','0','bluenejan@gmail.com'),('contact','451','message','','0','Hello\r\n\r\nJust let a voicemail on 07878 027845 number, we left our sons scooted on the field by the little entrance to the cars last night, I went over today but sadly it wasn’t there, I asked a couple of people but no one  seemed to have seen it so wondered if it may have been handed in or if someone may have left it by your door as you are the nearest building, if someone could let me know, I would be very grateful, thanks\r\nJulia\r\n'),('contact','451','name','','0','julia '),('contact','451','your_telephone_number','','0','07884477330'),('contact','453','email','','0','ben_1984@hotmail.co.uk'),('contact','453','message','','0','Good evening \r\nMy name is Ben \r\nI was asking if there is any where I could offer free pest control for you \r\nI am fully insured \r\nIt’s more of a hobby for myself '),('contact','453','name','','0','Ben Haddrell '),('contact','453','your_telephone_number','','0','07918615023'),('contact','454','email','','0','wburrett@hotmail.co.uk'),('contact','454','message','','0','Good morning. \r\n\r\nI hope all is well. \r\n\r\nI have just purchased a house in Buriton. I wanted to see if I could talk to someone/see someone about potentially extending the parking bay of the house? If you could give me a call on the number above that would be great. \r\n\r\nThanks. \r\n\r\nBill. '),('contact','454','name','','0','Bill Burrett'),('contact','454','your_telephone_number','','0','07768986093'),('contact','455','email','','0','sjfranks43@outlook.com'),('contact','455','message','','0','Hello\r\n\r\nI am looking for a place to hire for dog training classes\r\n\r\nDo you have availability in your hall please?\r\n\r\nThank you '),('contact','455','name','','0','Sarah-Jane Franks'),('contact','455','your_telephone_number','','0','07738306020'),('contact','457','email','','0','j.bryant195@btinternet.com');
INSERT INTO `webform_submission_data` VALUES ('contact','457','message','','0','Hi Doug,\r\nWonder if you can get in touch with who this might concern but coming into the village past the building works today there were twelve cars parked outside and you are completely blind on that bend quite a danger and someone is going to come a cropper there you just can''t see round safely just got to take a chance its not really a very good place to park it was the same yesterday if you want I have a picture and I have put a copy on Buriton Life they just don''t care on that site. Thanks John.'),('contact','457','name','','0','John Bryant'),('contact','457','your_telephone_number','','0','07484344990'),('contact','458','email','','0','saskiajonathan23@gmail.com'),('contact','458','message','','0','Hello, I have a query regarding the Greenway lane development and I was wondering what the best method of submitting this would be?\r\n\r\nany help would be great thank you.\r\n\r\nkind regards,\r\n\r\nJonathan.'),('contact','458','name','','0','Jonathan McSharry'),('contact','458','your_telephone_number','','0','07794436890'),('contact_buriton_village_hall','459','email','','0','trevk1977@gmail.com'),('contact_buriton_village_hall','459','message','','0','Good afternoon, I would like to enquire about the availability of the hall, on Saturday 8th July. Ideally looking to hire the hall from 1.00PM through to around 9PM. It would be a private event with approx. 30 guests. Use of kitchen would be good. I look forward to hearing from you.'),('contact_buriton_village_hall','459','name','','0','Trevor KNight'),('contact_buriton_village_hall','459','your_telephone_number','','0','07881 357046'),('contact','460','email','','0','actimms@icloud.com'),('contact','460','message','','0','5 kids (2 really quite small) trying to kick out the glass in the book swap. Put the bin in there. general low level but noisy and a nuisance. Banging on Anne and Mark''s house and running away. next step I imagine will be broken windows!\r\nIt''s always the same ones (electric scooters, football kicked at parked cars and they just need to be identified and put on notice to behave. Is there anyone who knows who they are.\r\n\r\nkind regards\r\n\r\nAlistair\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','460','name','','0','Alistair Timms'),('contact','460','your_telephone_number','','0','07970 200420'),('contact','461','email','','0','ellie.wilks@ageconcernhampshire.org.uk'),('contact','461','message','','0','Good afternoon, \r\n\r\nI hope this email finds you well. \r\nMy name is Ellie, I am the footcare coordinator for Age Concern Hampshire and I am looking for new venue to run our Petersfield clinics from. \r\nThe clinics provide a Foot care service to the Over 50s in the local community, we offer a Toenail cut and foot health care check on a 6-week cycle. Once the client has a spot they are then on a regular six-week cycle to keep up with their foot health. \r\n\r\nThe clinics run from 9am -330pm and we would be looking for a small private room, with access to running water either in the room or close by for handwashing between clients. The room would need a window for ventilation, and we would need access to wifi if possible. \r\nOur main concern is the access to the building and carpark availability as a lot of our clients are in wheelchairs or use sticks to aid with walking.\r\n\r\nWe have clinics booked until 2024 and would then like to proceed with a block booking for the next financial year. We would be looking to move from our current venue as soon as possible. \r\n\r\nI very much look forward to hearing from you soon. \r\n\r\nMany Thanks '),('contact','461','name','','0','Eleanor Wilks'),('contact','461','your_telephone_number','','0','07791006540'),('contact','462','email','','0','paula.wigley42@gmail.com'),('contact','462','message','','0','I cannot find a date for your village show this year.  My husband and I have judged photography and crafts in the past and I didn''t want to let you down if you were expecting us.\r\nPaula Wigley'),('contact','462','name','','0','Paula Wigley'),('contact','462','your_telephone_number','','0','01730300729'),('contact_buriton_village_hall','463','email','','0','oliviadarley@gmail.com'),('contact_buriton_village_hall','463','message','','0','Dear Steve\r\n\r\nWe are looking to host a birthday party and wondered if you had any availability on Saturday 24th sept in the morning? If so, please can you also let me know about prices- we live in west Harting.\r\nMany thanks \r\nOlivia');
INSERT INTO `webform_submission_data` VALUES ('contact_buriton_village_hall','463','name','','0','Olivia Turner'),('contact_buriton_village_hall','463','your_telephone_number','','0','07814208524'),('contact_buriton_village_hall','465','email','','0','livarmstrong@gmail.com'),('contact_buriton_village_hall','465','message','','0','Good afternoon,\r\nI’m wondering whether it’s still possible to hire crockery from the village hall? We live at 39, North Lane and are looking to hire 20 plates and bowls for Saturday, 9th September.\r\nMany thanks,\r\nLiv '),('contact_buriton_village_hall','465','name','','0','Olivia Burnett-Armstrong '),('contact_buriton_village_hall','465','your_telephone_number','','0','07775732395'),('contact','466','email','','0','dylankibble@yahoo.co.uk'),('contact','466','message','','0','Hi, I am one of the managers for Petersfield Town Football Club and was down at the village hall and playing fields tonight marking the pitches out, unfortunately though the key the club have been provided for the hanging rooms (where we will be storing some equipment) appears to have been poorly cut as it was a real struggle to get the door open and then I was unable to lock it.\r\n\r\nI’ve tried calling Steve Franks (voicemail left) and Linda (the listed parish councillor on the noticeboard) on 01730 263805 but I think the number might be out-of-date as it didn’t connect. I also tried in the 5 Bells but apparently they are no longer key holders. I have sent this contact form and will email as well (and contact any other people I think may be able to help).\r\n\r\nSo basically, the changing room door is currently closed but unlocked. We’ll go back up there tomorrow to collect our equipment and try again to lock the door but I will be staggered if it locks. Please could someone attend as a matter of urgency and lock the door up, and could arrangements be made for PTFC to have a copy of the key that works!'),('contact','466','name','','0','Dylan Kibble'),('contact','466','your_telephone_number','','0','07896 968410'),('contact_buriton_village_hall','467','email','','0','dylankibble@yahoo.co.uk');
INSERT INTO `webform_submission_data` VALUES ('contact_buriton_village_hall','467','message','','0','Hi, I am one of the managers for Petersfield Town Football Club and was down at the village hall and playing fields tonight marking the pitches out, unfortunately though the key the club have been provided for the hanging rooms (where we will be storing some equipment) appears to have been poorly cut as it was a real struggle to get the door open and then I was unable to lock it. \r\nI’ve tried calling Steve Franks (voicemail left) and Linda (the listed parish councillor on the noticeboard) on 01730 263805 but I think the number might be out-of-date as it didn’t connect. I also tried in the 5 Bells but apparently they are no longer key holders. I have sent this contact form and will email as well (and contact any other people I think may be able to help).\r\nSo basically, the changing room door is currently closed but unlocked. We’ll go back up there tomorrow to collect our equipment and try again to lock the door but I will be staggered if it locks. Please could someone attend as a matter of urgency and lock the door up, and could arrangements be made for PTFC to have a copy of the key that works!'),('contact_buriton_village_hall','467','name','','0','Dylan Kibble'),('contact_buriton_village_hall','467','your_telephone_number','','0','07896 968410'),('contact','468','email','','0','amy.southey@hotmail.co.uk'),('contact','468','message','','0','Hello\r\nMy daughter was playing at your park yesterday and she hurt her finger when she was playing with the musical tubes that go up and down on the platform at the top of the small slide. She caught her finger in the gap between the tube and the hole as the tube was going down and has a sore blood blister. I mentioned it to another mum and she said the same thing happened to her daughter too when she was playing with them recently.\r\nI wondered if you might be able to look at putting some foam around the bottom of the tubes to avoid this happening to other children or maybe a sign so parents are aware it can happen.\r\nMany thanks\r\nAmy');
INSERT INTO `webform_submission_data` VALUES ('contact','468','name','','0','Amy Southey'),('contact','468','your_telephone_number','','0','07985352338'),('contact','469','email','','0','ladyanna.ah@gmail.com'),('contact','469','message','','0','Following on from recent meetings with Damian Hinds and EHDC Leaders I have booked Petersfield Community Centre for 7.30 on Friday 20th of October for a public meeting. Invitations will go out to local environmental networks, Councillors from all 4 tiers, political parties, schools, churches as well as residents from Petersfield and it’s surrounding villages. I intend to use a similar presentation as I used with Damian Hinds, Cllrs Millard, Tree etc so the focus will be on resilience with particular reference to food but also coastal migration following a flooding event. Two things that are currently blind spots for our councils. Thankfully EHDC Leaders are taking these issues seriously and a follow up meeting is booked for next month. \r\n \r\nI would like to invite Buriton Parish Councillors to the meeting on 20/10/23.\r\n \r\nThe ‘blurb’ I’m sending out is as follows; What will Petersfield look like in 2033? Can we use the powerful tools of our own imaginations and story telling to find solutions to the problems on the path ahead? What we need now, more than ever before, is cognitive diversity; people with ideas borne of lived experience coming together to tackle issues such as global food security. This is a talk full of facts but also of hope and possibilities. Recently presented to the Leaders of EHDC and to the Rt. Hon’ Damian Hinds I know it will promote plenty of discussion and ideas. \r\n \r\nPlease don’t hesitate to make contact should you need to discuss this further.\r\nWarm regards\r\nAnna Grey\r\n \r\n'),('contact','469','name','','0','Anna Grey'),('contact','469','your_telephone_number','','0','07795346878'),('contact','470','email','','0','ladyanna.ah@gmail.com'),('contact','470','message','','0','Following on from recent meetings with Damian Hinds and EHDC Leaders I have booked Petersfield Community Centre for 7.30 on Friday 20th of October for a public meeting. Invitations will go out to local environmental networks, Councillors from all 4 tiers, political parties, schools, churches as well as residents from Petersfield and it’s surrounding villages. I intend to use a similar presentation as I used with Damian Hinds, Cllrs Millard, Tree etc so the focus will be on resilience with particular reference to food but also coastal migration following a flooding event. Two things that are currently blind spots for our councils. Thankfully EHDC Leaders are taking these issues seriously and a follow up meeting is booked for next month. \r\n \r\nI would like to invite Buriton Parish Councillors to the meeting on 20/10/23.\r\n \r\nThe ‘blurb’ I’m sending out is as follows; What will Petersfield look like in 2033? Can we use the powerful tools of our own imaginations and story telling to find solutions to the problems on the path ahead? What we need now, more than ever before, is cognitive diversity; people with ideas borne of lived experience coming together to tackle issues such as global food security. This is a talk full of facts but also of hope and possibilities. Recently presented to the Leaders of EHDC and to the Rt. Hon’ Damian Hinds I know it will promote plenty of discussion and ideas. \r\n \r\nPlease don’t hesitate to make contact should you need to discuss this further.\r\nWarm regards\r\nAnna Grey\r\n \r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','470','name','','0','Anna Grey'),('contact','470','your_telephone_number','','0','07795346878'),('contact','472','email','','0','info@michael-arnold.net'),('contact','472','message','','0','Hello,\r\nI am interested in hiring the hall on a saturday or sunday early November.\r\nWould be grateful if you could get back to me on availability and prices.\r\nMany thanks\r\nRebecca'),('contact','472','name','','0','Rebecca Arnold'),('contact','472','your_telephone_number','','0','07923269073'),('contact_buriton_village_hall','474','email','','0','jordanallan26@gmail.com'),('contact_buriton_village_hall','474','message','','0','Hi there \r\n\r\nMay I make bookings for the small hall on \r\n\r\nThe 6th and 13th novemeber 18.45-19.45 \r\nAlso the 4th December 18.45-19.45\r\n\r\nI did try online but I think I filled it out wrong ! \r\n\r\nThank you\r\n\r\nJordan '),('contact_buriton_village_hall','474','name','','0','Jordan Allan'),('contact_buriton_village_hall','474','your_telephone_number','','0','07769111765'),('contact','475','email','','0','nicola.merrett01@bbc.com'),('contact','475','message','','0','Hello,\r\n\r\nI hope this message finds you well. I''m writing from the BBC''s Countryfile programme where I''m currently developing an episode based on the South Downs. As it''s a dark skies region I''m interested in the connection between this and the people who live in the area and would love to find some nice community links. For example the people of Buriton being conscious of their use of lights and then also reaping the benefits via stargazing or use of the observatory. \r\n\r\nVery best wishes,\r\nNicola'),('contact','475','name','','0','Nicola Merrett'),('contact','475','your_telephone_number','','0','07725212957'),('contact','477','email','','0','robertcunninghamreid@yahoo.co.uk'),('contact','477','message','','0','Hi, on this Saturdat, I would like to walk the south downs way, starting at Buriton! Please can I park my car overnight at the town hall, or please can you recommend a suitable spot? Thanks you VERY MUCH, Robert\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','477','name','','0','robert cunningham-reid'),('contact','477','your_telephone_number','','0','07720294172'),('contact','478','email','','0','barry.faust@ntlworld.com'),('contact','478','message','','0','Dear Sir/Madam,\r\n                           Has Buriton PC considered directly or in partnership with a bordering parish council , employing a community/parish warden?\r\n\r\nIm aware of other similar sized parishes doing this with others in Sussex and wondered if you would ever consider this as i think having such a scheme could rewally benefit the people of Buriton.\r\n\r\nI know the local district council might be looking at having wardens and a private company that also offers this so the council has options.\r\n\r\nI also have examples of where this has been working for over 20 years in a small parish in Sussex.'),('contact','478','name','','0','Barry Faust'),('contact','478','your_telephone_number','','0','+447941616064'),('contact','479','email','','0','pcg@europe.com'),('contact','479','message','','0','Dear Sirs,\r\n\r\nRe supplier Introduction\r\n\r\nI would like to introduce Westbourne Garden Services, a private and commercial support service for Land and grounds maintenance. We undertake quoted or contract works for residents and / or businesses and offer strimming, brush cutting, clearing, mowing and maintenance service.\r\n\r\nI am currently looking to obtain supplier status for Care Homes, Parish Councils, Diocese and Local Authorities in the ground’s maintenance arena. \r\n\r\nIt would be greatly appreciated if you could offer guidance on the supplier registration process so that Westbourne Garden Services can tender opportunities in our chosen field.\r\n\r\nFor an overview of our services please visit   www.westbourneservices.com\r\n\r\nI would take this opportunity to thank you for your time and consideration.\r\n\r\nYours sincerely\r\n\r\nPatrick Cahill-Grant\r\n'),('contact','479','name','','0','patrick cahill-grant'),('contact','479','your_telephone_number','','0','02392002487');
INSERT INTO `webform_submission_data` VALUES ('contact','482','email','','0','aspinall.lucy@gmail.com'),('contact','482','message','','0','Hello, I am trying to find a contact for the bowls club and wondered if you could help, thanks a lot'),('contact','482','name','','0','Lucy Aspinall'),('contact','482','your_telephone_number','','0','07939215104'),('contact','483','email','','0','elizabeth.keeling@hants.gov.uk'),('contact','483','message','','0','Good morning,\r\n\r\nWe''d love to include some information in your newsletter about the funding we  are able to provide community groups and landowners to plant trees. Do you have an email address I can contact to send details?\r\n\r\nhttps://www.hants.gov.uk/hampshireforestpartnership\r\n\r\nRegards,\r\n\r\nLiz Keeling'),('contact','483','name','','0','Elizabeth Keeling'),('contact','483','your_telephone_number','','0','+447714170798'),('contact','485','email','','0','billnruth@btinternet.com'),('contact','485','message','','0','Where could a party of walkers park in Buriton?'),('contact','485','name','','0','William Hudson'),('contact','485','your_telephone_number','','0','01252 597111'),('contact_buriton_village_hall','486','email','','0','david@eskemoz.co.uk'),('contact_buriton_village_hall','486','message','','0','I hope you are doing well.\r\n\r\nWe are a UK based web design company and with your permission, I would like to send you a proposal for your website buriton.info.  \r\n\r\nMay I send the Proposal along with our company details?\r\n\r\nWarm regards,\r\nDavid Lightly\r\n'),('contact_buriton_village_hall','486','name','','0','David Lightly'),('contact_buriton_village_hall','486','your_telephone_number','','0','03333 444825'),('contact','487','email','','0','hughknight@aandapackaging.co.uk'),('contact','487','message','','0','Good Afternoon,\r\n \r\nWe are looking for a venue for a business event on the 22nd December from 11:00am – 6pm... is the full hall (including upper) available on this date?\r\nlooks fine on the online booking form... but just wanted to check.\r\n\r\nWe were planning on doing some BBQ steaks, are we allowed to use a bbq outside the hall?\r\n\r\nPlease confirm the cost of this.\r\nwith many thanks\r\nHugh.\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','487','name','','0','Hugh Knight'),('contact','487','your_telephone_number','','0','02392597792'),('contact_buriton_village_hall','488','email','','0','hughknight@aandapackaging.co.uk'),('contact_buriton_village_hall','488','message','','0','Good Afternoon,\r\n \r\nWe are looking for a venue for a business event on the 22nd December from 11:00am – 6pm... is the full hall (and upstairs) available on this date?\r\nApprox 20 persons.\r\nWe were thinking of doing BBQ steak, can we cook using a bbq outside the hall?\r\nPlease confirm the cost for this.\r\n\r\nLook forward to your response, before this gets booked out.\r\n\r\nMany thanks,\r\nHugh Knight | Operations Director\r\nA&A Packaging Horndean Hants PO8 9JX\r\n'),('contact_buriton_village_hall','488','name','','0','Hugh Knight'),('contact_buriton_village_hall','488','your_telephone_number','','0','02392597792'),('contact_buriton_village_hall','490','email','','0','missyshelly@msn.com'),('contact_buriton_village_hall','490','message','','0','Hi can you tell me what availability you would have for Tuesday 16th January in small hall please. Would be from 5pm to 8.30 pm approx for a 65th birthday party. Can you also send me prices for this and what it would include please thanks '),('contact_buriton_village_hall','490','name','','0','Michelle Francis'),('contact_buriton_village_hall','490','your_telephone_number','','0','07494788735'),('contact','491','email','','0','helengreen357@aol.com'),('contact','491','message','','0','Good afternoon\r\nI am researching my Paternal family tree and have found that my 2 x grandparents came from Buriton. Thomas Colwell and Jane Mullins, both born in 1828 although I believe Jane was born in Steep. I was wondering if you would have any records that mention these two. I know very little about the Colwell''s past history as my grandfather (Percy Colwell 1900 - 1971) appears to have been estranged from the family. I am happy to come and visit if you have records to go through. I would particularly like to find something of their lifestyle, what school they would have gone to, where they worked etc. \r\n\r\nwith Kind regards\r\n\r\nHelen Green (nee Colwell)');
INSERT INTO `webform_submission_data` VALUES ('contact','491','name','','0','Helen Green'),('contact','491','your_telephone_number','','0','07810352646'),('contact','493','email','','0','office@easthantsconservatives.com'),('contact','493','message','','0','Hi - I am wondering if you might have availability for  us to hold a members meeting at your hall on Thursday 1st February from 6.30pm.  This will probably be for around 2 hours.\r\nAlso I wanted to check there was plenty of car parking space.\r\nI look forward to hearing from you\r\nBest wishes\r\n\r\nTracey'),('contact','493','name','','0','Mrs Tracey Anderson'),('contact','493','your_telephone_number','','0','01420 84122'),('contact','494','email','','0','tanyacarolfoord@yahoo.co.uk'),('contact','494','message','','0','Hello, I have just listened to the podcast on shine radio, with regards to the crafty volunteers for theproject on making sanitary items for the young ladies in Africa, I am keen to help on this project. I am about to open (on 6th Feb) Twillys alterations and repairs. I would love to get involved in such a worthy project, and here are some ways I could help, I have lots of fabric (not certain what fabrics exactly you need but I am sure i could help a little there somehow). I have a large space upstairs from the shop, that could be used for gatherings to meet and sew (including use of several sewing machines). If someone would like to give me a ring anytime ( except Monday and Wednesday of next week) I would love to chat and see where I could help and offer my services. Tanya'),('contact','494','name','','0','Mrs Tanya C Wilkinson'),('contact','494','your_telephone_number','','0','07713282461'),('contact','498','email','','0','jasgalloway15@gmail.com'),('contact','498','message','','0','Hi,\r\nI wonder if the hall is free on Saturday 30/3/24 for a child’s birthday party?\r\nIf you could give me a call that would be great.\r\n Kind regards,\r\nJas Galloway\r\n'),('contact','498','name','','0','Jas Galloway'),('contact','498','your_telephone_number','','0','07791513110'),('contact','505','email','','0','rdvoot@hotmail.com');
INSERT INTO `webform_submission_data` VALUES ('contact','505','message','','0','Please could we attend the meeting on Saturday 23rd March. Fascinating world of Lichens. \r\nRegards Richard and Dawn '),('contact','505','name','','0','Dawn Sibley '),('contact','505','your_telephone_number','','0','0784396784'),('contact','509','email','','0','horndeanunitedfc@gmail.com'),('contact','509','message','','0','Afternoon,\r\n\r\nMy name is Lewis Charlton & i am the secretary/Development officer at Horndean United FC. We are currently looking into pitch options & at a recent committee meeting Buriton recreation but also the parish as a whole was mentioned as somewhere we would look to see if there were any viable options. Would there be a contact i could have an informal discussion with to discuss?\r\n\r\nLook forward to your reply\r\n\r\nRegards\r\n\r\nLewis '),('contact','509','name','','0','Lewis Charlton'),('contact','509','your_telephone_number','','0','07788775051'),('contact','523','email','','0','annmarden7@gmail.com'),('contact','523','message','','0','Hi\r\nDid you want to advertise for free your events on our event page at shine radio? I can see you have events in the year that might be fun to mention? I can give you a login if you would like Just need name of person in charge, email address. \r\nAnn '),('contact','523','name','','0','Ann Marden'),('contact','523','your_telephone_number','','0','07958 291769'),('contact','559','email','','0','yogastacey@hotmail.co.uk'),('contact','559','message','','0','Hello,\r\n\r\nLike to find out more about the lichen talks. We live in Buriton.\r\n\r\nMant thanks '),('contact','559','name','','0','Stacey Black'),('contact','559','your_telephone_number','','0','07788580810'),('contact','560','email','','0','dennishok@outlook.com'),('contact','560','message','','0','कुशल और विश्वसनीय पावर लाइन ग्लास इंसुलेटर्स। सालाना 4 मिलियन पावर-लाइन इंसुलेटर्स की उत्पादन क्षमता। \r\n \r\nउच्च गुणवत्ता वाले पावर लाइन्स ग्लास इंसुलेटर्स की व्यापक रेंज \r\n \r\n- विभिन्न आकारों के ग्लास शेल्स और पिन इंसुलेटर्स सहित व्यापक चयन। \r\n- अंतरराष्ट्रीय प्रयोगशालाओं द्वारा प्रमाणित गुणवत्ता और पावर इंजीनियरों द्वारा विश्वसनीय। \r\n- ग्लास इंसुलेटर्स की दुनिया में अतुलनीय गुणवत्ता के लिए प्रतिस्पर्धी मूल्य निर्धारण। \r\n \r\nहमारे विशेषीकृत ग्लास इंसुलेटर्स में से चुनें: \r\n \r\nFog Type Profile, Open Profile, PSD, ShS, Standard Profile \r\nU70BLP, U120BP, U160BLP, U160BSP \r\n \r\nहमारे विश्व स्तरीय उत्पादन मानकों और प्रतिस्पर्धी मूल्य निर्धारण हमें आपकी आदर्श पसंद बनाते हैं। \r\n \r\nकोई प्रश्न हो, यहाँ पूछें: \r\n \r\nhttp://ito.mx/N5e7 \r\n \r\n------------------------------------------------- \r\n \r\nHV Glass Insulators \r\n \r\nEfficient and reliabile power line glass insulators. Production capacity of 4 million power-line insulators annually. \r\n \r\n \r\nWide Range of High-Quality Power Lines Glass Insulators \r\n \r\nBroad selection including various shapes of glass shells and pin insulators. \r\nCertified quality by international laboratories and trusted by power engineers. \r\nCompetitive pricing for unmatched quality in the world of glass insulators. \r\n \r\nChoose from our specialized glass insulators for sale: \r\n \r\nFog Type Profile, Open Profile, PSD, ShS, Standard Profile \r\nU70BLP, U120BP, U160BLP, U160BSP \r\n \r\n \r\nOur world-class production standards and competitive pricing make us your ideal choice. \r\n \r\nAny questions, ask here: http://ito.mx/N5e7');
INSERT INTO `webform_submission_data` VALUES ('contact','560','name','','0','DennisDag'),('contact','560','your_telephone_number','','0','81483353247'),('contact_buriton_village_hall','562','email','','0','ccengland@live.co.uk'),('contact_buriton_village_hall','562','message','','0','good morning. i would like to speak to some one about the possibility of the hire of your green space long term \r\nthis could bring money to the village hall and the local pubs / shops . if some one could give me a call please.'),('contact_buriton_village_hall','562','name','','0','chris england'),('contact_buriton_village_hall','562','your_telephone_number','','0','+447704024492'),('contact','565','email','','0','rdvoot@hotmail.com'),('contact','565','message','','0','I haven''t heard, wandering if we are allowed to attend this event , for next weekend. '),('contact','565','name','','0','Dawn Sibley '),('contact','565','your_telephone_number','','0','07843967847'),('contact','566','email','','0','juan.mulley@yahoo.com'),('contact','566','message','','0','Struggling to Launch Your Online E-commerce Store?\r\nMissing out on potential sales and customers? Building a successful eCommerce site can be complex and time-consuming.\r\nTransform Your Business with Expert eCommerce Development at affordable prices!\r\n\r\n>> Benefits:\r\n> Customized Online Stores\r\n> Seamless User Experience\r\n> Boosted Sales and Conversions\r\n\r\n>> Ready to create an E-Commerce store? Start Today!\r\nClick here >> https://outsource-bpo.com/website/?src=m14buriton.info\r\n\r\nDon''t let eCommerce challenges hold you back. Launch a powerful online store with our expert eCommerce development services!'),('contact','566','name','','0','Mike Mulley'),('contact','566','your_telephone_number','','0','478 8545'),('contact_buriton_village_hall','570','email','','0','lucyking51@yahoo.co.uk'),('contact_buriton_village_hall','570','message','','0','Hello,\r\nI am looking to book the village hall for my daughters birthday on June 15th 10-2. Do you have availability for this?\r\n\r\nThank you \r\nLucy'),('contact_buriton_village_hall','570','name','','0','Lucy Jayne Rogan');
INSERT INTO `webform_submission_data` VALUES ('contact_buriton_village_hall','570','your_telephone_number','','0','07557689353'),('contact','580','email','','0','notsohappy234@gmail.com'),('contact','580','message','','0','If you''re a content creator, it''s essential to stay ahead in the fast-evolving digital landscape, and \r\n\r\nAI tools are the game changers you can''t afford to miss. Imagine transforming your creative process with the top five AI tools designed specifically for content creation. \r\n\r\nThese cutting-edge tools harness the power of artificial intelligence to revolutionize everything from idea generation to content optimization, making your workflow more efficient and your content more engaging. arktickuno.com\r\n\r\nWhether you''re a writer, marketer, or multimedia artist, embracing these AI innovations will not only save you time but also elevate the quality and impact of your work. \r\n\r\nDon''t let the digital wave overtake you; dive into the future of content creation with these must-have AI tools!\r\n\r\narktickuno.com\r\n'),('contact','580','name','','0','Kevin James'),('contact','580','your_telephone_number','','0','357592648'),('contact','582','email','','0','beltrance@gmail.com'),('contact','582','message','','0','Hi, it''s the hall available next Sunday?\r\nCheers!'),('contact','582','name','','0','Carlos Beltran '),('contact','582','your_telephone_number','','0','07870372008'),('contact_buriton_village_hall','586','email','','0','elinor.newman@southdowns.gov.uk'),('contact_buriton_village_hall','586','message','','0','Hello\r\n\r\nWe are organising a walk for a group of up to 150 people along the South Downs Way, and looking for somewhere to pause for lunch, with facilities.  The date is Sunday 19 May.  We may also look at engaging a caterer to supply teas and coffees in the hall.  Please could you confirm whether the hall is available (it appears so on the calendar), and how much it would cost to hire it.\r\n\r\nPlease let me know if you need any further information at this point.\r\n\r\nKind regards\r\nElinor');
INSERT INTO `webform_submission_data` VALUES ('contact_buriton_village_hall','586','name','','0','Elinor Newman'),('contact_buriton_village_hall','586','your_telephone_number','','0','07775770909'),('contact_buriton_village_hall','588','email','','0','the_gurneys@yahoo.com'),('contact_buriton_village_hall','588','message','','0','Hello, I live in Greenway Lane and am a member of the Petersfield Beekeepers. We are raising awareness of the Asian Hornet, which hopefully you have heard about. It''s  a non native invasive insect which predates on honey bees and other insects. I noticed that outside the village hall main entrance there is a locked notice board. If possible, I''d like to put an A4 poster showing how to identify and what to do if someone thinks they have seen one.\r\nI hope this is acceptable, many thanks.\r\nPhil Gurney'),('contact_buriton_village_hall','588','name','','0','Phil Gurney'),('contact_buriton_village_hall','588','your_telephone_number','','0','07940832590'),('contact','592','email','','0','allan.muir@btclick.com'),('contact','592','message','','0','Whilst the website is very well presented, there is a problem viewing it on my android mobile phone. The website menu button in the top right hand corner is completely hidden by the Accessibility button!'),('contact','592','name','','0','Allan Muir'),('contact','592','your_telephone_number','','0','07950646265'),('contact','602','email','','0','gm@ensolvesolutions.com'),('contact','602','message','','0','Hello,\r\n\r\nI would like to know whether the club has plans to update its floodlights to LED - if you have not already done so.\r\n\r\nEnsolve Solutions are an ILP member, and we provide sports, commercial and industrial lighting to clients in the UK and Europe including LTA members, various sports clubs, Airbus, Toyota, Ikea and Vinci Facilities.\r\n\r\nWe can offer a huge variety of low-glaring sports lights with specially designed linear asymmetric optics which provide superb uniformity. We also provide excellent tailor-made control management systems. Our rates are very competitive, and we pride ourselves on our customer service. \r\n\r\nAs you know, LED lights represent a quantum leap in lighting design. They are much more sustainable (less overall power needed), switch on immediately, offer a substantially longer design life with low maintenance (no lamp replacements) and superior control systems with an ability to dim the lights. Replacement bulbs for halide lights are becoming harder and harder to source.\r\n\r\nWe can also quote for installation of masts and cabling on any courts that are currently unlit.\r\n\r\nWe would be very happy to arrange a visit and discuss what we could offer.\r\n\r\nKind regards,\r\nKetan Karia\r\nBusiness Development Manager\r\nEnsolve Solutions Ltd.\r\n\r\nEmail: gm@ensolvesolutions.com\r\nTel: +44 203 445 0543\r\nTel: +44 7552 995 256 \r\nwww.ensolvesolutions.com');
INSERT INTO `webform_submission_data` VALUES ('contact','602','name','','0','Ketan Karia'),('contact','602','your_telephone_number','','0','07552 995 256'),('contact','614','email','','0','johawkes1@gmail.com'),('contact','614','message','','0','Hi there, we are thinking of moving to Buriton and just wondering if the Toddler group is still going there? Many thanks, \r\n Jo'),('contact','614','name','','0','Jo Hawkes'),('contact','614','your_telephone_number','','0','07856364204'),('contact','618','email','','0','megan@merlinestates.co.uk'),('contact','618','message','','0','Hello, we are looking for a venue to hold an AGM for up to 200 people. Do you have the capacity to hold this many people in the village hall? '),('contact','618','name','','0','Megan Hyland'),('contact','618','your_telephone_number','','0','03330 917137'),('contact','621','email','','0','Catherine@content.gocompare.com'),('contact','621','message','','0','Hi,\r\n\r\nAccording to the Environment Agency, over two million people in England live and work in properties at risk of flooding from rivers or the sea, whilst more face flood threats from groundwater, surface water, sewers, and reservoirs.\r\n\r\nAt Gocompare, we have put together a guide to preparing for a flood and protecting your property - https://www.gocompare.com/household-tips/limiting-flood-risk-and-damage/\r\n\r\nIn extreme conditions you won''t be able to stop flood water, and you should always put personal safety above attempts to protect property and possessions. Despite this, there are steps that you can take to keep water out, to buy yourself time to preserve property and possessions, and to limit the damage that flood water does.\r\n\r\nWe think this information would be useful for your readers and wonder if you would consider linking to our guide at your page http://www.buriton.info/news/buriton_village_hall/flooding_buriton_village_hall\r\n\r\nThank you for your support, we''re extremely grateful.\r\n\r\nKind regards,\r\nCatherine Bailey\r\nPublisher Partner Manager \r\n\r\n'),('contact','621','name','','0','Catherine Bailey');
INSERT INTO `webform_submission_data` VALUES ('contact','621','your_telephone_number','','0','01'),('contact','627','email','','0','Catherine@content.gocompare.com'),('contact','627','message','','0','Hi,\r\n\r\nHope you are well.\r\n\r\nI was just wondering if you had enough time to consider our request.\r\n\r\nI would be grateful for any feedback.\r\n\r\nStay safe and healthy!\r\n\r\nKind Regards, \r\n'),('contact','627','name','','0','Catherine Bailey'),('contact','627','your_telephone_number','','0','01'),('contact','635','email','','0','annie@verdegardendesign.co.uk'),('contact','635','message','','0','Hi,\r\nWe live in Ramsdean and are holding a family party in our garden on Saturday 8th June. We wondered if it is possible to hire tables and chairs from you? Ideally we are after 75 chairs and 10 tables or there about.\r\nAll the best,\r\nAnnie Chapman 07951 697645\r\n'),('contact','635','name','','0','annie'),('contact','635','your_telephone_number','','0','07951697645'),('contact','654','email','','0','lionandunicornplayers@gmail.com'),('contact','654','message','','0','Good evening, \r\nThe Lion & Unicorn Players would like to take a touring production around the villages in and around Petersfield, and I wondered if you could let me know if the village hall is available for hire on any of the following dates: \r\n\r\n November 18-23\r\n\r\nMany thanks\r\nLaura'),('contact','654','name','','0','Laura Sheppard'),('contact','654','your_telephone_number','','0','07400 409744'),('contact','655','email','','0','tracyhorsted@hotmail.co.uk'),('contact','655','message','','0','I''m contacting you on behalf of the Year 6 parents at Buriton Primary School.  It falls upon the Year 6 parents every year to organise the Summer Fair, which this year will be held on Saturday 29th June 2024, 12-3pm, at the recreation ground and Village Hall.  I''d be very grateful if this could be added to your events pages.  I''m happy to provide further information about the Summer Fair if required.\r\nMany thanks\r\nTracy Horsted'),('contact','655','name','','0','Tracy Horsted'),('contact','655','your_telephone_number','','0','07786271600');
INSERT INTO `webform_submission_data` VALUES ('contact','741','email','','0','Catherine@content.gocompare.com'),('contact','741','message','','0','Hi,\r\n\r\nI haven’t heard from you since I sent my emails over a few weeks ago.  \r\n         \r\nCould you please forward me to the person/department who can consider our request?\r\n\r\nThank you and look forward to hearing from you soon.\r\n\r\nKind Regards,\r\n'),('contact','741','name','','0','Catherine Bailey'),('contact','741','your_telephone_number','','0','01'),('contact','750','email','','0','rosiemaett@outlook.com'),('contact','750','message','','0','Hi there I''m trying to book with you please for a wake on the 1st July please for about 11:30 please?\r\nMany thanks \r\nRosie Thornton '),('contact','750','name','','0','Rosie '),('contact','750','your_telephone_number','','0','07581486532'),('contact_buriton_village_hall','764','email','','0','info@thorntonsbuilders.com'),('contact_buriton_village_hall','764','message','','0','Hi there, we have the hall booked for Monday 1st January but we have been unable to open your e-mail. Tried to e-mail you back but it just bounced back to us! We need to pay you for the hall. \r\nkind regards\r\nFrog 07825 271 865\r\n'),('contact_buriton_village_hall','764','name','','0','Clive Thornton'),('contact_buriton_village_hall','764','your_telephone_number','','0','07825 271 865'),('contact_buriton_village_hall','765','email','','0','info@thorntonsbuilders.com'),('contact_buriton_village_hall','765','message','','0','Hi there, we have the hall booked for Monday 1st January but we have been unable to open your e-mail. Tried to e-mail you back but it just bounced back to us! We need to pay you for the hall. \r\nkind regards\r\nFrog 07825 271 865\r\n'),('contact_buriton_village_hall','765','name','','0','Clive Thornton'),('contact_buriton_village_hall','765','your_telephone_number','','0','07825 271 865'),('contact_buriton_village_hall','794','email','','0','info@juliawillmott.com'),('contact_buriton_village_hall','794','message','','0','hi there\r\nIs your hall available please for a one off hire for my dance fitness class, as our usual venue isn''t available?\r\nIt''s for Wed 10 July, preferably 7pm to 8pm but have some flexibility. \r\nMany thanks\r\nJulia ');
INSERT INTO `webform_submission_data` VALUES ('contact_buriton_village_hall','794','name','','0','Julia Willmott'),('contact_buriton_village_hall','794','your_telephone_number','','0','07786550873'),('contact','830','email','','0','allenjosephlife@gmail.com'),('contact','830','message','','0','Hello ,\r\n \r\nI saw your website www.buriton.info  and it''s impressive. I wonder if advertising options like guest post, ad content are available on your site?\r\nWhat''s the price if we want to advertise on your site?\r\nNote : Article must not be any mark as  sponsored or advertised or like that and we can only pay by paypal.\r\n\r\nCheers\r\nAllen joseph \r\n'),('contact','830','name','','0','Allen'),('contact','830','your_telephone_number','','0','8668786868868'),('contact','848','email','','0','doug.pam@btinternet.com'),('contact','848','message','','0','Just testing that these messages come to me.  Doug'),('contact','848','name','','0','Doug Jones'),('contact','848','your_telephone_number','','0','01730 231326'),('contact','856','email','','0','carys@climberswaytreecare.co.uk'),('contact','856','message','','0','Afternoon, \r\n\r\nHope all is well. \r\n\r\nClimbers Way Tree Care have been working successfully within frameworks for many years and we are keen to explore the possibilities of working for other local councils.   \r\n\r\nWe currently work with Winchester Council, Fareham Borough Council, Chichester Council, Oxfordshire County Council and other local parish councils on a regular basis. Providing tree safety audits which involve our surveyors visiting sites to plot and record trees with potential defects, and produce a report/maintenance plan.\r\n\r\nWe understand that each council handles their tree work differently. Could you please inform me if there is a framework we can tender for in the future, or if we can price individual projects? \r\n\r\nIf you have any questions or queries please don''t hesitate to contact us. We look forward to hearing from you!'),('contact','856','name','','0','Carys Lockyer'),('contact','856','your_telephone_number','','0','02380361062');
INSERT INTO `webform_submission_data` VALUES ('contact','869','email','','0','clangfordathome@googlemail.com'),('contact','869','message','','0','i am walking the Hangers Way on Wednesday 24th July. Would I be able to park two vehicles from about 9:00AM to 3:00PM, I will post a donation through your letterbox?\r\n'),('contact','869','name','','0','Christopher Langford'),('contact','869','your_telephone_number','','0','07801666140'),('contact_buriton_village_hall','872','email','','0','mariasharipo@gmail.com'),('contact_buriton_village_hall','872','message','','0','Hello,\r\n\r\nMy name is Maria and I am writing on behalf of Southern Ceramics Group, we are interested in booking your hall for a day on the Saturday, the 12th of October. This would need to be for the whole day 9-5pm. This is for a lecture and a demonstration by a ceramics artist. \r\n\r\nCould you please let us know if that would be possible \r\n\r\nRegards\r\n\r\nMaria '),('contact_buriton_village_hall','872','name','','0','Maria'),('contact_buriton_village_hall','872','your_telephone_number','','0','07838998516'),('contact','875','email','','0','slackjack@btinternet.com'),('contact','875','message','','0','Would you be kind enough to remove the Cricket Club from the groups list please.  There is no chance that it will resurrect in it''s current form. Many thanks. Peter Nixon. Former fixtures secretary.'),('contact','875','name','','0','Peter Nixon'),('contact','875','your_telephone_number','','0','01730269034'),('contact','878','email','','0','4rosemaryclark@gmail.com'),('contact','878','message','','0','Hi Doug\r\nWhilst hunting in our attic I found a Jubilee Celebration book called Percy’s Poems. It is a collection of works put together by Percy Legg in 1977 but written over a long period prior to that. I wondered whether if you do not have a copy you might at least like to have a look at it.\r\nHope all goes well with you. Best wishes Rosemary Clark'),('contact','878','name','','0','Rosemary Clark'),('contact','878','your_telephone_number','','0','01730267058'),('contact','886','email','','0','clumbsytheclown@gmail.com');
INSERT INTO `webform_submission_data` VALUES ('contact','886','message','','0','Dear Town Clerk\r\n\r\nI am writing to you to offer my entertainment services for your upcoming events.\r\n\r\nI have been a full time family entertainer for over 30 years. I also have performed in circuses all over the world, including Billy Smart''s Circus and The Hungarian State circus in Budapest. In 2008 I won awards for my performances. Then whilst on tour with Fossett''s Circus in Ireland I performed for the President of Ireland, Mary Macaless in her home. I have also performed for a great number of celebrity clients, high profile businesses and tourist attractions.\r\n\r\nI now perform multiple high energy family shows, which incorporate crazy music and sound effects, with loads of comedy and tv special effects, including radio remote control puppets and props. I make all of my own comedy props and choreograph my routines, so they’re guaranteed to be something really different, each of my shows feature multiple reveals and comedy surprises throughout the performance.\r\n\r\nEach of my shows deliver a cartoon experience, I currently perform my cartoon magic show, superhero magic show, pirate show, halloween shows, easter show and Christmas shows which are perfect for public family events.\r\n\r\nI am also a skilled balloon modeller that entertains the crowds.\r\n\r\nAlso available with walk around comedy characters.\r\n\r\nPlease check out my website\r\n\r\nI look forward to hearing from you.\r\n\r\nLloyd Reed\r\n\r\nClumsy Entertainment\r\n\r\nContact number\r\n\r\n07786467312\r\n\r\nwww.clumsyentertainment.com'),('contact','886','name','','0','LLOYD rEED'),('contact','886','your_telephone_number','','0','07786467312'),('contact','888','email','','0','info@rmwinscom.co.uk'),('contact','888','message','','0','Good afternoon,\r\n\r\nI am emailing in respect to the overhanging trees along Ramsdean Lane and Weston Lane. There has been no maintenance to the HCC hedges for years and its now so overgrown some hit the top of my pickup. \r\n\r\nOn Saturday 27/07/24 while moving the combine for harvest, we hit a tree branch on Ramsdean Lane, it has bent the rear steps and hand rail which will cost thousands to replace. Weston Lane is so overgrown we cant even take the combine to the farm and the HGV lorries are often having damage caused to them. \r\n\r\nCan you please also contact HCC and get a urgent message to them to get this cut back so we can access the farm and fields we need to. I will be returning in two weeks with the combine so this needs to be address urgently. \r\n\r\nMany thanks,\r\nMark Rowden,\r\nR.M Winscom Ltd,\r\nWeston Farm ');
INSERT INTO `webform_submission_data` VALUES ('contact','888','name','','0','Mark Rowden'),('contact','888','your_telephone_number','','0','07917855750'),('contact','970','email','','0','liz@burridgeclan.co.uk'),('contact','970','message','','0','I would like to know who to contact re a table at the next arts trail day'),('contact','970','name','','0','Maryann Burridge'),('contact','970','your_telephone_number','','0','07979864667'),('contact','986','email','','0','bluenilejan@gmail.com'),('contact','986','message','','0','Hello\r\nI have just tried calling to enquire about your hall hire and gauge if it can have bouncy castles etc .\r\nThe date is the 3rd November from about 2:30 till 6 /6:30pm. Many thanks \r\nMany '),('contact','986','name','','0','Julia'),('contact','986','your_telephone_number','','0','07884477330'),('contact','996','email','','0','gillthom@gmail.com'),('contact','996','message','','0','Hi - I''m moving to the Village in mid October to a house in Petersfield Road and I wondered if there was a village Whatapp group or something where you could ask local people for recommendations on things such as cleaners, decorating companies, builders etc? \r\nthanks\r\nkind regards\r\n\r\nGill'),('contact','996','name','','0','Gill Thom'),('contact','996','your_telephone_number','','0','07973223179'),('contact_buriton_village_hall','1008','email','','0','h.sparrowhawk10@gmail.com'),('contact_buriton_village_hall','1008','message','','0','Hi\r\nI am enquiring as to the price of the village hall to hire for an hour weekly.  I am thinking of running a cardio dance class for over 40’s.  \r\nWould you know the size of the hall please And the availability please\r\n\r\nKind regards \r\n\r\nHelen'),('contact_buriton_village_hall','1008','name','','0','Helen Sparrowhawk '),('contact_buriton_village_hall','1008','your_telephone_number','','0','07963156713'),('contact_buriton_village_hall','1032','email','','0','Caralane1111@gmail.com'),('contact_buriton_village_hall','1032','message','','0','Hi how big is the small room?'),('contact_buriton_village_hall','1032','name','','0','Cara Laffoley-Lane');
INSERT INTO `webform_submission_data` VALUES ('contact_buriton_village_hall','1032','your_telephone_number','','0','07446571871'),('contact','1034','email','','0','burnettsfunfair@gmail.com'),('contact','1034','message','','0','Good afternoon I wonder if you can help me my name is Becky from burnetts fun fair we use to attend buriton for there fire works display with are fun fair equipment and was just wondering if there are planning have it returned this year and who I would speak to regarding this many thanks \r\nBecky '),('contact','1034','name','','0','Becky burnett'),('contact','1034','your_telephone_number','','0','07488310279'),('contact','1040','email','','0','graham.hill@alton.gov.uk'),('contact','1040','message','','0','Perhaps you can help me. I am a Town Councillor on Alton Town Council for the Holybourne ward. Some residents are interested to informally explore the possibility of Holybourne becoming a Parish Council. I understand that you went through this process a few years ago so I would like to have a chat/meeting with someone who could help me understand what is involved. Many thanks Cllr Graham Hill (I am also an EHDC District Councillor for the same ward)'),('contact','1040','name','','0','Cllr Graham Hill'),('contact','1040','your_telephone_number','','0','07745837772'),('contact','1041','email','','0','h.sparrowhawk10@gmail.com'),('contact','1041','message','','0','Hi\r\nI am looking to hire a hall weekly and ideally a Thursday evening and wondered what your hall availability and hire costs are please.\r\n\r\nKind regards \r\n\r\nHelen'),('contact','1041','name','','0','Helen Sparrowhawk '),('contact','1041','your_telephone_number','','0','07963156713'),('contact','1049','email','','0','lauradani467@gmail.com'),('contact','1049','message','','0','Hi, I am a student at Sussex University, I am in my 3rd year and I''m writing my dissertation on chalk formations in the South Downs. I want to collect samples of chalk from the Buriton Chalk pits I was wondering who I contact to make this possible.\r\nThank you,\r\nLaura Dani\r\n'),('contact','1049','name','','0','Laura Dani');
INSERT INTO `webform_submission_data` VALUES ('contact','1049','your_telephone_number','','0','07519881232'),('contact','1075','email','','0','evaisabelashford@gmail.com'),('contact','1075','message','','0','Hello,\r\nI am hoping to be able to be part of the Christmas fair this year. If there is any space for me to have my own art print and Christmas decoration stall that would be amazing. I would be happy to help in set up and running. \r\nBest wishes \r\nEva'),('contact','1075','name','','0','Eva Mueller'),('contact','1075','your_telephone_number','','0','07341551158'),('contact','1114','email','','0','fkbond52@btinternet.com'),('contact','1114','message','','0','Can you advise if Buriton Manor is open to the public at all please and, if so, whom I might contact to find out more eg opening times next year?'),('contact','1114','name','','0','Keith Bond'),('contact','1114','your_telephone_number','','0','07990 703512'),('contact','1120','email','','0','j.eades@buriton.hants.sch.uk'),('contact','1120','message','','0','Hi, The telephone number for Buriton Primary School has changed to 01730 642070.  Please could you kindly update your records on your website.\r\n\r\nMany thanks, Joanna'),('contact','1120','name','','0','Joanna Eades'),('contact','1120','your_telephone_number','','0','01730642070'),('contact','1121','email','','0','lmdarrand@googlemail.com'),('contact','1121','message','','0','Hi, I am moving to Buriton in the near future and am trying to find information on a school bus to The Petersfield School, that someone in the pub mentioned. Do you have any information on that, please?'),('contact','1121','name','','0','Lisa Darrand'),('contact','1121','your_telephone_number','','0','07935288270'),('contact','1123','email','','0','s.bone@pwp-architects.com'),('contact','1123','message','','0','We are architects to a planning application in the Parish at Maple Durham House, GU32 3NJ. We submitted the application to SDNP on 1st October and they have took until 8th November to validate the application. We would welcome the chance of meeting the parish council either through the full meeting on 25th November or to the planning committee (but we can see no future dates for these events). The reference number for the application is SDNP/24/04023/FUL. I''d be grateful to receive an initial telephone call to discuss this matter. Many thanks   ');
INSERT INTO `webform_submission_data` VALUES ('contact','1123','name','','0','stuart bone'),('contact','1123','your_telephone_number','','0','07745 309387'),('contact','1149','email','','0','tg.reynolds@btinternet.com'),('contact','1149','message','','0','Please, when are the dates for council meetings for 2025.\r\nmany thanks'),('contact','1149','name','','0','Tim Reynolds'),('contact','1149','your_telephone_number','','0','07848 455993'),('contact_buriton_village_hall','1154','email','','0','cubleader@1stpetersfieldscouts.org.uk'),('contact_buriton_village_hall','1154','message','','0','Hey, we are looking to hire the hall for a sleepover for Cubs/Scouts on 7th March until 8 March. Please could you let me know if you have any availability.\r\n\r\nThanks\r\n\r\nDeanna\r\nCub Section Leader'),('contact_buriton_village_hall','1154','name','','0','Deanna O’Brien'),('contact_buriton_village_hall','1154','your_telephone_number','','0','07403039976'),('contact','1155','email','','0','Jessica@jwilson.org.uk'),('contact','1155','message','','0','Hello, we are looking for a venue for my Son''s wedding reception on Saturday 17th May 2025. Please will you advise whether your hall is available and if so the hire fees from Friday afternoon(for set up) until Sun am. Also, please advise whether you have tables, chairs crockery glasses etc.sound system. Many thanks for your help. Kind regards,\r\nJessica'),('contact','1155','name','','0','Jessica Wilson'),('contact','1155','your_telephone_number','','0','0790957391576'),('contact','1156','email','','0','rab@abishopandson.co.uk'),('contact','1156','message','','0','Good morning.\r\n\r\nLooking for a venue to stream our WI AGM on Wednesday June 4th -.9 - 5 approx times.\r\nDo you have a screen/Wifi to do this?\r\n\r\nmany thanks Rosemary'),('contact','1156','name','','0','Rosemary Bishop'),('contact','1156','your_telephone_number','','0','01730823520'),('contact_buriton_village_hall','1158','email','','0','luxorganic2023@gmail.com'),('contact_buriton_village_hall','1158','message','','0','Hi there. I would be interested in hiring your premises for a pop up vegan supper and/or possible lunch venue. I work out of the kitchen 2 days a week in South Harting Stores where I sell my products and am a fully trained chef. Please may I have an appointment to see around, discuss the above and get rates. Good luck with your new building, it looks amazing. Kind regards Pete');
INSERT INTO `webform_submission_data` VALUES ('contact_buriton_village_hall','1158','name','','0','Pete Lurie'),('contact_buriton_village_hall','1158','your_telephone_number','','0','07860691081'),('contact','1159','email','','0','michelle.monaghan@farnhamherald.com'),('contact','1159','message','','0','I''m from the Petersfield Post and would like to do a story about the latest stage of improvements that have been made to Buriton Village Hall. Who would be the best person to speak to about it?'),('contact','1159','name','','0','Michelle Monaghan'),('contact','1159','your_telephone_number','','0','07376 044 997‬'),('contact','1161','email','','0','helen.skelton-smith@hiwwt.org.uk'),('contact','1161','message','','0','Hi, \r\nI''m hoping you will find this news story about Coulters Dean Nature Reserve, which is located near Buriton, of interest. \r\nMany thanks,\r\nHelen\r\n\r\n\r\nPress Release\r\n\r\nFor Immediate Release: January 28, 2025 \r\n\r\nWildlife wins big: Local nature reserve expands thanks to supporters\r\n\r\nHampshire & Isle of Wight Wildlife Trust is delighted to announce the expansion of Coulters Dean Nature Reserve, made possible by a generous gift left in a Will and a £50,000 donation from Southern Co-op. \r\n\r\nThis funding has enabled the Trust to almost double the size of the reserve and increase the amount of chalk grassland by four times, transforming its ability to protect one of the UK’s rarest habitats.\r\n\r\nThe expanded Coulters Dean, which is located near Buriton in Hampshire, will safeguard extraordinary wildlife, from dazzling butterflies to beautiful wildflowers including 11 species of wild orchid such as the rare Bee and Fly orchids. This fragile habitat, with its vibrant wildflowers, butterflies, and birdlife, is a haven of biodiversity that will now thrive for generations to come.\r\n\r\nThe newly acquired land, previously intensively farmed, is already showing signs of recovery. Under careful management, it will become a flourishing extension of the reserve, reconnecting fragmented habitats and creating vital corridors for wildlife. \r\n\r\nDebbie Tann MBE, Chief Executive of Hampshire & Isle of Wight Wildlife Trust, said: “The expansion of Coulters Dean has been a long-held ambition for many years. This is not just a triumph for conservation but a beacon of hope for some of the UK’s most threatened species.\r\n\r\n“Thanks to the generosity of our members, Southern Co-op and the vision of those who left a gift in their Will, Coulters Dean will now remain a sanctuary where nature can flourish. This investment ensures a brighter, more connected future for wildlife across Hampshire.\r\n\r\n"The Trust would also like to thank the Barnett family at Buriton Estates for their positive engagement during this process, and we look forward to continuing to work together in the years ahead."\r\n\r\nSouthern Co-op, who have supported the Trust as corporate partners for the past 15 years, donated £50,000 to make the land purchase dream a reality. This latest donation, which is in addition to the existing funding the company provides for the Trust’s Wilder Communities initiative, came as part of Southern Co-op’s 150-year anniversary celebrations in 2023/24.\r\n\r\nMark Smith, CEO of Southern Co-op said: “We’re thrilled to have contributed to this vital land purchase, which not only protects a haven for nature and wildlife to flourish but also reinforces our commitment to addressing the climate and nature recovery imperative. By safeguarding these ecosystems, we’re investing in a healthier planet for future generations - a responsibility businesses must embrace. Together, we’re proving that economic success and environmental stewardship go hand in hand.”\r\n\r\nDebbie Tann MBE added: “We’re hugely grateful for our brilliant partnership with Southern Co-op. Corporate partners and members have a major role to play in nature’s recovery and Southern Co-op set a great example for others to follow.” \r\n\r\nChalk grassland is an internationally rare and ecologically significant habitat, found only in north-west Europe. Half of the world’s chalk grassland is located in the UK, with a significant portion nestled within the warm and dry southern counties of England. With as many as 40 plant species in every square metre, it has vastly more biodiversity than the other type of grassland in the country. 35 of Britain''s 56 butterfly species are found on chalk grassland.  \r\n\r\nAt Coulters Dean Nature Reserve, this precious habitat flourishes alongside areas of broadleaved woodland. Classified as a Site of Special Scientific Interest (SSSI), the reserve highlights the vital role Hampshire plays in safeguarding chalk grassland’s exceptional biodiversity. \r\n\r\nTo learn more about corporate support of Hampshire & Isle of Wight Wildlife Trust, visit hiwwt.org.uk/wildlife-supporters \r\n\r\n\r\n---- Ends ----\r\n\r\nImages: You are welcome to use the images in this PIXIESET gallery. Please note that the images are for one-off use only in connection to this story. Please credit all images where appropriate to file name. DOWNLOAD PIN: 7994 \r\n\r\nMedia contact: Helen Skelton-Smith, Communications Officer (PR & Media), Hampshire and Isle of Wight Wildlife Trust  \r\nEmail: Helen.Skelton-Smith@hiwwt.org.uk\r\nPhone: 07880 888577\r\n\r\nNotes to editors\r\n\r\nCoulters Dean Nature Reserve\r\nCoulters Dean Nature Reserve contains broadleaved woodland and grass chalkland, and is classified as a Site of Special Scientific Interest (SSSI). \r\n\r\nThe reserve boasts a rich and intriguing ecological history. Coulters Dean derives its name from the term ‘coulter,’ referring to the vertical blade on early ploughs that cut vertically through the soil in front of the ploughshare, and ‘dean,’ a Saxon word for valley. First documented in 1914 by the renowned botanist Arthur Tansley, it was identified as a dynamic grassland transitioning from its earlier use as arable farmland.\r\n\r\nChalk grassland (also known as download)\r\nChalk grassland is an internationally rare habitat: it is only found in north-west Europe. Half of the world’s chalk grassland is located in the UK, and a significant proportion of this is in the warm and dry southern counties of England. \r\n\r\nChalk grassland habitat, also known as lowland calcareous grassland, is characterised by well drained, open soil, typically in a sunny position. These nutrient-poor conditions are ideal for a spectacular array of flora and fauna. With as many as 40 plant species in every square metre, it has vastly more biodiversity than the other type of grassland in the country. 35 of Britain''s 56 butterfly species are found on chalk grassland.  \r\n\r\nScrub is typically present, and the scrubby grassland margin supports species not found out on the open grassland. \r\n\r\nThanks to its huge variety of flora, chalk grassland supports hundreds of invertebrate species, including many rare butterflies. The mix of bare ground, short vegetation and longer tussocks together with plenty of flowering plants is ideal for a range of bees, ants, hoverflies, beetles and grasshoppers, many of which are important pollinators. \r\n\r\nWithout traditional management which mimics the practices of our ancestors, chalk grassland will begin to revert to scrubland or woodland. If this happens many of the rare and unique plant and insect species associated with the habitat will disappear.\r\n\r\n\r\nAbout Hampshire and Isle of Wight Wildlife Trust\r\nHampshire & Isle of Wight Wildlife Trust is committed to creating a wilder future by 2030, where nature is recovering, wildlife is returning, and ecosystems are being restored across our counties. With the support of more than 29,000 members, we want to see many more people on nature’s side. We aim to engage 1 in 4 people, encouraging them to take action for nature by becoming part of Team Wilder. \r\n  \r\nWe want to see at least 30% of land and sea transformed into wilder places where nature is recovering by 2030. We are already doing this by expanding our nature reserves, ensuring land outside them is working for wildlife, restoring missing species and campaigning for the right policies to drive the change we need. But we need much more of this rapid, positive action to tackle the climate and ecological crises and to create a wilder future for us all. \r\n\r\nWe’re part of the UK-wide movement of 46 Wildlife Trusts, all standing up for the natural world. Together, we are the nation’s most active and influential nature conservation partnership. Each Trust works within its local community to inspire people and bring about positive change. Discover and protect local wildlife on your doorstep with Hampshire & Isle of Wight Wildlife Trust www.hiwwt.org.uk\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','1161','name','','0','Helen.Skelton-Smith'),('contact','1161','your_telephone_number','','0','07880 888577'),('contact_buriton_village_hall','1169','email','','0','katwoo@me.com'),('contact_buriton_village_hall','1169','message','','0','I need to cancel the hall booking for Lion and Unicorn on May 9 as we couldn''t cast our play'),('contact_buriton_village_hall','1169','name','','0','Kat Wootton'),('contact_buriton_village_hall','1169','your_telephone_number','','0','07471203855'),('contact','1174','email','','0','hcacontractors@outlook.com'),('contact','1174','message','','0','Hello,\r\n\r\nI hope all is well. I wanted to email you to introduce my business and explore any potential opportunities to work together on your projects. We offer a wide range of services, from operated plant hire, civils & groundwork gangs to reinstatement including hard landscaping and surfacing. We have worked on major projects across the area, and are based in the Petersfield area. I have attached my website below for you to have a look at the services I am able to offer and view our portfolio of previous and current projects. Any leads to being part of your projects would be greatly appreciated.\r\n\r\nhttps://www.hcacontractors.co.uk/services\r\n\r\nPlease don''t hesitate to get in touch if you have any queries.\r\n\r\n\r\nKind Regards,\r\n\r\nHenry Atkins\r\n\r\nOutlook-signatureI.png\r\nHCA Contractors\r\nMobile: 07572655960\r\nWebsite: www.hcacontractors.co.uk\r\nEmail: hcacontractors@outlook.com\r\n\r\n'),('contact','1174','name','','0','Henry'),('contact','1174','your_telephone_number','','0','07572655960'),('contact','1177','email','','0','mbifflesner@hotmail.com'),('contact','1177','message','','0','Good evening.\r\n\r\nI am enquiring to the possibility for some assistance.\r\nI will be completing the Tommies Sleep Out for the Royal British Legion for homeless veterans, including 2 night sleeping out and a trek from RAF Odiham to Portsmouth via Waterloville.\r\nTo that end, I was wondering if I could use your field behind the village hall for a safe place to bed down whilst resting up for the next leg. I won’t cook or deface any of the area and will likely be packed and moving by 0700. You will be approx 20 miles into the walk which I a perfect distance. This is schedules for 24th March for that leg of the walk.\r\n\r\nAnything you can provide space wise for safety would be greatly appreciated.\r\n\r\nKindest regards\r\nSamuel Baillie');
INSERT INTO `webform_submission_data` VALUES ('contact','1177','name','','0','Samuel Baillie'),('contact','1177','your_telephone_number','','0','07815563095'),('contact','1179','email','','0','allan.muir@btclick.com'),('contact','1179','message','','0','Several years ago I was assigned editorial access to the Cycling Group page on this website. I can no longer login to edit the page and a request to change my password did not work. However I rarely receive enquiries from the page and I have never managed to attract sufficient cyclists to form a regular cycling group. \r\nFor those reasons, I think we should remove the Cycling group from the website.\r\nThank you'),('contact','1179','name','','0','Allan Muir'),('contact','1179','your_telephone_number','','0','07950 646265'),('contact','1180','email','','0','chris@chrisandsally.co.uk'),('contact','1180','message','','0','Hi,  I am on the committee of Buriton Tennis Club and our section of this website is very out of date. We do not know whom to contact to request access.  Please can you help!  '),('contact','1180','name','','0','Chris Jones'),('contact','1180','your_telephone_number','','0','07810303705'),('contact','1183','email','','0','seankalinski@gmail.com'),('contact','1183','message','','0','Hello.  I wondered whether the hall is available for private hire on Sat 5th July, please?  I am arranging a 50th Birthday celebration.  If so, please could you advise costs.  I also wondered whether there is a bar facility available on-site, please?\r\n\r\nThanks, Sean Kalinski '),('contact','1183','name','','0','Sean Kalinski'),('contact','1183','your_telephone_number','','0','07904723732'),('contact','1184','email','','0','michelle.monaghan@farnhamherald.com'),('contact','1184','message','','0','Looking to get a quote asap from Buriton Parish Council regarding the planning appeal against the decision to refuse the hotel and cycle centre (SDNP/24/00070/REF) in Buriton? '),('contact','1184','name','','0','Michelle Monaghan'),('contact','1184','your_telephone_number','','0','07376 044 997‬'),('contact','1187','email','','0','doug.pam@btinternet.com');
INSERT INTO `webform_submission_data` VALUES ('contact','1187','message','','0','Just testing'),('contact','1187','name','','0','Doug Jones'),('contact','1187','your_telephone_number','','0','01730 231326'),('contact','1188','email','','0','info@hampshirepetfair.co.uk'),('contact','1188','message','','0','Good evening,\r\n\r\nWe are holding the Hampshire Pet Fair at Rookesbury Park at Wickham, Hampshire on 28 & 29 June.  We wanted to let residents of Hampshire know all about it, is there anyway of letting them know through your whats on in your magazine please? \r\n\r\nBest Wishes\r\n\r\n\r\nSam\r\n\r\nM   07359 879126\r\nE    info@hampshirepetfair.co.uk\r\nw hampshirepetfair.co.uk'),('contact','1188','name','','0','Samantha Paterson'),('contact','1188','your_telephone_number','','0','07841660177'),('contact','1192','email','','0','sophiadoe@hotmail.com'),('contact','1192','message','','0','Hello,\r\nPlease can you tell me if the village hall is available to hire on 10th August this year? Many thanks.'),('contact','1192','name','','0','Sophie Doe'),('contact','1192','your_telephone_number','','0','07734861491'),('contact','1193','email','','0','events@halfmoonsheet.co.uk'),('contact','1193','message','','0','I hope you''re well. I’m reaching out from The Half Moon in Sheet to share a new offering that might be of real interest to your hall users — and to your committee too.\r\n\r\nWe’ve recently launched a buffet-style party catering service, perfect for events hosted in village halls like yours — birthdays, family parties, wakes and more. All food is freshly made by our kitchen team, packed in presentation trays, and ready to collect — no staff, no setup, no stress.\r\n\r\nTo help get the word out, we’re offering a £30 referral fee for every confirmed catering booking that comes via your hall. All we ask is that you mention us in your hire pack, or suggest us when speaking with organisers. We can supply flyers or PDFs to help you share the option easily.\r\n\r\nYou can find the full menu and details here:  \r\n👉 www.halfmoonsheet.co.uk/party-catering-petersfield](https://www.halfmoonsheet.co.uk/party-catering-petersfield\r\n\r\nIf you’re interested, I’d be happy to drop off some flyers or chat about how it might work best for you.\r\n\r\nThanks again, and I hope we can work together!\r\n\r\nBest wishes,  \r\nChris\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','1193','name','','0','Chris '),('contact','1193','your_telephone_number','','0','01730 263859'),('contact_buriton_village_hall','1194','email','','0','Joanna@BalancedBodiesSport.com'),('contact_buriton_village_hall','1194','message','','0','Hi, I''d like to explore establishing a monthly Foot Health Clinic in Buriton. The first date that matches with my availability is Wednesday 11th June. I can see that the small hall is full. I''m hoping to be able to book in 4 clients on that day as a starting point but won''t know until I advertise as to how many I get. Is it possible to reserve the room whilst I advertise to see if I can get some client''s interested? \r\n\r\nBest Wishes, Joanna'),('contact_buriton_village_hall','1194','name','','0','Joanna '),('contact_buriton_village_hall','1194','your_telephone_number','','0','07397325790'),('contact','1195','email','','0','welt.karts9v@icloud.com'),('contact','1195','message','','0','We would like to know Buriton Cricket Club''s  fixtures for this year.    Many thanks'),('contact','1195','name','','0','Jennie Allport'),('contact','1195','your_telephone_number','','0','07533218436'),('contact_buriton_village_hall','1196','email','','0','esalvan@utility-aid.co.uk'),('contact_buriton_village_hall','1196','message','','0','Hello Steve Franks,\r\nI hope you''re well. My name is Elisabetta and I’m reaching out from Utility Aid. I tried to contact you by phone today but wasn’t able to reach you.\r\nWe specialise in supporting non-profit organizations, like yours, by helping them save time, money  and to recover overcharges on their utilities.\r\nWould you be available for a quick call to discuss how we can assist you? If email is more convenient, we can continue our conversation here.\r\nLooking forward to hearing from you.\r\nBest regards,\r\nElisabetta'),('contact_buriton_village_hall','1196','name','','0','elisabetta salvan'),('contact_buriton_village_hall','1196','your_telephone_number','','0','0161 464 9293'),('contact','1197','email','','0','senayyilmaz@yahoo.com');
INSERT INTO `webform_submission_data` VALUES ('contact','1197','message','','0','Hello, I am the social secretary for Peterfield musical theatre group and I am trying to organise our summer party (a barbecue) in buriton park. I was hoping you could provide me with more information on what we need eg; designated area, booking, recommendation for barbecue hire ect. Any assistance you are able to provide will be greatly appreciated.\r\n\r\nThank you in advance and I look forward to hearing from you.\r\n\r\nKind regards,\r\nJaz Howells'),('contact','1197','name','','0','Jaz Howells'),('contact','1197','your_telephone_number','','0','07828155575'),('contact','1198','email','','0','matt.seber@global.ntt'),('contact','1198','message','','0','Hi Steve and Team,\r\n\r\nPlease can you help ? I am arranging a family picnic and game of rounders at Buriton park Saturday 19th July. There will be approx. 18 adults plus children. Is there anyway we can gain access to the village hall to use the toilets ? Guessing we will be in the park from approx. 1pm until 5pm.\r\n\r\nBest Regards\r\n\r\nMatt\r\n'),('contact','1198','name','','0','Matt Seber'),('contact','1198','your_telephone_number','','0','07887658411'),('contact','1199','email','','0','info@stickthetwig.co.uk'),('contact','1199','message','','0','Hi there\r\nI was wondering if there is a possibility to put up a flyer in the village hall advertising a new activity coming to Petersfield.\r\nMany thanke\r\nMel'),('contact','1199','name','','0','Melanie Way'),('contact','1199','your_telephone_number','','0','01420 538171'),('contact','1200','email','','0','amanda.swanson@southdowns.gov.uk'),('contact','1200','message','','0','Hello, \r\n\r\nWe are planning a River Rother Parish and Community Event on 7th October in Midhurst. Can you let me know the best email address to send the invitation and information about it to?\r\n\r\nMany thanks, \r\nAmanda Swanson'),('contact','1200','name','','0','Amanda Swanson'),('contact','1200','your_telephone_number','','0','01730819220'),('contact','1201','email','','0','kimbersarahlouise@gmail.com');
INSERT INTO `webform_submission_data` VALUES ('contact','1201','message','','0','Hi there,\r\n\r\nPlease can someone give me a call or drop me an email regarding my booking for 7th September? It was approved on the form but has now disappeared? Thanks so much, Sarah Kimber'),('contact','1201','name','','0','Sarah Kimber'),('contact','1201','your_telephone_number','','0','07957326212'),('contact','1203','email','','0','doug.pam@btinternet.com'),('contact','1203','message','','0','TEST'),('contact','1203','name','','0','Doug Jones'),('contact','1203','your_telephone_number','','0','01730 231326'),('contact_buriton_village_hall','1204','email','','0','eleanormossdewhurst@gmail.com'),('contact_buriton_village_hall','1204','message','','0','Hello,\r\nIs the hall available to hire for 2-3 hours either this Saturday (6th) or Saturday 27th September please?\r\n\r\nThank you,\r\nEleanor '),('contact_buriton_village_hall','1204','name','','0','Eleanor Dewhurst'),('contact_buriton_village_hall','1204','your_telephone_number','','0','07515934607'),('contact','1205','email','','0','trevorlamphee@gmail.com'),('contact','1205','message','','0','Hi just reaching out to contact some of my extended family \r\nKind regards Trevor lamphee \r\nOf Eastleigh grandson of Michel Gibson Joyce brays brother? '),('contact','1205','name','','0','Trevor lamphee'),('contact','1205','your_telephone_number','','0','07789262696'),('contact','1206','email','','0','brightstarsspecialclub@yahoo.co.uk'),('contact','1206','message','','0','Dear Buriton,\r\n\r\nI would be grateful for a discussion on the work you are currently doing in Dominase Ghana please.  Grateful if someone calls me back or responds to me in an email to progress a conversation.  \r\n\r\nKind Regards\r\n\r\nSuezanne'),('contact','1206','name','','0','Suezanne Awotwi'),('contact','1206','your_telephone_number','','0','07764194645'),('contact','1207','email','','0','kmlastilleros@yahoo.com'),('contact','1207','message','','0','Dear Buriton Village Hall,\r\nIs there now a regular Repair Shop happening during Coffee Morning every first Saturday of the month 10:30am-12:30pm at Buriton Village Hall? \r\nThanks in advance.');
INSERT INTO `webform_submission_data` VALUES ('contact','1207','name','','0','Kenia'),('contact','1207','your_telephone_number','','0','07881648793'),('contact','1208','email','','0','mail@mjlrowe.plus.com'),('contact','1208','message','','0','I am looking for information about Richard Patrick, who arrived in BUriton in 1499 at the age of 12. I am trying to find out where he came from and who his parents were. I know its a long time back, but we are stuck on our family tree and cant find a link anywhere. We know that the family owned properties in the area for many years and some are buried in the local churchyard, but are desperate to find out where he came from. Any help would be gratefully received.\r\nmany thanks'),('contact','1208','name','','0','Julie Rowe'),('contact','1208','your_telephone_number','','0','01761 437704'),('contact_buriton_village_hall','1209','email','','0','frances.w5@btinternet.com'),('contact_buriton_village_hall','1209','message','','0','i was just wondering if you have any availability on a Sunday afternoon  about once a month ( we can be flexible). It is for Dog Rally Obedience classes, all adult well trained dogs who are training for competitions .\r\nI am fully insured and have been running classes in various venues for many years.\r\nFrances Killeen\r\nArmchair Pets'),('contact_buriton_village_hall','1209','name','','0','Frances Killeen'),('contact_buriton_village_hall','1209','your_telephone_number','','0','07930732634'),('contact','1210','email','','0','kennith.gist@gmail.com'),('contact','1210','message','','0','Are you searching for a job that can be done right away? If so, countless businesses are hiring website chat support agents - no experience is needed, as full training will be provided.\r\n\r\nClick here to complete your application if you are interested.\r\n\r\n-----> https://tinyurl.com/db5nx74y'),('contact','1210','name','','0','Kennith Gist'),('contact','1210','your_telephone_number','','0','8158400824'),('contact','1211','email','','0','gillthom@gmail.com'),('contact','1211','message','','0','Hi\r\nI''d be grateful for some help and information from the Parish Council please. \r\nI moved into 26B Petersfield Road just over a year ago.\r\n\r\nI''m very concerned about the lack of privacy I have from no 15 Sumner Road. I have been doing some investigation and I see that they made an application in 2021 to remove part of the hedgerow that runs along the boundary of that estate onto Petersfield Road. Their reason was so that they could erect a fence to contain their dog within their garden (or lack of garden as they have developed that plot so much there is very little outside space). \r\nI can maybe understand that they needed to cut the hedge back to erect a fence but I fail to understand how they can even have been granted planning on land that they didn''t even own. There seems to have been no restriction on them to reinstate this hedgerow post the fence erection. The gap created is not only unsightly but I''m sure that it must have been a condition of the original planning consent for the hedge to be maintained to try to preserve the rural aspect of the sight which was formerly a field, (I can''t find the original planning application on the SD planning portal).\r\nI have a serious privacy issue with the bedroom window which is right opposite my bedroom window at the far end of my house. I can see directly into their teenage son''s bedroom. I had more privacy living in a terraced street in London. What seems to have been completely overlooked is the fact that this house, and mine, are raised above the level of the road so no one has taken into account the fact that these properties look directly into each other. \r\nI would like to write to the Council requesting that the hedge is reinstated and maintained at the height of the established hedge on the road which should then address the privacy issues. \r\nI know that a number of neighbours and the owners of this property at the time objected to the application however they failed to put a stress on the privacy infringement.\r\nIs there any particular angle I should stress in my communication or any support that would be available from the Parish Council to this application? \r\nthanks and kind regards\r\nGill');
INSERT INTO `webform_submission_data` VALUES ('contact','1211','name','','0','Gill Thom'),('contact','1211','your_telephone_number','','0','07973223179'),('contact','1212','email','','0','suemilnersmith@gmail.com'),('contact','1212','message','','0','Hi Amanda and Team, I have booked a table this Sunday 16th for 6 people and I think I forgot to say it’s for a lady’s 60th if you could possible set the table with this in mind that would be great.\r\n\r\nLook forward to our visit\r\nMany thanks\r\nSue'),('contact','1212','name','','0','Susan Milner-Smith'),('contact','1212','your_telephone_number','','0','07718980540'),('contact','1213','email','','0','alison.foster@plantheritage.org.uk'),('contact','1213','message','','0','Dear Buriton Community, \r\nI work for Plant Heritage and one of our collection holders is featured on your website - Mr Junius de Brisay. It mentions the book "A history of Buriton" that he has written and lists his mobile phone no. \r\nWe have been trying to contact Junius recently in relation to his National Collections (Eucomis, Hippeastrum and Veltheimia) and would very much like to do so to confirm all is well. Is there any way that you could pass this message onto him and ask him to please contact the membership team at Plant Heritage. Many thanks indeed.  '),('contact','1213','name','','0','Alison Foster'),('contact','1213','your_telephone_number','','0','01483 447540'),('contact','1214','email','','0','trudybaxendale@gmail.com'),('contact','1214','message','','0','I''m looking at venues for a 50th on Friday 30 October 2026 to accommodate about 120/130 people - Adults and children.  Timing would be from about 5pm (to allow for decorating and set up).  \r\nIt''s going to be a barn dance theme and we''d like to possibly look at getting a mechanical bull for a couple hours - would this be ok to set up inside? \r\nIt''s a bring your own alcohol party and possibly a spit roast to be set up outside. Ending time about 11pm for guests, so about midnight to allow for clean up. can you please let me know costings and availability. Many thanks, Trudy');
INSERT INTO `webform_submission_data` VALUES ('contact','1214','name','','0','Trudy Baxendale'),('contact','1214','your_telephone_number','','0','07748971494'),('contact','1216','email','','0','Council@bramshottandliphook-pc.gov.uk'),('contact','1216','message','','0','Hello, I have just seen the article in the latest EHDC Newsletter re the dredging of your village pond.  We have a pond in one of our parks that we are currently looking into various options re the management of the flow of water through the pond and one option includes dredging.  It would be really useful to have some background information about your pond and what led you to the decision to use the amphibious excavator and the funding for the project.\r\nMany thanks\r\nGeraldine Sheedy\r\nDeputy Clerk, Bramshott and Liphook PC'),('contact','1216','name','','0','Geraldine Sheedy'),('contact','1216','your_telephone_number','','0','01428722988'),('contact','1217','email','','0','suzywilkes@yahoo.com'),('contact','1217','message','','0','I would like to know the cost and deposit to hire your hall please and if you have availability on Saturday the 18th of April for my daughters birthday, there will be 16 children maximum and around 20 adults if the parents stay too.\r\nMany thanks\r\nSuzy'),('contact','1217','name','','0','Suzy wilkes'),('contact','1217','your_telephone_number','','0','07512621769'),('contact','1218','email','','0','harrywalwslife@gmail.cpom'),('contact','1218','message','','0','Hello ,\r\n\r\nI see your website https://buriton.info/for  and its impressive. I wonder if advertising options like guest post, ad content are available on your site?\r\nWhat''s the price if we want to advertise on your site?\r\nNote : Article must not be any mark as sponsored or advertise.\r\n\r\nCheers                                                                             \r\nHarry Wales   \r\n'),('contact','1218','name','','0','harry wales'),('contact','1218','your_telephone_number','','0','9852457845'),('contact_buriton_village_hall','1219','email','','0','halcheni1990@mail.ru');
INSERT INTO `webform_submission_data` VALUES ('contact_buriton_village_hall','1219','message','','0','Пляжная линия https://akademy21.ru/contacts/yakutsk\r\n \r\n1 dd https://akademy21.ru/contacts/almaty\r\n mm https://akademy21.ru/comerchiskie_ukladki\r\n yy Воскресенье Понедельник Вторник Среда Четверг Пятница Суббота Вс Пн Вт Ср Чт Пт Сб Вос Пон Вто Сре Чет Пят Суб Январь Февраль Март Апрель Май Июнь Июль Август Сентябрь Октябрь Ноябрь Декабрь Янв Фев Мар Апр Май Июн Июл Авг Сен Окт Ноя Дек Предыдущий месяц Следующий месяц https://akademy21.ru/medsestra_cosmetolog\r\n \r\nК сожалению, у нас нет подходящих туров для отображения https://akademy21.ru/courses/massage/master-apparatnoy-korrektsii-figury\r\n \r\nСпециальные предложения https://akademy21.ru/master_epiliacii\r\n \r\nInternational Asia Pacific Convention Center & HNA Resort https://akademy21.ru/contacts/spb\r\n \r\nОтдых в Китае – станет для вас не забываемым приключением, наполненным новыми эмоциями, открытиями и впечатлениями! Турфирма Россита в Санкт-Петербурге - туроператор по Китаю, предлагает туры в Китай с посещением основных туристических мест и маршрутов https://akademy21.ru/courses/massage/intimnoye-otbelivaniye-iapparatnoye-omolozheniye\r\n  Туры в Китай и цены на них вы можете узнать на сайте или по телефону у менеджеров нашей компании https://akademy21.ru/osnovy_makeiaja\r\n  Каждый из маршрутов обеспечит вам чудесный отдых и массу незабываемых впечатлений https://akademy21.ru/trener-naraschivanie-volos\r\n  Получите удовольствие от посещения Китая с агенством путешествий Россита https://akademy21.ru/contacts\r\n \r\n');
INSERT INTO `webform_submission_data` VALUES ('contact_buriton_village_hall','1219','name','','0','PhilipNak'),('contact_buriton_village_hall','1219','your_telephone_number','','0','82871576543'),('contact_buriton_village_hall','1220','email','','0','dolnovam@mail.ru'),('contact_buriton_village_hall','1220','message','','0','Рассчитайте стоимость поискового продвижения и получите скидку 35% на первый счет https://proffseo.ru/prodvizhenie-zarubezhnykh-sajtov\r\n \r\nВ геоНЕзависимом продвижении сайтов по России не получится снизить конкуренцию региональной отстройкой https://proffseo.ru/prodvizhenie-angloyazychnykh-sajtov\r\n  А значит, нужно много, долго и ежедневно трудиться над повышением качества и популяризацией веб-проекта https://proffseo.ru/prodvizhenie-angloyazychnykh-sajtov\r\n \r\nМы расскажем о тонкостях геоНЕзависимой раскрутки сайтов в границах РФ и Рунета под Яндекс и Google https://proffseo.ru/prodvizhenie-sajtov-po-rf\r\n \r\nОсновным поисковиком в России и странах СНГ является Яндекс https://proffseo.ru/privacy\r\n  Большинство посетителей придут к вам именно оттуда https://proffseo.ru/privacy\r\n  Поэтому далее речь пойдет, в основном, именно о Яндексе https://proffseo.ru/prodvizhenie-angloyazychnykh-sajtov\r\n \r\nВ качестве примера посмотрим на сайт Wikipedia https://proffseo.ru/privacy\r\n org https://proffseo.ru/prodvizhenie-sajtov-po-rf\r\n  Википедия геоНЕзависима и попадает в ТОП-10 по многим запросам и регионам России https://proffseo.ru/prodvizhenie-sajtov-po-rf\r\n \r\nLink-менеджер https://proffseo.ru/prodvizhenie-sajtov-po-moskve\r\n \r\n');
INSERT INTO `webform_submission_data` VALUES ('contact_buriton_village_hall','1220','name','','0','BuddyJen'),('contact_buriton_village_hall','1220','your_telephone_number','','0','88787375495'),('contact','1221','email','','0','Catherine@content.gocompare.com'),('contact','1221','message','','0','Hi,\r\n\r\nAccording to the Environment Agency, over two million people in England live and work in properties at risk of flooding from rivers or the sea, whilst more face flood threats from groundwater, surface water, sewers, and reservoirs.\r\n\r\nAt Gocompare, we have put together a guide to preparing for a flood and protecting your property - https://www.gocompare.com/home-insurance/guide/flood-damage-repair-and-prevention/\r\n\r\nIn extreme conditions you won''t be able to stop flood water, and you should always put personal safety above attempts to protect property and possessions. Despite this, there are steps that you can take to keep water out, to buy yourself time to preserve property and possessions, and to limit the damage that flood water does.\r\n\r\nWe think this information would be useful for your readers and wonder if you would consider linking to our guide at your page https://www.buriton.info/news/flooding-buriton-village-hall\r\n\r\nThank you for your support, we''re extremely grateful.\r\n\r\nKind regards,\r\nCatherine Bailey\r\nPublisher Partner Manager '),('contact','1221','name','','0','Catherine Bailey'),('contact','1221','your_telephone_number','','0','01'),('contact_buriton_village_hall','1222','email','','0','suzywilkes@yahoo.com'),('contact_buriton_village_hall','1222','message','','0','Hello,\r\nI have a provisional booking in for Saturday the 18th April, I will be paying the invoice on Saturday 7th March, I just wanted to let you know so the provisional booking could stay in place till I pay if possible?\r\n\r\nMany Thanks\r\nSuzy Wilkes'),('contact_buriton_village_hall','1222','name','','0','Suzy'),('contact_buriton_village_hall','1222','your_telephone_number','','0','07512621769'),('contact','1223','email','','0','Catherine@content.gocompare.com');
INSERT INTO `webform_submission_data` VALUES ('contact','1223','message','','0','Hi,\r\n\r\nHope you are well.\r\n\r\nI was just wondering if you had enough time to consider our request.\r\n\r\nI would be grateful for any feedback.\r\n\r\nKind Regards, \r\n	\r\n'),('contact','1223','name','','0','Catherine Bailey'),('contact','1223','your_telephone_number','','0','01'),('contact','1224','email','','0','babsiewood17@gmail.com'),('contact','1224','message','','0','Hello Petra\r\nA while ago I contacted you regarding the 2hr Outreach Post Office Service in Buriton.  This used to follow a similar service in Compton but because the venue (Coach & Horses Pub) closed we have now lost this facility. I have been trying unsuccessfully to get this reinstated in the Village Shop in Compton.  What I would like to know is the average use of the outreach post office in Buriton?  It appears that the service will only be returned if we can guarantee a certain level of usage.\r\nI noticed when I visited your Post Office in the annex of the church that there seemed to be a non-post office person in attendance - maybe for security reasons?. If that is so they could monitor the number of residents making use of the P.O. service.\r\nif you would like to give me a call your help would be greatly appreciated!\r\nKind Regards,     Barbara Wood  April Cottage Compton '),('contact','1224','name','','0','Barbara Wood'),('contact','1224','your_telephone_number','','0','02392631246'),('contact','1225','email','','0','needham6417@doctors.net.uk'),('contact','1225','message','','0','Hi, I am looking to book a venue for a departmental meeting, and wondered if the village hall was free on Tuesday the 12th may? \r\nThank you, Sophie '),('contact','1225','name','','0','Sophie Needham'),('contact','1225','your_telephone_number','','0','07753292219'),('contact_buriton_village_hall','1226','email','','0','jodie.heather.10@gmail.com'),('contact_buriton_village_hall','1226','message','','0','Hello, I was looking at three dates to hire the hall and they all have provisional bookings in. Could you please confirm if these events are going ahead? 30th August, 3rd May, 24th May. I only want one and this is order of preference - from midday to midnight ideally please, or similar. Many thanks, Jodie ');
INSERT INTO `webform_submission_data` VALUES ('contact_buriton_village_hall','1226','name','','0','Jodie Heather'),('contact_buriton_village_hall','1226','your_telephone_number','','0','07779022982'),('contact','1227','email','','0','Catherine@content.gocompare.com'),('contact','1227','message','','0','Hi,\r\n\r\nI haven’t heard from you since I sent my emails over a few weeks ago.  \r\n         \r\nCould you please forward me to the person/department who can consider our request?\r\n\r\nThank you and look forward to hearing from you soon.\r\n\r\nKind Regards,\r\n'),('contact','1227','name','','0','Catherine Bailey'),('contact','1227','your_telephone_number','','0','01'),('contact_buriton_village_hall','1228','email','','0','profconbu_64@mail.ru'),('contact_buriton_village_hall','1228','message','','0','Как мы осуществили переход уровня через slott 80 Подробнее https://skyprofi.ru/potolki-v-rajonax/natyazhnye-potolki-v-vyborgskom-rajone/\r\n \r\nБесщелевой KRAAB 4 https://skyprofi.ru/\r\n 0 и Теневой EuroKRAAB потолок https://skyprofi.ru/potolki-v-rajonax/natyazhnye-potolki-v-murino/\r\n \r\nГарантия и сервисное обслуживание https://skyprofi.ru/potolki-v-rajonax/natyazhnye-potolki-sestroreck/\r\n \r\nТканевые фактуры https://skyprofi.ru/natyazhnye-potolki-pvkh/glyancevye/\r\n \r\nОн, в том числе, учитывает стоимость люстр и точечных светильников https://skyprofi.ru/tipovye-resheniya/natyazhnye-potolki-9m2/\r\n  А вот, доп https://skyprofi.ru/stati/montazh-ustanovka-natjazhnyh-potolkov/\r\n  услуги к потолку, такие, как: «скрытый карниз», «парящие», «контурные» потолки и т https://skyprofi.ru/\r\n д https://skyprofi.ru/tipovye-resheniya/natyazhnye-potolki-11m2/\r\n  до конца пока реализовать не удалось, из-за огромного количества нюансов возникающих при их подсчёте https://skyprofi.ru/\r\n \r\nБолее 12 лет качественной работы с натяжными потолками https://skyprofi.ru/installment/\r\n  Мы проверены временем https://skyprofi.ru/stati/montazh-potolochnogo-karniza-na-natyazhnoj-potolok/\r\n \r\n');
INSERT INTO `webform_submission_data` VALUES ('contact_buriton_village_hall','1228','name','','0','Markusnix'),('contact_buriton_village_hall','1228','your_telephone_number','','0','88655547978'),('contact','1229','email','','0','ceriiii_872@hotmail.com'),('contact','1229','message','','0','Hi There\r\nI would like to know if there is anything that the council can do to help the little ducklings survive at the pond? Every year, and sometimes twice a year, she''s had a brood, and no one duckling has survived for the last two years. There doesn''t seem to be anywhere safe for her to nest, and the new island is too high for her to access with the ducklings. I know it''s probably a long shot, but would the council agree to installing a floating duck house? My children go to Buriton Primary School and love seeing the wildlife at the pond. I know a few of the parents around the school would be happy to contribute to the cost. It''s just so sad to see them disappearing every year. She currently has six, probably just a day old. It would be lovely if we could see these grow up.\r\nKind regards '),('contact','1229','name','','0','Ceri Brighton'),('contact','1229','your_telephone_number','','0','07787447719'),('contact_buriton_village_hall','1230','email','','0','lashawndaqkpuc@mail.ru'),('contact_buriton_village_hall','1230','message','','0','Техноиндустрия https://zittel.ru/news/109-anugafoodtec2012.html\r\n \r\n0 https://zittel.ru/ppv.html\r\n 71 x 1 https://zittel.ru/juice.html\r\n 72 x 0 https://zittel.ru/likerovodochnoe.html\r\n 59 https://zittel.ru/oborudovanie/37-oborudovanie/190-elektronnyj-kopir-v-etiketirovochnoj-mashine-makro-labelling-italiya.html\r\n \r\nБесплатный номер: 8-800-775-33-00 https://zittel.ru/maslojirovoe.html\r\n \r\nВремя цикла https://zittel.ru/news.html\r\n \r\n0,17 кВт/час https://zittel.ru/oborudovanie/37-oborudovanie/237-brozhenie-fermentatsiya-piva-v-butylke-oborudovanie-rozliva.html\r\n \r\nОборудование для пищевой промышленности играет ключевую роль в обеспечении безопасности и качества продукции https://zittel.ru/paletizacia.html\r\n  Современные технологии позволяют автоматизировать многие процессы, что значительно повышает производительность и снижает риск ошибок https://zittel.ru/obyomny.html\r\n  Требования к оборудованию пищевой промышленности строго регламентированы, чтобы гарантировать соответствие всем санитарным и технологическим нормам https://zittel.ru/oborudovanie/37-oborudovanie/205-induktsionnaya-zapajka-folgoj-model-gst-italiya.html\r\n  Производители оборудования для пищевой промышленности постоянно разрабатывают инновационные решения, способствующие улучшению качества и эффективности производственных процессов https://zittel.ru/gravitacionni.html\r\n \r\n');
INSERT INTO `webform_submission_data` VALUES ('contact_buriton_village_hall','1230','name','','0','Josephsparf'),('contact_buriton_village_hall','1230','your_telephone_number','','0','89415468836'),('contact_buriton_village_hall','1231','email','','0','yaroslav.sevastyanov.1988@mail.ru'),('contact_buriton_village_hall','1231','message','','0','4 200 р уб https://yaschiki.ru/product/derevyannii-yashchik-1300-600-700/\r\n \r\nДеревянные ящики для хранения вещей https://yaschiki.ru/upakovka-press-form-dlya-otpravki-v-kitai/\r\n \r\nтиповые проекты – это деревянные ящики, изготавливаемые по стандартным чертежам с нужными габаритными размерами; сделанные по индивидуальному техническому заданию – на заказ https://yaschiki.ru/product/derevyannii-yashchik-300-300-300/\r\n \r\nкоторая обеспечивает высокий уровень удобства при погрузке, разгрузке, что позволяет заметно увеличить скорость погрузочно-разгрузочных работ https://yaschiki.ru/product/derevyannii-yashchik-1200-1150-1900/\r\n \r\nПосылочные ящики https://yaschiki.ru/product-category/yashchiki-iz-osb/\r\n \r\nУслуги Разработка тары и упаковки Производство тары Ящики с фитосанитарной обработкой (ISPM-15) Упаковка груза на территории заказчика Доставка Разработка чертежей тары и проектов по упаковке Вкладыши/ложементы и трафареты по ГОСТ 14192-91 Тарная продукция Деревянные ящики Военные ящики Экспортные ящики Ящики по специсполнению Фанерные ящики ExPack стандарт (многооборотная тара) Тара для стекла Морская упаковка ГОСТы и ТУ на тару и упаковку ГОСТы на тарную фурнитуру Материалы для упаковки Контакты Пользователи https://yaschiki.ru/uslugi/upakovka-v-termousadochnuyu-plenku/\r\n \r\n');
INSERT INTO `webform_submission_data` VALUES ('contact_buriton_village_hall','1231','name','','0','AndrewRom'),('contact_buriton_village_hall','1231','your_telephone_number','','0','87382899682'),('contact_buriton_village_hall','1232','email','','0','woof@bentleyspetersfield.co.uk'),('contact_buriton_village_hall','1232','message','','0','Hello,\r\n\r\nI hope you are well? \r\n\r\nYour location has been recommend to me as a possible location for our annual charity dog show. We simply require field space and parking for attendees. Would this possibly be something you would consider? We would ideally like to hold the event in September on a Sunday. \r\n\r\nI look forward to hearing back from you, \r\n\r\nKind regards\r\nShelley '),('contact_buriton_village_hall','1232','name','','0','Shelley Houghton'),('contact_buriton_village_hall','1232','your_telephone_number','','0','07884005878'),('contact_buriton_village_hall','1233','email','','0','jodieechadwick@gmail.com'),('contact_buriton_village_hall','1233','message','','0','Good afternoon \r\nWe are looking to hire the space on the 18th July 2026 but would like access to both the hall (part of it) and the outside area, was wondering how if this was possible at all?\r\n\r\nThank you\r\nJodie '),('contact_buriton_village_hall','1233','name','','0','Jodie Chadwick'),('contact_buriton_village_hall','1233','your_telephone_number','','0','07925586235'),('contact','1234','email','','0','marcel@attard1.com'),('contact','1234','message','','0','Hello, I will be leading a group of walkers on a long walk starting at Buriton on Sunday 10th May.  Would it be possible to use the Village Hall car park as a starting point?  There should be around 15 cars bringing our walkers.\r\nThank you.\r\nMarcel Attard, on behalf of Hampshire Hikers'),('contact','1234','name','','0','Marcel Attard'),('contact','1234','your_telephone_number','','0','07736 272042'),('contact','1235','email','','0','jo.edwards@easthants.gov.uk'),('contact','1235','message','','0','A car has been reported to us in your car park, KY18EYA White Vauxhall Mocha. We have written to the registered keeper with no response. We have put a notice on the vehicle.  Can you confirm you are happy for us to remove the vehicle if t is not claimed after the notice expires and we have completed our final chacks.\r\n\r\nThanks\r\n\r\nJo Edwards\r\nEast Hampshire District Council\r\n');
INSERT INTO `webform_submission_data` VALUES ('contact','1235','name','','0','Jo Edwards'),('contact','1235','your_telephone_number','','0','07764790730'),('contact','1236','email','','0','rsmacleod45@gmail.com'),('contact','1236','message','','0','My maiden name was PRETTY; my gr,grandfather was HenryPRETTY of "Bullinge Hill", Buriton, Hants b.1855. Died 1892. \r\nTheir son was James PRETTY b.1855 - he left home about 18, travelling to N.Z. with his sister Ellen and her husband James ATKINS on 20 Mar., 1874. He is shown as a Shepherd but often indicated he was an "engine driver" (as on his wedding cert. in Australia in 1888).  I have wondered if he perhaps drove an engine in Buriton?  Do you have any record at all of this? \r\nAlso any info. about the rest of his siblings in Buriton? His parents were Henry and Eliza (nee TULETT) and Henry''s siblings were: Sarah, James, William, (m. Mary Newman), George, Jane (m.George Silvester), Harriet (m.Jonathon KENT) & John. \r\nI own three of your Buriton histories: "Buriton in Living Memory", "A Buriton Timeline" and "Buriton Then and Now".'),('contact','1236','name','','0','Ruth Macleod'),('contact','1236','your_telephone_number','','0','0421530480'),('contact_buriton_village_hall','1237','email','','0','Victoriadoidge@hotmail.co.uk'),('contact_buriton_village_hall','1237','message','','0','Good morning, \r\n\r\nI''m looking to hire a hall for my sons birthday party  on Saturday the 18th of July. \r\nWe would most likely just need the recreation ground but would like to enquire the availability and cost of your village hall.\r\nI have been on the calendar and can see that the small hall is available. \r\nHow small is that ? Big enough to host a football party for about 15 people if needed?\r\nMany thanks \r\nVicky '),('contact_buriton_village_hall','1237','name','','0','Victoria Doidge'),('contact_buriton_village_hall','1237','your_telephone_number','','0','07880502540'),('contact','1238','email','','0','johnkiymail@gmail.com'),('contact','1238','message','','0','Hi, I am wondering if it would be possible to hire the hall for practice with my band during the week? We play 80s covers and are now looking for a new rehearsal space. A couple of us used the hall a couple of years ago in a different band. ');
INSERT INTO `webform_submission_data` VALUES ('contact','1238','name','','0','John Kiy'),('contact','1238','your_telephone_number','','0','07534159245'),('contact_buriton_village_hall','1239','email','','0','debcowley@gmx.com'),('contact_buriton_village_hall','1239','message','','0','Hello, looking to hire your hall on the 31 Aug from 10am to 5.30/6pm can see there is a provisional booking. Wonder when you will know whether this is going ahead or not. Also how much it would cost to hire the whole venue for this time scale.  Look forward to hearing back from you.\r\nMany thanks\r\nDeb'),('contact_buriton_village_hall','1239','name','','0','Mrs D COWLEY'),('contact_buriton_village_hall','1239','your_telephone_number','','0','07848458870'),('contact','1240','email','','0','Road.safety@hants.gov.uk'),('contact','1240','message','','0','Good morning,\r\nI am contacting you to provide you with the details of our driving assessment scheme for volunteer drivers- there is a discount if we book 3 or more drivers in for assessments from the same organisation on the same day and location.\r\n \r\nTo be eligible for this scheme the drivers must meet our assessor at a chosen location which has a car park for assessor to park her car (no parking restrictions)  and toilet facilities.\r\n \r\nHere is the application form link – https://forms.office.com/e/KdG60rRw5X In the box that says "heard about scheme" please put "Buriton Volunteer Drivers" so we can easily group the volunteers together. The volunteer drivers will be using their own vehicles for this assessment, so it is similar to their normal driving practices.\r\n \r\nFor payment, this scheme is £70 but if 3 or more in one day are booked, each assessment is £45.\r\n\r\nIf you do have any questions please contact road.safety@hants.gov.uk\r\n\r\nKind regards\r\nRebecca\r\n'),('contact','1240','name','','0','Road Safety Team - Hampshire County Council'),('contact','1240','your_telephone_number','','0','01962 846100 '),('contact','1241','email','','0','denise@thedirectorygroup.co.uk'),('contact','1241','message','','0','Test - please let me know when you get this Petra');
INSERT INTO `webform_submission_data` VALUES ('contact','1241','name','','0','denise Lloyd'),('contact','1241','your_telephone_number','','0','07525101861'),('contact','1242','email','','0','rendelllyn@btinternet.com'),('contact','1242','message','','0','Hi can you tell me will there be available Parking on this day please'),('contact','1242','name','','0','Lynda '),('contact','1242','your_telephone_number','','0','07734159496'),('contact_buriton_village_hall','1243','email','','0','linda.j.jones1@gmail.com'),('contact_buriton_village_hall','1243','message','','0','Believe you have a short mat bowls on a Monday night. I am interested as I am new to the game. Please can you tell me if there is short mat bowls on Monday and who to contact to join the club. Thank you Linda Jones'),('contact_buriton_village_hall','1243','name','','0','Linda jones'),('contact_buriton_village_hall','1243','your_telephone_number','','0','07940581972'),('contact','1244','email','','0','jacqualinebotma@yahoo.co.uk'),('contact','1244','message','','0','Hi, just wondering if you’ve received the payment for the hall booking for 26th Sept and if it’s all confirmed so we can send invites out ?'),('contact','1244','name','','0','Jacqualine Restell'),('contact','1244','your_telephone_number','','0','07794343176'),('contact_buriton_village_hall','1245','email','','0','joannamealey@gmail.com'),('contact_buriton_village_hall','1245','message','','0','Hello \r\nI can see there is availability for hire on Sunday 9th November. I was wondering your hire charges please. \r\n\r\nMany thanks\r\nJo Mealey '),('contact_buriton_village_hall','1245','name','','0','Joanna Mealey'),('contact_buriton_village_hall','1245','your_telephone_number','','0','07825578986'),('contact','1246','email','','0','denise@thedirectorygroup.co.uk'),('contact','1246','message','','0','TEST - HELLO JUST TESTING THE WEBSITE CONTACT EMAILS - PLEASE ADVISE WHO RECEIVES THIS - AND WHICH EMAIL ADDRESS IT COMES TO THANK YOU \r\nDENISE \r\n\r\nMAIN CONTACT PAGE '),('contact','1246','name','','0','denise Lloyd'),('contact','1246','your_telephone_number','','0','07525101861');
DROP TABLE IF EXISTS `webform_submission_log`;
CREATE TABLE `webform_submission_log` (   `lid` int(11) NOT NULL AUTO_INCREMENT COMMENT 'Primary Key: Unique log event ID.',   `webform_id` varchar(32) NOT NULL COMMENT 'The webform id.',   `sid` int(10) unsigned DEFAULT NULL COMMENT 'The webform submission id.',   `handler_id` varchar(64) DEFAULT NULL COMMENT 'The webform handler id.',   `uid` int(10) unsigned NOT NULL DEFAULT 0 COMMENT 'The users.uid of the user who triggered the event.',   `operation` varchar(64) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL DEFAULT '' COMMENT 'Type of operation, for example "save", "sent", or "update."',   `message` longtext NOT NULL COMMENT 'Text of log message.',   `data` longblob NOT NULL COMMENT 'Serialized array of data.',   `timestamp` int(11) NOT NULL DEFAULT 0 COMMENT 'Unix timestamp of when event occurred.',   PRIMARY KEY (`lid`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='Table that contains logs of all webform submission events.' AUTO_INCREMENT=1;


