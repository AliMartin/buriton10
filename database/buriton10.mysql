INSERT INTO `search_dataset` VALUES ('523','en','node_search',' buriton cc vs gentlemen of bedales buriton cc vs gentlemen of bedales it may be the show weekend but the big fixture is our game versus the staff and parents of bedales school spectators welcome anonymous not verified mon 19052014 931pm  ','0'),('524','en','node_search',' buriton cc vs lavant buriton cc vs lavant our final fixture of the season against a strong local team spectators always welcome anonymous not verified mon 19052014 933pm  ','0'),('525','en','node_search',' the gemini consort at st mary s the gemini consort at st mary s pachasapopruuacuhovistajotrichidrarudocukonotredau a concert entitled midsummer music performed by an all female group anonymous not verified sat 7062014 1242pm  ','0'),('526','en','node_search',' birdsong walk was quieter than usual birdsong walk was quieter than usual birdsongwalkcimg3386bestjpg about 20 villagers and friends spent an enchanting evening in the buriton chalk pits local nature reserve on 15th may and emerged much wiser about the distinctive bird songs of many of our local species doug jones wed 11062014 537pm  ','0'),('527','en','node_search',' tennis players turn back time tennis players turn back time vintagetennisjpeg more than 50 players took a step back in time on 18th may by donning their vintage white clothes digging out their old wooden rackets and hitting the courts for an afternoon of tennis as it used to be doug jones wed 11062014 539pm  ','0'),('528','en','node_search',' sponsored toddle raises over 300 for good causes sponsored toddle raises over 300 for good causes sponsoredtoddle2014cjpg children parents helpers and friends of buriton nursery school took part in a sponsored toddle on the village recreation ground in may to raise money for school funds and for their friends in africa doug jones wed 11062014 542pm  ','0'),('529','en','node_search',' local connections with dday are revealed local connections with dday are revealed fredsmapfinalcjpg over 100 people packed into the church on 10th june to hear two fascinating presentations about operation overlord and the dday landings of 70 years ago doug jones wed 11062014 547pm  ','0');
INSERT INTO `search_dataset` VALUES ('530','en','node_search',' village show to be in three venues this year village show to be in three venues this year villageshow1cjpg even though the village hall will not be available this year the show will go on on saturday 16th august as planned doug jones mon 23062014 253pm  ','0'),('531','en','node_search',' treasuretrove of old documents donated to buriton heritage bank treasuretrove of old documents donated to buriton heritage bank lcpapersselectionjpg almost 50 old documents about the parish some of which are 300 years old return home doug jones sat 12072014 713pm  ','0'),('532','en','node_search',' parish campout parish campout pachasapopruuacuhovistajotrichidrarudocukonotredau all are welcome at buriton 39 s popular annual 39 campout 39 on the recreation ground commencing on saturday 19th july and camping overnight until about 1pm on sunday 20th doug jones sat 12072014 719pm  ','0'),('533','en','node_search',' over 10000 orchids at coulters dean this year over 10000 orchids at coulters dean this year coultersdeanimg3913jpg and a sea of roundheaded rampions looks set to follow doug jones sat 12072014 722pm  ','0'),('534','en','node_search',' new south downs show in the parish this year at the queen elizabeth country park august bank holiday weekend new south downs show in the parish this year at the queen elizabeth country park august bank holiday weekend pachasapopruuacuhovistajotrichidrarudocukonotredau the show promises scores of activities in a main arena and many other attractions with a particular focus on the landscape of the south downs and on managing pressures in the national park doug jones mon 4082014 721pm  ','0'),('535','en','node_search',' new south downs show in the parish this year at the queen elizabeth country park august bank holiday weekend new south downs show in the parish this year at the queen elizabeth country park august bank holiday weekend pachasapopruuacuhovistajotrichidrarudocukonotredau the show promises scores of activities in a main arena and many other attractions with a particular focus on the landscape of the south downs and on managing pressures in the national park doug jones mon 4082014 722pm  ','0');
