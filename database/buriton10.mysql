INSERT INTO `node__field_subtitle` VALUES ('news','0','1401','1455','en','0','<p><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt">The mobile van will not be able to visit the village on Friday 25 September – and there are new plans in October</span></span></span></p>\r\n','full_html'),('news','0','1402','1456','en','0','<p><span style="font-size:12.0pt"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;">Hard work in Nature Reserve for school children</span></span></p>\r\n','full_html'),('news','0','1404','1458','en','0','<p>A new childminding service in the village hall</p>\r\n','full_html'),('news','0','1405','1459','en','0','<p>During the Coronavius pandemic an on-line version has been produced in addition to the usual hard copy versions delivered to every household in the parish.&nbsp;&nbsp;</p>\r\n','full_html'),('news','0','1411','1467','en','0','<p><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%"><span style="color:black">Detailed responses to complex proposals from Government and at the Butser Hill Quarries</span></span></span></span></span></span></p>\r\n','full_html'),('news','0','1412','1468','en','0','<p><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt">Community project a step nearer to completion</span></span></span></span></p>\r\n','full_html'),('news','0','1413','1469','en','0','<p><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%"><span style="color:black">Temporary location in Kiln Lane until a High Street site is confirmed by the District Council</span></span></span></span></span></span></p>\r\n','full_html'),('news','0','1414','1470','en','0','<p><span style=