INSERT INTO `node__field_subtitle` VALUES ('news','0','1416','1472','en','0','<p><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;">Would you like to be involved in your local community?</span></span></span></p>\r\n','full_html'),('news','0','1419','1475','en','0','<p style="margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">The District Council is helping to catch offenders</span></span></span></span></span></p>\r\n','full_html'),('quickevent','0','1421','1477','en','0','<p><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="color:#333333">Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, with an opportunity for members of the public to ask questions or make comments in a Public Forum session. Due to the current Government Restrictions on Public Meetings during the Coronavirus Outbreak, Buriton Parish Council has adopted alternative ways of working in order to continue with business whilst upholding democratic principles and compliance with the public health guidance. Members of the public are still able to attend meetings, observe business and ask questions in a Public Forum session. If you have any queries about any Parish Council matter, please continue to contact our Clerk, Mrs Petra Norris, in the normal way: via 07943 536065 or&nbsp;<a href="mailto:buritonparishcouncil@hotmail.co.uk"><span style="color:blue">buritonparishcouncil@hotmail.co.uk</span></a>&nbsp;&nbsp;More details about the Parish Council can be found elsewhere on this website:&nbsp;<a href="http://www.buriton.info/parish-council"><span style="color:blue">http://www.buriton.info/parish-council</span></a></span></span></b></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:11px">&nbsp;</p>\r\n','full_html');
INSERT INTO `node__field_subtitle` VALUES ('quickevent','0','1422','1478','en','0','<p><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="color:#333333">Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. Due to the current Government Restrictions on Public Meetings during the Coronavirus Outbreak, Buriton Parish Council has adopted alternative ways of working in order to continue with business whilst upholding democratic principles and compliance with the public health guidance. Members of the public are still able to attend meetings, observe business and ask questions in a Public Forum session. If you have any queries about any Parish Council matter, please continue to contact our Clerk, Mrs Petra Norris, in the normal way: via 07943 536065 or&nbsp;<a href="mailto:buritonparishcouncil@hotmail.co.uk"><span style="color:blue">buritonparishcouncil@hotmail.co.uk</span></a>&nbsp;&nbsp;More details about the Parish Council can be found elsewhere on this website:&nbsp;<a href="http://www.buriton.info/parish-council"><span style="color:blue">http://www.buriton.info/parish-council</span></a></span></span></b></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:11px">&nbsp;</p>\r\n','full_html'),('quickevent','0','1423','1479','en','0','<p><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="color:#333333">Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. Due to the current Government Restrictions on Public Meetings during the Coronavirus Outbreak, Buriton Parish Council has adopted alternative ways of working in order to continue with business whilst upholding democratic principles and compliance with the public health guidance. Members of the public are still able to attend meetings, observe business and ask questions in a Public Forum session. This meeting, in May 2021, will start at 6.30pm so as&nbsp;to accommodate the Annual Parish Meeting. The date has been&nbsp;brought forward this&nbsp;year because&nbsp;Government legislation&nbsp;does not allow any&nbsp;Councils&nbsp; to hold virtual meetings&nbsp;after 7th May - but also currently prohibits indoor gatherings,&nbsp;meetings or events. If you have </span></span></b></span></span></span></span><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="color:#333333">any queries about any Parish Council matter, please continue to contact our Clerk, Mrs Petra Norris, in the normal way: via 07943 536065 or&nbsp;<a href="mailto:buritonparishcouncil@hotmail.co.uk"><span style="color:blue">buritonparishcouncil@hotmail.co.uk</span></a>&nbsp;&nbsp;More details about the Parish Council can be found elsewhere on this website:&nbsp;<span style="color:blue"><a href="http://www.buriton.info/parish-council">http://www.buriton.info/parish-council</a>.&nbsp;</span></span></span></b></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:11px">&nbsp;</p>\r\n','full_html');
INSERT INTO `node__field_subtitle` VALUES ('quickevent','0','1424','1480','en','0','<p><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="color:#333333">Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. Due&nbsp;to&nbsp; Government Restrictions on Public Meetings during the Coronavirus Outbreak, Buriton Parish Council adopted alternative ways of working in order to continue with business whilst upholding democratic principles and compliance with the public health guidance. It&nbsp;is&nbsp;anticipated that this meeting of the Parish Council will take place in the main part of the&nbsp;village hall. Members of the public will be&nbsp;able to attend meetings, observe business and ask questions in a Public Forum session. If you have any queries about any Parish Council matter, please continue to contact our Clerk, Mrs Petra Norris, in the normal way: via 07943 536065 or&nbsp;<a href="mailto:buritonparishcouncil@hotmail.co.uk"><span style="color:blue">buritonparishcouncil@hotmail.co.uk</span></a>&nbsp;&nbsp;More details about the Parish Council can be found elsewhere on this website:&nbsp;<a href="http://www.buriton.info/parish-council"><span style="color:blue">http://www.buriton.info/parish-council</span></a></span></span></b></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:11px">&nbsp;</p>\r\n','full_html'),('quickevent','0','1425','1481','en','0','<p><b>Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. Due&nbsp;to&nbsp; Government Restrictions on Public Meetings during the Coronavirus Outbreak, Buriton Parish Council adopted alternative ways of working in order to continue with business whilst upholding democratic principles and compliance with the public health guidance. It&nbsp;is&nbsp;anticipated that this meeting of the Parish Council will take place in the main part of the&nbsp;village hall. Members of the public will be&nbsp;able to attend meetings, observe business and ask questions in a Public Forum session. If you have any queries about any Parish Council matter, please continue to contact our Clerk, Mrs Petra Norris, in the normal way: via 07943 536065 or&nbsp;<a href="mailto:buritonparishcouncil@hotmail.co.uk">buritonparishcouncil@hotmail.co.uk</a>&nbsp;&nbsp;More details about the Parish Council can be found elsewhere on this website:&nbsp;<a href="http://www.buriton.info/parish-council">http://www.buriton.info/parish-council</a></b></p>\r\n\r\n<p style="margin-bottom:11px">&nbsp;</p>\r\n','full_html');
INSERT INTO `node__field_subtitle` VALUES ('quickevent','0','1426','1482','en','0','<p><b>Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. Due&nbsp;to&nbsp; Government Restrictions on Public Meetings during the Coronavirus Outbreak, Buriton Parish Council adopted alternative ways of working in order to continue with business whilst upholding democratic principles and compliance with the public health guidance. It&nbsp;is&nbsp;anticipated that this meeting of the Parish Council will take place in the main part of the&nbsp;village hall. Members of the public will be&nbsp;able to attend meetings, observe business and ask questions in a Public Forum session. If you have any queries about any Parish Council matter, please continue to contact our Clerk, Mrs Petra Norris, in the normal way: via 07943 536065 or&nbsp;<a href="mailto:buritonparishcouncil@hotmail.co.uk">buritonparishcouncil@hotmail.co.uk</a>&nbsp;&nbsp;More details about the Parish Council can be found elsewhere on this website:&nbsp;<a href="http://www.buriton.info/parish-council">http://www.buriton.info/parish-council</a></b></p>\r\n\r\n<p style="margin-bottom:11px">&nbsp;</p>\r\n','full_html'),('news','0','1428','1484','en','0','<p style="margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="line-height:107%">An opportunity to have your say …</span></span></b></span></span></span></p>\r\n','full_html'),('event','0','1429','1485','en','0','<p class="CxSpFirst"><span style="font-size:12.0pt">Saturday 19 to Tuesday 29 December</span></p>\r\n','full_html'),('news','0','1434','1490','en','0','<p><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><b><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;">During the Christmas and New Year period, revised dates will be in place for EHDC waste and recycling collections.</span></b></span></span></p>\r\n','full_html');
INSERT INTO `node__field_subtitle` VALUES ('news','0','1435','1491','en','0','<p><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt">Everyone must stay at home, apart from very limited exceptions.</span></span></span></span></span></p>\r\n','full_html'),('news','0','1436','1492','en','0','<p>Can you help?</p>\r\n','full_html'),('news','0','1437','1493','en','0','<p>New trees for old!!</p>\r\n','full_html'),('news','0','1438','1494','en','0','<p>Following the Prime Minister’s announcement on the evening of 4th January, this area is now part of the national lockdown.</p>\r\n','full_html'),('news','0','1439','1495','en','0','<p style="margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="background:white"><span style="line-height:107%"><span style="color:#333333">Peter Gray can help you avoid trips to supermarkets</span></span></span></span></span></span></span></p>\r\n','full_html'),('news','0','1440','1496','en','0','<p style="margin-bottom:15px"><span style="font-size:12pt"><span style="background:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="background:white"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;"><span style="color:#333333">F</span></span></span><span style="background:white"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;"><span style="color:#333333">raudsters are trying to steal personal details …</span></span></span></span></span></span></p>\r\n','full_html'),('news','0','1441','1497','en','0','<p style="margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">Please help with pictures and messages of support</span></span><