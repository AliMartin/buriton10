INSERT INTO `search_dataset` VALUES ('640','en','node_search',' far from the madding crowd far from the madding crowd pachasapopruuacuhovistajotrichidrarudocukonotredau buriton 39 s cinema is back in action in the village hall for the autumn 2015 season so why not come along to see this beautifullymade new version of hardy s timeless classic novel with ravishing photography from and excellent performances including carey mulligan and michael sheen  doug jones wed 16092015 509pm  ','0'),('641','en','node_search',' a royal night out a royal night out pachasapopruuacuhovistajotrichidrarudocukonotredau on the eve of ve day our two young princesses escape buckingham palace to meet the people a lovely romantic drama starring rupert everett and emily watson doug jones wed 16092015 510pm  ','0'),('642','en','node_search',' mr holmes mr holmes pachasapopruuacuhovistajotrichidrarudocukonotredau ian mckellen is a tour de force as the ageing holmes with one last case to solve  doug jones wed 16092015 511pm  ','0'),('643','en','node_search',' cinderella cinderella pachasapopruuacuhovistajotrichidrarudocukonotredau an allstar cast kate blanchett helena bonhamcarter lily james and fabulous costumes in kenneth branagh s magical retelling of this favourite fairytale nb this film starts at 6pm with doors open from 530 doug jones wed 16092015 512pm  ','0'),('644','en','node_search','  films in buriton are back autumn season 2015  films in buriton are back autumn season 2015 film flyer edit 2 33 percentjpg buriton s cinema is back in action in the village hall for the autumn 2015 season so why not make a note of the dates and details below to ensure a series of entertaining evenings and some good chats with friends and neighbours  doug jones wed 16092015 518pm  ','0'),('645','en','node_search','  bygone buriton local history exhibition and open day  bygone buriton local history exhibition and open day pachasapopruuacuhovistajotrichidrarudocukonotredau the annual local history exhibitio