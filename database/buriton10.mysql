INSERT INTO `search_dataset` VALUES ('360','en','node_search',' finals of buriton tennis tournaments finals of buriton tennis tournaments pachasapopruuacuhovistajotrichidrarudocukonotredau the second day of the tennis club s finals weekend anyone is welcome to watch the culmination of the club s annual tennis tournaments doug jones mon 7012013 1127am  ','0'),('361','en','node_search',' local history and heritage exhibition local history and heritage exhibition pachasapopruuacuhovistajotrichidrarudocukonotredau large exhibition of local history including hundreds of old photographs brought together in the buriton heritage bank in the village hall from 11am until 4pm copies of all the local history books will be available for sale doug jones mon 7012013 1132am  ','0'),('362','en','node_search',' village show village show pachasapopruuacuhovistajotrichidrarudocukonotredau buriton s popular annual village show including flowers fruit vegetables baking and arts crafts entries in the morning showtime in the afternoon doug jones mon 7012013 1137am  ','0'),('363','en','node_search',' bioblitz bioblitz pachasapopruuacuhovistajotrichidrarudocukonotredau come and help identify as many species of wildlife as possible in a 24hour period begins at 4pm on saturday 10th august and finishes at 4pm on sunday 11th more details from queen elizabeth country park on 2392 595040 doug jones mon 7012013 1143am  ','0'),('364','en','node_search',' bioblitz bioblitz pachasapopruuacuhovistajotrichidrarudocukonotredau come and help identify as many species of wildlife as possible in a 24hour period begins at 4pm on saturday 10th august and finishes at 4pm on sunday 11th more details from queen elizabeth country park on 2392 595040 doug jones mon 7012013 1143am  ','0'),('365','en','node_search',' great expectations film night in buriton village hall great expectations film night in buriton village hall pachasapopruuacuhovistajotrichidrarudocukonotredau great new film released in 2012 starring hel