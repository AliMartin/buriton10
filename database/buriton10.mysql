INSERT INTO `search_dataset` VALUES ('1394','en','node_search',' apple pressing give it a go  apple pressing give it a go  pouringjuicelandscapedscn01541jpeg anonymous not verified mon 24082020 822am  ','0'),('1395','en','node_search',' parish council update report august 2020 parish council update report august 2020 doug jones tue 25082020 850am bpc update report august 2020pdf update reports 2020 2021 ','0'),('1397','en','node_search',' a chance to make your own juice or cider a chance to make your own juice or cider anonymous not verified tue 25082020 1217pm apple pressing a group of villagers has organised a series of communal apple pressings this autumn the thing is many of us have an apple tree or two in the garden but no access to a press so much of the harvest goes to waste the idea is to bring your own apples help mill and press them and take away your juice we are fortunate to have access to a couple of privatelyowned presses in the area no fee and no experience required there are some howto guides about preserving juice and cidermaking at the bottom of this page if the pressings go well we may also get together again around the new year for a tasting who made the best juice and cider wassail the old apple tree and all that and if the project proves popular perhaps we should consider setting up a cooperative in future first point of contact if you want to get involved buzz cousins cousinsjulien gmailcom 1730 263499 how to preserve raw juicepdf how to make pasteurised juicepdf how to make ciderlightpdf how to make ciderstrongpdf wheretogetkitpdf ','0'),('1398','en','node_search',' tai chi sessions tai chi sessions tai chijpg the popular tai chi sessions are set to continue  doug jones sun 20092020 852am  ','0'),('1399','en','node_search','  home front walk to visit buriton cancelled  home front walk to visit buriton cancelled abf walkjpg 100km walk in the footsteps of those who fought in wwi and wwii to raise funds for soldiers and veterans doug jones sun 2