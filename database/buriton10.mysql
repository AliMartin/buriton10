INSERT INTO `search_dataset` VALUES ('646','en','node_search',' quiz night in buriton the antidote to ordinary quiz nights what the  quiz night in buriton the antidote to ordinary quiz nights what the  pachasapopruuacuhovistajotrichidrarudocukonotredau also known as 34 pm 39 s question time 34 in buriton village hall doug jones wed 16092015 536pm  ','0'),('648','en','node_search',' buriton and the first world war buriton and the first world war ww1 logo 2jpg what was happening at home and abroad 100 years ago  doug jones sun 4102015 942pm  ','0'),('649','en','node_search',' photos of little wonder bus sent from miami in time for history exhibition photos of little wonder bus sent from miami in time for history exhibition little wonder busjpg the annual bygone buriton event attracted almost 200 visitors to st mary s church on 26th september including families from around the country doug jones sun 4102015 945pm  ','0'),('650','en','node_search',' new funkey choir for buriton would you like to join in  new funkey choir for buriton would you like to join in  choirpng the funkey choir starts on sunday 4th october 2015 430 530pm in buriton church and on sundays thereafter  doug jones sun 4102015 947pm  ','0'),('651','en','node_search',' buriton and the first world war buriton and the first world war ww1 logo 2jpg what was happening at home and abroad 100 years ago  doug jones sun 4102015 949pm  ','0'),('653','en','node_search',' edward thomas local literary giant and war poet edward thomas local literary giant and war poet pachasapopruuacuhovistajotrichidrarudocukonotredau edward thomas will have been familiar with many of the lanes and pathways around buriton and petersfield doug jones sun 4102015 954pm  ','0'),('654','en','node_search','  bygone buriton calendar for 2016  bygone buriton calendar for 2016 calendar 2016 spread 1jpg there s a new twist to the buriton parish calendar for 2016 but it s an old twist  doug jones sun 4102015 955pm  ','0'),('656','en','node_sea