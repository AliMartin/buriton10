{s:9:"\0*\0string";s:140:"Existing submissions that have conditionally hidden elements will have the element''s submission data cleared when the submission is updated.";s:12:"\0*\0arguments";a:0:{}s:10:"\0*\0options";a:0:{}}}}s:4:"link";a:3:{s:5:"#type";s:4:"link";s:6:"#title";O:48:"Drupal\\Core\\StringTranslation\\TranslatableMarkup":3:{s:9:"\0*\0string";s:10:"Learn more";s:12:"\0*\0arguments";a:0:{}s:10:"\0*\0options";a:0:{}}s:4:"#url";O:15:"Drupal\\Core\\Url":12:{s:15:"\0*\0urlGenerator";N;s:15:"\0*\0urlAssembler";N;s:16:"\0*\0accessManager";N;s:12:"\0*\0routeName";N;s:18:"\0*\0routeParameters";a:0:{}s:10:"\0*\0options";a:1:{s:8:"external";b:1;}s:11:"\0*\0external";b:1;s:11:"\0*\0unrouted";b:1;s:6:"\0*\0uri";s:35:"https://www.drupal.org/node/2956589";s:15:"\0*\0internalPath";N;s:14:"\0*\0_serviceIds";a:0:{}s:18:"\0*\0_entityStorages";a:0:{}}}}s:19:"webform_update_8187";s:320:"<strong>ATTENTION DEVELOPERS!!!</strong> Please make sure to download and update the <a href="https://github.com/RobinHerbots/Inputmask">Input Mask</a> library to version 5.0.x <a href="https://www.drupal.org/docs/8/modules/webform/webform-libraries">Learn more about updating the Webform module''s external libraries</a>";s:19:"webform_update_8622";s:261:"<strong>ATTENTION!!!</strong> The default Contact webform, included with the Webform module, has been updated to send the confirmation email to an authenticated user''s email address. <a href="https://www.drupal.org/project/webform/releases/6.0.2">Learn more</a>";}}');
