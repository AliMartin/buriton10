INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1362','1414','en','0','<p><span style="font-size:11pt"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="color:#333333">Fridays, 12.30-2pm in the Village Inn car park</span></span></span></span></p>\r\n','full_html'),('news','0','1365','1418','en','0','<p><span style="font-size:11pt"><span style="background:white"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span lang="EN-US" style="font-size:12.0pt"><span style="color:#0a0a0a">Restraint, responsibility and respect to be observed in the South Downs</span></span></span></span></span></p>\r\n','full_html'),('news','0','1371','1424','en','0','<p>There has been lots of creative activity during the lockdown - follow the Art Trail from Saturday 20 June &nbsp;</p>\r\n','full_html'),('news','0','1373','1426','en','0','<p><span style="font-size:11pt"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:10.5pt"><span style="background:white"><span style="font-family:&quot;Helvetica&quot;,sans-serif"><span style="color:#333333">During the Coronavius pandemic an on-line version has been produced in addition to the usual hard copy versions delivered to every household in the parish.&nbsp;</span></span></span></span></span></span>&nbsp;</p>\r\n','full_html'),('news','0','1375','1428','en','0','<p><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">Hoping to re-open as soon as is it is safe to do so – please read more ...</span></span></span></p>\r\n','full_html'),('news','0','1376','1429','en','0','<p><span style="font-size:12.0pt"><span style="font-family:&quot;Calibri&quot;,sans-serif">Do you grow apples, and always fancied getting some juice out of them – but never got around to it? Read more ...</span></span></p>\r\n','full_html'),('news','0','1378','1431','en','0','<h2>Covid has clobbered our show. Instead you can enter at buritonvillageshow.co.uk &nbsp;For details…</h2>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1380','1433','en','0','<p style="margin-bottom:14px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="color:black">Initial phase completed in spite of coronavirus</span></span></span></span></span></p>\r\n','full_html'),('news','0','1381','1434','en','0','<p><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;">Re-opened – but caution required. Please read all the following information ...</span></span></span></p>\r\n','full_html'),('event','0','1385','1439','en','0','<p><span style="font-size:11pt"><span style="line-height:115%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="line-height:115%">Sunday 16<sup>th</sup> August – 10am</span></span></span></span></span></p>\r\n','full_html'),('news','0','1386','1440','en','0','<p><span style="font-size:11pt"><span style="line-height:115%"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="line-height:115%">Give a donation to save a life – can you help?</span></span></b></span></span></span></p>\r\n','full_html'),('news','0','1389','1443','en','0','<p class="MsoNoSpacing">Congratulations to Dave Williams, Abigail McKern, Jonathan Jones, Ros Coles, Greg Boy, Logan &amp; Joshua Hooker and many more</p>\r\n','full_html'),('news','0','1392','1446','en','0','<p><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">Anniversary marked quietly but with feeling</span></span></span></span></span></p>\r\n','full_html'),('news','0','1398','1452','en','0','<p><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif">The popular Tai Chi sessions are set to continue …</span></span></p>\r\n','full_html'),('event','0','1399','1453','en','0','<p><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt">100km walk in&nbsp;the footsteps of those who fought in WWI and WWII – to raise funds for soldiers and veterans.</span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1401','1455','en','0','<p><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt">The mobile van will not be able to visit the village on Friday 25 September – and there are new plans in October</span></span></span></p>\r\n','full_html'),('news','0','1402','1456','en','0','<p><span style="font-size:12.0pt"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;">Hard work in Nature Reserve for school children</span></span></p>\r\n','full_html'),('news','0','1404','1458','en','0','<p>A new childminding service in the village hall</p>\r\n','full_html'),('news','0','1405','1459','en','0','<p>During the Coronavius pandemic an on-line version has been produced in addition to the usual hard copy versions delivered to every household in the parish.&nbsp;&nbsp;</p>\r\n','full_html'),('news','0','1411','1467','en','0','<p><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%"><span style="color:black">Detailed responses to complex proposals from Government and at the Butser Hill Quarries</span></span></span></span></span></span></p>\r\n','full_html'),('news','0','1412','1468','en','0','<p><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt">Community project a step nearer to completion</span></span></span></span></p>\r\n','full_html'),('news','0','1413','1469','en','0','<p><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%"><span style="color:black">Temporary location in Kiln Lane until a High Street site is confirmed by the District Council</span></span></span></span></span></span></p>\r\n','full_html'),('news','0','1414','1470','en','0','<p><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">Latest implications of Government Regulations</span></span></span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1416','1472','en','0','<p><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;">Would you like to be involved in your local community?</span></span></span></p>\r\n','full_html'),('news','0','1419','1475','en','0','<p style="margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">The District Council is helping to catch offenders</span></span></span></span></span></p>\r\n','full_html'),('quickevent','0','1421','1477','en','0','<p><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="color:#333333">Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, with an opportunity for members of the public to ask questions or make comments in a Public Forum session. Due to the current Government Restrictions on Public Meetings during the Coronavirus Outbreak, Buriton Parish Council has adopted alternative ways of working in order to continue with business whilst upholding democratic principles and compliance with the public health guidance. Members of the public are still able to attend meetings, observe business and ask questions in a Public Forum session. If you have any queries about any Parish Council matter, please continue to contact our Clerk, Mrs Petra Norris, in the normal way: via 07943 536065 or&nbsp;<a href="mailto:buritonparishcouncil@hotmail.co.uk"><span style="color:blue">buritonparishcouncil@hotmail.co.uk</span></a>&nbsp;&nbsp;More details about the Parish Council can be found elsewhere on this website:&nbsp;<a href="http://www.buriton.info/parish-council"><span style="color:blue">http://www.buriton.info/parish-council</span></a></span></span></b></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:11px">&nbsp;</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','1422','1478','en','0','<p><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="color:#333333">Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. Due to the current Government Restrictions on Public Meetings during the Coronavirus Outbreak, Buriton Parish Council has adopted alternative ways of working in order to continue with business whilst upholding democratic principles and compliance with the public health guidance. Members of the public are still able to attend meetings, observe business and ask questions in a Public Forum session. If you have any queries about any Parish Council matter, please continue to contact our Clerk, Mrs Petra Norris, in the normal way: via 07943 536065 or&nbsp;<a href="mailto:buritonparishcouncil@hotmail.co.uk"><span style="color:blue">buritonparishcouncil@hotmail.co.uk</span></a>&nbsp;&nbsp;More details about the Parish Council can be found elsewhere on this website:&nbsp;<a href="http://www.buriton.info/parish-council"><span style="color:blue">http://www.buriton.info/parish-council</span></a></span></span></b></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:11px">&nbsp;</p>\r\n','full_html'),('quickevent','0','1423','1479','en','0','<p><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="color:#333333">Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. Due to the current Government Restrictions on Public Meetings during the Coronavirus Outbreak, Buriton Parish Council has adopted alternative ways of working in order to continue with business whilst upholding democratic principles and compliance with the public health guidance. Members of the public are still able to attend meetings, observe business and ask questions in a Public Forum session. This meeting, in May 2021, will start at 6.30pm so as&nbsp;to accommodate the Annual Parish Meeting. The date has been&nbsp;brought forward this&nbsp;year because&nbsp;Government legislation&nbsp;does not allow any&nbsp;Councils&nbsp; to hold virtual meetings&nbsp;after 7th May - but also currently prohibits indoor gatherings,&nbsp;meetings or events. If you have </span></span></b></span></span></span></span><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="color:#333333">any queries about any Parish Council matter, please continue to contact our Clerk, Mrs Petra Norris, in the normal way: via 07943 536065 or&nbsp;<a href="mailto:buritonparishcouncil@hotmail.co.uk"><span style="color:blue">buritonparishcouncil@hotmail.co.uk</span></a>&nbsp;&nbsp;More details about the Parish Council can be found elsewhere on this website:&nbsp;<span style="color:blue"><a href="http://www.buriton.info/parish-council">http://www.buriton.info/parish-council</a>.&nbsp;</span></span></span></b></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:11px">&nbsp;</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','1424','1480','en','0','<p><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="color:#333333">Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. Due&nbsp;to&nbsp; Government Restrictions on Public Meetings during the Coronavirus Outbreak, Buriton Parish Council adopted alternative ways of working in order to continue with business whilst upholding democratic principles and compliance with the public health guidance. It&nbsp;is&nbsp;anticipated that this meeting of the Parish Council will take place in the main part of the&nbsp;village hall. Members of the public will be&nbsp;able to attend meetings, observe business and ask questions in a Public Forum session. If you have any queries about any Parish Council matter, please continue to contact our Clerk, Mrs Petra Norris, in the normal way: via 07943 536065 or&nbsp;<a href="mailto:buritonparishcouncil@hotmail.co.uk"><span style="color:blue">buritonparishcouncil@hotmail.co.uk</span></a>&nbsp;&nbsp;More details about the Parish Council can be found elsewhere on this website:&nbsp;<a href="http://www.buriton.info/parish-council"><span style="color:blue">http://www.buriton.info/parish-council</span></a></span></span></b></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:11px">&nbsp;</p>\r\n','full_html'),('quickevent','0','1425','1481','en','0','<p><b>Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. Due&nbsp;to&nbsp; Government Restrictions on Public Meetings during the Coronavirus Outbreak, Buriton Parish Council adopted alternative ways of working in order to continue with business whilst upholding democratic principles and compliance with the public health guidance. It&nbsp;is&nbsp;anticipated that this meeting of the Parish Council will take place in the main part of the&nbsp;village hall. Members of the public will be&nbsp;able to attend meetings, observe business and ask questions in a Public Forum session. If you have any queries about any Parish Council matter, please continue to contact our Clerk, Mrs Petra Norris, in the normal way: via 07943 536065 or&nbsp;<a href="mailto:buritonparishcouncil@hotmail.co.uk">buritonparishcouncil@hotmail.co.uk</a>&nbsp;&nbsp;More details about the Parish Council can be found elsewhere on this website:&nbsp;<a href="http://www.buriton.info/parish-council">http://www.buriton.info/parish-council</a></b></p>\r\n\r\n<p style="margin-bottom:11px">&nbsp;</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','1426','1482','en','0','<p><b>Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. Due&nbsp;to&nbsp; Government Restrictions on Public Meetings during the Coronavirus Outbreak, Buriton Parish Council adopted alternative ways of working in order to continue with business whilst upholding democratic principles and compliance with the public health guidance. It&nbsp;is&nbsp;anticipated that this meeting of the Parish Council will take place in the main part of the&nbsp;village hall. Members of the public will be&nbsp;able to attend meetings, observe business and ask questions in a Public Forum session. If you have any queries about any Parish Council matter, please continue to contact our Clerk, Mrs Petra Norris, in the normal way: via 07943 536065 or&nbsp;<a href="mailto:buritonparishcouncil@hotmail.co.uk">buritonparishcouncil@hotmail.co.uk</a>&nbsp;&nbsp;More details about the Parish Council can be found elsewhere on this website:&nbsp;<a href="http://www.buriton.info/parish-council">http://www.buriton.info/parish-council</a></b></p>\r\n\r\n<p style="margin-bottom:11px">&nbsp;</p>\r\n','full_html'),('news','0','1428','1484','en','0','<p style="margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="line-height:107%">An opportunity to have your say …</span></span></b></span></span></span></p>\r\n','full_html'),('event','0','1429','1485','en','0','<p class="CxSpFirst"><span style="font-size:12.0pt">Saturday 19 to Tuesday 29 December</span></p>\r\n','full_html'),('news','0','1434','1490','en','0','<p><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><b><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;">During the Christmas and New Year period, revised dates will be in place for EHDC waste and recycling collections.</span></b></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1435','1491','en','0','<p><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt">Everyone must stay at home, apart from very limited exceptions.</span></span></span></span></span></p>\r\n','full_html'),('news','0','1436','1492','en','0','<p>Can you help?</p>\r\n','full_html'),('news','0','1437','1493','en','0','<p>New trees for old!!</p>\r\n','full_html'),('news','0','1438','1494','en','0','<p>Following the Prime Minister’s announcement on the evening of 4th January, this area is now part of the national lockdown.</p>\r\n','full_html'),('news','0','1439','1495','en','0','<p style="margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="background:white"><span style="line-height:107%"><span style="color:#333333">Peter Gray can help you avoid trips to supermarkets</span></span></span></span></span></span></span></p>\r\n','full_html'),('news','0','1440','1496','en','0','<p style="margin-bottom:15px"><span style="font-size:12pt"><span style="background:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="background:white"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;"><span style="color:#333333">F</span></span></span><span style="background:white"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;"><span style="color:#333333">raudsters are trying to steal personal details …</span></span></span></span></span></span></p>\r\n','full_html'),('news','0','1441','1497','en','0','<p style="margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">Please help with pictures and messages of support</span></span></span></span></span></p>\r\n','full_html'),('news','0','1443','1499','en','0','<p><span style="font-size:11pt"><span style="line-height:normal"><span style="text-autospace:none"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt">Important information from Hampshire’s NHS</span></span></span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1449','1505','en','0','<p style="margin-bottom:15px"><span style="font-size:12pt"><span style="background:white"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="background:white"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;"><span style="color:black">Parish Council reactions, progress and outcomes.</span></span></span></span></span></span></p>\r\n','full_html'),('news','0','1450','1506','en','0','<p class="x"><span style="font-size:11pt"><span style="line-height:105%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="line-height:105%">Late change of plan: parking spaces will no longer be required for this&nbsp;project. The details below have now been superseded as Network Rail has found an alternative location which "should reduce disruption and disturbance in the local area".</span></span></span></span></span></p>\r\n','full_html'),('news','0','1451','1507','en','0','<p style="margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">The ‘Big Buriton Boost’ is being greatly appreciated </span></span></span></span></span></p>\r\n','full_html'),('news','0','1452','1508','en','0','<p><span style="font-size:11pt"><span style="line-height:105%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="line-height:105%">The Parish Council has planted more trees recently – and there’s a chance to buy your own.</span></span></span></span></span></p>\r\n','full_html'),('news','0','1453','1509','en','0','<p class="x"><span style="font-size:11pt"><span style="line-height:105%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="line-height:105%">Buriton is a special place in the South Downs International Dark Skies Reserve</span></span></span></span></span></p>\r\n','full_html'),('news','0','1466','1522','en','0','<p>As well as letting some of the grass grow ...</p>\r\n','full_html');
