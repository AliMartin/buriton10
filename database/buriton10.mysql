DROP TABLE IF EXISTS `node_revision__field_subtitle`;
CREATE TABLE `node_revision__field_subtitle` (   `bundle` varchar(128) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL DEFAULT '' COMMENT 'The field instance bundle to which this row belongs, used when deleting a field instance',   `deleted` tinyint(4) NOT NULL DEFAULT 0 COMMENT 'A boolean indicating whether this data item has been deleted',   `entity_id` int(10) unsigned NOT NULL COMMENT 'The entity id this data is attached to',   `revision_id` int(10) unsigned NOT NULL COMMENT 'The entity revision id this data is attached to',   `langcode` varchar(32) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL DEFAULT '' COMMENT 'The language code for this data item.',   `delta` int(10) unsigned NOT NULL COMMENT 'The sequence number for this data item, used for multi-value fields',   `field_subtitle_value` longtext NOT NULL,   `field_subtitle_format` varchar(255) CHARACTER SET ascii COLLATE ascii_general_ci DEFAULT NULL,   PRIMARY KEY (`entity_id`,`revision_id`,`deleted`,`delta`,`langcode`),   KEY `bundle` (`bundle`),   KEY `revision_id` (`revision_id`),   KEY `field_subtitle_format` (`field_subtitle_format`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='Revision archive storage for node field field_subtitle.';
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','22','22','und','0','Have you got things to sell? The book a table at the Table Top Sale on Saturday 5 February 2011, 12pm - 3pm at Buriton Village Hall. Book your table as soon as possible to avoid disappointment.',null),('news','0','26','26','und','0','<p>If you receive a new mobile phone for Christmas, please don''t throw away the old one. It can be used to raise money for a good cause! James Raftery, 13, who lives in Buriton, has a scheme whereby old mobiles can be recycled. He will collect your old mobile and help raise money for our "Buy a Bog for Dominase" campaign.</p>\r\n','full_html'),('news','0','27','27','und','0','Help support Buriton Tennis Club and book a table at the Table Top Sale at Buriton Village Hall on Saturday 5th February, 12pm - 3pm. Book your table as soon as possible to avoid disappointment!',null),('news','0','28','28','und','0','<p>If anybody identifies a person who is vulnerable and who may also be worried that their fuel supply is about to run out (or has run out), the following telephone number at HantsDirect will be staffed (24hrs) to coordinate this: 0845 603 5630 (Adult Services).</p>\r\n','full_html'),('news','0','35','35','und','0','<p>Conditions in Dominase are very poor and quite unhealthy. Very few households have their own toilets, there is no running water and many people just go and squat in the grass near to houses and paths.</p>\r\n','full_html'),('event','0','37','37','und','0','Plans for a day of festivities and fun in Buriton on Sunday 3rd June have been revealed in the Parish Magazine.  And bookings are needed for the Street Party by 1st May so that the organisers know how many tables and chairs to obtain. \r\n',null),('event','0','38','38','und','0','This annual event in the Village Hall, the antidote to ordinary quiz nights, raises funds for our sister community of Dominase in Ghana.  In 2010 we raised over ?1,500 to help with toilets and sanitation.  Please help us to raise even more in 2011.  Only ?5 per person ? and lots of fun !!   ',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','40','40','und','0','Monthly Parish Council meeting at The Village Hall.',null),('news','0','45','45','en','0','<p>One of the first areas of support provided by villagers in Buriton was to help provide a health clinic with a generator and funding for living quarters for a nurse. Without this effort there was a risk that the health authorities may have closed the clinic.</p>\r\n','full_html'),('news','0','46','46','en','0','<p>There is no running water in this part of Ghana and only a few boreholes and wells. The local river, often used for washing, is very dirty and can cause chronic disease and death. The Village-to-Village Groups in Buriton and Dominase therefore agreed that an early priority should be helping to improve supplies of clean water.</p>\r\n','full_html'),('news','0','47','47','en','0','<p>Children in Dominase are not fortunate to have many of the educational aids that we take for granted. Pens, pencils, paper, books and school uniforms are all very expensive for poor families. Without any electricity in their schools, most children can only learn computer skills by looking at books with pictures of keyboards.</p>\r\n','full_html'),('news','0','48','48','en','0','<p>On one of our early visits to Dominase, thanks to village connections with (and the generosity of) Corporate Mobile Recycling Ltd, we were able to take a number of recycled mobile phones with us.</p>\r\n','full_html'),('quickevent','0','54','54','en','0','At the Village Hall.',null),('news','0','58','58','en','0','<p>Many thanks to everybody who has helped with our ''Buy a Bog'' fund-raising campaign to help improve sanitation conditions in our sister community of Dominase. Photographs in earlier messages have shown work taking place on the block of school toilets that we are providing. Here are two more photos (taken in January) which show the building taking shape.</p>\r\n','full_html'),('event','0','75','75','en','0','Almost a shopfloor version of ''Calendar Girls'', the film is based on the Ford women car workers'' strike of 1968, in which female staff sewing seat covers for Cortinas and Zephyrs went on strike for the same wage as men.',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','77','77','en','0','Copy date: 20 March\r\nPublication: early April',null),('quickevent','0','78','78','en','0','Copy date: 20 May\r\nPublication: early June',null),('quickevent','0','79','79','en','0','Copy date: 20 July\r\nPublication: early August',null),('quickevent','0','80','80','en','0','Copy date: 20 September\r\nPublication: early October',null),('quickevent','0','81','81','en','0','Copy date: 20 November\r\nPublication: early December',null),('news','0','86','86','en','0','<p>140 people got into the Medieval mood on February 19th and dined on parish produce in the magnificent Manor Barn.</p>\r\n','full_html'),('event','0','87','87','en','0','It''s that time of year when we try to keep our lanes and public spaces looking clean and tidy.  Can you help?\r\n',null),('event','0','94','94','en','0','Buriton Cricket Club play away at Clanfield.  All welcome!',null),('event','0','95','95','en','0','Buriton Cricket Club play at home against Gentlemen of Bedales at the Recreation Ground.  All welcome!',null),('event','0','96','96','en','0','Buriton Cricket Club play at home against Clanfield at the Recreation Ground.  All welcome!',null),('event','0','97','97','en','0','Buriton Cricket Club play away against DADC (Rowlands Castle).  All welcome!',null),('event','0','98','98','en','0','RESERVE DATE: Buriton Cricket Club play at home against Gentlemen of Bedales at the Recreation Ground.  All welcome!',null),('event','0','99','99','en','0','Buriton Cricket Club play at home against Lavant at the Recreation Ground.  All welcome!',null),('event','0','100','100','en','0','Village Quiz Night - all welcome.  ',null),('event','0','101','101','en','0','Another popular Barn Dance in the magnificent Manor Barn. Tickets are going fast - book soon.  Details below.  ',null),('event','0','102','102','en','0','The Tennis Club''s ''Early Season Round Robin Tournament'' will be held on Sunday 17th April (10am): a good way to warm up for the season and meet more members of the Club.  Everyone welcome - all standards catered for!  Please contact Nigel Harrison (01730 261029) to book your place.',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','103','103','en','0','The Tennis Club''s popular ''Davis Cup'' weekend will be held on Saturday 9th July and Sunday 10th July 2011.  Represent the country of your choice - or simply come along to cheer on the players!',null),('event','0','104','104','en','0','The Tennis Club''s popular ''Davis Cup'' weekend will be held on Saturday 9th July and Sunday 10th July 2011.  Represent the country of your choice - or simply come along to cheer on the players!',null),('event','0','105','105','en','0','The Finals of the Club''s Tournaments - come along and enjoy some exciting matches. All welcome.',null),('event','0','106','106','en','0','The Finals of the Club''s Tournaments - come along and enjoy some exciting matches. All welcome.',null),('event','0','107','107','en','0','Buriton''s annual local history exhibition in the Village Hall: 11am - 4pm.  Fascinating displays of local interest, copies of all the Heritage Bank books for sale and much more ...\r\n\r\n',null),('event','0','108','108','en','0','Come and see all the new born lambs at Nursted Farm (2pm - 5pm).  Part of the ''Down on Buriton''s farms'' programme of farm events, open days, walks and talks during 2011.',null),('event','0','109','109','en','0','Come and see all the new born lambs at Nursted Farm (2pm - 5pm).  Part of the ''Down on Buriton''s farms'' programme of farm events, open days, walks and talks during 2011.',null),('event','0','110','110','en','0','Come and see all the new born lambs at Nursted Farm (2pm - 5pm).  Part of the ''Down on Buriton''s farms'' programme of farm events, open days, walks and talks during 2011.',null),('event','0','111','111','en','0','Come and see all the new born lambs at Nursted Farm (2pm - 5pm).  Part of the ''Down on Buriton''s farms'' programme of farm events, open days, walks and talks during 2011.',null),('event','0','112','112','en','0','Come and see all the new born lambs at Nursted Farm (2pm - 5pm).  Part of the ''Down on Buriton''s farms'' programme of farm events, open days, walks and talks during 2011.',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','113','113','en','0','Let Susan Shone lead you along some farm paths not normally open to the public - followed by tea back at the farm and a stroll around the garden.\r\n\r\n\r\nPlease arrive at Bolinge Hill Farm ready to start on the walk at 2pm.  The walk will take about one to one-and-a-half hours and walking shoes are advisable.  \r\n\r\n\r\nThen everyone is welcome to a lovely afternoon tea and an opportunity to look at the gardens at Bolinge Hill Farm.\r\n\r\n\r\n',null),('event','0','115','115','en','0','A guided walk around the fields and footpaths at Weston Farm - an opportunity to see and learn more about one of our local farms.  Part of the ''Down on Buriton''s farms'' programme of farm events, open days, walks and talks during 2011.',null),('news','0','118','118','en','0','<p>Pupils from Ditcham Park School have recently been fund-raising to help disadvantaged families in Buriton''s sister community of Dominase in rural Ghana.</p>\r\n','full_html'),('news','0','119','119','en','0','<p>Members of Buriton''s Parish Plan team travelled to London in March ? and came home with the top prize in a competition across all counties in the South East of England.</p>\r\n','full_html'),('news','0','120','120','en','0','<p>The pilot stage of Buriton''s programme to provide household toilets in Dominase has now been completed successfully.</p>\r\n','full_html'),('news','0','121','121','en','0','<p>It is exactly ten years since the Buriton Heritage Bank was launched and much has been achieved in that time: a series of nine lavishly illustrated books was published in 2003, free copies were provided to every household in the parish and popular annual Local History exhibitions have been held ever since.</p>\r\n','full_html'),('event','0','124','124','en','0','An occasional discussion group of topical interest.',null),('event','0','125','125','en','0','An occasional discussion group of topical interest.',null),('event','0','126','126','en','0','The next Big Question will be:  "Does it matter what we believe?"',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','127','127','en','0','A family friendly event on Saturday 7th May to celebrate achievements over the past year in the Buriton Chalk Pits project (11am - 3pm). ',null),('event','0','129','129','en','0','First Beer: Sunday May 1st at 8.00pm. at The Five Bells.  A chance for the men of Buriton to get together for a drink and some intelligent conversation.  Starting subject: Euthanasia, can it ever be justified?',null),('event','0','130','130','en','0','First Beer: Sunday June 1st at 8.00pm. at The Five Bells.  A chance for the men of Buriton to get together for a drink and some intelligent conversation.  Starting subject:  Drugs, Doctors and Diseases.',null),('event','0','133','133','en','0','As always, Buriton will be supporting this anuual fund-raising drive for the poor and disadvantaged. Christian Aid aims to attract support for its projects not just from the church community but from all quarters. Collection envelopes will be distributed in advance and collected house-to-house.',null),('event','0','136','136','en','0','This is the third Buriton Wine Challenge in aid of the AGSD-UK. Funds raised will sponsor Allan Muir to take part in a slightly more demanding challenge ? a 1500 mile cycle ride from Pompey to Pompeii in September. All funds raised from the event will go towards supporting families living with Pompe and related ultra-rare diseases and to promote research into improved care and treatments.',null),('news','0','140','140','en','0','<p>Over 100 villagers and friends have booked places for Buriton''s popular antidote to ordinary Quiz Nights: Saturday 14th May, 7.30pm in Buriton Village Hall.</p>\r\n','full_html'),('news','0','143','143','en','0','<p>About 70 parishioners, family and friends were treated to a delightful stroll along farm paths not normally open to the public ? including a magnificent show of bluebells and some impressive Early Purple orchids.</p>\r\n','full_html'),('news','0','144','144','en','0','<p>Scores of parishioners and visitors from further afield came to the first Open Day in the Buriton Chalk Pits on Saturday 7th May. There was a range of activities for all age groups ? enhanced by perfect weather conditions.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','145','145','en','0','In Buriton Village Hall',null),('quickevent','0','146','146','en','0','In Buriton Village Hall',null),('quickevent','0','147','147','en','0','In Buriton Village Hall',null),('quickevent','0','148','148','en','0','In Buriton Village Hall',null),('news','0','149','149','en','0','<p>Over 20 villagers and friends spent an enchanting evening in the Buriton Chalk Pits Local Nature Reserve on Wednesday 11th May ? and emerged much wiser about the distinctive bird songs of many of our local species.</p>\r\n','full_html'),('news','0','150','150','en','0','<p>As well as the successful completion of a number of ''pilot'' toilets for individual households in Dominase, the latrine block at the Marfo Junior Secondary School in Dominase has now been officially opened.</p>\r\n','full_html'),('news','0','153','153','en','0','<p>15 piglets (2 litters) have been born in the last few weeks. They are Oxford Sandy and Blacks. Visitors are welcome.</p>\r\n','full_html'),('news','0','155','155','en','0','<p>The Post Office is open every Friday (1.30 - 3.30pm**) in the Seward Room next to St. Mary''s church. You do not have to queue (well, you do very occasionally but even that is enjoyable) and you are treated to a cup of coffee or tea and some healthy gossip.</p>\r\n','full_html'),('quickevent','0','156','156','en','0','Our traditional Village Show will be held on Saturday 20th August 2011 and will concentrate on Horticultural and Craft classes including baking, fruit, vegetables, flowers, photography and much more.\r\n\r\nFor further details contact Maggie Johnston on 01730 262293 ',null),('news','0','157','157','en','0','<p>Buriton''s ''Alternative Quiz Night'' on 14th May was a huge success ? providing fun for participants and funding for our link with Dominase.</p>\r\n','full_html'),('news','0','158','158','en','0','<p>Christian Aid house-to-house collections throughout the Parish raised a total of ?827-55 this year.</p>\r\n','full_html'),('news','0','160','160','en','0','<p>Old photographs from the Buriton Heritage Bank collection are on display at the Queen Elizabeth Country Park.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','164','164','en','0','The locally renowned ''Downland Singers'' will be giving a special performance in Buriton on Sunday 18th September (2.30pm).',null),('news','0','165','165','en','0','<p>Pupils in Middle Juniors (Yr5) at Ditcham Park School have recently raised an extra £130 to help friends in Ghana.</p>\r\n','full_html'),('event','0','166','166','en','0','Come and search for the elusive Cheese Snail on Sunday 10th July.  Book early.\r\n\r\n \r\n',null),('event','0','167','167','en','0','An illustrated talk by David Bee',null),('event','0','168','168','en','0','Opportunities to sell and buy: Friday 15th July',null),('news','0','170','170','en','0','<p>Hogget is, in this case, a 15 month old sheep. More information can be found on the web site: www.alegateachcorner.com.</p>\r\n','full_html'),('news','0','171','171','en','0','<p>This might not be the correct place to put this note but there we go!</p>\r\n','full_html'),('news','0','172','172','en','0','<p>Susan Shone put on a special spread for seniors from across the parish on mid-summer?s day.</p>\r\n','full_html'),('news','0','173','173','en','0','<p>The latest guided walk in Buriton''s Chalk Pits revealed lots of life in unlikely places.</p>\r\n','full_html'),('news','0','174','174','en','0','<p>Shearing on the Bray family?s Nursted Farm in July brought an end to one of Buriton?s more unusual social events: the annual sheep-rolling rota.</p>\r\n','full_html'),('news','0','176','176','en','0','<p>Members of Buriton Tennis Club played about 600 games of tennis in their annual ?Davis Cup? weekend (July 9th - 10th) ? with ?Team Ghana? emerging as winners.</p>\r\n','full_html'),('news','0','181','181','en','0','<p>An excellent series of ''Films in Buriton'' has been arranged for the autumn season.</p>\r\n','full_html'),('quickevent','0','183','183','en','0','In the Village Hall: doors open at 7pm. Refreshments are available with the films commencing at 7.30pm. Tickets are ?5 each and can be bought on the night at the door (please try to have exact money available ) or in advance from Olive Ayling, Sarah Marks or Doug Jones.',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','184','184','en','0','In the Village Hall: doors open at 7pm. Refreshments are available with the films commencing at 7.30pm. Tickets are ?5 each and can be bought on the night at the door (please try to have exact money available ) or in advance from Olive Ayling, Sarah Marks or Doug Jones.',null),('quickevent','0','185','185','en','0','In the Village Hall: doors open at 7pm. Refreshments are available with the films commencing at 7.30pm. Tickets are ?5 each and can be bought on the night at the door (please try to have exact money available ) or in advance from Olive Ayling, Sarah Marks or Doug Jones.',null),('news','0','186','186','en','0','<p>Buriton''s special "Buy-a-Bog" campaign has stepped up the delivery of family toilets in Ghana.</p>\r\n','full_html'),('news','0','187','187','en','0','<p>As part of a week long study tour, five senior Local Government officials from Ghana came to Buriton in August.</p>\r\n','full_html'),('news','0','188','188','en','0','<p>There are now two sessions each week of this latin-inspired, easy-to-follow, calorie burning, dance fitness-party.</p>\r\n','full_html'),('news','0','189','189','en','0','<p>Buriton Tennis Club''s annual Tournament Finals had an added attraction this year.</p>\r\n','full_html'),('news','0','190','190','en','0','<p>The Premier League soccer team is the latest organisation to provide help to Buriton''s sister community in rural Ghana.</p>\r\n','full_html'),('quickevent','0','193','193','en','0','The Tennis Club''s popular Christmas Party event, with food, live music and other fun, will be held on Friday 16th December.  More details from Barbara Muir: 01730 231554 or barbara.muir@btconnect.com  \r\n',null),('news','0','196','196','en','0','<p>Buriton?s fascinating history was brought to life in a special exhibition on Saturday September 24th and the event attracted visitors from as far away as Australia.</p>\r\n','full_html'),('news','0','197','197','en','0','<p>Almost 50 parishioners, family and friends enjoyed a fascinating and informative farm walk on Sunday 25th September thanks to farm manager Oliver Howe of Weston Farm.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','200','200','en','0','<p>More information can be found on the web site: www.alegateachcorner.com.</p>\r\n','full_html'),('news','0','201','201','en','0','<p>The latest guided walks in Buriton''s Chalk Pits Nature Reserves discovered a rare fungus which appears on the Red Data List of threatened British fungi.</p>\r\n','full_html'),('news','0','202','202','en','0','<p>The Government has awarded over ?8 million to Hampshire County Council to improve broadband access for rural communities. But Buriton will probably only get some of the money if we do something about it.</p>\r\n','full_html'),('event','0','203','203','en','0','Ever struggle with Christmas Gift Ideas? Dislike the Christmas madness on the High Street?',null),('news','0','204','204','en','0','<p>A new group of volunteers has begun to look after parts of the Chalk Pits Nature Reserve ? but there is still time for more people to join the (working) party!</p>\r\n','full_html'),('news','0','205','205','en','0','<p>Fun and inspiring for everyone - in the comfort of the Five Bells: Monday evenings (7 - 9pm) from November 14th to December 19th</p>\r\n','full_html'),('news','0','206','206','en','0','<p>Buriton?s unique link with Dominase in rural Ghana continues to bring real benefits for the West African community.</p>\r\n','full_html'),('news','0','207','207','en','0','<p>The community won a special Environmental Improvement Design &amp; Conservation Award from the District Council in October.</p>\r\n','full_html'),('news','0','208','208','en','0','<p>Over 100 people packed into the Manor Barn in November for another great night to raise money for local good causes.</p>\r\n','full_html'),('news','0','211','211','en','0','<p>About 80 people packed into Buriton Village Hall on Monday 5th December to listen to best-selling thriller writer Graham Hurley.</p>\r\n','full_html'),('event','0','212','212','en','0','Carols, mince pies and mulled wine - a perfect winter''s evening',null),('news','0','213','213','en','0','<p>Stuck for a gift for family or friends? What about a toilet? That''s right, just ?30 can buy the materials for a family toilet in Buriton''s sister community of Dominase in rural Ghana. ?50 includes enough money to pay for a mason to help build it.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','214','214','en','0','Enjoy a leisurely afternoon supporting your local village cricket team on the Recreation Ground: 2pm - 7pm (approximately)  ',null),('event','0','215','215','en','0','Enjoy a leisurely afternoon supporting your local village cricket team on the Recreation Ground as they take on a team from ''Transport for London'': 2.30pm - 7pm (approximately)  ',null),('event','0','216','216','en','0','Enjoy a leisurely afternoon supporting your local village cricket team on the Recreation Ground: 2pm - 7pm (approximately)  ',null),('event','0','217','217','en','0','Enjoy a leisurely afternoon supporting your local village cricket team on the Recreation Ground: 2pm - 7pm (approximately)  ',null),('event','0','218','218','en','0','Enjoy a leisurely afternoon supporting your local village cricket team on the Recreation Ground: 2pm - 7pm (approximately)  ',null),('event','0','219','219','en','0','Enjoy a leisurely afternoon supporting your local village cricket team on the Recreation Ground: 2pm - 7pm (approximately)  ',null),('event','0','220','220','en','0','Enjoy a leisurely afternoon supporting your local village cricket team on the Recreation Ground: 2pm - 7pm (approximately)  ',null),('quickevent','0','221','221','en','0','The Parish Magazine is published every 2 months - the next issue will be distributed to every household in the parish early next month.   Please send contributions by e-mail to: pm@pmdc.co.uk or by hand / post to: Grantchester House, Bones Lane, Buriton, GU31 5SE \r\n\r\n',null),('quickevent','0','223','223','en','0','The Parish Magazine is published every 2 months - the next issue will be distributed to every household in the parish early next month.   Please send contributions by e-mail to: pm@pmdc.co.uk or by hand / post to: Grantchester House, Bones Lane, Buriton, GU31 5SE \r\n\r\n',null),('quickevent','0','224','224','en','0','The Parish Magazine is published every 2 months - the next issue will be distributed to every household in the parish early next month.   Please send contributions by e-mail to: pm@pmdc.co.uk or by hand / post to: Grantchester House, Bones Lane, Buriton, GU31 5SE \r\n\r\n',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','225','225','en','0','The Parish Magazine is published every 2 months - the next issue will be distributed to every household in the parish early next month.   Please send contributions by e-mail to: pm@pmdc.co.uk or by hand / post to: Grantchester House, Bones Lane, Buriton, GU31 5SE \r\n\r\n',null),('quickevent','0','226','226','en','0','The Parish Magazine is published every 2 months - the next issue will be distributed to every household in the parish early next month.   Please send contributions by e-mail to: pm@pmdc.co.uk or by hand / post to: Grantchester House, Bones Lane, Buriton, GU31 5SE \r\n\r\n',null),('event','0','227','227','en','0','Parish Council meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm',null),('event','0','228','228','en','0','Parish Council meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm',null),('event','0','229','229','en','0','Parish Council meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm',null),('event','0','230','230','en','0','Parish Council meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm',null),('event','0','231','231','en','0','Parish Council meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm',null),('event','0','232','232','en','0','Parish Council meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm',null),('event','0','234','234','en','0','Currently nominated for 4 Oscars and 5 Bafta Awards, Buriton?s village hall cinema has scooped another box office favourite for 2012 ? another film not to be missed.',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','235','235','en','0','There?s another great show in Buriton?s Village Hall Cinema on Friday 13th April as ?The Iron Lady? follows Margaret Thatcher (Meryl Streep) as she reminisces on her life, from her childhood to the present day.',null),('event','0','236','236','en','0','Hundreds of photographs of the parish in years gone by.  Free exhibition in the Village Hall from 11am to 4pm. ',null),('event','0','237','237','en','0','Sing along to some "Last Night of the Proms" classics in the magnificent Manor Barn.',null),('event','0','238','238','en','0','The first day of the Tennis Club''s popular tournament finals.  Come and watch some keenly contested matches.  The weekend will feature the finals of singles and doubles competitions.',null),('event','0','239','239','en','0','The second day of the Tennis Club''s popular tournament finals.  Come and watch some keenly contested matches.  The weekend will feature the finals of singles and doubles competitions.',null),('event','0','240','240','en','0','There will be lots of special attractions at the Village Show this year - as well as all the traditional favourites',null),('event','0','241','241','en','0','It is hoped that the Olympic Torch will pass through parts of the parish on Monday 16th July - as part of its journey from Portsmouth to Petersfield.  More details will be available nearer to the date.',null),('event','0','242','242','en','0','All the fun of the fete - at Buriton Primary School',null),('event','0','243','243','en','0','Experts will be on hand to identify all the varieties of orchids and other rare plants which can be found in this small Nature Reserve on the South Downs above Buriton village.  Visit any time from 10am to 12.30pm. Contact Di Mitchell (01730 266064 or email dimartin.buriton@btinternet.com) for more information.',null),('event','0','244','244','en','0','The first day of Buriton''s own international tennis competition - with club members representing a wide range of countries: tennis giants and dwarfs.  Team Ghana won the 2011 tournament.  Come and enjoy some exciting tennis - and some fascinating fancy dress!  ',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','245','245','en','0','The second day of Buriton''s own international tennis competition - with club members representing a wide range of countries: tennis giants and dwarfs.  Team Ghana won the 2011 tournament.  Come and enjoy some exciting tennis - and some fascinating fancy dress!  ',null),('event','0','246','246','en','0','From 11am to 3pm - activities and fun for all parishioners, family and friends: farm animals, trailer rides, agricultural machinery and a Barbecue. \r\n\r\n',null),('event','0','248','248','en','0','Activities for all age groups ? storytelling, art activities, family quizzes, guided walks and a popular moth and bug hunt.  All free of charge in our local Buriton Chalk Pits Nature Reserve.\r\n',null),('event','0','249','249','en','0','Book your places now for Buriton?s popular ?alternative? Quiz Night: ?What the ??!?',null),('event','0','256','256','en','0','It''s amazing how much litter accumulates along our lanes and hedgerows - and how untidy it can make the parish look.  Come and lend a hand on this annual ''spring clean'' Saturday - even just an hour will be a great help ...',null),('news','0','257','257','en','0','<p>Buriton?s innovative ?Buy a Bog? Christmas fund raising campaign raised over ?600 with contributions from London, Northamptonshire and the Lake District.</p>\r\n','full_html'),('news','0','261','261','en','0','<p>An enthusiastic group of volunteers have improved a popular countryside footpath in the parish ? making access to some wonderful views over the village much easier.</p>\r\n','full_html'),('news','0','262','262','en','0','<p>Monday evenings (7pm to 9pm) from 16th January 2012. Fun and inspiring for everyone - in the comfort of The Five Bells, High Street, Buriton, GU31 5RX</p>\r\n','full_html'),('news','0','263','263','en','0','<p>East Hampshire District Council and Hampshire County Council have joined forces with other councils across the county to help householders install loft and cavity-wall insulation to high standards. Anyone registering before 31st March 2012 is likely to get work done free of charge ? thereafter there will be some charges but they are likely to represent very good value. Full details are available via the website www.insulatehampshire.co.uk or by phoning 0800 952 0037</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','264','264','en','0','<p>That was the view of many of the people collecting their supplies of meat from Susan Shone at Bolinge Hill Farm in January.</p>\r\n','full_html'),('news','0','265','265','en','0','<p>As a unique souvenir of Jubilee Year, a special full-colour hardback book is being produced to record activities in the parish during the year. A free copy of the book will be available for every household ? early in 2013. But ? your help is needed.</p>\r\n','full_html'),('quickevent','0','267','267','en','0','Enjoy an exciting 20:20 run chase and support your local village cricket team on the Recreation Ground: starting at 6pm',null),('quickevent','0','268','268','en','0','Enjoy a leisurely afternoon supporting your local village cricket team on the Recreation Ground: 2pm - 7pm (approximately) ...',null),('quickevent','0','269','269','en','0','Enjoy an exciting 20:20 run chase and support your local village cricket team on the Recreation Ground: starting at 6pm ...',null),('news','0','270','270','en','0','<p>Children, parents, helpers and friends of Buriton Nursery School took part in a ''Sponsored Toddle'' on Friday 24th February on the Village Recreation Ground - and raised over ?200 !</p>\r\n','full_html'),('news','0','271','271','en','0','<p>Rogue traders are reportedly cold calling in parts of Hampshire claiming that residents need to replace their TV aerial in order to receive digital TV signals.</p>\r\n','full_html'),('event','0','272','272','en','0','300 years ago ? on this very day ? the steeple on Buriton Church was struck by lightening and burnt down. Our team of bell-ringers will be ringing the bells to mark this anniversary. They will also be giving demonstrations and providing parishioners with an opportunity to have a go.',null),('event','0','273','273','en','0','We are extremely fortunate, in this Diamond Jubilee year, to have the Royal Correspondent of one of our National Newspapers living in the parish.  At the autumn meeting of the Buriton Village Association, Richard Palmer will give an insight into his work ? and a ''behind the scenes'' look at many of the Royal events taking place during 2012.\r\n',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','274','274','en','0','An evening of comic song, gently mocking the British way of life. A bit of a coup for the village - and possibly one of the last chances to enjoy one of Buriton Events'' evenings of fun in the Manor Barn.',null),('event','0','275','275','en','0','The unprecedented demand for wool and wheat during the Napoleonic Wars changed our local landscapes for ever.  ',null),('event','0','278','278','en','0','More details will be available nearer to the date of the event.',null),('event','0','280','280','en','0','Experts will guide parishioners and visitors around the Chalk Pits Nature Reserve, helping to identify a wide range of local spiders (and their web-sites!)\r\n',null),('event','0','281','281','en','0','Oliver Howe will provide a guided walk around some of the fields and features of Weston Farm',null),('event','0','282','282','en','0','In a special event to raise awareness about Buriton?s sister community of Dominase in rural Ghana, children from Buriton Primary School will walk half way to Ditcham Park School to meet pupils who have walked from there for a healthy snack picnic and to exchange Olympic Torch before returning to their own schools.',null),('event','0','283','283','en','0','Experts will guide parishioners and visitors around the Chalk Pits Nature Reserve, helping to identify bats and moths.',null),('event','0','284','284','en','0','Experts will guide parishioners and visitors around the Chalk Pits Nature Reserve, helping to identify bats and moths.',null),('event','0','285','285','en','0','A popular annual treat for senior citizens from across the parish ? book your places via the contact details below. Transport can be provided.',null),('event','0','286','286','en','0','Experts will guide parishioners and visitors around the Chalk Pits Nature Reserve, helping to identify local butterflies.',null),('event','0','287','287','en','0','Make yourself a fortune by selling all your unwanted clutter ? or simply pop along between 11am and 3.30pm to buy yourself a bargain.  Book your table for this popular event by contacting Barbara Muir: 01730 231554 or barbara.muir@btconnect.com\r\n',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','288','288','en','0','All are welcome at Buriton?s popular annual ?camp-out?.  Commencing from noon on Friday 20th July, camping overnight until the afternoon of Saturday 21st\r\n',null),('news','0','289','289','en','0','<p>Regular walkers along The Links, at Halls Hill and in Weston will have noticed that the Parish Council has been able to replace yet more awkward stiles with easy-to-use kissing gates.</p>\r\n','full_html'),('news','0','290','290','en','0','<p>Tickets were snapped up for Buriton''s innovative ?Lambing Lottery? - to try to win attractive cash prizes. Each of the ewes at Nursted Farm had been given their own secret number and the last ones to give birth to their lambs in the spring triggered cash prizes for three lucky people.</p>\r\n','full_html'),('news','0','291','291','en','0','<p>On a wet March morning an old truck was dragged up into the Chalk Pits from Buriton pond. For over 70 years, trucks like this had hurtled around the site ? carrying chalk from the quarry faces down to the limeworks below.</p>\r\n','full_html'),('news','0','292','292','en','0','<p>Plans for a day of festivities and fun in Buriton on Sunday 3rd June have been revealed in the Parish Magazine. And bookings are needed for the Street Party so that the organisers know how many tables and chairs to obtain.</p>\r\n','full_html'),('event','0','301','301','en','0','A giant cycle around the gently undulating lanes of the South Downs.\r\nThree circular routes for all levels of ability: 44, 76 and 102 miles.\r\nBuriton is just over half-way along the longest route, the 102 mile-long Giant. Cyclists will pass through Buriton from late morning onwards.',null),('news','0','302','302','en','0','<p>If you can help in any way with this year''s display then come and join the Fireworks Committee at The Five Bells in Buriton on Tuesday 8th May at 8pm.</p>\r\n','full_html'),('news','0','305','305','en','0','<p>Dance to the live sounds of six decades of music at "A Right Royal Rave", Sunday 3rd June (7.30pm ? 11pm) in Buriton manor Barn</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','306','306','en','0','On the day that the Olympic Torch passes through part of the parish, Piers Burton-Page limbers up for the Games with a very surprising history of an Olympic opera.',null),('news','0','309','309','en','0','<p>Wet weather brought an added bonus to Buriton''s Chalk Pits Open Day on Saturday 28th April. Whilst some of the planned activities were switched indoors into the village hall, a number of special discoveries were made on the bug hunting expeditions and guided walks.</p>\r\n','full_html'),('news','0','310','310','en','0','<p>Despite days of wet weather, Susan Shone?s annual Bluebell Walk at Bolinge Hill Farm took place as planned on Sunday 29th April. And it was obviously ?meant to be?.</p>\r\n','full_html'),('news','0','311','311','en','0','<p>Organisers of a new scheme which is designed to help local pubs and businesses were delighted with the interest shown in Buriton on Saturday 28th April.</p>\r\n','full_html'),('news','0','313','313','en','0','<p>Drumming lessons, free samples of ?Divine? FairTrade chocolate and signed raffle prizes from comedy writer and actress Miranda Hart were amongst the attractions in the Village Hall ? but Comfort Appiah, who had travelled all the way from Dominase in Ghana, was the star of the show!</p>\r\n','full_html'),('event','0','314','314','en','0','Hugely popular comedy drama and multi award winner.  The next film in your Village Hall cinema.',null),('event','0','315','315','en','0','A popular comedy-drama which follows a group of British retirees who decide to ?outsource? their retirement to less expensive and seemingly exotic India. ',null),('event','0','316','316','en','0','Steven Spielberg?s popular film about Devon farm-boy Albert and his beloved horse, Joey.  ',null),('event','0','317','317','en','0','A comedy-drama featuring a stuffy government scientist, Fred, who is asked by a fishing-obsessed Arab Sheik to do the seemingly impossible - introduce British salmon to the Wadis of the Yemen. ',null),('event','0','318','318','en','0','Anna Karenina is a classic drama: Joe Wright directs the classic Tolstoy story of marital infidelity in an adaptation by Tom Stoppard. ',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','319','319','en','0','<p>An excellent series of ''Films in Buriton'' has been arranged for autumn 2012 with a series of recently acclaimed films:</p>\r\n','full_html'),('news','0','320','320','en','0','<p>The weather was kind to Buriton. Whilst rain was falling all around, everything took place as planned enabling a host of happy memories from a thoroughly enjoyable day.</p>\r\n','full_html'),('news','0','321','321','en','0','<p>A highlight of the community?s ?Down on our Farms? programme this year was Susan Shone?s big Farm Open Day.</p>\r\n','full_html'),('news','0','322','322','en','0','<p>Even some heavy showers of rain couldn?t detract from the enthusiasm of forty members of Buriton Tennis Club as they enjoyed two days of non-stop tennis.</p>\r\n','full_html'),('news','0','323','323','en','0','<p>Susan Shone put on a special spread for seniors from across the parish in July - an established part of the community?s annual ?Down on our farms? programme of events, open days, walks and talks.</p>\r\n','full_html'),('news','0','324','324','en','0','<p>Two hundred and fifty schoolchildren walked to meet together on the top of the South Downs this month in a unique celebration to mark the Olympic Games and the schools? links with rural Ghana.</p>\r\n','full_html'),('news','0','325','325','en','0','<p>Over 350 children attend the Primary and Secondary Schools in Dompoase ? an outlying hamlet of Dominase in rural Ghana. And, until now, they have not had anywhere private to go to the loo. Teenage girls would choose not to go to school for a few days every month; missing out on vital learning.</p>\r\n','full_html'),('news','0','326','326','en','0','<p>"A great evening" seems to be the overwhelming reaction to Buriton''s first ever ''Parish Proms''. Held in the magnificent Manor Barn on Sunday 9 September, the event contained a mixture of humorous songs and Albert Hall favourites - something for everybody ? and it provided another opportunity to wave those Union Jacks and bunting.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','327','327','en','0','<p>Possibly one of the last chances to enjoy one of Buriton Events'' evenings of fun in the Manor Barn - and a bit of a coup for the village with the visit of stars of radio, TV and the Edinburgh Fringe, "Instant Sunshine".</p>\r\n','full_html'),('news','0','329','329','en','0','<p>Families from nine different counties in England and some from Wales flocked to see Buriton?s annual local history exhibition on Saturday 29th September 2012 ? mingling with residents and parishioners.</p>\r\n','full_html'),('news','0','331','331','en','0','<p>There was a pleasant surprise for the community recently when a Buriton project scooped the top award at a special ceremony near Winchester.</p>\r\n','full_html'),('news','0','332','332','en','0','<p>Copies of a brand new Buriton Parish Calendar for 2013 are now available. At only ?7 per copy the new calendar makes a perfect Christmas present for family and friends.</p>\r\n','full_html'),('news','0','333','333','en','0','<p>Applause rang out long and loud for the multi-talented ''Instant Sunshine'' after their performance in the Manor Barn in late October.</p>','full_html'),('news','0','334','334','en','0','<p>Exactly 300 years ago the church tower was struck by lightening and destroyed by fire. Buriton?s bell-ringers will be marking this anniversary ? and they will also be giving people a chance to have a go at ringing the bells.</p>\r\n','full_html'),('event','0','335','335','en','0','A special chance to see wonderful details on the Moon ? and to be amazed by the beauty of Orion?s Sword. Experts from local astronomical groups will be bringing their telescopes to Buriton on Saturday 17 November ? and giving people an opportunity to look and learn.',null),('event','0','336','336','en','0','Members, family and friends are all welcome to the Tennis Club''s annual Christmas Party.',null),('event','0','337','337','en','0','Something a bit special for the village and surrounding area ? an opportunity to have a good laugh to kickstart the Christmas season.',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','338','338','en','0','Come and join the merry throng - followed by mince pies, refreshments and more carols in the church.',null),('news','0','339','339','en','0','<p>Some significant work will take place at and around the village pond during November ? with planting and finishing touches taking place in the spring of 2013.</p>\r\n','full_html'),('news','0','340','340','en','0','<p>Three hundred years ago Buriton church was struck by lightning and partly destroyed by fire. To mark the exact anniversary of the fateful day, Buriton?s bell-ringers rang a quarter peal on the morning of Saturday 17 November 2012 and, in the afternoon, gave a public demonstration with opportunities for anyone to have a go at ringing the bells.</p>\r\n','full_html'),('news','0','341','341','en','0','<p>Cloudy skies meant that Buriton''s innovative star-gazing party had to stay indoors. But experts from Hants Astro turned St Mary''s church into a mini-planetarium for the evening and engaged the audience with images projected onto the walls and ceiling - and, with the help of local children, demonstrated the expanse of the solar system by using fruit!</p>\r\n','full_html'),('event','0','343','343','en','0','Following the great successes at the Buriton Fireworks and the Christmas Fair in the church, A Leg At Each Corner is going to hold a Buriton Bacon Occasion:  a special event just before Christmas.',null),('news','0','344','344','en','0','<p>Are you tired of waiting for decent broadband? Is slow broadband stopping you working at home? Faster broadband can make a big difference to your life. You may wish to consider joining this ?campaign? now.</p>\r\n','full_html'),('event','0','346','346','en','0','Please send all contributions to Steve and Kirsty Thomas via buritonmagazine@yahoo.com  ',null),('event','0','347','347','en','0','Please send all contributions to Steve and Kirsty Thomas via buritonmagazine@yahoo.com  ',null),('event','0','348','348','en','0','Please send all contributions to Steve and Kirsty Thomas via buritonmagazine@yahoo.com  ',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','349','349','en','0','Please send all contributions to Steve and Kirsty Thomas via buritonmagazine@yahoo.com  ',null),('event','0','350','350','en','0','Please send all contributions to Steve and Kirsty Thomas via buritonmagazine@yahoo.com  ',null),('event','0','351','351','en','0','Please send all contributions to Steve and Kirsty Thomas via buritonmagazine@yahoo.com  ',null),('event','0','352','352','en','0','Parish Council Meeting in the Village Hall.\r\n\r\nMeetings commence at 7pm with the Public Forum at 7.45pm',null),('event','0','353','353','en','0','Parish Council Meeting in the Village Hall.\r\n\r\nMeetings commence at 7pm with the Public Forum at 7.45pm',null),('event','0','354','354','en','0','Parish Council Meeting in the Village Hall.\r\n\r\nMeetings commence at 7pm with the Public Forum at 7.45pm',null),('event','0','355','355','en','0','Parish Council Meeting in the Village Hall.\r\n\r\nMeetings commence at 7pm with the Public Forum at 7.45pm',null),('event','0','356','356','en','0','Parish Council Meeting in the Village Hall.\r\n\r\nMeetings commence at 7pm with the Public Forum at 7.45pm',null),('event','0','357','357','en','0','Parish Council Meeting in the Village Hall.\r\n\r\nMeetings commence at 7pm with the Public Forum at 7.45pm',null),('event','0','358','358','en','0','The Annual Parish Meeting of Buriton Parish Council.\r\n\r\nCommences at 7pm in the Village Hall.\r\n\r\nMore details nearer to the date of this event.',null),('event','0','359','359','en','0','The first day of the Tennis Club''s ''Finals Weekend''.\r\n\r\nAnyone is welcome to watch the culmination of the Club''s annual tennis tournaments.',null),('event','0','360','360','en','0','The second day of the Tennis Club''s ''Finals Weekend''.\r\n\r\nAnyone is welcome to watch the culmination of the Club''s annual tennis tournaments.',null),('event','0','361','361','en','0','Large exhibition of local history (including hundreds of old photographs) brought together in the Buriton Heritage Bank. In the Village hall from 11am until 4pm. Copies of all the local history books will be available for sale.  ',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','362','362','en','0','Buriton''s popular annual village show - including flowers, fruit, vegetables, baking and arts & crafts.  Entries in the morning - showtime in the afternoon. ',null),('event','0','363','363','en','0','Come and help identify as many species of wildlife as possible in a 24-hour period.  Begins at 4pm on Saturday 10th August and finishes at 4pm on Sunday 11th.  More details from Queen Elizabeth Country Park on 02392 595040',null),('event','0','364','364','en','0','Come and help identify as many species of wildlife as possible in a 24-hour period.  Begins at 4pm on Saturday 10th August and finishes at 4pm on Sunday 11th.  More details from Queen Elizabeth Country Park on 02392 595040',null),('event','0','365','365','en','0','Great new film - released in 2012 - starring Helena Bonham Carter, Ralph Fiennes and Robbie Coltrane',null),('event','0','366','366','en','0','Great new film - released in 2012 - starring Maggie Smith, Michael Gambon and Billy Connolly',null),('event','0','367','367','en','0','Great new film - released in 2012 - starring Colin Firth',null),('event','0','368','368','en','0','The AGM of our Village Hall Charity.  Everybody is welcome.  Come and make your suggestions and offers of help ...',null),('event','0','369','369','en','0','Annual Spring Clean Litter-picking morning. Please be willing to lend a hand to help make the parish clean and tidy. Contact Parish Clerk, Wendy Shone, via buritonparishcouncil@hotmail.co.uk for more details. ',null),('event','0','370','370','en','0','Hang on to your hats and jump aboard as Buriton Players present their new production: ''Fools Steam Ahead''. ',null),('event','0','371','371','en','0','Hang on to your hats and jump aboard as Buriton Players present their new production: ''Fools Steam Ahead''. ',null),('event','0','372','372','en','0','Have you ever wondered why the Buriton Chalk Pits were designated as a Local Nature Reserve? What is it about the habitats there that make it a very special place for some plants and wildlife? Come to the Village Hall for a brief introductory talk by District Council expert Martin Healey before a short guided tour of the site followed by feedback and discussion in one of the pubs. ',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','373','373','en','0','The hardback book about events and activities in the parish of Buriton during 2012 will be available for collection in the village hall from 10.30am to 4pm. One copy per household - free of charge.',null),('news','0','374','374','en','0','<p>A friendly group of beginners and amateur artists will be meeting at the Five Bells on Tuesday evenings. Suitable for everyone, from complete beginners to recognised talents. The meetings are informal and fun and will cover a range of subjects.</p>\r\n','full_html'),('news','0','375','375','en','0','<p>Bike hire is now available at the Maple Inn. ?15 per day or ?7.50 for half a day. For further information phone 01730 267275.</p>\r\n','full_html'),('news','0','376','376','en','0','<p>Are you tired of waiting for decent broadband? Is slow broadband stopping you working at home? Faster broadband can make a big difference to your life. You may wish to consider joining this ?campaign? now.</p>\r\n','full_html'),('news','0','377','377','en','0','<p>Scores of people have already bought beef from Bolinge Hill Farm ? and, as anyone who has tried it will testify, the texture and flavours are fantastic. Supplies were ?sold out? before Christmas but there are now just a few orders to fill in January and February. After that we all have to wait until December again!</p>\r\n','full_html'),('news','0','381','381','en','0','<p>As part of the Parish Council?s lottery-funded Chalk Pits project, an audio guide is being produced for schools across the area.</p>\r\n','full_html'),('event','0','382','382','en','0','A few years ago Bernie & Mary Saunders organised a ?Walk for Water? along the South Downs Way which raised over ?5,000 for water supplies in Dominase. Something similar ? but less strenuous ? is now being planned ... ',null),('news','0','396','396','en','0','<p>Petersfield Young Farmers raise over £200 for good causes by delivering tons of manure</p>\r\n','full_html'),('news','0','397','397','en','0','<p>Award winning author?s talk in Buriton takes place in black-out conditions.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','398','398','en','0','<p>Over 200 households collected their free copies of ?Buriton ? the book of the year? on February 16th ? but more copies are still available.</p>\r\n','full_html'),('quickevent','0','399','399','en','0','First home game of the season - a 20:20 fixture on the Recreation Ground - supporters always welcome!',null),('quickevent','0','400','400','en','0','First home Sunday game of the season - on the Recreation Ground - supporters always welcome!',null),('quickevent','0','401','401','en','0','An evening 20/20 game - supporters welcome.',null),('quickevent','0','402','402','en','0','An evening 20/20 game - supporters welcome.',null),('quickevent','0','403','403','en','0','An evening 20/20 game - supporters welcome.',null),('quickevent','0','404','404','en','0','The TfL Dinos team again visit Buriton  - spectators welcome.',null),('quickevent','0','405','405','en','0','Buriton again host the Gentlemen of Bedales (staff, students and friends of the School) for a friendly game - spectators welcome.',null),('quickevent','0','406','406','en','0','Sunday afternoon cricket on the recreation ground - spectators welcome.',null),('quickevent','0','407','407','en','0','Sunday afternoon village cricket on the recreation ground - spectators welcome.',null),('quickevent','0','408','408','en','0','Sunday afternoon village cricket on the recreation ground - spectators welcome.',null),('quickevent','0','409','409','en','0','Last game of the season - village cricket on the recreation ground - spectators welcome.',null),('news','0','410','410','en','0','<p>Francesca Concannon?s exhibition runs from 1st March to 14th April</p>\r\n','full_html'),('event','0','411','411','en','0','Charity Bike Ride and family fun day',null),('event','0','412','412','en','0','The antidote to ordinary quiz nights ?',null),('event','0','413','413','en','0','A talk by Paul Martin that explains ?what he does?, how he does it and what his sources of inspiration are.',null),('news','0','414','414','en','0','<p>About 30 villagers and families attended the special event in the village hall in February to learn about how we should manage a special little Nature Reserve like the Buriton Chalk Pits.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','415','415','en','0','<p>Sponsored walkers from Buriton were amongst the first to set foot along the Shipwrights Way in March following an official opening ceremony.</p>\r\n','full_html'),('event','0','416','416','en','0','Spend an enchanting evening in one of our Local Nature Reserves and emerge much wiser about the distinctive bird songs of many of our local species. ',null),('news','0','417','417','en','0','<p>Trustees of a local charity, set up over 300 years ago, have recently deposited many of their records at the Hampshire Records Office in Winchester.</p>\r\n','full_html'),('event','0','418','418','en','0','An opportunity for parishioners, family and friends to take a delightful guided stroll along farm paths not normally open to the public ? and opportunities (weather permitting) to see thousands of bluebells and impressive Early Purple orchids. \r\n\r\n\r\n',null),('news','0','419','419','en','0','<p>Miles and miles without stiles. Over the last four years, with cooperation from landowners, the Parish Council has been able to remove 21 stiles to make things easier for elderly people, for young families and people walking with dogs.</p>\r\n','full_html'),('event','0','420','420','en','0','All are welcome at Buriton?s popular annual ?camp-out? on the Recreation Ground: commencing on Saturday 20th July and  camping overnight until about 1pm on Sunday 21st .',null),('news','0','421','421','en','0','<p>Our guide, Di Mitchell, assured us that birds would be singing in spite of a bit of light drizzle ? and she was right ?</p>\r\n','full_html'),('event','0','422','422','en','0','Activities for all age groups ? art activities, bug hunts, family quizzes and guided walks.  New for this year: "Life in Leaf Litter" - microscopes will be available so that everyone can see the wide variety of creatures that live amongst the leaves on the floor of the Nature Reserve.',null),('event','0','423','423','en','0','Local artists, local venues, local food ?',null),('event','0','424','424','en','0','Local artists, local venues, local food ?',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','425','425','en','0','<p>Following Michelle Magorian?s talk in Buriton earlier in the year, here?s a chance to see a musical version of her award-winning novel.</p>\r\n','full_html'),('news','0','426','426','en','0','<p>As part of the county?s activities to mark the 60th anniversary of the Queen?s Coronation there will be a special service of celebration in Winchester Cathedral.</p>\r\n','full_html'),('event','0','427','427','en','0','Saturday 22nd June (12 til 2.30pm) on the Recreation Ground',null),('event','0','428','428','en','0','Pre-booking is essential: please see details below.',null),('news','0','429','429','en','0','<p>With the three years of Lottery Funding drawing towards its close, volunteers are putting the finishing touches to their plans to look after the Chalk Pits Nature Reserve over the years ahead.</p>\r\n','full_html'),('news','0','430','430','en','0','<p>The Petersfield Ramblers group made a special visit to Buriton in June to look at the nature reserves at Coulters Dean and in the Buriton Chalk Pits.</p>\r\n','full_html'),('news','0','431','431','en','0','<p>There is more good news to report from Dominase thanks to money raised by the Buriton-based ?Village-to-Village? Charity.</p>\r\n','full_html'),('news','0','432','432','en','0','<p>Villagers in Buriton?s adopted community of Dominase ? thousands of miles away in darkest Africa ? are now learning more about life in Buriton.</p>\r\n','full_html'),('news','0','433','433','en','0','<p>Some of the community activities that have taken place in the parish in recent years are featured in the South Downs National Park?s latest newspaper.</p>\r\n','full_html'),('news','0','434','434','en','0','<p>Susan Shone put on a special spread for senior citizens from across the parish in July ? an established part of the community?s annual ?Down on our farms? programme of events, open days, walks and talks.</p>\r\n','full_html'),('news','0','435','435','en','0','<p>Over 40 members of Buriton Tennis Club took part in their annual ?fancy dress? Davis Cup competition ? dressed to represent teams from France, Hawaii, New Zealand and the USA.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','436','436','en','0','<p>The community?s 2013 calendar was far more popular than initially envisaged ? so the organisers are doing the same thing for 2014 and want even more people to take photographs for consideration.</p>\r\n','full_html'),('news','0','437','437','en','0','<p>An excellent series of films has been arranged for the autumn of 2013 with some very recently released films - and there is also an extra film this season, with a special introduction by award-winning author Michelle Magorian</p>\r\n','full_html'),('event','0','438','438','en','0','Starring Dan Stevens from Downton Abbey, this brand new film (only released in June this year) is a British period drama set in Edwardian Cornwall.',null),('event','0','439','439','en','0','English Vinglish is a 2012 Indian comedy-drama film shot mostly in New York which captures the inherent struggle of many people all over the world with the English Language. Hilarious, touching and sensitive ?',null),('event','0','440','440','en','0','A brilliant performance by Michael Douglas illuminates an affectionate and funny portrait of the flamboyant entertainer Liberace in another 2013 film coming swiftly to Buriton.',null),('event','0','441','441','en','0','Reviving a lovely old tradition, St Mary?s church will be full of flowers and open for viewing on Friday 4th, Saturday 5th and Sunday 6th October.',null),('event','0','442','442','en','0','Reviving a lovely old tradition, St Mary?s church will be full of flowers and open for viewing on Friday 4th, Saturday 5th and Sunday 6th October.',null),('event','0','443','443','en','0','Reviving a lovely old tradition, St Mary?s church will be full of flowers and open for viewing on Friday 4th, Saturday 5th and Sunday 6th October.',null),('event','0','444','444','en','0','All 120 tickets for Friday''s performance of Buriton?s own production of this highly regarded play were snapped up within a matter of days. The play recreates the true story surrounding the creation of an ?alternative? (?not naked but nude?) calendar by the Women?s Institute of Knapeley in the Yorkshire Dales. All profits from the Buriton performances will go to Leukemia Research.',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','445','445','en','0','All 120 tickets for Saturday''s performance of Buriton?s own production of this highly regarded play were snapped up within a matter of days.  The play recreates the true story surrounding the creation of an ?alternative? (?not naked but nude?) calendar by the Women?s Institute of Knapeley in the Yorkshire Dales. All profits from the Buriton performances will go to Leukemia Research.',null),('news','0','447','447','en','0','<p>Finding out about Buriton''s First World War and D-Day history ? can you help?</p>\r\n','full_html'),('news','0','450','450','en','0','<p>Visitors flocked to St Mary?s church to view the harvest-themed flower festival.</p>\r\n','full_html'),('news','0','451','451','en','0','<p>Bees are absolutely vital to our lives. They don?t just make honey but play a critical role in the production of all sorts of foodstuffs ? from fruit and veg to meat and dairy.</p>\r\n','full_html'),('news','0','452','452','en','0','<p>Light-hearted lyrics, memorable melodies and clever choreography helped ensure a memorable concert in St Mary?s church on Sunday 20th October.</p>\r\n','full_html'),('news','0','453','453','en','0','<p>Over sixty people packed into the village hall on a very wet and windy night to be entertained by a witty and informative talk ? the autumn meeting of the Buriton Village Association.</p>\r\n','full_html'),('news','0','454','454','en','0','<p>The Parish Council?s project to encourage more wildlife in the Chalk Pits Nature Reserve ? whilst providing an attractive place for local walkers to pause for a rest ? commenced in October.</p>\r\n','full_html'),('news','0','455','455','en','0','<p>After her popular and inspirational talk in the village in February, award-winning author Michelle Magorian returned to Buriton to introduce a film adaptation of her book ?Back Home?.</p>\r\n','full_html'),('news','0','456','456','en','0','<p>Copies of a brand new Buriton Parish Calendar for 2014 are now available. At only ?7 per copy the new calendar makes a perfect Christmas present for family and friends.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','457','457','en','0','Want something different for Christmas? Ever struggle with Christmas Gift Ideas? Dislike the Christmas madness on the High Street?',null),('event','0','458','458','en','0','Come and join the merry throng - followed by mince pies, refreshments and more carols in the church.',null),('event','0','459','459','en','0','Music to raise money for the Philippines Typhoon Appeal - in Buriton village hall',null),('news','0','460','460','en','0','<p>There has already been amazing support for the Parish Council / St Mary''s church ''Give Gifts to the Philippines'' appeal in the wake of Typhoon Haiyan - but more supplies are always welcomed.</p>\r\n','full_html'),('news','0','461','461','en','0','<p>In front of over 250 people in two sell-out nights, a group of brave Buriton women bared all as they followed in the footsteps of Hollywood stars Helen Mirren and Julie Walters to raise thousands of pounds for charity.</p>\r\n','full_html'),('news','0','462','462','en','0','<p>A few copies of this remarkable book are available ? and make great Christmas presents for anyone connected to Buriton: children, family and friends.</p>\r\n','full_html'),('news','0','463','463','en','0','<p>Unfortunately the village hall was flooded in the pre-Christmas storms. Work is underway to get the building fully operational again as soon as possible. For up to date information please visit the village hall website: http://www.buritonvillagehall.co.uk/</p>\r\n','full_html'),('event','0','464','464','en','0','Buriton Parish Council meets every alternate month throughout the year.  All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm.',null),('event','0','466','466','en','0','Buriton Parish Council meets every alternate month throughout the year.  All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm.',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','467','467','en','0','Buriton Parish Council meets every alternate month throughout the year.  All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm.',null),('event','0','469','469','en','0','Buriton Parish Council meets every alternate month throughout the year.  Meetings usually take place in the Village Hall but, due to repairs, this meeting will take place in the Seward Room at St Mary''s Church, starting at 7pm. The usual opportunity for members of the public to ask questions or make comments in the Public Forum will take place at 7.45pm.',null),('event','0','470','470','en','0','Buriton Parish Council meets every alternate month throughout the year.  All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm.',null),('event','0','471','471','en','0','Buriton Parish Council meets every alternate month throughout the year.  All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm.',null),('event','0','472','472','en','0','The annual meeting of Buriton Parish Council: including a review of the most recent year (April 2013 - March 2014) and issues for the forthcoming year (to March 2015). The Parish Council will also consider the current planning applications for Buriton Manor. This meeting will take place in St Mary''s church whilst the village hall is closed following flood damage.\r\n',null),('quickevent','0','473','473','en','0','Buriton Parish Magazine is produced four times every year with editions in Spring, Summer, Autumn and Winter.  \r\n\r\nThe Spring edition will be circulated in the first week of March and will cover all events for March, April and May.\r\n\r\nTo contact the editors, Steve & Kirsty Thomas, simply send an email to this address: buritonmagazine@yahoo.com\r\n\r\n',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','474','474','en','0','Buriton Parish Magazine is produced four times every year with editions in Spring, Summer, Autumn and Winter.  \r\n\r\nThe Summer edition will be circulated in the first week of June and will cover all events for June, July and August.\r\n\r\nTo contact the editors, Steve & Kirsty Thomas, simply send an email to this address: buritonmagazine@yahoo.com\r\n\r\n',null),('quickevent','0','475','475','en','0','Buriton Parish Magazine is produced four times every year with editions in Spring, Summer, Autumn and Winter.  \r\n\r\nThe Autumn edition will be circulated in the first week of September and will cover all events for September, October and November.\r\n\r\nTo contact the editors, Steve & Kirsty Thomas, simply send an email to this address: buritonmagazine@yahoo.com\r\n\r\n',null),('quickevent','0','476','476','en','0','Buriton Parish Magazine is produced four times every year with editions in Spring, Summer, Autumn and Winter.  \r\n\r\nThe Winter edition will be circulated in the first week of December and will cover all events for December, January and February.\r\n\r\nTo contact the editors, Steve & Kirsty Thomas, simply send an email to this address: buritonmagazine@yahoo.com\r\n\r\n',null),('event','0','477','477','en','0','Cate Blanchett, Oscar nominee for Best Actress for her role in this film is directed by Woody Allen in a highly acclaimed and very successful drama. With an excellent supporting cast including Sally Hawkins, Alec Baldwin and Toni Collette ? and some great shots of San Francisco.',null),('event','0','478','478','en','0','Judy Dench is an Irishwoman searching for the son taken from her as a baby. Steve Coogan is a journalist assisting her in her quest. Funny and sad and beautifully done on all levels.',null),('event','0','480','480','en','0','Take part in a moth survey as part of this year?s BIOBLITZ being organised by the Queen Elizabeth Country Park',null),('event','0','481','481','en','0','Come and help us to find what is growing, wriggling, flying and singing in the Chalk Pits Nature Reserve. ',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','482','482','en','0','<p>An excellent series of films has been arranged for the spring of 2014 with some very recently released films - and international award nominees.</p>\r\n','full_html'),('event','0','483','483','en','0','Special adviser on the Speilberg film ''War Horse'', Andy Robertshaw will give a fascinating insight into the making of a major blockbuster movie as well as unique knowledge about the role of horses in the conflicts of the First World War. Specially arranged for half-term week, this talk will appeal to adults and children of all ages.',null),('event','0','484','484','en','0','70 years ago hundreds of allied troops were camped in and around the parish in the build up to the D-Day Landings and Operation Overlord. Buriton Village Association is working in partnership with the D-Day Museum in Southsea to find out as much as possible about this period of local history - and a special evening talk will be held on Tuesday 10th June.',null),('event','0','485','485','en','0','Local expert Nick Heasman will explain many things that make the countryside and community of Buriton very special: from the wonderful starry night skies above our heads to the huge natural reservoir of the chalk rocks below our feet - via all the special plants, trees and wildlife all around us. Very few parts of the planet are special enough to be included in National Parks - Buriton is one of those special places ...',null),('event','0','487','487','en','0','Saint Paul had, since his conversion on the road to Damascus, spent ten years as an evangelist to the gentiles before being taken to Rome and his death.  He had planted churches in many Roman provinces.  This play reading will provide a rare opportunity to hear a modern interpretation of these events and times.',null),('event','0','488','488','en','0','An opportunity for parishioners, family and friends to take a delightful guided stroll along farm paths not normally open to the public ? and opportunities (weather permitting) to see thousands of bluebells and impressive Early Purple orchids. \r\n\r\n\r\n',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','489','489','en','0','Hundreds of photographs of the parish in years gone by.  Free exhibition from 11am to 4pm. This year in St Mary''s church due to ongoing repair work in the village hall. ',null),('event','0','490','490','en','0','Buriton Tennis Club is holding its regular Quiz Night in the Maple Inn this year ? and all are welcome.',null),('event','0','491','491','en','0','A guided walk, led by Hampshire expert Rosemary Webb - meet at the Halls Hill car park at 10am. [NB. This is a re-arranged date: this event was originally planned for 18 October]',null),('event','0','492','492','en','0','A quiet evening of poems and prose from a hundred years ago (some by local residents and servicemen), commemorating the start of four years of World War. \r\n',null),('event','0','493','493','en','0','An illustrated talk about Sir Edward Grey, Foreign Secretary at the outbreak of the First World War, will provide background to the build-up to the conflict and insights into Sir Edward?s many links with Hampshire',null),('news','0','494','494','en','0','<p>Hampshire County Council is consulting the community to find out whether this route, at Ditcham Wood, near Coulters Dean, should be recorded as a public footpath.</p>\r\n','full_html'),('news','0','495','495','en','0','<p>Buriton has been chosen as one of four small communities from Hampshire to take part in a special "D Day at 70" project - and your help is being sought.</p>\r\n','full_html'),('event','0','496','496','en','0','Judy Dench is an Irishwoman searching for the son taken from her as a baby. Steve Coogan is a journalist assisting her in her quest. Funny and sad and beautifully done on all levels.',null),('event','0','497','497','en','0','Buriton''s popular annual village show - including flowers, fruit, vegetables, baking and arts & crafts.  This year in three special venues (details below).  ',null),('event','0','498','498','en','0','The antidote to ordinary quiz nights ?',null),('news','0','500','500','en','0','<p>Winter newsletter praises work to restore the old pond at Buriton Chalk Pits</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','501','501','en','0','<p>Villagers in Buriton''s "adopted" communuity of Dominase, in Ghana, are seeing more and more improvements in the health of the population, particularly young children, as as result of Buriton?s programme of sanitation projects.</p>\r\n','full_html'),('news','0','502','502','en','0','<p>A unique event bringing together historians, schoolchildren and dance professionals will be held in Petersfield Square this summer to commemorate the centenary of the outbreak of the First World War.</p>\r\n','full_html'),('event','0','503','503','en','0','A unique event bringing together historians, schoolchildren and dance professionals will be held in Petersfield Square this summer to commemorate the centenary of the outbreak of the First World War. ',null),('news','0','504','504','en','0','<p>Buriton''s charity ''Village-to-Village'' group have successfully sponsored an inter-school Reading Competition in and around Dominase - with hundreds of children taking part.</p>\r\n','full_html'),('news','0','505','505','en','0','<p>Money from Buriton has provided scores of children with somewhere safe and clean to go to the loo during school time ? which, in turn, helps to boost attendances ?</p>\r\n','full_html'),('news','0','506','506','en','0','<p>The rare Cheese Snail which lives in the Buriton Chalk Pits is now celebrated in Portland Stone ? and two other sculptures on this new long distance walking and cycling route can also be found in the parish.</p>\r\n','full_html'),('news','0','507','507','en','0','<p>Buriton?s ?Village-to-Village? link with Dominase has recently delivered over 1,000 Supplementary Reading Books to hundreds of cheering schoolchildren.</p>\r\n','full_html'),('news','0','508','508','en','0','<p>Two new leaflets produced by Buriton Parish Council provide an insight into 100 million years of history ? and explain how the rocks beneath us not only create the landscapes and scenery in the parish, but also influence the natural vegetation, wildlife, agriculture and industrial history of the area.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','509','509','en','0','This popular event returns on Saturday 7 and Sunday 8 June from 2.00 ? 6.00 on both days. \r\n\r\nA wide variety of work by local creatives in 5 venues, including the Five Bells and the Manor Barn.\r\n',null),('event','0','510','510','en','0','Spend an enchanting evening in one of our Local Nature Reserves and emerge much wiser about the distinctive bird songs of many of our local species. ',null),('event','0','511','511','en','0','A chance to hear some wonderful bird song on a dawn chorus walk through the Buriton Chalk Pits',null),('news','0','512','512','en','0','<p>Due to the overwhelming response and interest in the calendar for 2014, the organisers have decided to do the same thing for 2015 and want even more people to take photographs for consideration</p>\r\n','full_html'),('event','0','513','513','en','0','This popular event returns on Saturday 7 and Sunday 8 June from 2.00 ? 6.00 on both days. \r\n\r\nA wide variety of work by local creatives in 5 venues, including the Five Bells and the Manor Barn.\r\n',null),('event','0','514','514','en','0','Tennis fun with afternoon tea - open to members and non-members of Buriton Tennis Club. Sunday 18 May.',null),('event','0','515','515','en','0','Pre-booking is essential: please see details below.',null),('news','0','516','516','en','0','<p>Some of Buriton?s connections with the famous D-Day campaign, 70 years ago, were unveiled at a major conference in Portsmouth recently</p>\r\n','full_html'),('quickevent','0','517','517','en','0','Spectators Welcome',null),('quickevent','0','518','518','en','0','Copme and see Buriton take on the might of Boris Johnson''s TfL Dinos! ',null),('quickevent','0','519','519','en','0','Spectators welcome',null),('quickevent','0','520','520','en','0','A 20/20 evening game.',null),('quickevent','0','521','521','en','0','Spectators always welcome ',null),('quickevent','0','522','522','en','0','A new fixture against Portsmouth University intellectuals!',null),('quickevent','0','523','523','en','0','It may be the show weekend, but the big fixture is our game versus the staff and parents of Bedales School - spectators welcome.',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','524','524','en','0','Our final fixture of the season against a strong local team - spectators always welcome!',null),('event','0','525','525','en','0','A concert entitled- Midsummer Music ? performed by an all female group.',null),('news','0','526','526','en','0','<p>About 20 villagers and friends spent an enchanting evening in the Buriton Chalk Pits Local Nature Reserve on 15th May ? and emerged much wiser about the distinctive bird songs of many of our local species.</p>\r\n','full_html'),('news','0','527','527','en','0','<p>More than 50 players took a step back in time on 18th May by donning their vintage white clothes, digging out their old wooden rackets and hitting the courts for an afternoon of tennis as it used to be.</p>\r\n','full_html'),('news','0','528','528','en','0','<p>Children, parents, helpers and friends of Buriton Nursery School took part in a ''Sponsored Toddle'' on the village recreation ground in May, to raise money for school funds and for their friends in Africa.</p>\r\n','full_html'),('news','0','529','529','en','0','<p>Over 100 people packed into the church on 10th June to hear two fascinating presentations about Operation Overlord and the D-Day Landings of 70 years ago.</p>\r\n','full_html'),('news','0','530','530','en','0','<p>Even though the Village Hall will not be available this year ? ?the Show will go on? on Saturday 16th August as planned.</p>\r\n','full_html'),('news','0','531','531','en','0','<p>Almost 50 old documents about the parish, some of which are 300 years old, return home.</p>\r\n','full_html'),('event','0','532','532','en','0','All are welcome at Buriton?s popular annual ?camp-out? on the Recreation Ground: commencing on Saturday 19th July and camping overnight until about 1pm on Sunday 20th. ',null),('news','0','533','533','en','0','<p>And a sea of Round-headed Rampions looks set to follow.</p>\r\n','full_html'),('event','0','534','534','en','0','The show promises scores of activities in a main arena and many other attractions ? with a particular focus on the landscape of the South Downs and on managing pressures in the National Park',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','535','535','en','0','The show promises scores of activities in a main arena and many other attractions ? with a particular focus on the landscape of the South Downs and on managing pressures in the National Park',null),('event','0','536','536','en','0','The show promises scores of activities in a main arena and many other attractions ? with a particular focus on the landscape of the South Downs and on managing pressures in the National Park',null),('news','0','537','537','en','0','<p>Susan Shone put on a special spread for senior citizens from across the parish in July ? an established part of the community?s annual ?Down on our farms? programme of events, open days, walks and talks.</p>\r\n','full_html'),('news','0','538','538','en','0','<p>As part of Buriton?s Village-to-Village link with its sister community of Dominase in rural Ghana, a new teacher-training initiative has been launched.</p>\r\n','full_html'),('news','0','539','539','en','0','<p>As part of the community?s research into connections with the D-Day landings of 1944, a new book has been produced by the Buriton Village Association as part of the Heritage Bank initiative.</p>\r\n','full_html'),('news','0','540','540','en','0','<p>The Open Day in the Buriton Chalk Pits Nature Reserve clocked up about 250 different species of plants and creatures in less than 24 hours ? including dozens of moths attracted to a special survey site on Saturday evening (see photo).</p>\r\n','full_html'),('news','0','541','541','en','0','<p>The Tennis Club?s popular Davis Cup competition this year came with some extra twists.</p>\r\n','full_html'),('news','0','542','542','en','0','<p>Visitors and residents alike remarked on the way that the parish?s war memorial was enhanced to mark the 100th anniversary of the outbreak of the First World War ? one of a series of thoughtful events being held in the community.</p>\r\n','full_html'),('news','0','543','543','en','0','<p>As the nation remembered the anniversary of the events of August 1914 and thereafter, the occasion was marked in Buriton with a quiet evening of wartime poems and prose, including some written by local servicemen and residents.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','544','544','en','0','<p>With the village hall unavailable the organisers of the annual village show put their thinking caps on and came up with a winning formula.</p>\r\n','full_html'),('event','0','545','545','en','0','Want something different for Christmas? Ever struggle with Christmas Gift Ideas? Dislike the Christmas madness on the High Street?',null),('news','0','546','546','en','0','<p>The Parish Council has learnt that a planning application has been submitted to change the use of the Maple Inn into a Bed &amp; Breakfast establishment with the construction of two new detached dwellings in the current garden and car park. There are a number of opportunities to have your say.</p>\r\n','full_html'),('event','0','547','547','en','0','Comedy film in Buriton?s new cinema ',null),('event','0','548','548','en','0','Romantic Drama film in Buriton?s new cinema ',null),('event','0','549','549','en','0','Period Drama film in Buriton?s new cinema ',null),('news','0','550','550','en','0','<p>The hall floor is now dry and the Parish Council has begun to schedule the repairs.</p>\r\n','full_html'),('news','0','551','551','en','0','<p>The South Downs National Park Authority is encouraging community groups to ?uncover the hidden historic gems of the local landscape? and volunteers from Buriton are already on board.</p>\r\n','full_html'),('news','0','552','552','en','0','<p>Almost 200 visitors flocked to Buriton church on Saturday 27th September 2014 for the annual ?Bygone Buriton? exhibition ? including families from across the country.</p>\r\n','full_html'),('news','0','553','553','en','0','<p>Copies of a brand new Buriton Parish Calendar for 2015 are now available. At only ?7.50 per copy the new calendar makes a perfect Christmas present for family and friends.</p>\r\n','full_html'),('event','0','554','554','en','0','The antidote to ordinary quiz nights ?  Saturday 22 November (7.30pm) - book soon',null),('news','0','555','555','en','0','<p>Launch of a local project to find out more about the impacts of the four-year conflict on life at home ? and to find out what happened to each of the 193 men who left the parish to take part in the war.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','556','556','en','0','<p>An audience of over sixty villagers and friends were highly entertained by Andrew Robertshaw?s illustrated talk about ?The Making of War Horse? in October.</p>\r\n','full_html'),('news','0','557','557','en','0','<p>October?s Fungi Foray was enjoyed by many local residents with all manner of weird and wonderful species being found.</p>\r\n','full_html'),('news','0','558','558','en','0','<p>How an article in the Parish Magazine led to the discovery of some fascinating local coincidences.</p>\r\n','full_html'),('news','0','559','559','en','0','<p>Too much red tape is being blamed for the demise of a local food project in Buriton ? but villagers want to carry on if they can.</p>\r\n','full_html'),('news','0','560','560','en','0','<p>A neglected plot in Buriton churchyard has been restored with help from an anonymous donor.</p>\r\n','full_html'),('event','0','561','561','en','0','Christmas meat from one of your local farms:  pork and lamb (hogget) joints, bacon, sausages, etc.',null),('news','0','564','564','en','0','<p>Buriton?s annual antidote to ordinary quiz nights launched a new ?regular giving? initiative for the community?s link with Dominase ? and raised almost ?1,000 for West African children.</p>\r\n','full_html'),('news','0','565','565','en','0','<p>Action at home and abroad ? 100 years ago</p>\r\n','full_html'),('event','0','566','566','en','0','Buriton Parish Council meets every alternate month throughout the year.  All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm.',null),('event','0','567','567','en','0','Buriton Parish Council meets every alternate month throughout the year.  This meeting (May 2015) will also be the occasion for the Annual Parish Meeting. ',null),('event','0','568','568','en','0','Buriton Parish Council meets every alternate month throughout the year.  All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm.',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','569','569','en','0','Buriton Parish Council meets every alternate month throughout the year.  All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. ',null),('event','0','570','570','en','0','Buriton Parish Council meets every alternate month throughout the year.  All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm.',null),('quickevent','0','571','571','en','0','Buriton Parish Magazine is produced four times every year with editions in Spring, Summer, Autumn and Winter.  \r\n\r\nThe Spring edition will be circulated in the first week of March and will cover all events for March, April and May.\r\n\r\nTo contact the editors, Steve & Kirsty Thomas, simply send an email to this address: buritonmagazine@yahoo.com\r\n\r\n',null),('quickevent','0','572','572','en','0','Buriton Parish Magazine is produced four times every year with editions in Spring, Summer, Autumn and Winter.  \r\n\r\nThe Autumn edition will be circulated in the first week of September and will cover all events for September, October and November.\r\n\r\nTo contact the editors, Steve & Kirsty Thomas, simply send an email to this address: buritonmagazine@yahoo.com\r\n\r\n',null),('quickevent','0','573','573','en','0','Buriton Parish Magazine is produced four times every year with editions in Spring, Summer, Autumn and Winter.  \r\n\r\nThe Winter edition will be circulated in the first week of December and will cover all events for December, January and February.\r\n\r\nTo contact the editors, Steve & Kirsty Thomas, simply send an email to this address: buritonmagazine@yahoo.com\r\n\r\n',null),('quickevent','0','574','574','en','0','Buriton Parish Magazine is produced four times every year with editions in Spring, Summer, Autumn and Winter.  \r\n\r\nThe Summer edition will be circulated in the first week of June and will cover all events for June, July and August.\r\n\r\nTo contact the editors, Steve & Kirsty Thomas, simply send an email to this address: buritonmagazine@yahoo.com\r\n\r\n',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','575','575','en','0','This is always a very popular social event, so please book your places quickly ? ?6 per person.',null),('event','0','576','576','en','0','Buriton Tennis Club is holding a midsummer barn dance in one of the barns at Tithe House ? courtesy of Maggie and Ian Johnson.\r\n',null),('event','0','577','577','en','0','Buriton''s popular annual village show - including flowers, fruit, vegetables, baking and arts & crafts.  Entries in the morning - showtime in the afternoon. ',null),('event','0','578','578','en','0','Come and see all the new born lambs at Nursted Farm (2pm - 4.30pm).  Part of the ''Down on Buriton''s farms'' programme of farm events, open days, walks and talks during 2015.',null),('event','0','579','579','en','0','Come and see all the new born lambs at Nursted Farm (2pm - 4.30pm).  Part of the ''Down on Buriton''s farms'' programme of farm events, open days, walks and talks during 2015.',null),('event','0','580','580','en','0','Come and see all the new born lambs at Nursted Farm (2pm - 4.30pm).  Part of the ''Down on Buriton''s farms'' programme of farm events, open days, walks and talks during 2015.',null),('event','0','581','581','en','0','Come and see all the new born lambs at Nursted Farm (2pm - 4.30pm).  Part of the ''Down on Buriton''s farms'' programme of farm events, open days, walks and talks during 2015.',null),('event','0','591','591','en','0','Buriton''s popular annual village show - including flowers, fruit, vegetables, baking and arts & crafts.  Entries in the morning - showtime in the afternoon. ',null),('event','0','592','592','en','0','An opportunity for parishioners, family and friends to take a delightful guided stroll along farm paths not normally open to the public ? and opportunities (weather permitting) to see thousands of bluebells and impressive Early Purple orchids. \r\n\r\n\r\n',null),('news','0','593','593','en','0','<p>Having hunted hard to find a local abattoir to replace the service provided by Laverstoke Park, Susan Shone is delighted that she is now able to take orders again for her high quality beef.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','594','594','en','0','A real treat in the spring',null),('news','0','595','595','en','0','<p>An old portrait from a renowned London studio has been re-united with its family roots thanks to the Buriton Heritage Bank.</p>\r\n','full_html'),('news','0','596','596','en','0','<p>Buriton Parish Council is proud to be supporting the South Downs National Park?s bid to obtain International Dark Skies Reserve status ? and there is an easy way for residents to back the bid, too.</p>\r\n','full_html'),('event','0','597','597','en','0','A light hearted look at the history of sanitation and the significant part the British have played in its development.  Not to be missed: don?t poo-poo it!\r\n\r\n',null),('news','0','598','598','en','0','<p>People have been very pleased to see kingfishers again this winter ? as well as regular morning visits from herons as well.</p>\r\n','full_html'),('event','0','599','599','en','0','A chance to hear some wonderful bird song on a dawn chorus walk through the Buriton Chalk Pits',null),('event','0','600','600','en','0','Spend an enchanting evening in one of our Local Nature Reserves and emerge much wiser about the distinctive bird songs of many of our local species. ',null),('news','0','601','601','en','0','<p>In the Morgue at the Five Bells until 21st March</p>\r\n','full_html'),('news','0','602','602','en','0','<p>Bill Gosney?s light hearted look at the history of sanitation attracted dozens of people to his talk in March and raised about ?150 for Buriton?s sister community of Dominase in rural Ghana, West Africa.</p>\r\n','full_html'),('news','0','603','603','en','0','<p>Come to the party!</p>\r\n','full_html'),('news','0','605','605','en','0','<p>What was happening at home and abroad ? 100 years ago?</p>\r\n','full_html'),('news','0','606','606','en','0','<p>One of the first wells that Buriton had provided in Dominase had stopped working ? but recent efforts have brought it back to life</p>\r\n','full_html'),('news','0','607','607','en','0','<p>Michael Reeves of Bones Lane has recently found a treasure trove of photographs showing scores of images from the time of the First World War.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','608','608','en','0','All are welcome at Buriton?s popular annual ?camp-out? on the Recreation Ground: commencing on Saturday 18th July and camping overnight until about 1pm on Sunday 19th. ',null),('event','0','609','609','en','0','A concert of music by Johannes Brahms, interspersed with short readings from letters exchanged with his closest female friend, Clara Schumann, widow of the composer Robert Schumann.',null),('news','0','610','610','en','0','<p>Neighbourcare Buriton wants to increase awareness in the services that it offers and now has a page on this website.</p>\r\n','full_html'),('news','0','611','611','en','0','<p>To mark the end of the five-year lottery-funded project to enhance the Buriton Chalk Pits Local Nature Reserve, the organisers have arranged for a new book to be available (free of charge) for every household in the parish.</p>\r\n','full_html'),('news','0','612','612','en','0','<p>Buriton''s ''Village-to-Village'' charity has arranged another successful inter-school Reading Competition in and around Dominase - with hundreds of children taking part.</p>\r\n','full_html'),('news','0','613','613','en','0','<p>We apologise for the shocking photograph ? but maybe you can help stop this from happening again?</p>\r\n','full_html'),('quickevent','0','614','614','en','0','Your chance to choose your District and Parish Councillors as well as your MP. Elections to the Parish Council take place on the same day as the General Election. Being a parish councillor gives you a chance to help make decisions on issues that affect our local community. You don''t need to have any experience or affiliation with any political party, you just need enthusiasm for the parish. More details of the process and more information about the Parish Council can be found here: http://www.buriton.info/parish_council',null),('news','0','615','615','en','0','<p>Hampshire Police are warning people about three telephone scams ? please warn your friends and neighbours.</p>\r\n','full_html'),('news','0','616','616','en','0','<p>Scores of families visited Nursted Farm in the first of this year?s lambing weekends ? the farm will be open again on Saturday 25th and Sunday 26th April from 2pm to 4.30pm</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','617','617','en','0','Britain''s Got Talent may be back on the telly but in Buriton all eyes will be focused on village performers.',null),('quickevent','0','618','618','en','0','Spectators welcome',null),('quickevent','0','619','619','en','0','Evening 20/20 game - spectators welcome',null),('event','0','620','620','en','0','This popular event returns on Saturday 1 and Sunday 2 August 2015.',null),('event','0','621','621','en','0','This popular event returns on Saturday 1 and Sunday 2 August 2015.',null),('event','0','622','622','en','0','Want something different for Christmas? Ever struggle with Christmas Gift Ideas? Dislike the Christmas madness on the High Street? ',null),('news','0','623','623','en','0','<p>Tai Chi is a martial art recognised for its graceful movements and its positive effect on our health and wellbeing. It is based on ancient Chinese traditions.</p>\r\n','full_html'),('news','0','624','624','en','0','<p>A small group of bleary eyes but well-tuned ears enjoyed the delights of the Dawn Chorus in the Chalk Pits at the beginning of May.</p>\r\n','full_html'),('news','0','625','625','en','0','<p>Presentations and discussion at the Annual Parish Meeting: Tuesday 19 May</p>\r\n','full_html'),('news','0','626','626','en','0','<p>Hot on the heels of the recent book about the Buriton Chalk Pits (''From Chalk to Cheese'', published in April), here is another local book which is well worth reading: ''A History of Buriton''.</p>\r\n','full_html'),('event','0','629','629','en','0','The popular Downland Singers will present their Summer Concert ?Songs for the Seasons? in Buriton on Saturday 4th July at 7.30pm. ',null),('news','0','630','630','en','0','<p>A new plan for the parish</p>\r\n','full_html'),('news','0','631','631','en','0','<p>There is now a special ''summer Sunday bus service''&nbsp;linking the village with Petersfield and with Clanfield, Horndean, Cowplain, Waterlooville and Havant</p>\r\n','full_html'),('event','0','632','632','en','0','This is a test item',null),('quickevent','0','633','633','en','0','THIS IS A TEST OF A "QUICK EVENT"',null);
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','634','634','en','0','FICTITIOUS FINALS DAY EVENT',null),('news','0','635','635','en','0','There was a buzz around Buriton this week when the web-site was restored.',null),('event','0','636','636','en','0','This is a test event.',null),('quickevent','0','637','637','en','0','This is a quick event.',null),('quickevent','0','639','639','en','0','Test event',null),('event','0','640','640','en','0','Buriton?s cinema is back in action in the village hall for the autumn 2015 season so why not come along to see this beautifully-made new version of Hardy''s timeless classic novel: with ravishing photography from and excellent performances (including Carey Mulligan and Michael Sheen).\r\n',null),('event','0','641','641','en','0','On the eve of VE day our two young princesses escape Buckingham Palace to meet the people. A lovely romantic drama starring Rupert Everett and Emily Watson.\r\n\r\n',null),('event','0','642','642','en','0','Ian McKellen is a tour de force as the ageing Holmes with one last case to solve ...! ',null),('event','0','643','643','en','0','An all-star cast (Kate Blanchett, Helena Bonham-Carter, Lily James) and fabulous costumes in Kenneth Branagh''s magical re-telling of this favourite fairytale.  NB. This film starts at 6pm with doors open from 5.30.\r\n',null),('news','0','644','644','en','0','<p>Buriton?s cinema is back in action in the village hall for the autumn 2015 season so why not make a note of the dates and details below to ensure a series of entertaining evenings and some good chats with friends and neighbours?</p>\r\n','full_html'),('event','0','645','645','en','0','The annual local history exhibition will take place in St Mary?s Church, Buriton, between 11am and 4pm on Saturday 26th September\r\n\r\n',null),('event','0','646','646','en','0','Also known as ?PM?s Question Time?.  In Buriton Village Hall. ',null),('news','0','648','648','en','0','<p>What was happening at home and abroad ? 100 years ago?</p>\r\n','full_html'),('news','0','649','649','en','0','<p>The annual ?Bygone Buriton? event attracted almost 200 visitors to St Mary?s church on 26th September ? including families from around the country.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','650','650','en','0','<p>The Fun-key choir starts on Sunday 4th October 2015: 4.30 - 5.30pm, in Buriton Church. And on Sundays thereafter ...</p>\r\n','full_html'),('news','0','651','651','en','0','<p>What was happening at home and abroad ? 100 years ago?</p>\r\n','full_html'),('event','0','653','653','en','0','Edward Thomas will have been familiar with many of the lanes and pathways around Buriton and Petersfield.',null),('news','0','654','654','en','0','<p>There''s a new twist to the Buriton Parish Calendar for 2016 - but it''s an old twist!</p>\r\n','full_html'),('news','0','656','656','en','0','<p>The Buriton bell-ringing team has recently lost some of its long-serving members ? and is very keen to find some replacements.</p>\r\n','full_html'),('event','0','657','657','en','0','On Saturday 12th December the Buriton bell-ringers will be marking a 300 year old connection with a very special performance.',null),('event','0','663','663','en','0','<p>A wonderfully warm-hearted romp. Maggie Smith is magnificent as a homeless woman who shares Alan Bennett?s drive in this moving adaptation of the West End play</p>\r\n','full_html'),('event','0','664','664','en','0','<p>A comedy drama based on Bill Bryson?s best seller</p>\r\n','full_html'),('event','0','665','665','en','0','<p>One of the most eagerly awaited films of the year starring Cary Mulligan, Helena Bonham-Carter, Meryl Streep, Anne-Marie Duff and Romola Garai.</p>\r\n','full_html'),('event','0','666','666','en','0','<p>Tom Courtenay and Charlotte Rampling are at the top of their game in this compelling drama of lost love and missed opportunity</p>\r\n','full_html'),('event','0','667','667','en','0','<p>The second day of the Buriton Village Show weekend - and a chance to enjoy the beauty of a number of gardens around the parish.</p>\r\n','full_html'),('event','0','668','668','en','0','<p>Buriton''s popular annual village show - including flowers, fruit, vegetables, baking and arts &amp; crafts. Entries in the morning - showtime in the afternoon.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','669','669','en','0','<p>Tim Winter will talk about how people were employed working in coppice woodland to produce a wide variety of products including charcoal, bark for tanneries, hurdles, hop poles, besom brooms, walking sticks, barrel hoops and clog soles.</p>\r\n','full_html'),('news','0','670','670','en','0','<p>Buriton?s Village-to-Village charity was able to deliver over 2,000 supplementary reading books to boost school libraries in our ?adopted? community in Ghana during October.</p>\r\n','full_html'),('event','0','671','671','en','0','Come and join the merry throng - followed by mince pies, refreshments and more carols in the church.',null),('news','0','672','672','en','0','<p>What was happening at home and abroad ? 100 years ago?</p>\r\n','full_html'),('news','0','673','673','en','0','<p>An excellent series of films has been arranged for the spring of 2016:</p>\r\n','full_html'),('event','0','674','674','en','0','<p>Toys, puzzles, games, books and DVDs</p>\r\n','full_html'),('quickevent','0','675','675','en','0','<p>Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: http://buriton.info/parish_council</p>\r\n','full_html'),('quickevent','0','676','676','en','0','<p>Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: http://www.buriton.info/parish_council</p>\r\n','full_html'),('quickevent','0','677','677','en','0','<p>Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Village Hall, starting at 7pm. In May, the Council also holds its Annual Parish Meeting (APM) when it can arrange presentations on topics of local interest. In recent years these have focused on planning matters and the Parish Council will be pleased to hear comments on any current planning applications at this year''s APM. Time will also be devoted to the latest situation regarding a potential community bid for the Village Inn / Maple Inn and ideas relating to the village pond car park and landscaping adjacent to the war memorial. The APM will commence at 7pm and will be followed by the normal meeting of the Parish Council at approximately 8pm.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','678','678','en','0','<p>Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: http://www.buriton.info/parish_council</p>\r\n','full_html'),('quickevent','0','679','679','en','0','<p>Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: http://www.buriton.info/parish_council</p>\r\n','full_html'),('quickevent','0','680','680','en','0','<p>Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: http://www.buriton.info/parish_council</p>\r\n','full_html'),('news','0','683','683','en','0','<p>Buriton Parish Council has learnt that emails or letters are being sent to couples who are planning to hold their weddings at the Manor Barn, Buriton, on behalf of Mr Robert Camping.</p>\r\n','full_html'),('news','0','686','686','en','0','<p>Over night between 10th and 11th January 2016 three cars were entered in Buriton and items taken. Items were small amounts of money, sun glasses and CDs.</p>\r\n','full_html'),('event','0','688','688','en','0','<p>The Buriton Players will have dusted off their dancing shoes, lubricated their larynxes and created new costumes to entertain us all ? accompanied by a sumptuous supper and a cash bar.</p>\r\n','full_html'),('event','0','689','689','en','0','<p>The Buriton Players will have dusted off their dancing shoes, lubricated their larynxes and created new costumes to entertain us all ? accompanied by a sumptuous supper and a cash bar.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','690','690','en','0','<p>The annual local history exhibition will take place in St Mary?s Church, Buriton, between 11am and 4pm on Saturday 24th September. Lots of displays, photographs and information - with presentations about the village and villagers 100 years ago, during the First World War.</p>\r\n','full_html'),('event','0','691','691','en','0','<p>Buriton?s annual autumn quiz night is always highly entertaining ? and always sells out quickly. Book your places soon.</p>\r\n','full_html'),('event','0','692','692','en','0','<p>Pre-booking is essential: please see details below.</p>\r\n','full_html'),('event','0','693','693','en','0','<p>An opportunity for parishioners, family and friends to take a delightful guided stroll along farm paths not normally open to the public ? and opportunities (weather permitting) to see thousands of bluebells and impressive Early Purple orchids.</p>\r\n','full_html'),('event','0','694','694','en','0','<p>Are there some things that you don?t like? Do you think that some things need changing? Are you worried that some of the things that you like about the parish might be under threat or might get changed?</p>\r\n','full_html'),('news','0','699','699','en','0','<p>The Parish Council has received some updates about the Planning and Licensing situation at Buriton Manor including: outcomes of Appeals against the refusal of planning applications in January 2015; withdrawal of current Planning Applications; and the latest situation about the Review of the Premises License at the Manor Barn.</p>\r\n','full_html'),('news','0','700','700','en','0','<p>Buriton Parish Council has learnt that emails or letters are being sent to couples who are planning to hold their weddings at the Manor Barn, Buriton, on behalf of Mr Robert Camping.</p>\r\n','full_html'),('news','0','701','701','en','0','<p>Thanks to money raised in and around Buriton the ?Village-to-Village? charity has been able to continue to help improve living conditions and the education of children in the Dominase area of the Central Region of Ghana</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','702','702','en','0','<p>The Parish Council is trying to get Hampshire County Council to re-visit local by-ways open to all traffic (BOATS) to assess them for suitability for use by 4x4 off-road vehicles</p>\r\n','full_html'),('news','0','704','704','en','0','<p>The Parish Council understands that the Village Inn, owned by Mr Robert Camping, was placed in Receivership on 9th December 2015.</p>\r\n','full_html'),('news','0','706','706','en','0','<p>This mini ended up on top of a hedge in Greenway Lane recently. If you have any special photographs showing interesting events or special places in the parish: please enter them in the ?Buriton in Perpetuity? class in the village show so that we continue to build up a fascinating record of life in the parish for future generations to look back on ?</p>\r\n','full_html'),('news','0','707','707','en','0','<p>The BBC, ITV News and Daily Mirror are amongst news outlets reporting that the venue has hit financial troubles and that dozens of couples have been left disappointed after their weddings have been abruptly cancelled</p>\r\n','full_html'),('event','0','708','708','en','0','<p>EVER looked up at the night sky and wondered at the thousands of stars before your eyes?</p>\r\n','full_html'),('news','0','709','709','en','0','<p>That appears to be the outcome of East Hampshire District Council''s meeting on 28th January which revoked the Premises License for Buriton Manor Barn.</p>\r\n','full_html'),('news','0','710','710','en','0','<p>As the number of sheep being injured and killed by dogs across the country increases, a new community initiative is aiming to help protect the National Flock.</p>\r\n','full_html'),('news','0','711','711','en','0','<p>The Hampshire CountryWatch Police Team has circulated more warnings and advice.</p>\r\n','full_html'),('news','0','712','712','en','0','<p>Over 60 people squeezed into the village hall on Friday 12th February and saw the International Space Station pass overhead.</p>\r\n','full_html'),('news','0','713','713','en','0','<p>More and more Barn Owls can now be seen flying over the fields around Buriton ? and some have been filmed nesting at Nursted Farm.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','714','714','en','0','<p>A meeting of the Parish Council''s Planning Committee will take place in the Village Hall</p>\r\n','full_html'),('news','0','715','715','en','0','<p>Filming for the popular TV programme took place with Tom Heap recently</p>\r\n','full_html'),('news','0','717','717','en','0','<p>What was happening at home and abroad 100 years ago and why were some brave boys of Buriton out in India?</p>\r\n','full_html'),('news','0','718','718','en','0','<p>Due to the success of the Buriton calendar over the last few years, it''s been decided to do it again. But your help is needed</p>\r\n','full_html'),('event','0','719','719','en','0','<p>7pm til midnight in Buriton Village Hall: Saturday 7th May</p>\r\n','full_html'),('news','0','721','721','en','0','<p>Come and tell us on Saturday, April 23rd, 10.30am-4pm in Buriton village hall.</p>\r\n','full_html'),('event','0','722','722','en','0','<p>This popular event returns on Saturday 23 July and Sunday 24 July 2016.</p>\r\n','full_html'),('event','0','723','723','en','0','<p>This popular event returns on Saturday 23 July and Sunday 24 July 2016.</p>\r\n','full_html'),('news','0','724','724','en','0','<p>Hundreds of children took part in the Buriton ''Village-to-Village'' Group?s 2016 inter-school challenge with the best 70 competing together for prizes and prestige recently.</p>\r\n','full_html'),('news','0','725','725','en','0','<p>The County Council is faced with yet more cuts in funding from Government and has concluded that ?it is no longer feasible to deliver services at the same level, and in the same way?.</p>\r\n','full_html'),('news','0','726','726','en','0','<p>As part of Buriton?s Village-to-Village link with its sister community of Dominase in rural Ghana, teachers are nearing the end of their special training project.</p>\r\n','full_html'),('news','0','729','729','en','0','<p>Scores of people took part in a special ?pop-in? event in Buriton village hall recently to help shape the future of the parish.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','730','730','en','0','<p>The recent pop-in event in the village hall was very successful ? with scores of visitors. But, if you weren?t able to be there, there?s still time to have your say ?</p>\r\n','full_html'),('news','0','731','731','en','0','<p>After a number of years of sterling service, Wendy Shone is standing down from her role as Parish Clerk and so a replacement is required.</p>\r\n','full_html'),('news','0','732','732','en','0','<p>As parishioners may already be aware, there is to be a Public Inquiry into Network Rail?s application to extinguish part of Footpath 3 across the railway line.</p>\r\n','full_html'),('news','0','733','733','en','0','<p>Over 90 people enjoyed a delightful guided stroll along farm paths not normally open to the public thanks to the generosity of local farmer Susan Shone.</p>\r\n','full_html'),('event','0','734','734','en','0','<p>Gates open for sellers at 7am with buyers from 8am</p>\r\n','full_html'),('event','0','735','735','en','0','<p>Want something different for Christmas? Ever struggle with Christmas Gift Ideas? Dislike the Christmas madness on the High Street?</p>\r\n','full_html'),('event','0','736','736','en','0','<p>Lots of fun on Saturday 18th June</p>\r\n','full_html'),('news','0','737','737','en','0','<p>The pop-in event in the village hall was very successful and all the comments made have now been studied.</p>\r\n','full_html'),('news','0','738','738','en','0','<p>Recent reports from the Police are warning people about a range of scams.</p>\r\n','full_html'),('news','0','739','739','en','0','<p>The organisers of Petersfield?s links are keen to involve people in surrounding villages ? to match the involvement across the channel.</p>\r\n','full_html'),('news','0','740','740','en','0','<p>The latest instalment of this community project reveals what life was like in the parish in April ? June 1916 as well as describing the roles played by Buriton men in the preparations for the Battle of the Somme, at the Battle of Jutland and in some of the earliest airborne activities.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','743','743','en','0','<p>Pieces by Bach, Beethoven, Brahms and others in St Mary?s Church at 2.30pm.</p>\r\n','full_html'),('event','0','745','745','en','0','<p>An opportunity to take part (and get sponsorship) to cycle, walk, run or drive to as many local churches as possible or to sponsor someone else taking part.</p>\r\n','full_html'),('event','0','746','746','en','0','<p>A talk about Jonathan?s experiences as an auctioneer and his TV work, followed by an opportunity to get comments on antiques brought along by the audience</p>\r\n','full_html'),('event','0','748','748','en','0','<p>A hundred years ago people in Buriton were hearing about the largest battle in naval history and about the bloodiest day ever for the British Army.</p>\r\n','full_html'),('event','0','751','751','en','0','<p>A programme of words and smaller-scale musical pieces by the great Russian composer in St Mary''s Church.</p>\r\n','full_html'),('news','0','752','752','en','0','<p>When Buriton-born Margaret Davis recently found a five-inch bronze plaque, inscribed in honour of Charles Lee, amongst family possessions, she had no idea of the sad stories it might be harbouring.</p>\r\n','full_html'),('event','0','753','753','en','0','<p>Steven Spielberg?s massive hit version of Roald Dahl?s famous book needs no introduction!</p>\r\n','full_html'),('event','0','754','754','en','0','<p>A thriller from the 2010 novel by John Le Carre ? moving from the era of Cold War spying to the equally dark world of money laundering involving Russian mafia and MI6.</p>\r\n','full_html'),('event','0','755','755','en','0','<p>A clever adaptation of Jane Austen?s novella ?Lady Susan? with a mesmerising performance from Kate Beckinsale as notorious Lady Susan Vernon.</p>\r\n','full_html'),('event','0','756','756','en','0','<p>This wonderful remake of the old favourite features an all-star voice cast and amazing graphics whilst retaining the sense of magic and wonder.</p>\r\n','full_html'),('event','0','757','757','en','0','<p>Based on the 1980s real life story of Britain?s hopeless but courageous ski-jumper, and with a superb performance from Taron Egerton in the lead, this film needs no introduction - a real crowd-pleaser!</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','758','758','en','0','<p>An Ealing-style comedy with a great array of British talent including Bernard Hill, Simon Callow, Virginia McKenna, Una Stubbs and Phil Davies.</p>\r\n','full_html'),('news','0','759','759','en','0','<p>An excellent series of films has been arranged for the autumn of 2016:</p>\r\n','full_html'),('news','0','760','760','en','0','<p>Local actor and comedian Hugh Dennis has teamed up with the Commonwealth War Graves Commission to promote awareness of war graves here in Britain ? and Buriton will be featured.</p>\r\n','full_html'),('event','0','763','763','en','0','<p>Come and enjoy a Murder Mystery evening in the village hall (staged by members of the Lion and Unicorn Players) and enjoy a delicious supper.</p>\r\n','full_html'),('event','0','766','766','en','0','<p>?10 for a family of 4 or ?3 per person</p>\r\n','full_html'),('news','0','767','767','en','0','<p>Due to the success of the Buriton calendar over the last few years, it?s been decided to do it again and the closing date for entries is the day of the Village Show: Saturday 20th August.</p>\r\n','full_html'),('news','0','771','771','en','0','<p>Please help ensure that the Post Office continues to visit Buriton every week by visiting to buy stamps, post parcels or tax your car ?</p>\r\n','full_html'),('news','0','776','776','en','0','<p>Actor and comedian Hugh Dennis will be supporting the annual ?Bygone Buriton? exhibition at St Mary?s Church on September 24, featuring the community?s involvement in the First World War.</p>\r\n','full_html'),('event','0','777','777','en','0','<p>Come along and help the Country Park?s rangers with some vital habitat management.</p>\r\n','full_html'),('event','0','779','779','en','0','<p>Come along and help the Country Park?s rangers with some vital habitat management.</p>\r\n','full_html'),('event','0','780','780','en','0','Come along and help the Country Park?s rangers with some vital habitat management.',null),('event','0','781','781','en','0','<p>Pop into the village hall on Saturday 15th October</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','782','782','en','0','<p>In May 2016 the South Downs National Park became the world?s newest International Dark Sky Reserve and the Parish Council is now hoping that all planning applications will help to protect the astonishing star-studded skies overhead.</p>\r\n','full_html'),('news','0','783','783','en','0','<p>The Parish Council owns the land to the rear of the war memorial and would like parishioners to design something to give thanks to all those who have helped the country in times of conflict, not just in the armed forces but also helping the war effort at home in various important ways.</p>\r\n','full_html'),('news','0','784','784','en','0','<p>The latest instalment of this community project reveals the roles played by Buriton men during the Battle of the Somme as well as describing what life was like at home in the parish in the months of July, August and September 1916.</p>\r\n','full_html'),('event','0','785','785','en','0','<p>While travelling in traffic between Buriton and Portsmouth, or northwards towards Guildford, have you ever thought that you are following one of the most important routes in British history?</p>\r\n','full_html'),('news','0','786','786','en','0','<p>The graves of four First World War servicemen, buried in St Mary?s churchyard, were honoured as part of the community?s annual ?Bygone Buriton? exhibition in September.</p>\r\n','full_html'),('news','0','789','789','en','0','<p>The Parish Council is in discussions with South East Water about problems with water pressure in parts of the parish and you may be able to help.</p>\r\n','full_html'),('news','0','790','790','en','0','<p>Dozens of people took part in the special ?Plan B? workshop on Saturday 15th October to help shape guidelines which planners use to look after the parish?s special qualities.</p>\r\n','full_html'),('news','0','792','792','en','0','<p>Copies of a brand new Buriton Parish Calendar for 2017 are now available. At only ?8 per copy the new calendar makes a perfect Christmas present for family and friends.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','793','793','en','0','<p>Discoveries made after airborne laser scanning mapped part of the South Downs National Park that had been hidden under woodland for hundreds of years were described at the Buriton Village Association autumn talk in October.</p>\r\n','full_html'),('event','0','794','794','en','0','<p>Buriton?s Fireworks evening will be as fun-packed as ever when the dark skies will be temporarily lit by the fantastic annual display ? and much more ?.</p>\r\n','full_html'),('event','0','795','795','en','0','<p>Parishioners and users of the village hall are invited to a public meeting on Tuesday, 15th November to agree the future of the hall.</p>\r\n','full_html'),('news','0','796','796','en','0','<p>Did you know there was one? Read on for more details ?</p>\r\n','full_html'),('event','0','797','797','en','0','<p>Buriton?s Youth Club (the Countrysiders) will meet at the Five Bells for their AGM and a family quiz</p>\r\n','full_html'),('event','0','798','798','en','0','<p>Buriton?s Youth Club (the Countrysiders) will be doing a charity fund-raising carol singing event.</p>\r\n','full_html'),('event','0','799','799','en','0','<p>Buriton?s Youth Club (the Countrysiders) will be visiting the Panto in Petersfield</p>\r\n','full_html'),('news','0','800','800','en','0','<p>The latest instalment of this community project reveals the roles played by Buriton men during the last three months of 1916 (amidst the terrible weather on the Somme) as well as describing what life was like at home in the parish at that time.</p>\r\n','full_html'),('event','0','801','801','en','0','<p>Once hopes of a swift success on the Western Front in WW1 had been dashed, the country was to face a prolonged war and conscription became a necessary step to boost the number of soldiers and hasten a victory.</p>\r\n','full_html'),('news','0','802','802','en','0','<p>Recent reports from the Police are warning people about a range of thefts and providing advice.</p>\r\n','full_html'),('event','0','803','803','en','0','<p>Come and join the merry throng - followed by mince pies, refreshments and more carols in the church.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','804','804','en','0','<p>You are warmly invited to the launch of Monica?s book at One Tree Books, Petersfield</p>\r\n','full_html'),('event','0','807','807','en','0','<p>Laugh at its wry humour, swoon at its romance and cheer its moments of triumph!</p>\r\n','full_html'),('event','0','808','808','en','0','<p>A commuter becomes entangled in a missing persons investigation that promises to send shockwaves through her life: a not-to-be missed thriller.</p>\r\n','full_html'),('event','0','809','809','en','0','<p>The latest film about Bridget is sharp, well-written, and extremely funny.</p>\r\n','full_html'),('event','0','810','810','en','0','<p>Winner of the Palme d?Or at the 2016 Cannes Film Festival: a quietly fearsome piece of drama with Ken Loach?s talent for humour running throughout.</p>\r\n','full_html'),('news','0','811','811','en','0','<p>An excellent series of films has been arranged for the spring of 2017.</p>\r\n','full_html'),('news','0','812','812','en','0','<p>A routine field survey by local metal detectorists has unearthed a Canadian 1 cent coin in an area where Allied Troops are believed to have assembled in the weeks leading up to D-Day in 1944.</p>\r\n','full_html'),('news','0','813','813','en','0','<p>As well as the completion of another 70 family toilets, work is well under way on the latest block of toilets for another village school.</p>\r\n','full_html'),('quickevent','0','814','814','en','0','<p>Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: http://www.buriton.info/parish_council</p>\r\n','full_html'),('quickevent','0','815','815','en','0','<p>Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: http://www.buriton.info/parish_council</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','816','816','en','0','<p>Buriton Parish Council meets every alternate month throughout the year.</p>\r\n\r\n<p>On 22nd May the Parish Council will also be holding its Annual Parish Meeting, commencing at 6.30pm.</p>\r\n\r\n<p>The Agenda for the Annual Parish Meeting will include the Chairman''s annual report, a presentation of the upgraded community web-site and an update about the war memorial competition. A copy of the full agenda for the Annual Parish Meeting can be found on the home page of the Parish Council part of this web-site.</p>\r\n\r\n<p>At the end of the Annual Parish Meeting, the Council will hold its regular meeting which will also provide an opportunity for members of the public to ask questions or make comments in a Public Forum session. More details about the Parish Council can be found elsewhere on this website:&nbsp;http://www.buriton.info/parish-council</p>\r\n\r\n<p>&nbsp;</p>\r\n','full_html'),('quickevent','0','817','817','en','0','<p>Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website:&nbsp;http://www.buriton.info/parish-council</p>\r\n\r\n<p>&nbsp;</p>\r\n','full_html'),('quickevent','0','818','818','en','0','<p>Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website:&nbsp;http://www.buriton.info/parish-council</p>\r\n\r\n<p>&nbsp;</p>\r\n','full_html'),('quickevent','0','820','820','en','0','<p>Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website:&nbsp;http://www.buriton.info/parish-council</p>\r\n\r\n<p>&nbsp;</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','822','822','en','0','<p>Come along to the showing of BFG in the Village Hall on Wednesday 21st December for another chance to look at the ideas submitted for the community?s 2018 War Memorial project.</p>\r\n','full_html'),('news','0','823','823','en','0','<p>During the Christmas and New Year period, revised dates will be in place for EHDC waste and recycling collections.</p>\r\n','full_html'),('news','0','824','824','en','0','<p>First-time author Heather Lacey explains that her book ?is full of ?stuff? about the people and the places, the history, the landscape, work and leisure, that the usual guides don?t tell you about.?</p>\r\n','full_html'),('news','0','825','825','en','0','<p>Buriton Parish Council would welcome comments from parishioners about East Hampshire District Council?s proposals to sell the pieces of land that it owns at each end of Glebe Road / Sumner Road to a developer.</p>\r\n','full_html'),('event','0','826','826','en','0','<p>An opportunity for parishioners, family and friends to take a delightful guided stroll along farm paths not normally open to the public ? and opportunities (weather permitting) to see thousands of bluebells and impressive Early Purple orchids.</p>\r\n','full_html'),('event','0','827','827','en','0','<p>Pre-booking is essential: please see details below.</p>\r\n','full_html'),('quickevent','0','828','828','en','0','<p>Tickets are ?15 each (including three course dinner) and are available from Jill Martin: jillmartin@btinternet.com and 01730 821149. Cash bar.</p>\r\n\r\n<p>PLEASE NOTE: not many tickets for Saturday night now remaining.</p>\r\n','full_html'),('quickevent','0','829','829','en','0','<p>Tickets are ?15 each (including three course dinner) and are available from Jill Martin: jillmartin@btinternet.com and 01730 821149. Cash bar.</p>\r\n','full_html'),('news','0','830','830','en','0','<p>Susan Shone has some of her delicious local beef available ? particularly braising steak.&nbsp;</p>\r\n','full_html'),('news','0','831','831','en','0','<p>A part-time Village Hall Manager is required to oversee the day-to-day running of Buriton?s popular village hall.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','834','834','en','0','<p>Parishioners and users of the village hall are invited to a public meeting on Tuesday,15th November to agree the future of the hall.</p>\r\n','full_html'),('news','0','835','835','en','0','<p>Following the dissolution of the Village Hall Management Committee and the winding up of the charity, Buriton Village Hall is now managed by Buriton Parish Council.</p>\r\n','full_html'),('event','0','844','846','en','0','<p>Star-Gazing event at the Five Bells on Friday 17th February.</p>\r\n','full_html'),('news','0','845','847','en','0','<p>The local Police teams have recently reported incidents in Kiln Lane and Sumner Road. They are asking for information and providing advice about how to avoid a new email scam.</p>\r\n','full_html'),('event','0','846','848','en','0','<p>Join a gaggle of villagers to help cut back some of the scrub and brambles followed by delicious coffee and cakes provided by Mrs Shone.</p>\r\n','full_html'),('news','0','847','849','en','0','<p>Following the three-day inquiry in December, the Government?s inspector, Peter Millman, decided that the level crossing, carrying Buriton Footpath 3 across the railway line, should be extinguished.</p>\r\n','full_html'),('news','0','848','850','en','0','<p>The latest instalment of this community project reveals the roles played by Buriton men during the first three months of 1917 as well as describing what life was like at home in the parish at that time.</p>\r\n','full_html'),('news','0','849','851','en','0','<p>There have been burglaries at two houses in Buriton very recently with jewellery and other valuables stolen.</p>\r\n','full_html'),('news','0','858','860','en','0','<p>The BBC spent almost a full day in the parish on Thursday 16th February as part of a programme which is planned to be shown on Sunday March 5th.</p>\r\n','full_html'),('news','0','859','861','en','0','<p>About 40 people met at the Five Bells on Friday 17th February before enjoying the wonders of the thousands of stars that can be seen from the village using powerful telescopes and binoculars on the Recreation Ground</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','860','862','en','0','<p>An insight into a unique community project spanning 4,000 miles.</p>\r\n','full_html'),('event','0','861','863','en','0','<p>This popular event returns on Saturday 24 June and Sunday 25 June 2017.</p>\r\n','full_html'),('event','0','862','864','en','0','<p>This popular event returns on Saturday 24 June and Sunday 25 June 2017.</p>\r\n','full_html'),('event','0','863','865','en','0','<p>The traditional horticultural, baking and arts competitions will, as usual, provide the heart of this annual event - but there are some new ideas for 2017.</p>\r\n','full_html'),('event','0','864','866','en','0','<p>The second day of the Buriton Village Show weekend - and a chance to enjoy the beauty of a number of gardens around the parish.</p>\r\n','full_html'),('event','0','865','867','en','0','<p>The annual local history exhibition will take place in the village hall between 11am and 4pm on Saturday 23rd September. Lots of displays, photographs and information - with presentations about the village and villagers 100 years ago, during the First World War.</p>\r\n','full_html'),('event','0','882','893','en','0','<p>A morning in the Buriton Chalk Pits, with experts showing some of the wildlife that can be found.</p>\r\n','full_html'),('event','0','884','895','en','0','<p>Including barbecue with local burgers and lots of activities.</p>\r\n','full_html'),('news','0','886','897','en','0','<p>There was a comprehensive update about the War Memorial project at the Parish Council meeting at the end of March.</p>\r\n','full_html'),('news','0','888','899','en','0','<p>The South Downs National Park Authority (SDNPA) has published the community’s draft Village Design Statement for public comment.</p>\r\n','full_html'),('news','0','889','900','en','0','<p>Another successful inter-school reading competition was held on Friday 17<sup>th</sup> March, with scores of children taking part representing a dozen schools.</p>\r\n','full_html'),('event','0','890','901','en','0','<p>A concert featuring local musicians including (among others) cellist Mikhail Lezdkan and clarinettist Rob Blanken.&nbsp;</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','891','902','en','0','<p>Buriton''s ‘Village-to-Village’ charity has helped yet more families improve their living conditions, reduce risks of diseases and obtain some privacy - often lacking for millions of people in Africa.</p>\r\n','full_html'),('news','0','892','903','en','0','<p>Operation Falcon is the Police Force’s drive to reduce rural crime and for April the main priority will be thefts from motor vehicles. The Police have provided some new crime prevention advice</p>\r\n','full_html'),('news','0','893','904','en','0','<p>Money from Buriton has provided scores of children with somewhere safe and clean to go to the loo during school time - which, in turn, helps to boost attendances</p>\r\n','full_html'),('news','0','894','905','en','0','<p>East Hampshire District Council is warning residents about the risks of disposing of waste without using an approved carrier.</p>\r\n','full_html'),('news','0','895','906','en','0','<p>Buriton''s "Village-to-Village" link with Dominase has recently delivered over 2,200 more Supplementary Reading Books to hundreds of cheering schoolchildren.</p>\r\n','full_html'),('event','0','899','910','en','0','<p>PM’s Question Time: Saturday 14 October at 7.30pm</p>\r\n','full_html'),('news','0','900','911','en','0','<p><span style="font-family:Arial">New Hall Manager and contact for all bookings etc</span></p>\r\n','full_html'),('news','0','902','913','en','0','<p style="margin-top:0cm; margin-right:0cm; margin-bottom:9.0pt; margin-left:0cm"><span style="background:white"><span style="line-height:12.0pt"><span style="font-family:Arial"><span style="color:#333333"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Parishioners are being encouraged to help reduce the number of dog attacks that have killed and injured scores of sheep in the parish in recent years.</span></span></span></span></span></span></span></span></span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','903','914','en','0','<p style="margin-top:0cm; margin-right:0cm; margin-bottom:9.0pt; margin-left:0cm"><span style="background:white"><span style="line-height:12.0pt"><span style="font-family:Arial"><span style="color:#333333"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">A modern retelling of the story of <country-region style="box-sizing:border-box" w:st="on"></country-region><st1:country-region w:st="on"><st1:place w:st="on">England</st1:place></st1:country-region>''s famous warrior queen who rose up against the Romans.</span></span></span></span></span></span></span></span></span></span></span></p>\r\n','full_html'),('event','0','904','915','en','0','<p><span style="background:white"><span style="line-height:12.0pt"><span style="font-family:Arial">Another guided walk in one of our Nature Reserves: 6.30pm on Wednesday 24<sup style="box-sizing:border-box">th</sup> May</span></span></span></p>\r\n','full_html'),('event','0','907','918','en','0','<p>Gates open for sellers at 7am with buyers from 8am.</p>\r\n','full_html'),('event','0','908','919','en','0','<p>Gates open for sellers at 7am with buyers from 8am.</p>\r\n','full_html'),('event','0','910','921','en','0','<p>Gates open for sellers at 7am with buyers from 8am.</p>\r\n','full_html'),('news','0','913','924','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial">Culprit caught and given a 10-year sentence</span></span></p>\r\n','full_html'),('news','0','914','925','en','0','<p>Volunteers from Petersfield Ramblers, in conjunction with the HCC Countryside Team, have recently replaced two awkward stiles with kissing gates</p>\r\n','full_html'),('news','0','915','926','en','0','<p><span style="background:white"><span style="font-family:Arial">Eighteen willing volunteers helped cut back areas of overgrown scrub and brambles in The Links on Sunday 14 May to improve the appearance of Buriton’s secret valley and help local farmer, Susan Shone.</span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','916','927','en','0','<p>In the Seward Room at St Mary’s Church: from 3pm to 6pm.<br />\r\n<!--[if !supportLineBreakNewLine]--><br />\r\n<!--[endif]--></p>\r\n','full_html'),('news','0','917','928','en','0','<p style="margin: 0cm 0cm 0pt;"><span style="background: white;"><span style="font-family: Arial;">The latest instalment of this community project reveals the roles played by Buriton men during April, May and June 1917 as well as describing what life was like at home in the parish at that time.</span></span></p>\r\n','full_html'),('news','0','923','934','en','0','<p><span style="font-size:11.0pt"><span style="line-height:115%"><span style="font-family:Calibri">In her incredibly well-researched talk in Buriton in June, Alison Wilcox explained how the introduction of conscription in 1916 led to some significant opposition and, in some cases, imprisonment.</span></span></span></p>\r\n','full_html'),('news','0','924','935','en','0','<p>Rangers from the Queen Elizabeth Country Park enthralled local families with insights into a wide range of plants, butterflies and creep-crawlies in the Nature Reserve.</p>\r\n','full_html'),('news','0','929','944','en','0','<p>The Council is encouraging residents to complete a short on-line survey about waste - and is also encouraging people to report road problems via a new website.</p>\r\n','full_html'),('news','0','937','952','en','0','<p><span style="font-size:10.0pt"><span style="font-family:Arial">East Hampshire District Council has alerted the Parish Council to the “Hitting the Cold Spots” initiative which can help people with heating problems and help find funding</span></span></p>\r\n','full_html'),('event','0','938','953','en','0','<p>DATE NOW CHANGED TO FRIDAY 27th OCTOBER - STARTING AT&nbsp;4.30pm</p>\r\n','full_html'),('news','0','939','954','en','0','<p class="lead" style="margin-bottom:.0001pt"><span style="font-size:10.0pt"><span style="font-family:Arial">Hampshire County Council is conducting a survey to ask people for their views on options for managing their shortfall of money. Have your say!</span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','940','955','en','0','<p>Home made cakes and cream teas. This week starting at 1.30pm to coincide with Buriton''s Gardens Open Event.&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n','full_html'),('news','0','943','958','en','0','<p class="p1" style="margin:0cm; margin-bottom:.0001pt"><span style="font-size:11.0pt"><span style="font-family:Calibri">The community’s revised Village Design Statement (VDS) was considered by the South Downs National Park Authority in August.</span></span></p>\r\n','full_html'),('news','0','944','959','en','0','<p>Saturday 26th August</p>\r\n','full_html'),('event','0','945','960','en','0','<p class="p1" style="margin:0cm; margin-bottom:.0001pt"><span style="font-size:11.0pt"><span style="font-family:Calibri">Emma Watson and Dan Stevens star in this adaptation of the classic fairytale about a monstrous looking prince and a young woman who fall in love. The tale may be as old as time, but it’s retold with freshness and flair.</span></span></p>\r\n','full_html'),('event','0','946','961','en','0','<p class="p1" style="margin:0cm; margin-bottom:.0001pt"><span style="font-size:11.0pt"><span style="font-family:Calibri">Based on a true story, this is a moving drama about a forgotten occupation.</span></span></p>\r\n','full_html'),('event','0','947','962','en','0','<p><span style="font-size:11.0pt"><span style="font-family:Calibri">A romantic comedy drawing on a true life story.</span></span></p>\r\n','full_html'),('event','0','948','963','en','0','<p class="p1" style="margin:0cm; margin-bottom:.0001pt"><span style="font-size:11.0pt"><span style="font-family:Calibri">Gripping drama throughout.</span></span></p>\r\n','full_html'),('event','0','949','964','en','0','<p class="p1" style="margin:0cm; margin-bottom:.0001pt"><span style="font-size:11.0pt"><span style="font-family:Calibri">Irresistibly uplifting.</span></span></p>\r\n','full_html'),('news','0','950','965','en','0','<p><span style="font-size:11.0pt"><span style="font-family:Calibri">Films in Buriton are back with an exciting feast of films for the autumn season. </span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','951','966','en','0','<p style="margin: 0cm 0cm 0pt;"><span lang="EN" style="font-size: 11pt;"><span style="background: white;"><span style="font-family: &quot;Calibri&quot;,sans-serif;"><font color="#000000">With food shortages at home and the start of the Battle of Passchendaele across the channel, this was a difficult time for many Buriton families.</font></span></span></span></p>\r\n','full_html'),('news','0','952','967','en','0','<p><span style="font-size:11.0pt"><span style="font-family:Calibri">A Roman Legion, Darth Vader, a Jazz Band, Fancy Dress races and information about Buriton’s wonderful Dark Night Skies were amongst the star attractions at the 2017 Village Show.</span></span></p>\r\n','full_html'),('news','0','953','968','en','0','<p><span style="font-size:11.0pt"><span style="font-family:Calibri">The police are reporting increases in burglaries from sheds and garages, as well as increases in identity fraud. They are providing advice about what to do to reduce problems.</span></span></p>\r\n','full_html'),('event','0','954','969','en','0','<p><span style="font-size:11.0pt"><span style="font-family:Calibri">The Village Inn will be taking part in the worlds biggest Coffee Morning for Macmillan Cancer Support on Friday 29<sup>th</sup> September: 10.45 to 12.45.</span></span></p>\r\n','full_html'),('news','0','955','970','en','0','<p><span style="font-size:11.0pt"><span style="font-family:Calibri">Buriton is a great place to enjoy the best free light show that there is - with twinkling stars and bright planets scattered across the sky. How can we help to protect this?</span></span></p>\r\n','full_html'),('news','0','956','971','en','0','<p><span style="font-size:11.0pt"><span style="font-family:Calibri">Sometime between 9.30 am and 12 noon on Sunday 27<sup>th</sup> August unknown person/s have gained access to a property in Kiln Lane, Buriton. A rear window was broken and some cash was stolen.</span></span></p>\r\n','full_html'),('news','0','957','972','en','0','<p><span style="font-size: 11pt;"><span style="font-family: Calibri;">East Hampshire District Council had to remove a lime tree at the village pond recently because of its dangerous condition.</span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','960','975','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-size:10.0pt"><span style="font-family:Arial">Want something different for Christmas? Ever struggle with Christmas Gift Ideas? Dislike the Christmas madness on the High Street?</span></span></span></p>\r\n','full_html'),('news','0','962','977','en','0','<p>“Public Consultation Flyer”</p>\r\n','full_html'),('news','0','967','987','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="font-size:11pt"><span style="font-family:Arial">The pre-submission version of the South Downs Local Plan contains one set of 96 policies, replacing more than a thousand existing local plan policies currently operating in different parts of the National Park.</span></span></p>\r\n','full_html'),('event','0','968','988','en','0','<p>Services on Sunday 1<sup>st</sup> October</p>\r\n','full_html'),('news','0','969','989','en','0','<p>Scores of visitors flocked to Buriton Village Hall on Saturday 24<sup>th</sup> September for the annual ‘Bygone Buriton’ exhibition – including families from across the country.</p>\r\n','full_html'),('news','0','970','990','en','0','<p><span style="font-family:Calibri">At its meeting on 25th September the Parish Council agreed to change village hall hire charges.</span></p>\r\n','full_html'),('news','0','972','992','en','0','<p><span style="font-size:10.0pt"><span style="font-family:Arial">A pack of information (including voting slips) was recently delivered to every household in the parish with the heading “2018 Armistice Commemoration”.</span></span></p>\r\n','full_html'),('news','0','974','994','en','0','<p>The Lion and Unicorn Players tell the story of the first actresses allowed on the stage.</p>\r\n','full_html'),('news','0','975','995','en','0','<p>A number of parishioners have complained to the Parish Council about an increase in the number of cars driving along&nbsp;Bolinge Hill Lane&nbsp;(between&nbsp;Petersfield Road, Buriton, and The Causeway).</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','976','996','en','0','<p style="margin-top:0cm; margin-right:0cm; margin-bottom:9.0pt; margin-left:0cm"><span style="background:white"><span style="line-height:12.0pt"><span style="font-size:11.0pt"><span style="font-family:Arial">Join local Rangers and Volunteers for a family friendly game of ‘bat and moth’ followed by an autumnal evening walk around the chalk pits with bat detectors.</span></span></span></span></p>\r\n','full_html'),('news','0','977','997','en','0','<p><span style="font-family:Arial">There’s a new twist to the calendar for 2018 – but it’s an old twist: “Bygone Buriton”</span></p>\r\n','full_html'),('event','0','979','999','en','0','<p><span style="font-size:11pt"><span style="font-family:Arial">Friday 1 November. </span></span><span style="font-size:11pt"><span style="font-family:Arial">Gates open 6pm</span></span></p>\r\n','full_html'),('quickevent','0','981','1003','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: </span></span></span></span></span></span></span></span><span style="font-family:Arial"><a href="http://www.buriton.info/parish-council"><span style="text-decoration:none"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">http://www.buriton.info/parish-council</span></span></span></span></span></span></span></span></a></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','982','1004','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: </span></span></span></span></span></span></span></span><span style="font-family:Arial"><a href="http://www.buriton.info/parish-council"><span style="text-decoration:none"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">http://www.buriton.info/parish-council</span></span></span></span></span></span></span></span></a></span></span></p>\r\n','full_html'),('quickevent','0','983','1005','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: </span></span></span></span></span></span></span></span><span style="font-family:Arial"><a href="http://www.buriton.info/parish-council"><span style="text-decoration:none"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">http://www.buriton.info/parish-council</span></span></span></span></span></span></span></span></a></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','984','1006','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: </span></span></span></span></span></span></span></span><span style="font-family:Arial"><a href="http://www.buriton.info/parish-council"><span style="text-decoration:none"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">http://www.buriton.info/parish-council</span></span></span></span></span></span></span></span></a></span></span></p>\r\n','full_html'),('quickevent','0','985','1007','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: </span></span></span></span></span></span></span></span><span style="font-family:Arial"><a href="http://www.buriton.info/parish-council"><span style="text-decoration:none"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">http://www.buriton.info/parish-council</span></span></span></span></span></span></span></span></a></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','986','1008','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Buriton Parish Council meets every alternate month throughout the year. All meetings now take place in the Seward Room at St Mary''s church, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: </span></span></span></span></span></span></span></span><span style="font-family:Arial"><a href="http://www.buriton.info/parish-council"><span style="text-decoration:none"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">http://www.buriton.info/parish-council</span></span></span></span></span></span></span></span></a></span></span></p>\r\n','full_html'),('event','0','987','1009','en','0','<p><span style="background:white"><span style="font-family:Arial">The annual local history exhibition will take place in the church (from 1pm) with lots of displays, photographs and information about life in the parish in years gone by.</span></span></p>\r\n','full_html'),('event','0','988','1010','en','0','<p><span style="font-family: Arial;">An insight into the role of Buriton people in the war to end all wars</span></p>\r\n','full_html'),('event','0','989','1011','en','0','<p>A fascinating overview of local research work.</p>\r\n','full_html'),('news','0','990','1012','en','0','<p><span style="font-family:Arial">Since its last meeting there have been two important consultations. Details are provided here.</span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','991','1013','en','0','<p><span style="font-family:Arial">The Parish Council has arranged for new handrails to be fitted at both ends of the North Lane ("The Lawns") footpath.</span></p>\r\n','full_html'),('news','0','992','1014','en','0','<p><span style="font-family:Arial">Ranger Joe finds bats in the pits</span></p>\r\n','full_html'),('event','0','993','1015','en','0','<p><span style="font-family:Arial">Please come and help look after our Local Nature Reserve.</span></p>\r\n','full_html'),('event','0','994','1016','en','0','<p><span style="font-family: Arial;">Please come and help look after our Local Nature Reserve.</span></p>\r\n','full_html'),('event','0','995','1017','en','0','<p><span style="font-family: Arial;">Please come and help look after our Local Nature Reserve.</span></p>\r\n','full_html'),('news','0','996','1018','en','0','<p><span style="font-family:Arial">Diamonds Class use Buriton’s link with <st1:country-region w:st="on"><st1:place w:st="on">Ghana</st1:place></st1:country-region> to find out about “Ourselves and Our World”</span></p>\r\n\r\n<p>&nbsp;</p>\r\n','full_html'),('news','0','997','1019','en','0','<p><span style="font-family:Arial">Thanks to the generosity of villagers and sponsors, school libraries in Buriton’s sister village are likely to benefit from another boost of books</span></p>\r\n','full_html'),('event','0','998','1020','en','0','<p><span style="font-family:Arial">An illustrated talk about what the parish was like 180 years ago</span></p>\r\n','full_html'),('event','0','999','1021','en','0','<div class="clearfix text-formatted field field--name-field-subtitle field--type-text-long field--label-hidden field__item" style="text-align: left; color: rgb(51, 51, 51); text-transform: none; text-indent: 0px; letter-spacing: normal; clear: none; font-size: 14px; font-style: normal; font-variant: normal; font-weight: 600; text-decoration: none; word-spacing: 0px; display: block; white-space: normal; box-sizing: border-box; orphans: 2; background-color: transparent; -webkit-text-stroke-width: 0px;">\r\n<p style="margin: 0px; box-sizing: border-box;"><span style="line-height: normal; box-sizing: border-box;"><span style="font-size: 14px; box-sizing: border-box;"><span style="color: rgb(51, 51, 51); box-sizing: border-box;"><span style="box-sizing: border-box;">Over 100 tickets have now been snapped up for this popular event in the magnificent Tithe Barn and t</span></span></span><span lang="EN" style="font-size: 14px; box-sizing: border-box;" xml:lang="EN"><span style="color: rgb(51, 51, 51); box-sizing: border-box;"><span style="box-sizing: border-box;">he lucky ticket holders are now dusting&nbsp;off their dancing shoes and preparing to blow away those January blues ...</span></span></span></span></p>\r\n</div>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1000','1022','en','0','<p><span style="background:white"><span style="font-family:Arial">There’s a new twist to the calendar for 2018 – but it’s an old twist: “Bygone Buriton”</span></span></p>\r\n','full_html'),('news','0','1003','1025','en','0','<p style="margin: 0px;"><span style="margin: 0px; line-height: 107%; font-size: 12pt;">Following the resignation of Tricia Newby, the Parish Council has a vacancy.</span></p>\r\n','full_html'),('event','0','1004','1026','en','0','<p><span style="margin: 0px; line-height: 107%; font-size: 12pt;">Come and join the merry throng - followed by mince pies, refreshments and more carols in the church.</span></p>\r\n\r\n<p style="margin: 0px;"><span style="margin: 0px; line-height: 107%; font-size: 12pt;">&nbsp;</span></p>\r\n\r\n<p style="margin: 0px;"><span style="margin: 0px; line-height: 107%; font-size: 12pt;">Everyone is welcome at this great Buriton tradition.</span></p>\r\n\r\n<p style="margin: 0px;"><span style="margin: 0px; line-height: 107%; font-size: 12pt;">&nbsp;</span></p>\r\n','full_html'),('news','0','1005','1027','en','0','<p><span style="margin: 0px; line-height: 107%; font-size: 12pt;">Keen to make sure that parishioners know all about the Local Nature Reserve and that they consider helping to keep it in good condition, Joe Williams spoke to a packed Parish Council meeting in November.</span></p>\r\n','full_html'),('news','0','1006','1028','en','0','<p style="margin: 0px;"><span style="margin: 0px; line-height: 107%; font-size: 12pt;">At the beginning of the Parish Council meeting on Monday 27<sup>th</sup> November, Chairman Tim Concannon delivered the following speech.</span></p>\r\n','full_html'),('news','0','1007','1029','en','0','<p>I<span style="margin: 0px; line-height: 107%; font-size: 12pt;">n the amazing Tithe Barn at Ditcham on Saturday 20<sup>th</sup> January (7pm til 11pm). </span></p>\r\n','full_html'),('event','0','1011','1034','en','0','<p><span style="font-size: 11pt;"><span style="line-height: 107%;"><span style="font-family: &quot;Calibri&quot;,sans-serif;"><font color="#000000">Kenneth Branagh directs and stars in this scintillating new version of Agatha Christie‘s famous novel</font></span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','1012','1035','en','0','<p><span style="font-size: 11pt;"><span style="line-height: 107%;"><span style="font-family: &quot;Calibri&quot;,sans-serif;"><font color="#000000">Riveting World War II thriller filled with espionage and romance</font></span></span></span></p>\r\n','full_html'),('event','0','1013','1036','en','0','<p><span style="font-size: 11pt;"><span style="line-height: 107%;"><span style="font-family: &quot;Calibri&quot;,sans-serif;"><font color="#000000">The extraordinary true story of an unexpected friendship in the later years of Queen Victoria’s rule</font></span></span></span></p>\r\n','full_html'),('event','0','1014','1037','en','0','<p><span style="font-size: 11pt;"><span style="line-height: 107%;"><span style="font-family: &quot;Calibri&quot;,sans-serif;"><font color="#000000">From the novel by Daphne du Maurier</font></span></span></span></p>\r\n','full_html'),('news','0','1015','1038','en','0','<p><span lang="EN" style="font-size: 11pt;"><span style="color: rgb(51, 51, 51);"><span style="font-family: &quot;Calibri&quot;,sans-serif;">Most films are on the first Friday of the month and start at 7.30 (doors open from 7pm) in the village hall</span></span></span></p>\r\n','full_html'),('news','0','1016','1039','en','0','<p style="margin: 0cm 0cm 0pt;"><span style="line-height: normal;"><b><span lang="EN" style="font-size: 10.5pt;"><span style="color: rgb(51, 51, 51);"><span style="font-family: &quot;Helvetica&quot;,sans-serif;">In the amazing Tithe Barn at Ditcham: 7pm til 11pm</span></span></span></b></span></p>\r\n','full_html'),('news','0','1020','1043','en','0','<p>Advice about leaving valuables in vehicles following recent incidents</p>\r\n','full_html'),('news','0','1023','1052','en','0','<p style="margin: 0cm 0cm 8pt;"><font color="#000000"><font face="Calibri"><font size="3">With food shortages at home and fighting in Palestine and Mesopotamia as well as on the Western Front this was a difficult time for many Buriton families.</font></font></font></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','1024','1053','en','0','<p><font color="#000000"><font face="Calibri"><font size="3">Pre-booking is essential: please see details below.</font></font></font></p>\r\n','full_html'),('event','0','1025','1054','en','0','<p><font color="#000000"><font face="Calibri"><font size="3">An opportunity for parishioners, family and friends to take a delightful guided stroll along farm paths not normally open to the public - and opportunities (weather permitting) to see thousands of bluebells and impressive Early Purple orchids.</font></font></font></p>\r\n','full_html'),('news','0','1026','1055','en','0','<p style="margin: 0cm 0cm 8pt;"><font color="#000000"><font face="Calibri"><font size="3">A fascinating account of life in Buriton during the Second World War</font></font></font></p>\r\n','full_html'),('news','0','1027','1056','en','0','<p style="margin: 0cm 0cm 8pt;"><font color="#000000"><font face="Calibri"><font size="3">And a great time was had by all!</font></font></font></p>\r\n','full_html'),('news','0','1028','1057','en','0','<p style="margin: 0cm 0cm 8pt;"><font color="#000000"><font face="Calibri"><font size="3">Buriton Heritage Bank’s website gets a new look – with more information</font></font></font></p>\r\n','full_html'),('news','0','1029','1058','en','0','<p><font color="#000000"><font face="Calibri"><font size="3">Have you thought about using the village hall for your events?</font></font></font></p>\r\n','full_html'),('news','0','1031','1060','en','0','<p><span style="font-size: 12pt;"><span style="line-height: 107%;"><font color="#000000"><font face="Calibri">Towards the end of February, the South Downs National Park Authority installed the very first of a new design of South Downs Way fingerposts above the village. </font></font></span></span></p>\r\n','full_html'),('news','0','1032','1061','en','0','<p><span lang="EN-US" style="font-size: 12pt;"><span style="line-height: 107%;"><font color="#000000"><font face="Calibri">Buriton’s ‘Village-to-Village’ charity has received a wonderful letter of thanks from the Ghana Education Service.</font></font></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1033','1062','en','0','<p><span lang="EN" style="font-size: 12pt;"><span style="line-height: 107%;"><font color="#000000"><font face="Calibri">There was a good turn-out of villagers on 17<sup>th</sup> February to join Buriton’s popular Chalk Pits Ranger, Joe Williams, for a short conservation task morning.</font></font></span></span></p>\r\n','full_html'),('news','0','1037','1068','en','0','<p style="margin: 0cm 0cm 0pt;"><font face="Calibri"><font color="#000000"><font size="3">Almost exactly 70 people squeezed into the village hall on 21</font><sup><font size="2">st</font></sup><font size="3"> March and were enthralled by Robert Mocatta’s detailed research into what Buriton was like almost 200 years ago.</font></font></font></p>\r\n','full_html'),('news','0','1038','1069','en','0','<p style="margin: 0cm 0cm 0pt;"><font color="#000000"><font face="Calibri"><font size="3">The Parish Council Chairman summarised his “eventful first year” at the Annual Parish Meeting on 26th March.</font></font></font></p>\r\n','full_html'),('event','0','1039','1070','en','0','<p><span style="font-size: 11pt;"><span style="line-height: 107%;"><span style="font-family: &quot;Calibri&quot;,sans-serif;"><font color="#000000">A concert of words and music entirely devoted to Franz Schubert </font></span></span></span></p>\r\n','full_html'),('event','0','1041','1072','en','0','<p><span style="font-size: 11pt;"><span style="line-height: 107%;"><span style="font-family: &quot;Calibri&quot;,sans-serif;"><font color="#000000">Everyone is invited to the opening of the new playground on Saturday 12<sup>th</sup> May at 3.30pm.</font></span></span></span></p>\r\n','full_html'),('event','0','1044','1075','en','0','<p style="margin: 0cm 0cm 0pt;"><font color="#000000"><font face="Calibri">Get your tickets now</font></font></p>\r\n','full_html'),('event','0','1047','1078','en','0','<p><strong><font color="#000000"><font face="Calibri">PLEASE NOTE the re-timing: NOW 1.30pm to 6pm - to coincide with Buriton''s Open Gardens</font></font></strong></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','1048','1079','en','0','<p><span style="font-size:12.0pt"><span style="line-height:115%"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;"><font color="#000000">From 3pm to 6pm on selected Sunday afternoons during the summer</font></span></span></span></p>\r\n','full_html'),('event','0','1049','1080','en','0','<p style="margin:0in 0in 0pt"><span style="font-size:12.0pt"><span style="line-height:115%"><font color="#000000"><font face="Calibri">From 3pm to 6pm on selected Sunday afternoons during the summer</font></font></span></span></p>\r\n','full_html'),('event','0','1050','1081','en','0','<p style="margin:0in 0in 0pt"><span style="font-size:12.0pt"><span style="line-height:115%"><font color="#000000"><font face="Calibri">A special party</font></font></span></span></p>\r\n','full_html'),('event','0','1051','1082','en','0','<p><span lang="EN" style="font-size:12.0pt"><span style="line-height:115%"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;"><font color="#000000">This popular event returns on Saturday 23 June and Sunday 24 June</font></span></span></span></p>\r\n','full_html'),('event','0','1052','1083','en','0','<p><span lang="EN" style="font-size:12.0pt"><span style="line-height:115%"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;"><font color="#000000">This popular event returns on Saturday 23 June and Sunday 24 June</font></span></span></span></p>\r\n','full_html'),('event','0','1053','1084','en','0','<p><span style="font-size:12.0pt"><span style="line-height:115%"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;"><font color="#000000">From 3pm to 6pm on selected Sunday afternoons during the summer</font></span></span></span></p>\r\n','full_html'),('news','0','1054','1085','en','0','<p><span lang="EN" style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;mso-ascii-theme-font:minor-latin;\r\nmso-hansi-theme-font:minor-latin;mso-bidi-font-family:Arial;color:#333333;\r\nmso-ansi-language:EN">An enthusiastic and skilled administrator is required to support the Council in this vital role - an opportunity to be involved in local issues and to work largely from home.</span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1059','1093','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;"><span style="background:white"><span style="font-family:&quot;Arial&quot;,&quot;sans-serif&quot;"><span style="color:#212121">The new play facilities were officially opened on 12<sup>th</sup> May</span></span></span></span></span></span></span></p>\r\n','full_html'),('news','0','1060','1094','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;"><span style="font-family:&quot;Arial&quot;,&quot;sans-serif&quot;">There is now a crowd-funding opportunity to help with the community’s commemorative bench project.</span></span></span></span></p>\r\n','full_html'),('news','0','1061','1095','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:13.0pt"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;"><span style="font-size:12.0pt"><span style="color:black">T</span></span><span style="font-size:12.0pt"><span style="color:black">he Petersfield Museum is offering local people an opportunity to have their name etched for ever into their new facilities.</span></span></span></span></span></p>\r\n','full_html'),('news','0','1062','1096','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;"><span style="font-family:&quot;Arial&quot;,&quot;sans-serif&quot;"><span style="color:black">The amount of dog mess around the village is spoiling things for young children.</span></span></span></span></span></span></p>\r\n','full_html'),('news','0','1065','1099','en','0','<p style="margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:105%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">The period April to June 1918 was a busy one for Buriton: with daring action on the battlefields and at sea tinged with great sadness in the village.</span></span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1066','1100','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:105%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">A recent visit to the Hampshire Records Office revealed some fascinating information about Buriton – do you have anything of interest?</span></span></span></span></p>\r\n','full_html'),('news','0','1067','1101','en','0','<p style="margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Copy of passenger list proves journey from Vladivostok to Vancouver.</span></span></span></span></p>\r\n','full_html'),('news','0','1068','1102','en','0','<p style="margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Scores of children took part in a reading competition under a hot African sun in Ghana recently to find the best readers in each age group</span></span></span></span></p>\r\n','full_html'),('news','0','1069','1103','en','0','<p style="margin-bottom:6.0pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">The Petersfield Museum has just unveiled its latest exhibition – which includes “The Buriton Ornamental Hoard”.</span></span></span></span></p>\r\n','full_html'),('news','0','1071','1105','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Farmers are worried about fires in this extremely dry spell and hope parishioners can help - and avoid the risk of fires spreading to village homes and gardens</span><span style="font-size:12.0pt"><span style="line-height:107%">.</span></span></span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1072','1106','en','0','<p style="margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">Buriton’s Nursery School and Primary School are hoping that irresponsible dog owners will pay attention to new posters around the village.</span></span></span></span></p>\r\n','full_html'),('news','0','1073','1107','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:11pt"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Can you help?&nbsp; There are details here about how to respond to the County Council’s survey</span></span></span></span></p>\r\n','full_html'),('event','0','1077','1112','en','0','<p>Our Traditional Village Show, but this year with a twist.</p>\r\n\r\n<p>A Food and Flower Festival.</p>\r\n\r\n<p><strong>Come for lunch from 12.30pm</strong></p>\r\n','full_html'),('event','0','1078','1113','en','0','<p>After the Village Show on Saturday comes the Sunday Open Gardens 2-4.30 pm</p>\r\n','full_html'),('event','0','1082','1118','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:11pt"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt">Join in this popular event in aid of the ‘Hampshire and The Islands Historic Churches Trust’</span></span></span></p>\r\n','full_html'),('news','0','1083','1119','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:11pt"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt">The latest kissing gate in the Parish Council’s programme to gradually replace stiles in the parish was recently installed near Weston Farm.</span></span></span></p>\r\n','full_html'),('news','0','1084','1120','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:11pt"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt">It’s a lifeline and important for many other reasons …</span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1088','1124','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Calibri&quot;,sans-serif">Local farmers are keen to be aware of local bee keepers</span></span></span></p>\r\n','full_html'),('event','0','1090','1126','en','0','<p><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span lang="EN" style="font-family:&quot;Arial&quot;,sans-serif">A mystery story, a love triangle and a war story in a stunning Guernsey setting</span></span></span></span></p>\r\n','full_html'),('event','0','1091','1127','en','0','<p>A truly riveting thriller</p>\r\n','full_html'),('event','0','1092','1128','en','0','<p>Horror, humour and humanity in the trenches</p>\r\n','full_html'),('event','0','1093','1129','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span lang="EN" style="font-family:&quot;Arial&quot;,sans-serif">It is 1959 and widow Florence Green (Emily Mortimer) risks everything to open up a bookshop in the sleepy seaside town of Hardborough. </span></span></span></span></p>\r\n','full_html'),('event','0','1094','1130','en','0','<p><span style="font-size:11.0pt"><span style="line-height:107%"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">A particularly whacky evening in aid of a very good cause</span></span></span></span></p>\r\n','full_html'),('event','0','1095','1131','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">A charity bridge lunch in aid of Bowel Cancer UK. &nbsp;</span></span></span></span></span></p>\r\n','full_html'),('event','0','1096','1132','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">A special lunch for anybody in the village in aid of Help for Heroes.</span></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt">&nbsp;</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1097','1133','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span lang="EN" style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Most films are on the first Friday of the month and start at 7.30 (doors open from 7pm) in Buriton Village Hall</span></span></span></span></span></p>\r\n','full_html'),('event','0','1098','1134','en','0','<p>A chance to have a go at bell-ringing at St Mary''s church, Buriton</p>\r\n','full_html'),('news','0','1099','1135','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif">A part-time Village Hall Manager is required to oversee the day-to-day running of Buriton''s popular village hall near Petersfield.</span></span></span></span></p>\r\n\r\n<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt">&nbsp;</p>\r\n','full_html'),('news','0','1102','1138','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Calibri&quot;,sans-serif">Can you help solve or reduce these incidents?</span></span></span></p>\r\n','full_html'),('news','0','1106','1144','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">Classes in Buriton Village Hall – every Monday</span></span></span></span></span></p>\r\n','full_html'),('news','0','1107','1145','en','0','<p><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">Buriton''s ‘Village-to-Village’ charity has recently sent money to Ghana to help yet more families.</span></span></span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1108','1146','en','0','<p style="margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">Money from Buriton is now helping to provide scores of children with somewhere safe and clean to go to the loo during school time - which, in turn, should help to boost attendances</span></span></span></span></span></p>\r\n','full_html'),('news','0','1109','1147','en','0','<p><span style="font-size:12.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">Professor Clive Harfield travelled about 11,000 miles from his home in Australia, back to his family roots in Buriton, to give this talk.</span></span></span></p>\r\n','full_html'),('news','0','1110','1148','en','0','<p style="margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">Buriton church was buzzing on Saturday 29<sup>th</sup> September as scores of people visited the annual ‘Bygone Buriton’ exhibition – including families from across the country.</span></span></span></span></span></p>\r\n','full_html'),('event','0','1111','1149','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">Everyone is welcome – not just to watch heads being shaved, but also to have some fun. </span></span></span></span></span></p>\r\n','full_html'),('news','0','1112','1150','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">One of the best star-gazing places around …</span></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt">&nbsp;</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1113','1151','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt">Criminal damage to vehicles in the village</span></span></span></span></p>\r\n','full_html'),('news','0','1114','1152','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="tab-stops:list 36.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">At only £8 per copy the new calendar makes a perfect Christmas present for family and friends.</span></span></span></span></span></span></p>\r\n','full_html'),('news','0','1118','1156','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif">Part of the community’s activities to mark the 100<sup>th</sup> anniversary of the end of the First World War.</span></span></span></p>\r\n','full_html'),('quickevent','0','1120','1160','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Buriton Parish Council meets every alternate month throughout the year. All meetings now take place in the Seward Room in St Mary''s church, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: </span></span></span></span></span></span></span></span><span style="font-family:Arial"><a href="http://www.buriton.info/parish-council"><span style="text-decoration:none"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">http://www.buriton.info/parish-council</span></span></span></span></span></span></span></span></a></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','1121','1161','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Buriton Parish Council meets every alternate month throughout the year. All meetings now take place in the Seward Room in St Mary''s church, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: </span></span></span></span></span></span></span></span><span style="font-family:Arial"><a href="http://www.buriton.info/parish-council"><span style="text-decoration:none"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">http://www.buriton.info/parish-council</span></span></span></span></span></span></span></span></a></span></span></p>\r\n','full_html'),('quickevent','0','1122','1162','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Buriton Parish Council meets every alternate month throughout the year. All meetings now take place in the Seward Room in St Mary''s church, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: </span></span></span></span></span></span></span></span><span style="font-family:Arial"><a href="http://www.buriton.info/parish-council"><span style="text-decoration:none"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">http://www.buriton.info/parish-council</span></span></span></span></span></span></span></span></a></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','1123','1163','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: </span></span></span></span></span></span></span></span><span style="font-family:Arial"><a href="http://www.buriton.info/parish-council"><span style="text-decoration:none"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">http://www.buriton.info/parish-council</span></span></span></span></span></span></span></span></a></span></span></p>\r\n','full_html'),('quickevent','0','1124','1164','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: </span></span></span></span></span></span></span><a href="http://www.buriton.info/parish-council"><span style="text-decoration:none"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">http://www.buriton.info/parish-council</span></span></span></span></span></span></span></span></a></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','1125','1165','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: </span></span></span></span></span></span></span><a href="http://www.buriton.info/parish-council"><span style="text-decoration:none"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">http://www.buriton.info/parish-council</span></span></span></span></span></span></span></span></a></span></span></p>\r\n','full_html'),('event','0','1126','1166','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><font face="&quot;Calibri&quot;,sans-serif"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-size:12.0pt"><span style="line-height:107%">An excellent ''feel good'' start for the New Year - and an antidote to the Christmas break!</span></span></span></span></font></p>\r\n\r\n<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt">&nbsp;</p>\r\n','full_html'),('event','0','1127','1167','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">What a cast, what a plot: this film is not to be missed !</span></span></span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','1128','1168','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">The riveting story behind the first manned mission to the moon</span></span></span></span></span></p>\r\n','full_html'),('event','0','1129','1169','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%"><span style="color:#333333">You could hardly cook up a juicier moral quandary than the one at the heart of this film</span></span></span></span></span></span></p>\r\n','full_html'),('event','0','1130','1170','en','0','<p><span style="font-family: Arial;">Please come and help look after our Local Nature Reserve.</span></p>\r\n','full_html'),('event','0','1131','1171','en','0','<p><span style="font-family: Arial;">Please come and help look after our Local Nature Reserve.</span></p>\r\n','full_html'),('event','0','1132','1172','en','0','<p><span style="font-family: Arial;">Please come and help look after our Local Nature Reserve.</span></p>\r\n','full_html'),('event','0','1133','1173','en','0','<p><span style="font-family: Arial;">Please come and help look after our Local Nature Reserve.</span></p>\r\n','full_html'),('event','0','1134','1174','en','0','<p>An illustrated talk on the wildlife and management of the Chalk Pits Nature Reserve - valuable habitats for a variety of species (and a few surprises!)</p>\r\n','full_html'),('news','0','1135','1175','en','0','<p>Friday 30 November, Saturday 1st and Sunday 2nd December</p>\r\n','full_html'),('news','0','1136','1176','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">As part of Buriton''s programme of activities to commemorate the 100th anniversary of the WW1 Armistice, scores of parishioners squeezed into the village hall on Wednesday 7 November to hear some fascinating findings from 100 years ago.</span></span></span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','1137','1177','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">A talk about some amazing archaeological findings – by Ryan Watts of the Petersfield Museum</span></span></span></span></span></p>\r\n','full_html'),('news','0','1138','1178','en','0','<p><span style="font-size:12.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">That’s the message from Hampshire Police as they try to educate dog owners about the risk of attacks on livestock</span></span></span></p>\r\n','full_html'),('event','0','1139','1179','en','0','<p>Come and join the merry throng - followed by mince pies, refreshments and more carols in the church.</p>\r\n','full_html'),('event','0','1140','1180','en','0','<p>Want something different for Christmas? Ever struggle with Christmas Gift Ideas? Dislike the Christmas madness on the High Street?</p>\r\n','full_html'),('event','0','1148','1189','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-size:10.5pt"><span style="font-family:&quot;Helvetica&quot;,sans-serif"><span style="color:#1d2129">A wide variety of goods from up to twenty dealers</span></span></span></span></span></p>\r\n','full_html'),('event','0','1149','1190','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-size:10.5pt"><span style="font-family:&quot;Helvetica&quot;,sans-serif"><span style="color:#1d2129">A wide variety of goods from up to twenty dealers</span></span></span></span></span></p>\r\n','full_html'),('news','0','1151','1192','en','0','<p><span style="color: rgb(51, 51, 51); font-family: Calibri, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 600; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;">New Hall Manager and contact for all bookings etc</span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1152','1193','en','0','<p><span style="color: rgb(51, 51, 51); font-family: Calibri, sans-serif; font-size: 14.6667px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 600; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;">There is currently a vacancy on the Parish Council since Sarah O’Donoghue stepped down as she is leaving the area</span></p>\r\n','full_html'),('news','0','1155','1196','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span lang="EN" style="font-size:12.0pt"><span style="line-height:107%">An enthusiastic and skilled administrator is required to support the Council in this vital role - an opportunity to be involved in local issues and to work largely from home.</span></span></span></span></span></p>\r\n','full_html'),('news','0','1157','1198','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt">Buriton’s Silhouette Soldiers were relocated for a final farewell around the war memorial.&nbsp;</span></span></span></span></p>\r\n','full_html'),('news','0','1158','1199','en','0','<p><span style="font-size:11.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">Parish Council seeks views from interested parties</span></span></span></p>\r\n','full_html'),('news','0','1159','1200','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">As the community’s WW1 project draws towards its close, new information about Buriton’s involvement is still coming forward.</span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1160','1201','en','0','<p><span style="font-size:11.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">Buriton’s little charity continues to make big differences to lives in our adopted community of Dominase in central Ghana</span></span></span></p>\r\n','full_html'),('event','0','1162','1204','en','0','<p>Pre-booking is essential - please see details below.&nbsp;</p>\r\n','full_html'),('event','0','1163','1205','en','0','<p><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">An opportunity for parishioners, family and friends to take a delightful guided stroll along farm paths not normally open to the public - and opportunities (weather permitting) to see thousands of bluebells and impressive Early Purple orchids.</span></span></span></p>\r\n','full_html'),('event','0','1164','1206','en','0','<p><span style="font-size:11.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">It''s amazing how much litter accumulates along our lanes and hedgerows - and how untidy it can make the parish look. </span></span></span></p>\r\n','full_html'),('quickevent','0','1167','1209','en','0','<p style="margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><b>Your chance to choose your District and Parish Councillors. Being a parish councillor gives you a chance to help make decisions on issues that affect our local community. You don''t need to have any experience or affiliation with any political party, you just need enthusiasm for the parish. More information about the elections (and about the Parish Council) can be found here: </b></span></span></span>http://www.buriton.info/index.php/parish-council</p>\r\n\r\n<p style="margin:0cm 0cm 8pt">&nbsp;</p>\r\n\r\n<p style="margin:0cm 0cm 8pt">&nbsp;</p>\r\n','full_html'),('event','0','1168','1210','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><b><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#333333">From 3pm to 6pm on selected Sunday afternoons during the summer </span></span></b></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','1169','1211','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><b><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#333333">From 3pm to 6pm on selected Sunday afternoons during the summer - this date is subject to confirmation</span></span></b></span></span></p>\r\n','full_html'),('event','0','1170','1212','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><b><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#333333">From 3pm to 6pm on selected Sunday afternoons during the summer&nbsp;</span></span></b></span></span></p>\r\n','full_html'),('event','0','1171','1213','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><b><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#333333">From 3pm to 6pm on selected Sunday afternoons during the summer </span></span></b></span></span></p>\r\n','full_html'),('event','0','1172','1214','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><b><span style="background:white"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#333333">The annual local history exhibition will take place in the Village Hall (from 1pm) with lots of displays, photographs and information about life in the parish in years gone by.</span></span></span></b></span></span></p>\r\n','full_html'),('news','0','1173','1215','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#333333">Buriton’s new Chalk Pits Ranger, Ashlea Walters, arranged another popular session in the Nature Reserve on 16 February – enticing participants with the usual tea, coffee and cakes.</span></span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','1174','1216','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#333333">P</span></span><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#333333">opular artist Paul Best will be teaching and demonstrating techniques with acrylic paints, focusing on aspects of local Buriton landscapes. </span></span></span></span></p>\r\n','full_html'),('event','0','1175','1217','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#333333">A hundred years ago the hills above the village were all open downland – grazed by thousands of sheep. But reactions to the First World War brought significant changes – and perhaps more are yet to come?</span></span></span></span></p>\r\n','full_html'),('news','0','1176','1218','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#333333">Thanks to dozens of volunteers on Saturday 23 February, bags and bags of litter and rubbish were collected so that our lanes and hedgerows now look tidy again.</span></span></span></span></p>\r\n','full_html'),('news','0','1177','1219','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#333333">All the District Council’s litter bins around the village can be used for bags of dog poo.</span></span></span></span></p>\r\n\r\n<p style="margin:0cm 0cm 0pt">&nbsp;</p>\r\n','full_html'),('news','0','1178','1220','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#333333">Buriton’s new “Dottie Tots” Nursery School is finalising all its Ofsted requirements and will be opening very soon.</span></span></span></span></p>\r\n\r\n<p style="margin:0cm 0cm 0pt">&nbsp;</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','1182','1224','en','0','<p>Our Traditional Village Show with food and flower festival.<br />\r\n&nbsp;</p>\r\n','full_html'),('event','0','1183','1225','en','0','<p>After the Village Show on Saturday comes the Sunday Open Gardens 2-4.30 pm</p>\r\n','full_html'),('event','0','1184','1226','en','0','<p><span lang="EN" style="font-size:12.0pt"><span style="line-height:115%"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;"><font color="#000000">This popular event returns on Saturday 29 June (2-6pm) and Sunday 30 June (11am-5pm)</font></span></span></span></p>\r\n','full_html'),('event','0','1185','1227','en','0','<p><span lang="EN" style="font-size:12.0pt"><span style="line-height:115%"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;"><font color="#000000">This popular event returns on Saturday 29 June (2-6pm) and Sunday 30 June (11am-5pm)</font></span></span></span></p>\r\n','full_html'),('event','0','1186','1228','en','0','<p><span lang="EN" style="font-size:12.0pt"><span style="line-height:115%"><span style="font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;"><font color="#000000">A special ''launch event'' and preview of the 2019 Buriton Art Trail with guest speaker George Hardie</font></span></span></span></p>\r\n','full_html'),('news','0','1188','1230','en','0','<p>Art&nbsp;Trail Launch event planned</p>\r\n','full_html'),('news','0','1190','1232','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">About 60 people enjoyed a very informative, well-illustrated and entertaining talk in the village hall on 19 March</span></span></span></p>\r\n','full_html'),('news','0','1191','1233','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">Parishioners are being encouraged to help reduce the number of dog attacks that have killed and injured scores of sheep in the parish in recent years.</span></span></span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1192','1234','en','0','<p><span style="font-size:12.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">A new publication from the Buriton Heritage Bank&nbsp; </span></span></span></p>\r\n','full_html'),('event','0','1194','1236','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:11pt"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="background:white"><span style="color:#1d2129">Music, burgers, cakes, races, classic cars, bouncy castle and much more. </span></span></span></span></p>\r\n\r\n<p style="margin:0cm 0cm 0pt">&nbsp;</p>\r\n\r\n<p style="margin:0cm 0cm 0pt"><span style="font-size:11pt"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="background:white"><span style="color:#1d2129">Fun for all and free entry … </span></span></span></span></p>\r\n','full_html'),('event','0','1200','1242','en','0','<p style="margin-bottom:11.25pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:10.5pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#333333">Another opportunity to learn in our Local Nature Reserve.</span></span></span></span></span></span></p>\r\n','full_html'),('news','0','1201','1243','en','0','<p style="margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#333333">Frank Kempster parachuted into Normandy in the early hours of the invasion</span></span></span></span></span></p>\r\n','full_html'),('news','0','1206','1250','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:106%"><span style="font-family:&quot;Calibri&quot;,sans-serif">Would you like to be involved in your local community?</span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1208','1252','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-family:&quot;Calibri&quot;,sans-serif">New partnership launched between the South Downs National Park Trust and Buriton’s Village Inn.</span></span></span></p>\r\n','full_html'),('news','0','1209','1253','en','0','<p style="margin:0cm 0cm 0pt"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-size:11.0pt"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#555555">There are reports of at least three different sorts of local crime recently:</span></span></span></span></span></p>\r\n','full_html'),('news','0','1212','1256','en','0','<p style="margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">Dozens of children took part in Dominase’s annual inter-school reading competition in Ghana recently to find the best readers in each age group</span></span></span></span></span></p>\r\n','full_html'),('event','0','1214','1258','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">Pop along between 2 and 4pm on Saturday 14<sup>th</sup> September to find out more about bees and honey – whilst drinking tea and eating cakes!</span></span></span></span></span></p>\r\n','full_html'),('event','0','1218','1265','en','0','<p><span style="font-size:12.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#2f5496">Jack Malik (Himesh Patel) is a struggling singer-songwriter in a tiny English seaside town whose dreams of fame are rapidly fading ...&nbsp;</span></span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','1219','1266','en','0','<p><span style="font-size:12.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#2f5496">Katherine Newbury (Emma Thompson) is </span></span></span></span><span lang="EN" style="font-size:12.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#2f5496">a British comic coasting as a longtime host of a chat show ... </span></span></span></span></p>\r\n','full_html'),('event','0','1220','1267','en','0','<p><span style="font-size:12.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#2f5496">As a young student, JRR Tolkien finds love, friendship and artistic inspiration among a group of fellow outcasts ...&nbsp;</span></span></span></span></p>\r\n','full_html'),('event','0','1221','1268','en','0','<p><span style="font-size:12.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#2f5496">Joan Stanley is a widow living out a quiet retirement in the suburbs when, shockingly, the British Secret Service places her under arrest ... </span></span></span></span></p>\r\n','full_html'),('event','0','1223','1270','en','0','<p style="margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><b><span style="font-size:12.0pt"><span style="line-height:107%">Please come and help look after our Local Nature Reserve.</span></span></b></span></span></span></p>\r\n','full_html'),('news','0','1228','1276','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">An early challenge for the new Parish Council is some unexpected expenditure to address ash die-back in a number of trees. </span></span></span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1229','1277','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt">Work will affect the B2416 between Petersfield and South Harting</span></span></span></span></p>\r\n','full_html'),('news','0','1230','1278','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt">&nbsp;</p>\r\n\r\n<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">There will be new collectors for refuse in East Hampshire – and some things may change</span></span></span></span></span></p>\r\n','full_html'),('event','0','1231','1279','en','0','<p>Extra hands welcomed</p>\r\n','full_html'),('event','0','1236','1284','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="color:#333333">Want something different for Christmas? Ever struggle with Christmas Gift Ideas? Dislike the Christmas madness on the High Street?</span></span></span></span></span></p>\r\n','full_html'),('event','0','1237','1285','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><b><span style="font-size:12.0pt"><span style="line-height:107%">Please come and help look after our Local Nature Reserve.</span></span></b></span></span></span></p>\r\n','full_html'),('event','0','1238','1286','en','0','<p><b><span style="font-size:12.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">Please come and help look after our Local Nature Reserve</span></span></span></b></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1239','1287','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">Praise for the latest Heritage Bank publication</span></span></span></span></span></p>\r\n','full_html'),('event','0','1240','1288','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">Queen Elizabeth Country Park''s visitor centre is now open again with a day of family fun to celebrate on Saturday 19 October (10am-4pm).</span></span></span></span></span></p>\r\n','full_html'),('news','0','1241','1289','en','0','<p><span style="font-size:12.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">The homes of the parish’s fallen men can now be viewed on-line</span></span></span></p>\r\n','full_html'),('event','0','1242','1290','en','0','<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt">An illustrated talk by Pam Bruce</span></span></span></span></p>\r\n','full_html'),('event','0','1243','1291','en','0','<p><span style="font-size:12.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">During its Heritage Lottery refurbishment the Museum is visiting a different village every month</span></span></span></p>\r\n','full_html'),('news','0','1244','1292','en','0','<p><span style="font-size:12.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">Villagers joined other volunteers to cut back brambles and other growth on local footpath</span></span></span></p>\r\n','full_html'),('news','0','1245','1293','en','0','<p><span style="font-size:12.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">More good news from Buriton’s Village-to-Village link with Ghana</span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1246','1294','en','0','<p><span style="font-size:12.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">Over a hundred people squeezed into the village hall on Saturday 28<sup>th</sup> September – including some who had first come here over 70 years ago</span></span></span></p>\r\n','full_html'),('news','0','1247','1295','en','0','<p><span style="font-size:12.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">Search for information about men who lost their lives in the Second World War</span></span></span></p>\r\n','full_html'),('quickevent','0','1248','1296','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: </span></span></span></span></span></span></span><a href="http://www.buriton.info/parish-council"><span style="text-decoration:none"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">http://www.buriton.info/parish-council</span></span></span></span></span></span></span></span></a></span></span></p>\r\n','full_html'),('quickevent','0','1249','1297','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: </span></span></span></span></span></span></span><a href="http://www.buriton.info/parish-council"><span style="text-decoration:none"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">http://www.buriton.info/parish-council</span></span></span></span></span></span></span></span></a></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','1250','1298','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%"><span style="color:#333333">Buriton Parish Council normally meets every alternate month throughout the year with meetings taking place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. Due to the current Government Restrictions on Public Meetings during the Coronavirus Outbreak, Buriton Parish Council has adopted alternative ways of working in order to continue with business whilst upholding democratic principles and compliance with the public health guidance. If you have any queries about any Parish Council matter, please continue to contact our Clerk, Mrs Petra Norris, in the normal way: via 07943 536065 or <a href="mailto:buritonparishcouncil@hotmail.co.uk" style="color:blue; text-decoration:underline">buritonparishcouncil@hotmail.co.uk</a> &nbsp;More details about the Parish Council can be found elsewhere on this website: <a href="http://www.buriton.info/parish-council" style="color:blue; text-decoration:underline">http://www.buriton.info/parish-council</a></span></span></span></span></span></span></p>\r\n','full_html'),('quickevent','0','1251','1299','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: </span></span></span></span></span></span></span><a href="http://www.buriton.info/parish-council"><span style="text-decoration:none"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">http://www.buriton.info/parish-council</span></span></span></span></span></span></span></span></a></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('quickevent','0','1252','1300','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: </span></span></span></span></span></span></span><a href="http://www.buriton.info/parish-council"><span style="text-decoration:none"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">http://www.buriton.info/parish-council</span></span></span></span></span></span></span></span></a></span></span></p>\r\n','full_html'),('quickevent','0','1253','1301','en','0','<p style="margin:0cm; margin-bottom:.0001pt"><span style="background:white"><span style="font-family:Arial"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">Buriton Parish Council meets every alternate month throughout the year. All meetings take place in the Upper Hall, Buriton Village Hall, starting at 7pm with an opportunity for members of the public to ask questions or make comments in the Public Forum at 7.45pm. More details about the Parish Council can be found elsewhere on this website: </span></span></span></span></span></span></span><a href="http://www.buriton.info/parish-council"><span style="text-decoration:none"><span style="background-image:initial"><span style="background-attachment:initial"><span style="background-size:initial"><span style="background-origin:initial"><span style="background-clip:initial"><span style="background-position:initial"><span style="background-repeat:initial">http://www.buriton.info/parish-council</span></span></span></span></span></span></span></span></a></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1307','1359','en','0','<p><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="color:#333333">Both Hampshire County Council and East Hampshire District Council now have quick, on-line ways for people to report local problems – and there are now direct links from this website.</span></span></span></span></span></p>\r\n','full_html'),('news','0','1308','1360','en','0','<p><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt">About seventy people came to this meeting and heard about challenges of the past and risks in the future.</span></span></span></span></p>\r\n','full_html'),('event','0','1310','1362','en','0','<p style="margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">Come and join the merry throng - followed by mince pies, refreshments and more carols in the church.</span></span></span></span></span></p>\r\n','full_html'),('event','0','1316','1368','en','0','<p><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><b><span style="background:white"><span style="font-family:&quot;Calibri&quot;,sans-serif">Keira Knightley shines as a very British whistleblower</span></span></b></span></span></p>\r\n','full_html'),('event','0','1317','1369','en','0','<p><b><span style="font-size:11.0pt"><span style="background:white"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#222222">Vanessa Redgrave and Timothy Spall steal the show </span></span></span></span></span></b></p>\r\n','full_html'),('event','0','1318','1370','en','0','<p><b><span style="font-size:11.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#121212">A stand-alone movie based on the smash-hit TV series about inter-war aristocrats</span></span></span></span></b></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','1319','1371','en','0','<p><b><span style="font-size:12.0pt"><span style="background:white"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#222222">Renée </span></span></span></span></span><span style="font-size:12.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">Zellweger is magnetic as Judy Garland depicted in the final years of her life</span></span></span></b></p>\r\n','full_html'),('news','0','1320','1372','en','0','<p><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><b><span lang="EN" style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:black">Films are usually on the first Friday of the month (except January) and start at 7.30 (doors open from 7pm) in Buriton Village Hall</span></span></b></span></span></p>\r\n','full_html'),('event','0','1323','1375','en','0','<p style="margin-bottom:15px">P<span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="color:black">lease see update below.</span></span></span></span></span></p>\r\n','full_html'),('news','0','1325','1377','en','0','<p><b><span style="font-size:12.0pt"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#555555">Please help</span></span></span></b></p>\r\n','full_html'),('event','0','1327','1379','en','0','<p><span style="font-size:11pt"><span style="color:black"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%"><span style="color:#333333">Buriton''s popular annual village show - including flowers, fruit, vegetables, baking and arts &amp; crafts. Entries in the morning - showtime in the afternoon.</span></span></span></span></span></span></span></p>\r\n','full_html'),('event','0','1328','1380','en','0','<p><span style="font-size:11pt"><span style="color:black"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">2020 sees the 75<sup>th</sup> anniversary of the end of the Second World War and the government has arranged for a special Bank Holiday weekend: May 8<sup>th</sup>-10<sup>th</sup>.</span></span></span></span></span></span></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('event','0','1329','1381','en','0','<p style="margin-bottom:11px"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><b><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="color:#333333">Please come and help look after our Local Nature Reserve.</span></span></b></span></span></p>\r\n','full_html'),('news','0','1331','1383','en','0','<p><span style="font-size:11pt"><span style="line-height:normal"><span style="text-autospace:none"><span style="font-family:&quot;Calibri&quot;,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif">What would you do if one of these people called on you at home? </span></span></span></span></span></span></p>\r\n','full_html'),('event','0','1332','1384','en','0','<p><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:&quot;Calibri&quot;,sans-serif"><b><span style="font-size:12.0pt"><span style="color:#333333">It''s amazing how much litter accumulates along our lanes and hedgerows - and how untidy it can make the parish look. </span></span></b></span></span></span></p>\r\n','full_html'),('news','0','1342','1394','en','0','<p><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><b><span style="font-size:14.0pt"><span style="line-height:107%">VOLUNTEERS NEEDED TO HELP WITH SHOPPING etc</span></span></b></span></span></span></p>\r\n','full_html'),('news','0','1343','1395','en','0','<p><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif"><b><span style="font-size:14.0pt"><span style="line-height:107%">IF YOU ARE ISOLATED AT HOME …</span></span></b></span></span></span></p>\r\n','full_html'),('news','0','1344','1396','en','0','<p><span style="font-size:12.0pt"><span style="line-height:107%"><span style="font-family:&quot;Calibri&quot;,sans-serif">LOCAL GROUPS COMBINE TO HELP THE VULNERABLE AND ISOLATED</span></span></span></p>\r\n','full_html');
