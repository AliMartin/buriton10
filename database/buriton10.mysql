INSERT INTO `aggregator_item` VALUES ('88889','en','1','Eastleigh sign defender Koiki on short term deal','https://www.bbc.co.uk/sport/football/articles/cjdx3lvnnx0qo?at_medium=RSS&at_campaign=rss',null,'National League side Eastleigh sign former Northampton Town defender Ali Koiki on a short-term deal.','1792170935','https://www.bbc.co.uk/sport/football/articles/cjdx3lvnnx0qo#4','822d132a-b959-4ecc-b72d-130590832f78'),('88893','en','1','Mum feels ''heard'' as PM responds to drowning campaign','https://www.bbc.co.uk/news/articles/c69vzgprrpjko?at_medium=RSS&at_campaign=rss',null,'Vanessa Abbess has been campaigning after the death of her son Joe at Bournemouth Beach in 2023. ','1792217812','https://www.bbc.co.uk/news/articles/c69vzgprrpjko#0','9279f9d0-7fb8-4f42-8cf3-8b13add8c7a9'),('88894','en','1','Rider warns of out-of-control dogs year on from fall','https://www.bbc.co.uk/news/articles/cqn06596kld4o?at_medium=RSS&at_campaign=rss',null,'Marie Vickers suffered severe injuries when she fell from her horse after it was chased by a dog.','1792217918','https://www.bbc.co.uk/news/articles/cqn06596kld4o#0','973dbbff-c5e2-4466-992f-a3ca499a6c5b'),('88895','en','1','South weekly quiz: What can blue poo reveal about you?','https://www.bbc.co.uk/news/articles/c8p3gn4kry95o?at_medium=RSS&at_campaign=rss',null,'Test your knowledge of news from Hampshire, Berkshire, Dorset, Oxfordshire and the Isle of Wight with our quiz.','1792217735','https://www.bbc.co.uk/news/articles/c8p3gn4kry95o#0','c1cdddec-2c18-4a91-8e0c-1ab8ed92af05'),('88896','en','1','Women sentenced for migrant protest police assaults','https://www.bbc.co.uk/news/articles/cm75p3v0e7rno?at_medium=RSS&at_campaign=rss',null,'Sally Pearson and Shannon Dodds were among those to attend a protest in Gosport on 22 September. ','1792068213','https://www.bbc.co.uk/news/articles/cm75p3v0e7rno#1','e20f561c-ab48-4a32-966d-5c358aaa17ed'),('88897','en','1','Parking fee rises could ''desecrate'' high streets','https://www.bbc.co.