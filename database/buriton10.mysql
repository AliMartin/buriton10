INSERT INTO `search_dataset` VALUES ('729','en','node_search',' living in buriton living in buriton plan b workshop 4cjpg scores of people took part in a special popin event in buriton village hall recently to help shape the future of the parish doug jones mon 9052016 839am  ','0'),('730','en','node_search',' what s special about living in our parish  what s special about living in our parish  plan b logo for websitejpg the recent popin event in the village hall was very successful with scores of visitors but if you weren t able to be there there s still time to have your say  doug jones mon 9052016 840am  ','0'),('731','en','node_search',' buriton parish council needs a new parttime clerk buriton parish council needs a new parttime clerk parish council logo final for webjpg after a number of years of sterling service wendy shone is standing down from her role as parish clerk and so a replacement is required doug jones mon 9052016 841am  ','0'),('732','en','node_search',' public inquiry into extinguishment of footpath public inquiry into extinguishment of footpath network railjpg as parishioners may already be aware there is to be a public inquiry into network rail s application to extinguish part of footpath 3 across the railway line doug jones mon 9052016 843am  ','0'),('733','en','node_search',' bluebells and beef are great success bluebells and beef are great success bluebells 2016 img9640ecjpg over 90 people enjoyed a delightful guided stroll along farm paths not normally open to the public thanks to the generosity of local farmer susan shone doug jones mon 9052016 845am  ','0'),('734','en','node_search',' car boot sale on the recreation ground on sunday 28th august followed by a village bbq and fun day car boot sale on the recreation ground on sunday 28th august followed by a village bbq and fun day car boot buriton e2jpg gates open for sellers at 7am with buyers from 8am doug jones thu 2062016 656pm  ','0'),('735','en','node_search',' buriton christmas market