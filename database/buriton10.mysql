INSERT INTO `search_dataset` VALUES ('816','en','node_search',' parish council meeting and annual parish meeting parish council meeting and annual parish meeting buriton parish council meets every alternate month throughout the year on 22nd may the parish council will also be holding its annual parish meeting commencing at 630pm the agenda for the annual parish meeting will include the chairman s annual report a presentation of the upgraded community website and an update about the war memorial competition a copy of the full agenda for the annual parish meeting can be found on the home page of the parish council part of this website at the end of the annual parish meeting the council will hold its regular meeting which will also provide an opportunity for members of the public to ask questions or make comments in a public forum session more details about the parish council can be found elsewhere on this website  http wwwburitoninfo parishcouncil   doug jones sat 10122016 653pm  ','0'),('817','en','node_search',' parish council meeting parish council meeting buriton parish council meets every alternate month throughout the year all meetings take place in the village hall starting at 7pm with an opportunity for members of the public to ask questions or make comments in the public forum at 745pm more details about the parish council can be found elsewhere on this website  http wwwburitoninfo parishcouncil   doug jones sat 10122016 654pm  ','0'),('818','en','node_search',' parish council meeting parish council meeting buriton parish council meets every alternate month throughout the year all meetings take place in the village hall starting at 7pm with an opportunity for members of the public to ask questions or make comments in the public forum at 745pm more details about the parish council can be found elsewhere on this website  http wwwburitoninfo parishcouncil   doug jones sat 10122016 654pm  ','0'),('820','en','node_search',' parish council meeting parish council meeting buriton parish council meets every alternate month throughout the year all meetings take place in the village hall starting at 7pm with an opportunity for members of the public to ask questions or make comments in the public forum at 745pm more details about the parish council can be found elsewhere on this website  http wwwburitoninfo parishcouncil   doug jones sat 10122016 655pm  ','0');
