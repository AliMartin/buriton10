INSERT INTO `search_dataset` VALUES ('366','en','node_search',' quartet film night in buriton village hall quartet film night in buriton village hall pachasapopruuacuhovistajotrichidrarudocukonotredau great new film released in 2012 starring maggie smith michael gambon and billy connolly doug jones mon 7012013 1202pm  ','0'),('367','en','node_search',' gambit film night in buriton village hall gambit film night in buriton village hall pachasapopruuacuhovistajotrichidrarudocukonotredau great new film released in 2012 starring colin firth doug jones mon 7012013 1205pm  ','0'),('368','en','node_search',' village hall annual general meeting village hall annual general meeting pachasapopruuacuhovistajotrichidrarudocukonotredau the agm of our village hall charity everybody is welcome come and make your suggestions and offers of help  doug jones mon 7012013 1215pm  ','0'),('369','en','node_search',' community spring clean morning community spring clean morning pachasapopruuacuhovistajotrichidrarudocukonotredau annual spring clean litterpicking morning please be willing to lend a hand to help make the parish clean and tidy contact parish clerk wendy shone via buritonparishcouncil hotmailcouk for more details doug jones mon 7012013 1220pm  ','0'),('370','en','node_search','  fools steam ahead   fools steam ahead  pachasapopruuacuhovistajotrichidrarudocukonotredau hang on to your hats and jump aboard as buriton players present their new production fools steam ahead  doug jones mon 7012013 1228pm  ','0'),('371','en','node_search','  fools steam ahead   fools steam ahead  pachasapopruuacuhovistajotrichidrarudocukonotredau hang on to your hats and jump aboard as buriton players present their new production fools steam ahead  doug jones mon 7012013 1229pm  ','0'),('372','en','node_search',' chalk talk and walk chalk talk and walk pachasapopruuacuhovistajotrichidrarudocukonotredau have you ever wondered why the buriton chalk pits were designated as a local nature reserve what is it about the habitats there that make it a very special place for some plants and wildlife come to the village hall for a brief introductory talk by district council expert martin healey before a short guided tour of the site followed by feedback and discussion in one of the pubs doug jones mon 7012013 1237pm  ','0');
INSERT INTO `search_dataset` VALUES ('373','en','node_search',' the buriton book collect your free copy the buriton book collect your free copy pachasapopruuacuhovistajotrichidrarudocukonotredau the hardback book about events and activities in the parish of buriton during 2012 will be available for collection in the village hall from 1030am to 4pm one copy per household free of charge doug jones mon 7012013 1251pm  ','0'),('374','en','node_search','  art for all tuesday evenings 7pm to 9pm from 8th january  art for all tuesday evenings 7pm to 9pm from 8th january artistspalettejpg a friendly group of beginners and amateur artists will be meeting at the five bells on tuesday evenings suitable for everyone from complete beginners to recognised talents the meetings are informal and fun and will cover a range of subjects doug jones mon 7012013 144pm  ','0'),('375','en','node_search',' bikes for hire bikes for hire bikehire3jpg bike hire is now available at the maple inn 15 per day or 750 for half a day for further information phone 1730 267275 doug jones mon 7012013 155pm  ','0'),('376','en','node_search',' better broadband for buriton  better broadband for buriton  broadband4jpg are you tired of waiting for decent broadband is slow broadband stopping you working at home faster broadband can make a big difference to your life you may wish to consider joining this campaign now doug jones mon 7012013 202pm  ','0'),('377','en','node_search',' last chance to buy local beef for the months ahead last chance to buy local beef for the months ahead beeflabel2cjpg scores of people have already bought beef from bolinge hill farm and as anyone who has tried it will testify the texture and flavours are fantastic supplies were sold out before christmas but there are now just a few orders to fill in january and february after that we all have to wait until december again  doug jones mon 7012013 215pm  ','0'),('380','en','node_search',' park barn park barn parkbarnjpeg admin wed 16012013 802pm  ','0'),('381','en','node_search',' buriton players help bring chalk pits to life buriton players help bring chalk pits to life playersrecordingcimg9027jpg as part of the parish council s lotteryfunded chalk pits project an audio guide is being produced for schools across the area doug jones sun 20012013 1151am  ','0');
