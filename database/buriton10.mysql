INSERT INTO `search_dataset` VALUES ('670','en','node_search',' early christmas presents for children in dominase early christmas presents for children in dominase img7546e3jpg buriton s villagetovillage charity was able to deliver over 2000 supplementary reading books to boost school libraries in our adopted community in ghana during october doug jones sun 13122015 1039am  ','0'),('671','en','node_search',' carols round the pond carols round the pond pachasapopruuacuhovistajotrichidrarudocukonotredau come and join the merry throng followed by mince pies refreshments and more carols in the church doug jones sun 13122015 1039am  ','0'),('672','en','node_search',' buriton and the first world war 100 years ago buriton and the first world war 100 years ago ww1 logo 2jpg what was happening at home and abroad 100 years ago  doug jones sun 13122015 1039am  ','0'),('673','en','node_search',' films in buriton the spring season for 2016 films in buriton the spring season for 2016 film flyer edit 2 33 percentjpg an excellent series of films has been arranged for the spring of 2016  doug jones sun 13122015 1041am  ','0'),('674','en','node_search',' toy sale thursday 28 january from 315pm in the village hall toy sale thursday 28 january from 315pm in the village hall toy sale editjpg toys puzzles games books and dvds doug jones sun 13122015 1041am  ','0'),('675','en','node_search',' parish council meeting parish council meeting buriton parish council meets every alternate month throughout the year all meetings take place in the village hall starting at 7pm with an opportunity for members of the public to ask questions or make comments in the public forum at 745pm more details about the parish council can be found elsewhere on this website  http buritoninfo parishcouncil doug jones mon 14122015 150pm  ','0'),('676','en','node_search',' parish council meeting parish council meeting buriton parish council meets every alternate month throughout the year all meetings take place in the village hall starting at 7pm with an opportunity for members of the public to ask questions or make comments in the public forum at 745pm more details about the parish council can be found elsewhere on this website  http wwwburitoninfo parishcouncil doug jones mon 14122015 152pm  ','0');
INSERT INTO `search_dataset` VALUES ('677','en','node_search',' parish council meeting and apm parish council meeting and apm buriton parish council meets every alternate month throughout the year all meetings take place in the village hall starting at 7pm in may the council also holds its annual parish meeting apm when it can arrange presentations on topics of local interest in recent years these have focused on planning matters and the parish council will be pleased to hear comments on any current planning applications at this year s apm time will also be devoted to the latest situation regarding a potential community bid for the village inn maple inn and ideas relating to the village pond car park and landscaping adjacent to the war memorial the apm will commence at 7pm and will be followed by the normal meeting of the parish council at approximately 8pm doug jones mon 14122015 152pm  ','0'),('678','en','node_search',' parish council meeting parish council meeting buriton parish council meets every alternate month throughout the year all meetings take place in the village hall starting at 7pm with an opportunity for members of the public to ask questions or make comments in the public forum at 745pm more details about the parish council can be found elsewhere on this website  http wwwburitoninfo parishcouncil doug jones mon 14122015 153pm  ','0'),('679','en','node_search',' parish council meeting parish council meeting buriton parish council meets every alternate month throughout the year all meetings take place in the village hall starting at 7pm with an opportunity for members of the public to ask questions or make comments in the public forum at 745pm more details about the parish council can be found elsewhere on this website  http wwwburitoninfo parishcouncil doug jones mon 14122015 153pm  ','0'),('680','en','node_search',' parish council meeting parish council meeting buriton parish council meets every alternate month throughout the year all meetings take place in the village hall starting at 7pm with an opportunity for members of the public to ask questions or make comments in the public forum at 745pm more details about the parish council can be found elsewhere on this website  http wwwburitoninfo parishcouncil doug jones mon 14122015 154pm  ','0');
INSERT INTO `search_dataset` VALUES ('683','en','node_search',' weddings at the manor house at buriton weddings at the manor house at buriton manor barn 006ecjpg buriton parish council has learnt that emails or letters are being sent to couples who are planning to hold their weddings at the manor barn buriton on behalf of mr robert camping doug jones thu 14012016 658pm  ','0'),('686','en','node_search',' beware of car thefts beware of car thefts burglar 2jpg over night between 10th and 11th january 2016 three cars were entered in buriton and items taken items were small amounts of money sun glasses and cds doug jones thu 14012016 718pm  ','0'),('688','en','node_search','  hall s well that ends well   hall s well that ends well  halls well poster 2jpg the buriton players will have dusted off their dancing shoes lubricated their larynxes and created new costumes to entertain us all accompanied by a sumptuous supper and a cash bar doug jones sun 31012016 1148am  ','0'),('689','en','node_search','  hall s well that ends well   hall s well that ends well  halls well poster 2jpg the buriton players will have dusted off their dancing shoes lubricated their larynxes and created new costumes to entertain us all accompanied by a sumptuous supper and a cash bar doug jones sun 31012016 1149am  ','0'),('690','en','node_search','  bygone buriton local history exhibition  bygone buriton local history exhibition heritage bank web picture ejpg the annual local history exhibition will take place in st mary s church buriton between 11am and 4pm on saturday 24th september lots of displays photographs and information with presentations about the village and villagers 100 years ago during the first world war doug jones sun 31012016 1152am  ','0'),('691','en','node_search',' big autumn quiz night big autumn quiz night autumn leaves 4jpg buriton s annual autumn quiz night is always highly entertaining and always sells out quickly book your places soon doug jones sun 31012016 1155am  ','0'),('692','en','node_search',' seniors afternoon tea down on the farm seniors afternoon tea down on the farm farm tea 2014 img4028cjpg prebooking is essential please see details below doug jones sun 31012016 1158am  ','0');
INSERT INTO `search_dataset` VALUES ('693','en','node_search',' bluebell walk and farm tea at bolinge hill farm bluebell walk and farm tea at bolinge hill farm bluebells 1161602jpg an opportunity for parishioners family and friends to take a delightful guided stroll along farm paths not normally open to the public and opportunities weather permitting to see thousands of bluebells and impressive early purple orchids doug jones sun 31012016 1202pm  ','0'),('694','en','node_search',' what do you like about living in the parish  what do you like about living in the parish  plan b logo for websitejpg are there some things that you don t like do you think that some things need changing are you worried that some of the things that you like about the parish might be under threat or might get changed  doug jones sun 31012016 1207pm  ','0'),('699','en','node_search',' update about planning and licensing at buriton manor update about planning and licensing at buriton manor manor house 3e2jpg the parish council has received some updates about the planning and licensing situation at buriton manor including outcomes of appeals against the refusal of planning applications in january 2015 withdrawal of current planning applications and the latest situation about the review of the premises license at the manor barn doug jones sun 31012016 1213pm  ','0'),('700','en','node_search',' weddings at the manor house at buriton weddings at the manor house at buriton manor barn 006ecjpg buriton parish council has learnt that emails or letters are being sent to couples who are planning to hold their weddings at the manor barn buriton on behalf of mr robert camping doug jones sun 31012016 1214pm  ','0'),('701','en','node_search',' 2015 was another good year 2015 was another good year img2105ejpg thanks to money raised in and around buriton the villagetovillage charity has been able to continue to help improve living conditions and the education of children in the dominase area of the central region of ghana doug jones sun 31012016 1216pm  ','0');
INSERT INTO `search_dataset` VALUES ('702','en','node_search',' are you interested in making changes to local rights of way  are you interested in making changes to local rights of way  boat 1151597cjpg the parish council is trying to get hampshire county council to revisit local byways open to all traffic boats to assess them for suitability for use by 4x4 offroad vehicles doug jones sun 31012016 1229pm  ','0'),('704','en','node_search',' village inn in receivership village inn in receivership village innjpg the parish council understands that the village inn owned by mr robert camping was placed in receivership on 9th december 2015 doug jones sun 31012016 1236pm  ','0'),('706','en','node_search',' perfect parking  perfect parking  mini edit 3jpg this mini ended up on top of a hedge in greenway lane recently if you have any special photographs showing interesting events or special places in the parish please enter them in the buriton in perpetuity class in the village show so that we continue to build up a fascinating record of life in the parish for future generations to look back on  doug jones sun 31012016 1245pm  ','0'),('707','en','node_search',' buriton manor barn wedding venue hits the headlines buriton manor barn wedding venue hits the headlines bob c on bbc editedjpg the bbc itv news and daily mirror are amongst news outlets reporting that the venue has hit financial troubles and that dozens of couples have been left disappointed after their weddings have been abruptly cancelled doug jones sun 31012016 1246pm  ','0'),('708','en','node_search',' seeing stars seeing stars dark skies ejpg ever looked up at the night sky and wondered at the thousands of stars before your eyes  doug jones sun 31012016 1251pm  ','0'),('709','en','node_search',' manor barn set to lose its license manor barn set to lose its license license hearing edit cjpg that appears to be the outcome of east hampshire district council s meeting on 28th january which revoked the premises license for buriton manor barn doug jones wed 3022016 935pm  ','0');
INSERT INTO `search_dataset` VALUES ('710','en','node_search',' sheepwatch uk launched in buriton on 1st february sheepwatch uk launched in buriton on 1st february sheepwatch rgb for website storyjpg as the number of sheep being injured and killed by dogs across the country increases a new community initiative is aiming to help protect the national flock doug jones wed 3022016 938pm  ','0'),('711','en','node_search',' warnings and advice about thefts and fraud warnings and advice about thefts and fraud burglar 2jpg the hampshire countrywatch police team has circulated more warnings and advice doug jones wed 17022016 600pm  ','0'),('712','en','node_search',' buriton s dark night skies buriton s dark night skies dark skies ejpg over 60 people squeezed into the village hall on friday 12th february and saw the international space station pass overhead doug jones wed 17022016 602pm  ','0'),('713','en','node_search',' barn owls over buriton barn owls over buriton barn owl rob connolly editedjpg more and more barn owls can now be seen flying over the fields around buriton and some have been filmed nesting at nursted farm doug jones wed 17022016 604pm  ','0'),('714','en','node_search',' parish council committee meeting parish council committee meeting a meeting of the parish council s planning committee will take place in the village hall doug jones wed 17022016 656pm  ','0'),('715','en','node_search',' buriton features on bbc countryfile on sunday 28th february buriton features on bbc countryfile on sunday 28th february tom heap editjpg filming for the popular tv programme took place with tom heap recently doug jones thu 25022016 433pm  ','0'),('717','en','node_search',' buriton and the first world war at home and abroad 100 years ago buriton and the first world war at home and abroad 100 years ago ww1 logo 2jpg what was happening at home and abroad 100 years ago and why were some brave boys of buriton out in india  doug jones sun 6032016 630pm  ','0'),('718','en','node_search',' please get snapping for the parish calendar for 2017 please get snapping for the parish calendar for 2017 calendar 2015jpg due to the success of the buriton calendar over the last few years it s been decided to do it again but your help is needed doug jones sun 20032016 617pm  ','0');
INSERT INTO `search_dataset` VALUES ('719','en','node_search',' buriton may ball buriton may ball playground ball poster for websitejpg 7pm til midnight in buriton village hall saturday 7th may doug jones thu 31032016 524pm  ','0'),('721','en','node_search',' what s special about living in our parish popin event in the village hall what s special about living in our parish popin event in the village hall plan b logo for websitejpg come and tell us on saturday april 23rd 1030am4pm in buriton village hall doug jones mon 18042016 1002pm  ','0'),('722','en','node_search',' buriton art trail buriton art trail art trail 2016 2 png this popular event returns on saturday 23 july and sunday 24 july 2016 doug jones fri 29042016 600pm  ','0'),('723','en','node_search',' buriton art trail buriton art trail art trail 2016 2 png this popular event returns on saturday 23 july and sunday 24 july 2016 doug jones fri 29042016 600pm  ','0'),('724','en','node_search',' another successful reading competition in dominase another successful reading competition in dominase 9 dominase marfo jenifer dadzie p2cjpg hundreds of children took part in the buriton villagetovillage group s 2016 interschool challenge with the best 70 competing together for prizes and prestige recently doug jones fri 29042016 602pm  ','0'),('725','en','node_search',' flytipping around buriton and the future of the council s waste site in petersfield flytipping around buriton and the future of the council s waste site in petersfield fly tip img0288jpg the county council is faced with yet more cuts in funding from government and has concluded that it is no longer feasible to deliver services at the same level and in the same way  doug jones fri 29042016 605pm  ','0'),('726','en','node_search',' teacher training project helps improve education in dominase teacher training project helps improve education in dominase teachers 2016png as part of buriton s villagetovillage link with its sister community of dominase in rural