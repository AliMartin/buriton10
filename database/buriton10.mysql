INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1549','1611','en','0','<p><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="line-height:107%">A new ‘greenfield’ application and an update about telecoms masts</span></span></span></span></span></p>\r\n','full_html'),('news','0','1550','1612','en','0','<p><span style="font-size:11pt"><span style="line-height:105%"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="line-height:105%">&nbsp;– and fight climate change at the same time</span></span></b></span></span></span></p>\r\n','full_html'),('event','0','1553','1615','en','0','<p>Entries in the morning; Show in the afternoon&nbsp;&nbsp;</p>\r\n','full_html'),('event','0','1554','1616','en','0','<p>Saturday, 19 March</p>\r\n','full_html'),('news','0','1555','1617','en','0','<p>The ‘Re-Charge One’ application and the plans for ten new homes on Greenway Lane</p>\r\n','full_html'),('news','0','1556','1618','en','0','<p><strong>New volunteers are needed to keep the show going</strong></p>\r\n','full_html'),('news','0','1557','1619','en','0','<p><strong>Buriton is a special place in the South Downs International Dark Skies Reserve</strong></p>\r\n','full_html'),('news','0','1563','1625','en','0','<p>Maecenas sed diam eget risus varius blandit sit amet non magna. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aenean eu leo quam. Pellentesque ornare sem lacinia quam venenatis vestibulum. Sed posuere consectetur est at lobortis. Maecenas faucibus mollis interdum. Aenean eu leo quam. Pellentesque ornare sem lacinia quam venenatis vestibulum.</p>\r\n','full_html'),('news','0','1564','1626','en','0','<p>Test Shine radio player</p>\r\n','full_html'),('news','0','1569','1631','en','0','<p><strong>Greenway Lane planning application approved</strong></p>\r\n','full_html'),('news','0','1570','1632','en','0','<p><strong>Shine Radio visits the village</strong></p>\r\n','full_html'),('news','0','1571','1633','en','0','<p><strong>Many thanks to everyone who helped on 19th March</strong></p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1572','1634','en','0','<p><strong>News about Buriton’s new camera </strong></p>\r\n','full_html'),('news','0','1574','1636','en','0','<p><strong>A message from the organisers …</strong></p>\r\n','full_html'),('news','0','1576','1638','en','0','<p>‘Cut &amp; collect’ mowing should help nature …</p>\r\n','full_html'),('news','0','1577','1639','en','0','<p>Successful bid to National Park can help Pollinators</p>\r\n','full_html'),('news','0','1578','1640','en','0','<p>Unanimous decision at South Downs Planning Committee</p>\r\n','full_html'),('news','0','1579','1641','en','0','<p>EHDC Dog Wardens catch culprits on regular patrols</p>\r\n','full_html'),('news','0','1581','1643','en','0','<p>Successful bid to National Park to help create new wildlife habitats</p>\r\n','full_html'),('event','0','1582','1644','en','0','<p>The final day of Buriton’s Jubilee Celebrations will include ...</p>\r\n','full_html'),('quickevent','0','1583','1645','en','0','<p>Events on the third day of Buriton’s Jubilee Celebrations will take place in the Manor Barn with a Platinum Tea Party &amp; Memorabilia Exhibition from 2-5pm. A floral display of celebratory colour in St Mary’s church will run throughout the four-day holiday period.</p>\r\n','full_html'),('quickevent','0','1584','1646','en','0','<p>The second day of Buriton’s Jubilee Celebrations will be a ‘Royal Jubilee Family Festival’ on the recreation ground – from 2pm-9pm. There will be live local music, fancy dress competitions, decorated wheelbarrow races, inflatables, a beer tent – and more. Parishioners should bring their own ‘Royal Picnics’, drinks, chairs, tables, cups and plates – less cost, less waste! A floral display of celebratory colour in St Mary’s church will run throughout the four-day holiday period. All events are free of charge. Only food and drink will be chargeable.</p>\r\n','full_html'),('event','0','1585','1647','en','0','<p>The first day of Buriton’s Jubilee Celebrations will include ...</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1586','1648','en','0','<p>Buriton’s festivities promise fun and interest for all the family</p>\r\n','full_html'),('news','0','1587','1649','en','0','<p>A way to help Buriton’s Pollinator Project</p>\r\n','full_html'),('news','0','1592','1654','en','0','<p>Free fun for all the family: 2pm to 9pm</p>\r\n','full_html'),('event','0','1598','1661','en','0','<p>View and buy from a variety of local artistic creations and craft skills.</p>\r\n','full_html'),('event','0','1599','1662','en','0','<p>View and buy from a variety of local artistic creations and craft skills.</p>\r\n','full_html'),('news','0','1600','1663','en','0','<p>Feedback from users of the community’s thermal imaging camera.</p>\r\n','full_html'),('news','0','1601','1664','en','0','<p>Metis Homes appear to have sold the land to another developer - and more updates</p>\r\n','full_html'),('news','0','1602','1665','en','0','<p>So much fun, so many memories …</p>\r\n','full_html'),('event','0','1603','1666','en','0','<p>Scrumptious cream teas and cakes - from 2pm onwards.</p>\r\n\r\n<p>Afternoon teas are back at St Marys, Buriton.</p>\r\n\r\n<p>As part of a fund raising initiative for our lovely local church, afternoon tea / cream teas are being served in The Seward Room: Sunday June 26th at St Mary’s Church, Buriton, from 2pm onwards</p>\r\n\r\n<p>All welcome, come along for a chat with friends, make new friends and support the church by eating cake</p>\r\n\r\n<p>All funds in aid of St Mary’s Church Buriton.</p>\r\n','full_html'),('news','0','1605','1668','en','0','<p>Part of a fact-finding trip to study national park ideas</p>\r\n','full_html'),('news','0','1606','1669','en','0','<p>Opportunity to get a 2.5% discount</p>\r\n','full_html'),('news','0','1607','1670','en','0','<p>Have your say</p>\r\n','full_html'),('news','0','1609','1672','en','0','<p>More news about the forthcoming houses on Greenway Lane</p>\r\n','full_html'),('event','0','1612','1675','en','0','<p>It’s planned that the annual local history exhibition will take place in the Village Hall (1pm to 4pm) with lots of displays, photographs and information about life in the parish in years gone by.</p>\r\n','full_html');
INSERT INTO `node_revision__field_subtitle` VALUES ('news','0','1613','1676','en','0','<p>Latest updates</p>\r\n','full_html'),('news','0','1614','1677','en','0','<p>Available to download from website.</p>\r\n','full_html'),('news','0','1615','1678','en','0','<p>Responses submitted by the Parish Council</p>\r\n','full_html'),('news','0','1616','1679','en','0','<p>Next steps on the community’s Pollinator Project</p>\r\n','full_html'),('news','0','1617','1680','en','0','<p>50<sup>th</sup> anniversary of the South Downs Way.</p>\r\n','full_html'),('news','0','1618','1681','en','0','<p>New windows, doors and insulation as part of phased enhancements</p>\r\n','full_html'),('news','0','1619','1682','en','0','<p>Buriton is surrounded by farmland which is all tinder dry.</p>\r\n','full_html'),('news','0','1620','1683','en','0','<p>Be wise with water this summer</p>\r\n','full_html'),('news','0','1621','1684','en','0','<p>Saturday 20 August: 1.30 to 4.30pm</p>\r\n','full_html'),('news','0','1624','1687','en','0','<p>Something for everyone on a wonderful day ...</p>\r\n','full_html'),('news','0','1625','1688','en','0','<p>Get a nesting box fitted for only £35</p>\r\n','full_html'),('event','0','1626','1689','en','0','<p>Sunday 4th September (10am to noon on the Recreation Ground).</p>\r\n','full_html'),('news','0','1629','1693','en','0','<p>subtitle</p>\r\n','full_html'),('news','0','1637','1701','en','0','<p>Friday nights haven’t been the same …</p>\r\n','full_html'),('event','0','1638','1702','en','0','<p>Jim Broadbent excels in true tale of ​art-stealing pensioner</p>\r\n','full_html'),('event','0','1639','1703','en','0','<p>An extraordinary and true story …</p>\r\n','full_html'),('event','0','1640','1704','en','0','<p>Family classic sequel</p>\r\n','full_html'),('event','0','1641','1705','en','0','<p>A special illustrated 50th birthday talk in the village hall.</p>\r\n','full_html'),('news','0','1642','1706','en','0','<p>Condolence arrangements</p>\r\n','full_html'),('new