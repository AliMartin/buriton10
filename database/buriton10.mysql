INSERT INTO `search_dataset` VALUES ('162','en','node_search',' buriton post office buriton post office postoffice0jpg admin mon 13062011 945am  ','0'),('164','en','node_search',' the beatles lloyd webber and gilbert sullivan in buriton the beatles lloyd webber and gilbert sullivan in buriton pachasapopruuacuhovistajotrichidrarudocukonotredau the locally renowned 39 downland singers 39 will be giving a special performance in buriton on sunday 18th september 230pm  doug jones sun 19062011 136pm  ','0'),('165','en','node_search',' children provide more help for ghana children provide more help for ghana dpspicture2emay2011jpg pupils in middle juniors yr5 at ditcham park school have recently raised an extra 130 to help friends in ghana doug jones sun 19062011 155pm  ','0'),('166','en','node_search',' chalk and cheese guided walk in buriton chalk pits chalk and cheese guided walk in buriton chalk pits pachasapopruuacuhovistajotrichidrarudocukonotredau come and search for the elusive cheese snail on sunday 10th july book early doug jones sun 19062011 216pm  ','0'),('167','en','node_search','  the other side of africa   the other side of africa  pachasapopruuacuhovistajotrichidrarudocukonotredau an illustrated talk by david bee doug jones sun 19062011 247pm  ','0'),('168','en','node_search',' summer mini market in the seward room summer mini market in the seward room pachasapopruuacuhovistajotrichidrarudocukonotredau opportunities to sell and buy friday 15th july doug jones sun 19062011 252pm  ','0'),('170','en','node_search',' a leg at each corner fresh hogget lamb available from friday 8th a leg at each corner fresh hogget lamb available from friday 8th alaeclogoburitoninfojpg hogget is in this case a 15 month old sheep more information can be found on the web site  wwwalegateachcornercom  anonymous not verified wed 6072011 517pm  ','0'),('171','en','node_search',' walkers please be sensitive to  walkers please be sensitive to  viperjpg this might not be the correct pla