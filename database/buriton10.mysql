INSERT INTO `search_dataset` VALUES ('581','en','node_search',' lambing days at nursted farm lambing days at nursted farm pachasapopruuacuhovistajotrichidrarudocukonotredau come and see all the new born lambs at nursted farm 2pm 430pm part of the down on buriton s farms programme of farm events open days walks and talks during 2015 doug jones sat 7022015 1053pm  ','0'),('591','en','node_search',' village show village show pachasapopruuacuhovistajotrichidrarudocukonotredau buriton s popular annual village show including flowers fruit vegetables baking and arts crafts entries in the morning showtime in the afternoon doug jones sat 7022015 1135pm  ','0'),('592','en','node_search',' bluebell walk and farm tea at bolinge hill farm bluebell walk and farm tea at bolinge hill farm pachasapopruuacuhovistajotrichidrarudocukonotredau an opportunity for parishioners family and friends to take a delightful guided stroll along farm paths not normally open to the public and opportunities weather permitting to see thousands of bluebells and impressive early purple orchids doug jones sat 7022015 1136pm  ','0'),('593','en','node_search',' buriton beef is back on the menu buriton beef is back on the menu beefstoryimg4811cjpg having hunted hard to find a local abattoir to replace the service provided by laverstoke park susan shone is delighted that she is now able to take orders again for her high quality beef doug jones sat 7022015 1137pm  ','0'),('594','en','node_search',' restoring gilbert white s garden restoring gilbert white s garden pachasapopruuacuhovistajotrichidrarudocukonotredau a real treat in the spring doug jones sat 7022015 1138pm  ','0'),('595','en','node_search',' buriton s heritage bank helps bring 150year old portrait home buriton s heritage bank helps bring 150year old portrait home sewardportraitjpg an old portrait from a renowned london studio has been reunited with its family roots thanks to the buriton heritage bank doug jones sat 7022015 1138pm  ','0'),('596','en','node_search',' take the south downs dark skies pledge take the south downs dark skies pledge starparty2jpg buriton parish council is proud to be supporting the south downs national park s bid to obtain international dark skies reserve status and there is an easy way for residents to back the bid too doug jones sat 7022015 1139pm  ','0');
INSERT INTO `search_dataset` VALUES ('597','en','node_search','  flushed with pride on wednesday 18th march  flushed with pride on wednesday 18th march pachasapopruuacuhovistajotrichidrarudocukonotredau a light hearted look at the history of sanitation and the significant part the british have played in its development not to be missed don 39 t poopoo it  doug jones sat 7022015 1140pm  ','0'),('598','en','node_search',' kingfishers return to the village pond kingfishers return to the village pond kingfisher2jpg people have been very pleased to see kingfishers again this winter as well as regular morning visits from herons as well doug jones fri 27022015 1017pm  ','0'),('599','en','node_search',' dawn chorus walk saturday 2 may dawn chorus walk saturday 2 may pachasapopruuacuhovistajotrichidrarudocukonotredau a chance to hear some wonderful bird song on a dawn chorus walk through the buriton chalk pits doug jones sun 1032015 215pm  ','0'),('600','en','node_search',' evening birdsong walk evening birdsong walk pachasapopruuacuhovistajotrichidrarudocukonotredau spend an enchanting evening in one of our local nature reserves and emerge much wiser about the distinctive bird songs of many of our local species doug jones sun 1032015 216pm  ','0'),('601','en','node_search','  landscape reflections by local artist paul best  landscape reflections by local artist paul best artbestcburitoncommonajpg in the morgue at the five bells until 21st march doug jones sun 15032015 951pm  ','0'),('602','en','node_search',' toilet talk raises money for dominase toilet talk raises money for dominase gosneytalkpng bill gosney s light hearted look at the history of sanitation attracted dozens of people to his talk in march and raised about 150 for buriton s sister community of dominase in rural ghana west africa doug jones fri 20032015 1041am  ','0'),('603','en','node_search',' celebrations in buriton on saturday 28 march celebrations in buriton on saturday 28 march villagehalljpg come to the party  doug jones fri 20032015 1045am  ','0'),('604','en','node_search',' neighbourcare neighbourcare neighbourcarelogo0jpg anonymous not verified wed 25032015 111pm  ','0');
INSERT INTO `search_dataset` VALUES ('605','en','node_search',' buriton and the first world war buriton and the first world war ww1 logo 2jpg what was happening at home and abroad 100 years ago  doug jones fri 27032015 555pm  ','0'),('606','en','node_search',' muchneeded water flows again thanks to kind donations muchneeded water flows again thanks to kind donations webpicturejpg one of the first wells that buriton had provided in dominase had stopped working but recent efforts have brought it back to life doug jones fri 27032015 634pm  ','0'),('607','en','node_search',' old photo album boosts world war one project old photo album boosts world war one project 56e2transportonthefrontierjpg michael reeves of bones lane has recently found a treasure trove of photographs showing scores of images from the time of the first world war doug jones fri 27032015 639pm  ','0'),('608','en','node_search',' parish campout parish campout pachasapopruuacuhovistajotrichidrarudocukonotredau all are welcome at buriton 39 s popular annual 39 campout 39 on the recreation ground commencing on saturday 18th july and camping overnight until about 1pm on sunday 19th doug jones fri 3042015 625pm  ','0'),('609','en','node_search',' brahms and clara brahms and clara pachasapopruuacuhovistajotrichidrarudocukonotredau a concert of music by johannes brahms interspersed with short readings from letters exchanged with his closest female friend clara schumann widow of the composer robert schumann doug jones fri 3042015 636pm  ','0'),('610','en','node_search',' neighbourcare now on this website neighbourcare now on this website neighbourcarelogojpg neighbourcare buriton wants to increase awareness in the services that it offers and now has a page on this website doug jones fri 3042015 645pm  ','0'),('611','en','node_search',' from chalk to cheese from chalk to cheese chalktocheesecoverforwebsitejpg to mark the end of the fiveyear lotteryfunded project to enhance the buriton chalk pits local nature reserve the organisers have arranged for a new book to be available free of charge for every household in the parish doug jones fri 3042015 702pm  ','0');
INSERT INTO `search_dataset` VALUES ('612','en','node_search',' reading competition boosts enthusiasm to raise standards amongst children teachers and parents reading competition boosts enthusiasm to raise standards amongst children teachers and parents 27fredatreposoclass2winnercjpg buriton s villagetovillage charity has arranged another successful interschool reading competition in and around dominase with hundreds of children taking part doug jones sat 4042015 616pm  ','0'),('613','en','node_search',' this happened in buriton this happened in buriton lambattack2jpg we apologise for the shocking photograph but maybe you can help stop this from happening again  doug jones sat 4042015 627pm  ','0'),('614','en','node_search',' election day election day your chance to choose your district and parish councillors as well as your mp elections to the parish council take place on the same day as the general election being a parish councillor gives you a chance to help make decisions on issues that affect our local community you don t need to have any experience or affiliation with any political party you just need enthusiasm for the parish more details of the process and more information about the parish council can be found here  http wwwburitoninfo parishcouncil doug jones wed 8042015 317pm  ','0'),('615','en','node_search',' suspicious phone calls and scams suspicious phone calls and scams burglar2jpg hampshire police are warning people about three telephone scams please warn your friends and neighbours doug jones sat 18042015 434pm  ','0'),('616','en','node_search',' visitors flock to see lambs visitors flock to see lambs lambingimg5630jpg scores of families visited nursted farm in the first of this year s lambing weekends the farm will be open again on saturday 25th and sunday 26th april from 2pm to 430pm doug jones sat 18042015 440pm  ','0'),('617','en','node_search',' buriton s got talent buriton s got talent pachasapopruuacuhovistajotrichidrarudocukonotredau britain s got talent may be back on the telly but in buriton all eyes will be focused on village performers doug jones sat 18042015 446pm  ','0');
