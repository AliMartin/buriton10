DROP TABLE IF EXISTS `captcha_sessions`;
CREATE TABLE `captcha_sessions` (   `csid` int(11) NOT NULL AUTO_INCREMENT COMMENT 'CAPTCHA session ID.',   `token` varchar(64) DEFAULT NULL COMMENT 'One time CAPTCHA token.',   `uid` int(11) NOT NULL DEFAULT 0 COMMENT 'User''s users.uid.',   `sid` varchar(64) NOT NULL DEFAULT '' COMMENT 'Session ID of the user.',   `ip_address` varchar(128) DEFAULT NULL COMMENT 'IP address of the visitor.',   `timestamp` int(11) NOT NULL DEFAULT 0 COMMENT 'A Unix timestamp indicating when the challenge was generated.',   `form_id` varchar(128) NOT NULL COMMENT 'The form_id of the form where the CAPTCHA is added to.',   `solution` varchar(128) NOT NULL DEFAULT '' COMMENT 'Solution of the challenge.',   `status` int(11) NOT NULL DEFAULT 0 COMMENT 'Status of the CAPTCHA session (unsolved, solved, ...)',   `attempts` int(11) NOT NULL DEFAULT 0 COMMENT 'The number of attempts.',   PRIMARY KEY (`csid`),   KEY `csid_ip` (`csid`,`ip_address`) ) ENGINE=InnoDB AUTO_INCREMENT=34372 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='Stores the data about CAPTCHA sessions (solution, IP…' AUTO_INCREMENT=34372;
