INSERT INTO `search_dataset` VALUES ('657','en','node_search',' a peal linked to an appeal a peal linked to an appeal pachasapopruuacuhovistajotrichidrarudocukonotredau on saturday 12th december the buriton bellringers will be marking a 300 year old connection with a very special performance doug jones fri 13112015 847am  ','0'),('663','en','node_search',' the lady in the van the lady in the van lady in the vanjpg a wonderfully warmhearted romp maggie smith is magnificent as a homeless woman who shares alan bennett s drive in this moving adaptation of the west end play doug jones sun 13122015 1024am  ','0'),('664','en','node_search',' a walk in the woods a walk in the woods awalkinthewoodsjpg a comedy drama based on bill bryson s best seller doug jones sun 13122015 1026am  ','0'),('665','en','node_search',' suffragette suffragette suffragettepng one of the most eagerly awaited films of the year starring cary mulligan helena bonhamcarter meryl streep annemarie duff and romola garai doug jones sun 13122015 1027am  ','0'),('666','en','node_search',' 45 years 45 years 45yearsposterjpg tom courtenay and charlotte rampling are at the top of their game in this compelling drama of lost love and missed opportunity doug jones sun 13122015 1029am  ','0'),('667','en','node_search',' gardens open gardens open gardens open cjpg the second day of the buriton village show weekend and a chance to enjoy the beauty of a number of gardens around the parish doug jones sun 13122015 1036am  ','0'),('668','en','node_search',' village show village show village show 1cjpg buriton s popular annual village show including flowers fruit vegetables baking and arts crafts entries in the morning showtime in the afternoon doug jones sun 13122015 1037am  ','0'),('669','en','node_search',' local woodland industries an illustrated talk with scores of pictures from yesteryear local woodland industries an illustrated talk with scores of pictures from yesteryear woodland talkjpg tim winter will talk about